#!/bin/sh
# Run the checks of each part of the repository that the push changes.
# A failed check stops the push. This hook replaces CI on pull requests.
#
# Enable it once per clone:  git config core.hooksPath .githooks
# Run all checks:            APPGEN_CHECK_ALL=1 git push
# Skip the hook:             git push --no-verify
#
# To add a part, add a check_<part> function and call it in the
# "Parts" section with the path patterns of the part.

set -uf

# In Claude Code cloud sessions, use the mirror images of the sandbox.
if [ "${CLAUDE_CODE_REMOTE:-}" = "true" ]; then
    # shellcheck source=scripts/sandbox.env
    . scripts/sandbox.env
fi

changed=""
check_all="${APPGEN_CHECK_ALL:-0}"
failed=0

# Collect the files that the pushed commits change. Git gives one line
# for each pushed ref on stdin.
while read -r local_ref local_sha remote_ref remote_sha; do
    # A push that deletes a ref has no commits to check.
    case "$local_sha" in *[!0]*) ;; *) continue ;; esac

    if [ -n "${remote_sha##*[!0]*}" ] || ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
        # A new branch, or a remote commit that is not in this clone:
        # compare with the default branch of the remote.
        base=$(git merge-base "$local_sha" refs/remotes/origin/HEAD 2>/dev/null ||
            git merge-base "$local_sha" refs/remotes/origin/main 2>/dev/null) || base=""
    else
        base=$(git merge-base "$local_sha" "$remote_sha" 2>/dev/null) || base=""
        # A squash merge leaves the remote branch behind the default
        # branch. Do not count the changes of the default branch: use
        # its merge base when that base is newer.
        main_base=$(git merge-base "$local_sha" refs/remotes/origin/main 2>/dev/null) || main_base=""
        if [ -n "$base" ] && [ -n "$main_base" ] &&
            git merge-base --is-ancestor "$base" "$main_base"; then
            base=$main_base
        fi
    fi

    if [ -z "$base" ]; then
        echo "pre-push: no base commit for $local_ref, so run all checks."
        check_all=1
        continue
    fi
    changed="$changed
$(git diff --name-only "$base" "$local_sha")"
done

# Return 0 if a changed file matches one of the patterns (shell globs).
changes() {
    [ "$check_all" = 1 ] && return 0
    for pattern in "$@"; do
        for file in $changed; do
            # shellcheck disable=SC2254
            case "$file" in $pattern) return 0 ;; esac
        done
    done
    return 1
}

# Run one check. Record a failure, but continue, so that the output
# shows all failed checks.
run() {
    echo "pre-push: $*"
    if ! "$@"; then
        failed=1
    fi
}

check_python() {
    run uv run --locked ruff check
    run uv run --locked ruff format --check
    run uv run --locked pyright
    run uv run --locked pytest
}

# Check the traces of the output of the test binding (the golden
# files, which the tests compare with a fresh generator run).
check_traces() {
    run uv run --locked appgen check tests/fixtures/project-tracker.yaml tests/golden/minimal
    run uv run --locked appgen check tests/fixtures/project-tracker.yaml tests/golden/fastapi
}

# The app checks to run, for example " fastapi react". Each app has a
# check script scripts/check-<app>.sh: it generates the project tracker
# with the binding of the app, and builds, tests, and checks the output.
apps=""

# Run the app checks at the same time. The apps use different ports,
# image tags, and container names. Each output line of a check starts
# with the name of its app. APPGEN_CHECK_SERIAL=1 runs one check after
# the other, without the prefix.
run_apps() {
    [ -n "$apps" ] || return 0
    if [ "${APPGEN_CHECK_SERIAL:-0}" = 1 ]; then
        for app in $apps; do
            run scripts/check-"$app".sh
        done
        return 0
    fi
    # Start Docker and prepare the images once, before the checks start.
    if [ "${CLAUDE_CODE_REMOTE:-}" = "true" ]; then
        scripts/sandbox-setup.sh
    fi
    status_dir=$(mktemp -d "${TMPDIR:-/tmp}/appgen-pre-push.XXXXXX")
    for app in $apps; do
        echo "pre-push: scripts/check-$app.sh (in parallel)"
        (
            {
                scripts/check-"$app".sh 2>&1
                echo $? >"$status_dir/$app"
            } | while IFS= read -r line; do
                printf '[%s] %s\n' "$app" "$line"
            done
        ) &
    done
    wait
    for app in $apps; do
        if [ "$(cat "$status_dir/$app" 2>/dev/null)" = 0 ]; then
            echo "pre-push: scripts/check-$app.sh passed"
        else
            echo "pre-push: scripts/check-$app.sh failed (see the lines that start with [$app])"
            failed=1
        fi
    done
    rm -rf "$status_dir"
}

# Parts
if changes '*.py' 'src/*' 'tests/*' 'schema/*' 'examples/*' 'docs/*' '*.md' 'pyproject.toml' 'uv.lock' '.python-version' '.githooks/*'; then
    check_python
    check_traces
fi

if changes 'src/appgen/cli.py' 'src/appgen/__init__.py' 'src/appgen/__main__.py' 'src/appgen/dsl/*' \
    'src/appgen/gen/*' 'src/appgen/trace/*' 'src/appgen/bindings/fastapi/*' \
    'examples/project-tracker/*' 'examples/room-booking/*' 'scripts/check-fastapi.sh' \
    'scripts/check_schema_change.py' 'scripts/mock_oidc.py' 'scripts/check_provider_sign_in.py' \
    'scripts/check_shared_rate_limit.py' 'scripts/check_deploy_files.py' \
    'tests/fixtures/provider-sign-in.yaml' 'tests/fixtures/account-security.yaml' \
    'scripts/smoke_test.py' 'scripts/sandbox.env' 'scripts/sandbox-setup.sh' 'pyproject.toml' 'uv.lock' \
    '.githooks/*'; then
    apps="$apps fastapi"
fi

if changes 'src/appgen/cli.py' 'src/appgen/__init__.py' 'src/appgen/__main__.py' 'src/appgen/dsl/*' \
    'src/appgen/gen/*' 'src/appgen/trace/*' 'src/appgen/bindings/nextjs/*' 'src/appgen/bindings/shared/*' \
    'examples/project-tracker/*' 'examples/room-booking/*' 'scripts/check-nextjs.sh' \
    'scripts/check_shared_rate_limit.py' 'scripts/check_deploy_files.py' 'scripts/smoke_test.py' 'ui-tests/*' \
    'scripts/sandbox.env' 'scripts/sandbox-setup.sh' 'pyproject.toml' 'uv.lock' '.githooks/*'; then
    apps="$apps nextjs"
fi

if changes 'src/appgen/cli.py' 'src/appgen/__init__.py' 'src/appgen/__main__.py' 'src/appgen/dsl/*' \
    'src/appgen/gen/*' 'src/appgen/trace/*' 'src/appgen/bindings/react/*' 'src/appgen/bindings/shared/*' \
    'examples/project-tracker/*' 'scripts/check-react.sh' 'scripts/smoke_test.py' 'ui-tests/*' \
    'scripts/sandbox.env' 'scripts/sandbox-setup.sh' 'pyproject.toml' 'uv.lock' '.githooks/*'; then
    apps="$apps react"
fi

if changes 'src/appgen/cli.py' 'src/appgen/__init__.py' 'src/appgen/__main__.py' 'src/appgen/dsl/*' \
    'src/appgen/gen/*' 'src/appgen/bindings/react/*' 'src/appgen/bindings/fastapi/*' \
    'src/appgen/bindings/shared/*' 'examples/project-tracker/*' 'scripts/check-react-api.sh' \
    'scripts/api_client_test.py' 'scripts/sandbox.env' 'pyproject.toml' 'uv.lock' '.githooks/*'; then
    apps="$apps react-api"
fi

if changes 'src/appgen/cli.py' 'src/appgen/__init__.py' 'src/appgen/__main__.py' 'src/appgen/dsl/*' \
    'src/appgen/gen/*' 'src/appgen/bindings/react/*' 'src/appgen/bindings/nextjs/*' \
    'src/appgen/bindings/shared/*' 'examples/project-tracker/*' 'scripts/check-translations.sh' \
    'scripts/translation_test.py' 'scripts/untranslated_text.mjs' 'scripts/smoke_test.py' 'ui-tests/*' \
    'scripts/sandbox.env' 'pyproject.toml' 'uv.lock' '.githooks/*'; then
    apps="$apps translations"
fi

if changes 'src/appgen/cli.py' 'src/appgen/__init__.py' 'src/appgen/__main__.py' 'src/appgen/dsl/*' \
    'src/appgen/gen/*' 'src/appgen/bindings/react/*' 'src/appgen/bindings/nextjs/*' \
    'src/appgen/bindings/fastapi/*' 'src/appgen/bindings/shared/*' 'examples/room-booking/*' \
    'scripts/check-auth-ui.sh' 'scripts/auth_ui_test.py' 'scripts/mock_oidc.py' \
    'scripts/smoke_test.py' 'ui-tests/*' \
    'scripts/sandbox.env' 'pyproject.toml' 'uv.lock' '.githooks/*'; then
    apps="$apps auth-ui"
fi

run_apps

if [ "$failed" -ne 0 ]; then
    echo "pre-push: a check failed. Fix it, or push with --no-verify to skip the hook."
    exit 1
fi
