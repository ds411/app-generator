# Defaults for the check scripts in Claude Code cloud sessions (the
# sandbox). Docker Hub gives status 429 and ghcr.io is blocked there, so
# the checks use mirror images. A variable that the environment already
# sets keeps its value.
#
# The SessionStart hook (.claude/hooks/session-start.sh) loads this file
# into the session, and the pre-push hook loads it in cloud sessions.
# Load it by hand with:  . scripts/sandbox.env
#
# The file is a POSIX shell script: it only sets variables.

: "${POSTGRES_IMAGE:=mirror.gcr.io/library/postgres:18-alpine}"
: "${UV_IMAGE:=mirror.gcr.io/astral/uv:0.11}"
: "${PYTHON_IMAGE:=mirror.gcr.io/library/python:3.14-slim}"
: "${NGINX_IMAGE:=mirror.gcr.io/nginxinc/nginx-unprivileged:1.29-alpine}"
: "${NODE_IMAGE:=localhost/appgen-node:24-alpine}"
export POSTGRES_IMAGE UV_IMAGE PYTHON_IMAGE NGINX_IMAGE NODE_IMAGE
