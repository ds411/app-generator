import type { Metadata } from "next";

import { SignInForm } from "@/features/sign-in";

export const metadata: Metadata = { title: "Sign in" };

/** The sign-in page. After the sign-in, the app opens the page in `next`. */
export default async function Route({ searchParams }: PageProps<"/sign-in">) {
  const { next } = await searchParams;
  return <SignInForm next={typeof next === "string" && next.startsWith("/") ? next : "/"} />;
}
