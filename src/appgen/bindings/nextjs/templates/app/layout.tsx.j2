import { localeOf } from "@/shared/lib/i18n";
import { inRequestLanguage, requestLanguage } from "@/shared/lib/i18n-server";

/** The title and the description of the pages, in the language of the request. */
export async function generateMetadata(): Promise<Metadata> {
  return inRequestLanguage(() => ({
    title: { default: {{ tr("appConfig.title") }}, template: `%s · ${ {{- tr("appConfig.title") -}} }` },
    description: {{ tr("appConfig.description") }},
  }));
}
{% else %}

export const metadata: Metadata = {
  title: { default: appConfig.title, template: `%s · ${appConfig.title}` },
  description: appConfig.description,
};
{% endif %}

