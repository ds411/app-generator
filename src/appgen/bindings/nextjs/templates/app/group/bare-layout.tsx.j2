{{ trace_header("app") }}
import type { ReactNode } from "react";

{% if i18n %}
import { LanguageSwitch } from "@/features/switch-language";
{% endif %}
{% if nextjs.mode_toggle %}
import { ModeToggle } from "@/features/toggle-theme";
{% endif %}
import { appConfig } from "@/shared/config";

/** The frame of the pages without a layout: a header with the app title, and the page. */
export default function Layout({ children }: Readonly<{ children: ReactNode }>) {
  return (
    <div className="min-h-svh bg-background text-foreground">
      <header className="flex items-center justify-between border-b px-6 py-3">
        <span className="font-semibold">{{ "{" ~ tr("appConfig.title") ~ "}" }}</span>
{% if i18n %}
        <div className="flex items-center gap-2">
          <LanguageSwitch />
{% endif %}
{% if nextjs.mode_toggle %}
{% if i18n %}  {% endif %}        <ModeToggle />
{% endif %}
{% if i18n %}
        </div>
{% endif %}
      </header>
      <main className="p-6">{children}</main>
    </div>
  );
}
