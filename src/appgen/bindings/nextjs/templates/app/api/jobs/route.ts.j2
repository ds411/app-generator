{{ trace_header(element_id) }}
{% set job = nextjs.jobs[name] %}
import { {{ job.function }} } from "@/app/jobs/{{ job.module }}";
import { handleJob } from "@/shared/lib/jobs";

// Each call runs the job, so the build does not render the route.
export const dynamic = "force-dynamic";

/**
 * Run the job `{{ job.name }}`. A scheduler calls the route with the secret
 * JOBS_SECRET, for example a CronJob of `deploy/` (README.md, section Jobs).
 */
export async function POST(request: Request) {
  return handleJob(request, {{ job.name | tojson }}, {{ job.function }});
}
