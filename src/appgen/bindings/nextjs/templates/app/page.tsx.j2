{% set info = nextjs.pages[name] %}
{% set detail = element.entity and info.params and element.content is not none and element.content.view in ui_views.detail_views %}
{% set protected = definition.auth and name not in definition.auth.public_pages %}
{{ trace_header(element_id) }}
import type { Metadata } from "next";
{% if detail %}
import { notFound } from "next/navigation";

import { {{ element.entity | camel }}Repository } from "@/entities/{{ element.entity | kebab }}/server";
{% else %}

{% endif %}
import { {{ info.component }} } from "@/pages/{{ info.slice }}";
{% if protected and definition.access %}
import { requirePage } from "@/shared/auth/access";
{% elif protected %}
import { requirePageUser } from "@/shared/auth/session";
{% endif %}
{% if i18n %}
import { inRequestLanguage } from "@/shared/lib/i18n-server";
{% endif %}

{% if i18n %}
/** The title of the page, in the language of the request. */
export async function generateMetadata(): Promise<Metadata> {
  return inRequestLanguage(() => ({ title: {{ tr(js(element.title)) }} }));
}
{% else %}
export const metadata: Metadata = { title: {{ element.title | tojson }} };
{% endif %}
{% if detail %}

/** Show the not-found page (status 404) if the record does not exist. */
export default async function Route({ params }: PageProps<{{ ("/" ~ info.route_dir) | tojson }}>) {
{% if protected %}
{% if definition.access %}
  await requirePage({{ name | camel | tojson }}, {{ element.path | tojson }}, await params); {{ trace(definition.access.id) }}
{% else %}
  await requirePageUser({{ element.path | tojson }}, await params); {{ trace(definition.auth.id) }}
{% endif %}
{% endif %}
  const { {% if info.params[-1] != "id" %}{{ info.params[-1] }}: {% endif %}id } = await params;
  if (!(await {{ element.entity | camel }}Repository.exists(id))) {
    notFound();
  }
  return <{{ info.component }} />;
}
{% else %}

{% if protected %}
export default async function Route({% if info.params %}{ params }: PageProps<{{ ("/" ~ info.route_dir) | tojson }}>{% endif %}) {
{% if definition.access %}
  await requirePage({{ name | camel | tojson }}, {{ element.path | tojson }}{% if info.params %}, await params{% endif %}); {{ trace(definition.access.id) }}
{% else %}
  await requirePageUser({{ element.path | tojson }}{% if info.params %}, await params{% endif %}); {{ trace(definition.auth.id) }}
{% endif %}
  return <{{ info.component }} />;
}
{% else %}
export default function Route() {
  return <{{ info.component }} />;
}
{% endif %}
{% endif %}
