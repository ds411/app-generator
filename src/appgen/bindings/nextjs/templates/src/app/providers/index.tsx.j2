{{ trace_header(theme_element) }}
"use client";

import type { ReactNode } from "react";

{% if i18n %}
import type { Language } from "@/shared/lib/i18n";
import { LanguageProvider } from "@/shared/lib/language-provider";
{% endif %}
import { ThemeProvider } from "@/shared/lib/theme";
import { Toaster } from "@/shared/ui/sonner";
{% if memberships %}

// The data access of the memberships, for the actions of the UI (ADR 0048).
import "./member-permissions";
{% endif %}

{% if i18n %}
/** The toasts, with their labels in the selected language. */
function Toasts() {
  return (
    <Toaster
      richColors
      closeButton
      containerAriaLabel={{ jsx_attr("Notifications") }}
      toastOptions={ { closeButtonAriaLabel: {{ tr(js("Close toast")) }} } }
    />
  );
}

{% endif %}
{% if i18n %}
/** The providers of the app: the color mode, the language (the language of the request first), and the toasts. */
export function Providers({ language, children }: Readonly<{ language: Language; children: ReactNode }>) {
{% else %}
/** The providers of the app: the color mode and the toasts. */
export function Providers({ children }: Readonly<{ children: ReactNode }>) {
{% endif %}
  return (
    <ThemeProvider
      attribute="class"
      defaultTheme={{ nextjs.default_mode | tojson }}
      enableSystem
      disableTransitionOnChange
    >
{% if i18n %}
      <LanguageProvider language={language}>
        {children}
        <Toasts />
      </LanguageProvider>
{% else %}
      {children}
      <Toaster richColors closeButton />
{% endif %}
    </ThemeProvider>
  );
}
