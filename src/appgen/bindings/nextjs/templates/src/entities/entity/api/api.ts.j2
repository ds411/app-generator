{{ trace_header(element_id) }}
{% set type = name | pascal %}
{% set var = name | camel %}
{# An operation with lines (ADR 0035) is in its own feature slice. #}
{% set ops = operations_of(definition, name) | rejectattr("1.kind", "in", ("custom", "query")) | rejectattr("1.lines") | list %}
{% set lists = inverse_lists(definition, name) %}
{% set files = element.file_fields if definition.storage else {} %}
{% set history = element.history %}
{% set share = shares.get(name) %}
{% set ranges = nextjs.ranges.get(name) %}
{% set presence = presences.values() | selectattr("entity", "eq", name) | list %}
{% set api_names = ["createEntityApi"] + (["createFileApi"] if files else []) + (["createHistoryApi"] if history else []) + (["createPresenceApi"] if presence else []) + (["createSharingApi"] if share else []) + ["type EntityApi"] + (["type FileApi"] if files else []) + (["type HistoryApi"] if history else []) + (["type ListQuery", "type ListResult"] if lists or ops | selectattr("1.kind", "eq", "list") | list else []) + (["type OwnerRange"] if ranges else []) + (["type PresenceApi"] if presence else []) + (["type SharingApi"] if share else []) + (["unwrap"] if ranges else []) %}
import { {{ api_names | join(", ") }} } from "@/shared/api";

import type { {{ type }}, {{ type }}Input{{ ", " ~ type ~ "FileField" if files }} } from "../model/types";
import {
  create{{ type }}Action,
{% if share %}
  create{{ type }}ShareLinkAction,
{% endif %}
  get{{ type }}Action,
{% if share %}
  get{{ type }}ShareLinkAction,
{% endif %}
{% if presence %}
  here{{ type }}PresenceAction,
  leave{{ type }}PresenceAction,
{% endif %}
  list{{ type }}Action,
{% if history %}
  list{{ type }}HistoryAction,
{% endif %}
{% if ranges %}
  list{{ type }}RangesAction,
{% endif %}
  remove{{ type }}Action,
{% if files %}
  remove{{ type }}FileAction,
{% endif %}
{% if history %}
  restore{{ type }}HistoryEntryAction,
{% endif %}
{% if share %}
  revoke{{ type }}ShareLinkAction,
{% endif %}
  update{{ type }}Action,
{% if files %}
  upload{{ type }}FileAction,
{% endif %}
} from "./{{ name | kebab }}-actions";

/** The data access of {{ type }}. It calls the server actions, in the browser and on the server. */
export const {{ var }}Api: EntityApi<{{ type }}, {{ type }}Input> = createEntityApi({{ ts_value(name) }}, {
  list: list{{ type }}Action,
  get: get{{ type }}Action,
  create: create{{ type }}Action,
  update: update{{ type }}Action,
  remove: remove{{ type }}Action,
});
{% if files %}

/** The files of the file fields of {{ type }} (ADR 0027): the upload and the delete. */
export const {{ var }}Files: FileApi<{{ type }}, {{ type }}FileField> = createFileApi({{ ts_value(name) }}, {
  upload: upload{{ type }}FileAction,
  remove: remove{{ type }}FileAction,
});
{% endif %}
{% if history %}

/** The change log of {{ type }} (ADR 0040): the entries of a record, and a restore. */
export const {{ var }}History: HistoryApi<{{ type }}> = createHistoryApi({{ ts_value(name) }}, { {{ trace(history.id) }}
  list: list{{ type }}HistoryAction,
  restore: restore{{ type }}HistoryEntryAction,
});
{% endif %}
{% if presence %}

/** The other users on the pages of the records of {{ type }} (ADR 0052). */
export const {{ var }}Presence: PresenceApi = createPresenceApi({{ ts_value(name) }}, { {{ trace(presence[0].page_id) }}
  here: here{{ type }}PresenceAction,
  leave: leave{{ type }}PresenceAction,
});
{% endif %}
{% if share %}

/** The secret links of {{ type }} (ADR 0049): the state of the link of a record, a new link, and a revoke. */
export const {{ var }}Sharing: SharingApi = createSharingApi({ {{ trace(share.page_id) }}
  state: get{{ type }}ShareLinkAction,
  create: create{{ type }}ShareLinkAction,
  revoke: revoke{{ type }}ShareLinkAction,
});
{% endif %}
{% if ranges %}

/** Return the ranges of the related records of an available filter of {{ type }} (ADR 0047). */
export async function {{ var }}Ranges(key: {{ ranges.keys }}): Promise<OwnerRange[]> {
  return unwrap(await list{{ type }}RangesAction(key));
}
{% endif %}
{% for op_name, op in ops %}

{% if op.description %}
/** {{ op.description }} */
{% endif %}
{% if op.kind == "create" %}
export function {{ op_name | camel }}(input: {{ type }}Input): Promise<{{ type }}> { {{ trace(op.id) }}
  return {{ var }}Api.create(input);
}
{% elif op.kind == "read" %}
export function {{ op_name | camel }}(id: string): Promise<{{ type }}> { {{ trace(op.id) }}
  return {{ var }}Api.get(id);
}
{% elif op.kind == "update" %}
export function {{ op_name | camel }}(id: string, patch: Partial<{{ type }}Input>): Promise<{{ type }}> { {{ trace(op.id) }}
  return {{ var }}Api.update(id, patch);
}
{% elif op.kind == "delete" %}
export function {{ op_name | camel }}(id: string): Promise<void> { {{ trace(op.id) }}
  return {{ var }}Api.remove(id);
}
{% elif op.kind == "list" %}
export function {{ op_name | camel }}(query?: ListQuery<{{ type }}>): Promise<ListResult<{{ type }}>> { {{ trace(op.id) }}
  return {{ var }}Api.list(query);
}
{% endif %}
{% endfor %}
{% for owner, relation_name, relation in lists %}

/** The {{ type }} records of one {{ owner | pascal }}. */
export function list{{ relation_name | pascal }}Of{{ owner | pascal }}( {{ trace(relation.id) }}
  {{ owner | camel }}Id: string,
  query: ListQuery<{{ type }}> = {},
): Promise<ListResult<{{ type }}>> {
  const filters = [...(query.filters ?? []), { field: "{{ relation.inverse | camel }}Id" as const, op: "eq" as const, value: {{ owner | camel }}Id }];
  return {{ var }}Api.list({ ...query, filters });
}
{% endfor %}
