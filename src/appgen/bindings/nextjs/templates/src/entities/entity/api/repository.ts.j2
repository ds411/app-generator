{% set table = nextjs.tables_by_entity[name] %}
{% set type = name | pascal %}
{% set var = name | camel %}
{% set rules = record_rules.get(name) %}
{% set condition = nextjs.owner_conditions.get(name) %}
{% set totals = nextjs.totals.get(name) %}
{% set imports = [table.const] + table.lists | map(attribute="join_const") | list + table.inverse_ones | map(attribute="target_table") | list + ((condition.tables + ["getDb"]) if condition else []) + (totals.tables if totals else []) %}
{% set operators = (condition.operators if condition else []) + (totals.operators if totals else []) %}
{{ trace_header(element_id) }}
import "server-only";

{% if operators %}
import { {{ operators | unique | sort | join(", ") }} } from "drizzle-orm";

{% endif %}
import { {{ imports | unique | sort | join(", ") }} } from "@/shared/db";
{% if element.history %}
import type { HistoryMember } from "@/shared/db/history";
{% endif %}
import { Repository{{ ", total" if totals }} } from "@/shared/db/repository";

{% set events = ts_events(definition, name) %}
{% set schemas = events | map(attribute="schema") | select | unique | sort | list %}
{% if schemas %}
import { {{ schemas | join(", ") }} } from "../model/schema";
{% endif %}
import { {{ var }}Defaults, type {{ type }}, type {{ type }}Input } from "../model/types";

{% if element.history %}
/** The fields and the relations that the change log of {{ type }} keeps (ADR 0040): the name and the key. */
export const {{ var }}HistoryMembers: HistoryMember[] = [ {{ trace(element.history.id) }}
{% for m in history_members(name, element) %}
  [{{ ts_value(m.name) }}, {{ ts_value(m.key) }}],
{% endfor %}
];

{% endif %}
/** The data access of {{ type }} in the database. Use it only on the server. */
export const {{ var }}Repository = new Repository<{{ type }}, {{ type }}Input>({
  entity: {{ ts_value(name) }},
  table: {{ table.const }},
  defaults: {{ var }}Defaults,
{% set translatable = element.fields.items() | selectattr("1.translatable") | list %}
{% if translatable %}
  translatable: [{% for field_name, field in translatable %}{{ ts_value(field_name | camel) }}{{ ", " if not loop.last }}{% endfor %}],
{% endif %}
{% if element.history %}
  history: {{ var }}HistoryMembers,
{% endif %}
{% if element.file_fields %}
  // The URLs of the files: app/files/{{ name | kebab }}/[id]/[field]/route.ts (ADR 0027).
  files: {
{% for field_name, field in element.file_fields.items() %}
    {{ field_name | camel }}: {{ ts_value("/files/" ~ (name | kebab) ~ "/{id}/" ~ (field_name | kebab)) }}, {{ trace(field.id) }}
{% endfor %}
  },
{% endif %}
{% if rules and rules.direct %}
  owner: {{ ts_value(rules.path[0].key) }}, {{ trace(rules.path[0].element_id) }}
{% elif condition %}
  // The records of a user: the owner path {{ rules.path | map(attribute="relation") | join(".") }} of the record rules (ADR 0025).
{% for step in rules.path %}
  {{ trace(step.element_id) }}
{% endfor %}
  belongsTo: (user) =>
    {{ condition.code }},
{% endif %}
{% if table.lists %}
  manyToMany: [
{% for item in table.lists %}
    { {{ trace(item.element_id, scope="begin") }}
      key: {{ ts_value(item.key) }},
      table: {{ item.join_const }},
      ownerKey: {{ ts_value(item.owner_key) }},
      targetKey: {{ ts_value(item.target_key) }},
    }, {{ trace(item.element_id, scope="end") }}
{% endfor %}
  ],
{% endif %}
{% if table.inverse_ones %}
  inverseOne: [
{% for item in table.inverse_ones %}
    { {{ trace(item.element_id, scope="begin") }}
      key: {{ ts_value(item.key) }},
      table: {{ item.target_table }},
      foreignKey: {{ ts_value(item.foreign_key) }},
    }, {{ trace(item.element_id, scope="end") }}
{% endfor %}
  ],
{% endif %}
{% if totals and totals.totals %}
  // The totals of the related records (ADR 0034): a subquery for each one, of the record `record`.
  totals: (record) => ({
{% for t in totals.totals %}
{% for id in t.ids %}
    {{ trace(id) }}
{% endfor %}
    {{ t.code }}
{% endfor %}
  }),
{% endif %}
{% set compares = element.rules.values() | selectattr("kind", "eq", "compare") | rejectattr("totals") | list %}
{% set total_rules = element.rules.values() | selectattr("kind", "eq", "compare") | selectattr("totals") | list %}
{% set overlaps = element.rules.values() | selectattr("kind", "eq", "no_overlap") | list %}
{% if compares %}
  compare: [
{% for rule in compares %}
    { {{ trace(rule.id, scope="begin") }}
      field: {{ ts_value(rule_key(element, rule.field)) }},
      op: {{ ts_value(rule.op) }},
      other: {{ ts_value(rule_key(element, rule.other)) }},
      message: {{ text(rule.message) if i18n else ts_value(rule.message) }},
    }, {{ trace(rule.id, scope="end") }}
{% endfor %}
  ],
{% endif %}
{% if total_rules %}
  // The compare rules with totals of the lines (ADR 0034): checked after a change.
  totalRules: [
{% for rule in total_rules %}
    { {{ trace(rule.id, scope="begin") }}
      field: {{ ts_value(rule_side_key(rule.field) or rule_key(element, rule.field)) }},
      op: {{ ts_value(rule.op) }},
      other: {{ ts_value(rule_side_key(rule.other) or rule_key(element, rule.other)) }},
      message: {{ text(rule.message) if i18n else ts_value(rule.message) }},
    }, {{ trace(rule.id, scope="end") }}
{% endfor %}
  ],
{% endif %}
{% if totals and totals.rules %}
  // The totals that only the rules use: a subquery for each one, of the record `record`.
  ruleTotals: (record) => ({
{% for t in totals.rules %}
{% for id in t.ids %}
    {{ trace(id) }}
{% endfor %}
    {{ t.code }}
{% endfor %}
  }),
{% endif %}
{% if overlaps %}
  noOverlap: [
{% for rule in overlaps %}
    { {{ trace(rule.id, scope="begin") }}
      start: {{ ts_value(rule_key(element, rule.start)) }},
      end: {{ ts_value(rule_key(element, rule.end)) }},
      scope: {{ ts_value(rule_keys(element, rule.scope)) }},
      message: {{ text(rule.message) if i18n else ts_value(rule.message) }},
    }, {{ trace(rule.id, scope="end") }}
{% endfor %}
  ],
{% endif %}
{% set workflows = definition.workflows.values() | selectattr("entity", "eq", name) | list %}
{% if workflows %}
  workflows: [
{% for w in workflows %}
    { {{ trace(w.id, scope="begin") }}
      field: {{ ts_value(rule_key(element, w.field)) }},
{% if w.initial %}
      initial: {{ ts_value(w.initial) }},
{% endif %}
      transitions: [
{% for t in w.transitions.values() %}
{% for before in t.from_ %}
        [{{ ts_value(before) }}, {{ ts_value(t.to) }}], {{ trace(t.id) }}
{% endfor %}
{% endfor %}
      ],
{% if w.message %}
      message: {{ text(w.message) if i18n else ts_value(w.message) }},
{% endif %}
    }, {{ trace(w.id, scope="end") }}
{% endfor %}
  ],
{% endif %}
{% if events %}
  events: {
    // The events (ADR 0031). The repository imports the extension file of an
    // operation when its event runs, because the operation imports the repository.
{% for event in events | rejectattr("kind", "eq", "transition") %}
{% if event.kind == "changed" %}
    changed: { {{ trace(event.element_id, scope="begin") }}
      keys: {{ ts_value(event.keys | list) }},
      run: async (record) => {
        const { {{ event.function }} } = await import({{ ts_value(event.module) }});
        await {{ event.call() }};
      },
    }, {{ trace(event.element_id, scope="end") }}
{% else %}
    {{ event.kind }}: async (record) => { {{ trace(event.element_id, scope="begin") }}
      const { {{ event.function }} } = await import({{ ts_value(event.module) }});
      await {{ event.call() }};
    }, {{ trace(event.element_id, scope="end") }}
{% endif %}
{% endfor %}
{% set transitions = events | selectattr("kind", "eq", "transition") | list %}
{% if transitions %}
    transitions: [
{% for event in transitions %}
      { {{ trace(event.element_id, scope="begin") }}
        field: {{ ts_value(event.field) }},
        from: {{ ts_value(event.before | list) }},
        to: {{ ts_value(event.after) }},
        run: async (record) => {
          const { {{ event.function }} } = await import({{ ts_value(event.module) }});
          await {{ event.call() }};
        },
      }, {{ trace(event.element_id, scope="end") }}
{% endfor %}
    ],
{% endif %}
  },
{% endif %}
});
