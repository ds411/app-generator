{% set type = name | pascal %}
{% set var = name | camel %}
{{ trace_header(element_id) }}
{% set public = public_kinds(definition, name) %}
{% set ops = kind_operations(definition, name) if definition.access else {} %}
{% macro opt(kind, changes) -%}
{%- set items = (["changes: true"] if changes else []) + (["public: true"] if kind in public else []) + (["operation: " ~ (ops[kind] | tojson)] if kind in ops and kind not in public else []) -%}
{%- if items %}, { {{ items | join(", ") }} }{% endif -%}
{%- endmacro %}
{% set rules = record_rules.get(name) %}
{% set owner_key = rules.path[0].key if rules and rules.direct else none %}
{# The key of the owner relation of a record of a guest (ADR 0050). #}
{% set guest_key = rules.guest if rules else none %}
{# The record rules (ADR 0018, ADR 0025) apply to the actions that are not public. #}
{% set owned = (["list", "read", "create", "update", "delete"] | reject("in", public) | list) if rules else [] %}
{# An entity of the scope of the memberships (ADR 0048): the scope of the records depends on the operation. #}
{% set member = memberships and rules and rules.scope is not none %}
{% macro scope(kind) -%}
await recordScope({{ ts_value(name) }}, {{ ts_value("read" if kind in ("list", "read") else "change") }}{% if member and kind in ops %}, {{ ts_value(ops[kind]) }}{% endif %})
{%- endmacro %}
{% set files = element.file_fields if definition.storage else {} %}
{% set all_ops = kind_operations(definition, name) %}
{# The upload of a file is a change of the record: the access of the update, else of the create (ADR 0027). #}
{% set file_kind = "create" if "update" not in all_ops and "create" in all_ops else "update" %}
"use server";

{% set history = element.history %}
{% set share = shares.get(name) %}
{% set ranges = nextjs.ranges.get(name) %}
{% if files or ranges %}
import { type ActionResult, {{ "type HistoryEntry, " if history }}type ListQuery, type ListResult, {{ "type MemberPermissions, " if member }}{{ "NotFoundError, " if files }}{{ "type OwnerRange, " if ranges }}{{ "type ShareLinkCreated, type ShareLinkState, " if share }}ValidationError } from "@/shared/api";
{% else %}
import type { ActionResult, {{ "HistoryEntry, " if history }}ListQuery, ListResult{{ ", MemberPermissions" if member }}{{ ", ShareLinkCreated, ShareLinkState" if share }} } from "@/shared/api";
{% endif %}
import { idSchema, parseListQuery, runAction } from "@/shared/api/server";
{% if owned %}
import { {{ "memberPermissions, " if member }}recordScope } from "@/shared/auth/access";
{% endif %}
{% if share %}
import { sessionUserId } from "@/shared/auth/session";
{% endif %}
{% if history %}
import { historyPage, oldValues, restorable } from "@/shared/db/history";
{% endif %}
{% if share %}
import { makeShareLink, revokeShareLink, shareLinkState } from "@/shared/db/sharing";
{% endif %}
{% set translatable_history = history_members(name, element) | selectattr("field") | selectattr("field.translatable") | list if history else [] %}
{% if translatable_history %}
import { defaultLanguage } from "@/shared/lib/i18n";
{% endif %}
{% if files %}
import { deleteFiles, type FileRule, uploadFile } from "@/shared/storage";
{% endif %}

import { {{ var }}InputSchema, {{ var }}PatchSchema } from "../model/schema";
import type { {{ type }}, {{ type }}Input{{ ", " ~ type ~ "FileField" if files }} } from "../model/types";
import { {{ var }}{{ "HistoryMembers, " ~ var if history }}{{ "RangeQueries, " ~ var if ranges }}Repository } from "./{{ name | kebab }}-repository";

// The server actions of the data access of {{ type }}. Each action checks
// its input, because a browser can call it with any values.{% if owned %} A user of a
// record rule (ADR 0018, ADR 0025) uses only the records of the rule: the
// other records do not exist for the user, and a new or changed record
// must be part of the rule.{% if owner_key %} The user owns each new record.{% endif %}{% endif +%}
{% for id in (rules.element_ids if owned else []) %}
{{ trace(id) }}
{% endfor %}

export async function list{{ type }}Action(
  query?: ListQuery<{{ type }}>,
): Promise<ActionResult<ListResult<{{ type }}>>> {
{% if "list" in owned %}
  return runAction(
    async () => {{ var }}Repository.list(parseListQuery<{{ type }}>(query), {{ scope("list") }}),
    {{ opt("list", false)[2:] or "{}" }},
  );
{% else %}
  return runAction(() => {{ var }}Repository.list(parseListQuery<{{ type }}>(query)){{ opt("list", false) }});
{% endif %}
}

{% if ranges %}

/**
 * Return the ranges of the related records of an available filter (ADR
 * 0047): `key` is the relation and the rule. A user who may list the
 * records gets the ranges of all related records, also of the records
 * that a record rule hides: a record is not free when another user has a
 * booking. The ranges have only the IDs of the records and the times.
 */
export async function list{{ type }}RangesAction(key: string): Promise<ActionResult<OwnerRange[]>> {
  return runAction(async () => {
    const query = Object.hasOwn({{ var }}RangeQueries, key) ? {{ var }}RangeQueries[key] : undefined;
    if (query === undefined) {
      throw new ValidationError(`{{ type }} has no available filter ${key}.`);
    }
    return query();
  }{{ opt("list", false) }});
}
{% endif %}

export async function get{{ type }}Action(id: string): Promise<ActionResult<{{ type }}>> {
{% if "read" in owned %}
  return runAction(
    async () => {{ var }}Repository.get(idSchema.parse(id), {{ scope("read") }}),
    {{ opt("read", false)[2:] or "{}" }},
  );
{% else %}
  return runAction(() => {{ var }}Repository.get(idSchema.parse(id)){{ opt("read", false) }});
{% endif %}
}

export async function create{{ type }}Action(input: {{ type }}Input): Promise<ActionResult<{{ type }}>> {
{% if "create" in owned %}
  return runAction(
    async () => {
      const scope = {{ scope("create") }};
{% if guest_key %}
      // A record of a guest has no owner until it moves to a user (ADR 0050).
{% if owner_key %}
      const owner = scope?.guest ? { {{ guest_key }}: null } : scope?.owner ? { {{ owner_key }}: scope.user } : {};
{% else %}
      const owner = scope?.guest ? { {{ guest_key }}: null } : {};
{% endif %}
      return {{ var }}Repository.create({{ var }}InputSchema.parse({ ...input, ...owner }), { scope });
{% elif owner_key %}
      const values = scope?.owner ? { ...input, {{ owner_key }}: scope.user } : input;
      return {{ var }}Repository.create({{ var }}InputSchema.parse(values), { scope });
{% else %}
      return {{ var }}Repository.create({{ var }}InputSchema.parse(input), { scope });
{% endif %}
    },
    {{ opt("create", true)[2:] }},
  );
{% else %}
  return runAction(() => {{ var }}Repository.create({{ var }}InputSchema.parse(input)){{ opt("create", true) }});
{% endif %}
}

export async function update{{ type }}Action(
  id: string,
  patch: Partial<{{ type }}Input>,
): Promise<ActionResult<{{ type }}>> {
  return runAction(
{% if "update" in owned %}
    async () => {
      const scope = {{ scope("update") }};
{% if guest_key %}
      // A guest cannot give its record an owner (ADR 0050).
{% if owner_key %}
      const owner = scope?.guest ? { {{ guest_key }}: undefined } : scope?.owner ? { {{ owner_key }}: scope.user } : {};
{% else %}
      const owner = scope?.guest ? { {{ guest_key }}: undefined } : {};
{% endif %}
      return {{ var }}Repository.update(idSchema.parse(id), {{ var }}PatchSchema.parse({ ...patch, ...owner }), scope);
{% elif owner_key %}
      const values = scope?.owner ? { ...patch, {{ owner_key }}: scope.user } : patch;
      return {{ var }}Repository.update(idSchema.parse(id), {{ var }}PatchSchema.parse(values), scope);
{% else %}
      return {{ var }}Repository.update(idSchema.parse(id), {{ var }}PatchSchema.parse(patch), scope);
{% endif %}
    },
{% else %}
    () => {{ var }}Repository.update(idSchema.parse(id), {{ var }}PatchSchema.parse(patch)),
{% endif %}
    {{ opt("update", true)[2:] }},
  );
}

export async function remove{{ type }}Action(id: string): Promise<ActionResult<null>> {
  return runAction(
    async () => {
{% if "delete" in owned %}
      await {{ var }}Repository.remove(idSchema.parse(id), {{ scope("delete") }});
{% else %}
      await {{ var }}Repository.remove(idSchema.parse(id));
{% endif %}
      return null;
    },
    {{ opt("delete", true)[2:] }},
  );
}
{% if files %}

// The rules of the file fields (ADR 0027): the largest file, in bytes, and
// the media types. Empty: all types.
const FILE_RULES: Record<{{ type }}FileField, FileRule> = {
{% for field_name, field in files.items() %}
  {{ field_name | camel }}: { maxSize: {{ field.size_limit }}, types: {{ ts_value(field.media_types) }} }, {{ trace(field.id) }}
{% endfor %}
};

/** Return the rule of a file field. A browser can send any name. */
function fileRule(field: string): FileRule {
  if (!Object.hasOwn(FILE_RULES, field)) {
    throw new ValidationError(`{{ type }} has no file field ${field}.`);
  }
  return FILE_RULES[field as {{ type }}FileField];
}

/**
 * Upload the file of a file field: the form data has it in `file`. A new
 * file replaces the old file, which the storage deletes after the change.
 */
export async function upload{{ type }}FileAction(
  id: string,
  field: {{ type }}FileField,
  data: FormData,
): Promise<ActionResult<{{ type }}>> {
  return runAction(
    async () => {
      const recordId = idSchema.parse(id);
      const rule = fileRule(field);
{% if file_kind in owned %}
      const scope = {{ scope(file_kind) }};
      if (!(await {{ var }}Repository.exists(recordId, scope))) {
{% else %}
      if (!(await {{ var }}Repository.exists(recordId))) {
{% endif %}
        throw new NotFoundError({{ ts_value(name) }}, recordId);
      }
      const file = await uploadFile(data.get("file"), rule, `{{ nextjs.tables_by_entity[name].name }}/${recordId}/${field}`, field);
      try {
        const { record, before } = await {{ var }}Repository.setFile(recordId, field, file{{ ", scope" if file_kind in owned }});
        await deleteFiles([before]);
        return record;
      } catch (error) {
        await deleteFiles([file]);
        throw error;
      }
    },
    {{ opt(file_kind, true)[2:] }},
  );
}

/** Delete the file of a file field. */
export async function remove{{ type }}FileAction(id: string, field: {{ type }}FileField): Promise<ActionResult<{{ type }}>> {
  return runAction(
    async () => {
      fileRule(field);
{% if file_kind in owned %}
      const scope = {{ scope(file_kind) }};
      const { record, before } = await {{ var }}Repository.setFile(idSchema.parse(id), field, null, scope);
{% else %}
      const { record, before } = await {{ var }}Repository.setFile(idSchema.parse(id), field, null);
{% endif %}
      await deleteFiles([before]);
      return record;
    },
    {{ opt(file_kind, true)[2:] }},
  );
}
{% endif %}
{% if history %}

{{ trace(history.id) }}
/** Return a page of the change log of a record, the newest first (ADR 0040). It needs the access of the read. */
export async function list{{ type }}HistoryAction(
  id: string,
  page?: { page: number; pageSize: number },
): Promise<ActionResult<ListResult<HistoryEntry>>> {
{% if "read" in owned %}
  return runAction(
    async () => {
      const record = await {{ var }}Repository.get(idSchema.parse(id), {{ scope("read") }});
      return historyPage({{ ts_value(name) }}, record.id, page);
    },
    {{ opt("read", false)[2:] or "{}" }},
  );
{% else %}
  return runAction(
    async () => {
      const record = await {{ var }}Repository.get(idSchema.parse(id));
      return historyPage({{ ts_value(name) }}, record.id, page);
    }{{ opt("read", false) }},
  );
{% endif %}
}

{{ trace(history.id) }}
/**
 * Give the fields of the entry of a change their old values back (ADR 0040).
 * The restore is a change, with the access and the checks of the update.
 */
export async function restore{{ type }}HistoryEntryAction(id: string, entryId: string): Promise<ActionResult<{{ type }}>> {
  return runAction(
    async () => {
{% if "update" in owned %}
      const scope = {{ scope("update") }};
      const record = await {{ var }}Repository.get(idSchema.parse(id), scope);
{% else %}
      const record = await {{ var }}Repository.get(idSchema.parse(id));
{% endif %}
      const entry = await restorable({{ ts_value(name) }}, record.id, idSchema.parse(entryId));
      const values = oldValues(entry, {{ var }}HistoryMembers);
{% for m in translatable_history %}
      if ({{ ts_value(m.key) }} in values) {
        // The change log keeps the value of the default language.
        values.{{ m.key }}Translations = { [defaultLanguage]: values.{{ m.key }} };
        delete values.{{ m.key }};
      }
{% endfor %}
{% if history_members(name, element) | selectattr("field") | selectattr("field.sequence") | list %}
      // The patch has no fields with a sequence: the database gives their numbers.
{% endif %}
      const patch = {{ var }}PatchSchema.parse(values);
      return {{ var }}Repository.update(record.id, patch, {{ "scope, " if "update" in owned else ("null, " if record_rules else "") }}"restored");
    },
    {{ opt("update", true)[2:] }},
  );
}
{% endif %}
{% if share %}
{% set get_record = var ~ "Repository.get(idSchema.parse(id)" ~ (", " ~ scope("update") if "update" in owned else "") ~ ")" %}
{% set share_opts = opt("update", false)[2:] or "{}" %}

{{ trace(share.page_id) }}
/** Return the state of the secret link of a record (ADR 0049). The links need the access of the update. */
export async function get{{ type }}ShareLinkAction(id: string): Promise<ActionResult<ShareLinkState>> {
  return runAction(
    async () => {
      const record = await {{ get_record }};
      return shareLinkState({{ ts_value(name) }}, record.id);
    },
    {{ share_opts }},
  );
}

{{ trace(share.page_id) }}
/** Make a new secret link of a record, and return its token: the old link stops (ADR 0049). */
export async function create{{ type }}ShareLinkAction(id: string): Promise<ActionResult<ShareLinkCreated>> {
  return runAction(
    async () => {
      const record = await {{ get_record }};
      return makeShareLink({{ ts_value(name) }}, record.id, await sessionUserId());
    },
    {{ share_opts }},
  );
}

{{ trace(share.page_id) }}
/** Revoke the secret link of a record (ADR 0049): the link opens nothing after it. */
export async function revoke{{ type }}ShareLinkAction(id: string): Promise<ActionResult<null>> {
  return runAction(
    async () => {
      const record = await {{ get_record }};
      await revokeShareLink({{ ts_value(name) }}, record.id);
      return null;
    },
    {{ share_opts }},
  );
}
{% endif %}
{% if member %}

{{ trace(memberships.element_id) }}
/**
 * Return the operations that the memberships of the signed-in user give on
 * the records of {{ type }} (ADR 0048): on some records, and on each record of the IDs.
 */
export async function get{{ type }}PermissionsAction(ids: string[]): Promise<ActionResult<MemberPermissions>> {
  return runAction(async () => {
    const wanted = ids.slice(0, 1000).map((id) => idSchema.parse(id));
    return memberPermissions({{ ts_value(name) }}, wanted, (found, scopes) => {{ var }}Repository.inScopesOf(found, scopes));
  }, {});
}
{% endif %}
