import { randomBytes, scryptSync, timingSafeEqual } from "node:crypto";

// The password hashes of the users. The seed script uses this module too,
// so it does not import "server-only".

/** Return the scrypt hash of a password, with a random salt. */
export function hashPassword(password: string): string {
  const salt = randomBytes(16);
  return `scrypt$${salt.toString("hex")}$${scryptSync(password, salt, 64).toString("hex")}`;
}

/** Return true if a password has the stored hash. */
export function verifyPassword(password: string, stored: string): boolean {
  const [, salt = "", digest = ""] = stored.split("$");
  const found = scryptSync(password, Buffer.from(salt, "hex"), 64);
  const expected = Buffer.from(digest, "hex");
  return found.length === expected.length && timingSafeEqual(found, expected);
}
