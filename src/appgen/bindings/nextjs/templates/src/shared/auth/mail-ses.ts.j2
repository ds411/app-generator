import "server-only";

import { SendEmailCommand, SESv2Client } from "@aws-sdk/client-sesv2";

{% if message_elements %}
import type { Message } from "./messages";

{% endif %}
// The delivery of {% if message_elements %}the messages of the sign-in{% endif %}{% if message_elements and emails %} and of {% endif %}{% if emails %}the emails of the notices (ADR 0044){% endif %} with
// Amazon SES (`auth.delivery: ses`, ADR 0017). The app sends each email
// with `SendEmail` of the API v2 of SES, from `SES_FROM` to the address of
// the user. The AWS SDK reads the region from `AWS_REGION`, and the
// credentials from its default chain: the environment variables, the web
// identity or EKS Pod Identity, the role of an ECS task, or the instance
// profile. `AWS_ENDPOINT_URL_SESV2` changes the endpoint, for example for a
// test server. Without `SES_FROM`, the development app writes a note to the
// log, and the production app gives an error.

/** The time in milliseconds that the app waits for the connection to SES, and for each answer. */
const TIMEOUT_MS = 10_000;

let client: SESv2Client | null = null;

/** Return the client of the API v2 of SES: one for the process. */
function sesClient(): SESv2Client {
  client ??= new SESv2Client({
    maxAttempts: 3,
    requestHandler: { connectionTimeout: TIMEOUT_MS, requestTimeout: TIMEOUT_MS },
  });
  return client;
}

/** An email to a user: the address, the subject, and the text. */
export type Email = { to: string; subject: string; text: string };

/**
 * Send an email with Amazon SES. `what` names the emails in the errors.
 * Return false without `SES_FROM` in the development app: the caller
 * writes a note to the log. Without `SES_FROM`, the production app gives
 * an error.
 */
export async function sendEmail(email: Email, what: string): Promise<boolean> {
  const from = process.env.SES_FROM;
  if (!from) {
    if (process.env.ENVIRONMENT === "development") {
      return false;
    }
    throw new Error(`Set SES_FROM to send ${what}.`);
  }
  const configurationSet = process.env.SES_CONFIGURATION_SET;
  const command = new SendEmailCommand({
    FromEmailAddress: from,
    Destination: { ToAddresses: [email.to] },
    Content: {
      Simple: {
        Subject: { Data: email.subject, Charset: "UTF-8" },
        Body: { Text: { Data: email.text, Charset: "UTF-8" } },
      },
    },
    ...(configurationSet ? { ConfigurationSetName: configurationSet } : {}),
  });
  try {
    await sesClient().send(command);
  } catch (error) {
    // For example MessageRejected, or an address that the sandbox of SES does not allow. The
    // log has the code of the error, but not the email with its link.
    const code = error instanceof Error ? error.name : "unknown";
    console.error(`Amazon SES did not send one of ${what}: ${code}`);
    throw new Error(`Amazon SES did not send the email: ${code}.`);
  }
  return true;
}
{% if message_elements %}

/** Send a message of the sign-in to a user with Amazon SES. */
export async function deliverMessage(message: Message): Promise<void> {
  if (!(await sendEmail(message, "the messages of the sign-in"))) {
    console.warn(`The ${message.kind} link of ${message.to}: ${message.link}`);
  }
}
{% endif %}
