import "server-only";

import { AsyncLocalStorage } from "node:async_hooks";
import { createCipheriv, createDecipheriv, createHash, createHmac, randomBytes, timingSafeEqual } from "node:crypto";

import { and, eq } from "drizzle-orm";
import { z } from "zod";

import type { TokenSource } from "@/shared/api/third-party";
import { apiConnectionsTable, getDb, ownDb } from "@/shared/db";

import { authSecret, publicUrl, sessionUserId, sign } from "./session";

// The connections of the users to the APIs with the authorization code flow
// of OAuth 2.0 (ADR 0033). The route `/connections/<api>/start` sends the
// browser of the signed-in user to the authorization URL of the API, where
// the user allows the access. The authorization server sends the browser
// back to `/connections/<api>/callback` with a code. The app changes the
// code for the tokens of the user (with PKCE), and keeps them in the table
// `api_connections`, encrypted with a key from AUTH_SECRET. A signed cookie
// holds the state, the PKCE verifier, and the user of the flow between the
// two requests.
//
// A client of the API reads the access token of the user (`UserToken`), and
// gets a new access token with the refresh token a little before the token
// ends, or after an answer with the status 401.

/** The time that a user has to allow the access at the authorization server. */
export const FLOW_SECONDS = 600;
/** A client gets a new access token this time before the token ends. */
const EARLY_SECONDS = 30;
/** The time that the app waits for an answer of a token endpoint. */
const TIMEOUT_MS = 10_000;
/** The page of the connections of the signed-in user. */
export const CONNECTIONS_PATH = "/connections";

/** The APIs with the authorization code flow, by their names in the paths. */
export const CONNECTION_NAMES = [{{ ts_connections | map(attribute="connection_name") | map("tojson") | join(", ") }}] as const;
export type ConnectionName = (typeof CONNECTION_NAMES)[number];

/** The client of the app at the authorization server of an API, with its settings. */
type OAuthApp = {
  /** The name of the API in the definition. */
  api: string;
  title: string;
  baseUrl: string;
  authorizationUrl: string;
  tokenUrl: string;
  refreshUrl: string;
  clientId: string;
  clientSecret: string;
  scopes: readonly string[];
};

/** Return the client of the app at the authorization server of an API, with the values of the environment. */
function oauthApp(name: ConnectionName): OAuthApp {
  const apps: Record<ConnectionName, OAuthApp> = {
{% for api in ts_connections %}
    {{ trace(api.id) }}
    {{ api.connection_name | tojson }}: {
      api: {{ api.name | tojson }},
      title: {{ tr(js(api.title)) }},
      baseUrl: process.env.{{ api.url_env }} || {{ api.base_url | tojson }},
      authorizationUrl: {{ api.authorization_url | tojson }},
      tokenUrl: {{ api.token_url | tojson }},
      refreshUrl: {{ api.refresh_url | tojson }},
      clientId: process.env.{{ api.client_id_env }} ?? "",
      clientSecret: process.env.{{ api.secret_env }} ?? "",
      scopes: {{ api.scopes | list | tojson }},
    },
{% endfor %}
  };
  return apps[name];
}

/** Return the name in the paths of an API of the definition. */
function nameOf(api: string): ConnectionName {
  const names: Record<string, ConnectionName> = {
{% for api in ts_connections %}
    {{ api.name | tojson }}: {{ api.connection_name | tojson }},
{% endfor %}
  };
  const name = names[api];
  if (name === undefined) throw new Error(`The API ${api} has no authorization code flow.`);
  return name;
}

/** Return true if a name is the name of an API with the authorization code flow in the paths. */
export function isConnectionName(name: string): name is ConnectionName {
  return (CONNECTION_NAMES as readonly string[]).includes(name);
}

/** Return a URL of the flow of an API. A path is under the base URL of the API. */
function urlOf(app: OAuthApp, value: string): string {
  return value.startsWith("/") ? app.baseUrl.replace(/\/+$/, "") + value : value;
}

/** The user has no connection to an API: the user connects an account first. */
export class NotConnectedError extends Error {
  constructor(readonly api: string) {
    super({{ js_format("Connect an account of the API {api} first.", api="api") }});
    this.name = "NotConnectedError";
  }
}

/** A connection that failed. The page of the connections shows the message. */
export class ConnectionError extends Error {
  constructor(message: string) {
    super(message);
    this.name = "ConnectionError";
  }
}

/** The token endpoint did not accept the code or the refresh token (400 or 401). */
class GrantError extends Error {}

/** Throw a ConnectionError if the server has no client ID or client secret for an API. */
function checkApp(app: OAuthApp): void {
  if (!app.clientId || !app.clientSecret) {
    throw new ConnectionError({{ js_format("The server has no client ID or client secret for the API {api}.", api="app.api") }});
  }
}

/** The key of the tokens: an HMAC of AUTH_SECRET, as in the FastAPI app. */
function encryptionKey(): Buffer {
  return createHmac("sha256", authSecret()).update("api-connections").digest();
}

/**
 * Return a token encrypted with AES-256-GCM. The context (the API, the
 * user, and the column) is part of the check: a value is valid only in
 * its own row and column.
 */
function seal(key: Buffer, value: string, context: string): string {
  const nonce = randomBytes(12);
  const cipher = createCipheriv("aes-256-gcm", key, nonce);
  cipher.setAAD(Buffer.from(context));
  const box = Buffer.concat([cipher.update(value, "utf8"), cipher.final(), cipher.getAuthTag()]);
  return Buffer.concat([nonce, box]).toString("base64url");
}

/** Return the token of a sealed value, or null if the value or the key is not correct. */
function unseal(key: Buffer, sealed: string, context: string): string | null {
  try {
    const data = Buffer.from(sealed, "base64url");
    const decipher = createDecipheriv("aes-256-gcm", key, data.subarray(0, 12));
    decipher.setAAD(Buffer.from(context));
    decipher.setAuthTag(data.subarray(data.length - 16));
    return Buffer.concat([decipher.update(data.subarray(12, data.length - 16)), decipher.final()]).toString("utf8");
  } catch {
    return null;
  }
}

type Connection = typeof apiConnectionsTable.$inferSelect;

function contextOf(api: string, userId: string, column: "access_token" | "refresh_token"): string {
  return `${api}.${userId}.${column}`;
}

/** The answer of a token endpoint (RFC 6749, section 5.1). */
const tokenAnswerSchema = z.object({
  access_token: z.string(),
  refresh_token: z.string().nullish(),
  expires_in: z.number().nullish(),
  scope: z.string().nullish(),
});
type TokenAnswer = z.infer<typeof tokenAnswerSchema>;

/** Return the columns of the tokens of an answer of a token endpoint. */
function tokenValues(key: Buffer, api: string, userId: string, answer: TokenAnswer) {
  return {
    accessToken: seal(key, answer.access_token, contextOf(api, userId, "access_token")),
    // Without a new refresh token, the old one stays valid (RFC 6749, section 6).
    ...(answer.refresh_token ? { refreshToken: seal(key, answer.refresh_token, contextOf(api, userId, "refresh_token")) } : {}),
    expiresAt: typeof answer.expires_in === "number" ? Math.floor(Date.now() / 1000) + answer.expires_in : null,
    ...(answer.scope ? { scope: answer.scope } : {}),
  };
}

/**
 * Send a grant to the token endpoint of an API, and return the tokens. The
 * app authenticates with HTTP Basic. Throw a GrantError if the endpoint
 * does not accept the grant (400 or 401), and a ConnectionError for
 * another error.
 */
async function requestTokens(app: OAuthApp, url: string, form: Record<string, string>): Promise<TokenAnswer> {
  checkApp(app);
  // RFC 6749: the client ID and the secret of the basic scheme are URL encoded.
  const basic = Buffer.from(`${encodeURIComponent(app.clientId)}:${encodeURIComponent(app.clientSecret)}`).toString("base64");
  const failed = {{ js_format("The token endpoint of the API {api} did not answer correctly.", api="app.api") }};
  let response: Response;
  try {
    response = await fetch(urlOf(app, url), {
      method: "POST",
      headers: { Accept: "application/json", Authorization: `Basic ${basic}` },
      body: new URLSearchParams(form),
      cache: "no-store",
      signal: AbortSignal.timeout(TIMEOUT_MS),
    });
  } catch {
    throw new ConnectionError(failed);
  }
  if (response.status === 400 || response.status === 401) {
    throw new GrantError(await response.text());
  }
  const answer = tokenAnswerSchema.safeParse(await response.json().catch(() => null));
  if (!response.ok || !answer.success) {
    throw new ConnectionError(failed);
  }
  return answer.data;
}

/** Return the connection of a user to an API, or null. */
async function findConnection(api: string, userId: string): Promise<Connection | null> {
  const [row] = await ownDb()
    .select()
    .from(apiConnectionsTable)
    .where(and(eq(apiConnectionsTable.api, api), eq(apiConnectionsTable.userId, userId)))
    .limit(1);
  return row ?? null;
}

/** Return true if a user has a connection to an API (the name in the definition). */
export async function connected(api: string, userId: string | null): Promise<boolean> {
  return userId !== null && (await findConnection(api, userId)) !== null;
}

/** The user of the work of `asUser()`. */
const actingUser = new AsyncLocalStorage<string>();

/**
 * Run work in the name of a user, for example a run of a job: the clients
 * of the APIs with the authorization code flow send the token of the user.
 */
export function asUser<T>(userId: string, work: () => Promise<T>): Promise<T> {
  return actingUser.run(userId, work);
}

/** The new tokens of each user and API that the server gets now: two requests wait for the same tokens. */
const refreshes = new Map<string, Promise<string>>();

/**
 * The access tokens of a user for an API: the token source of a client.
 *
 * The source reads the tokens of the user in the table `api_connections`.
 * When the access token ends, or the API does not accept it, the source
 * gets a new access token with the refresh token. Two requests at the same
 * time for a user wait for the same new token. If the token endpoint does
 * not accept the refresh token, the source deletes the connection, and the
 * user connects the account again.
 */
export class UserToken implements TokenSource {
  private rejected: string | null = null;

  /** `userId` null: the user of `asUser()`, else the signed-in user. */
  constructor(
    readonly api: string,
    readonly userId: string | null,
  ) {}

  /** Return the access token of the user. Throw a NotConnectedError without a connection. */
  async get(): Promise<string> {
    const userId = this.userId ?? actingUser.getStore() ?? (await sessionUserId());
    if (userId === null) throw new NotConnectedError(this.api);
    const key = encryptionKey();
    const token = this.usable(key, await findConnection(this.api, userId));
    if (token !== null) return token;
    const id = `${this.api}.${userId}`;
    let refresh = refreshes.get(id);
    if (refresh === undefined) {
      refresh = this.refresh(key, userId).finally(() => refreshes.delete(id));
      refreshes.set(id, refresh);
    }
    const fresh = await refresh;
    this.rejected = null;
    return fresh;
  }

  /** Forget a token that the API did not accept, so that `get` gets a new token. */
  reset(token: string): void {
    this.rejected = token;
  }

  /** Return the access token of a connection, or null if it ended or was rejected. */
  private usable(key: Buffer, connection: Connection | null): string | null {
    if (connection === null) throw new NotConnectedError(this.api);
    const token = unseal(key, connection.accessToken, contextOf(connection.api, connection.userId, "access_token"));
    const ends = connection.expiresAt;
    if (token === this.rejected || (ends !== null && Date.now() / 1000 >= ends - EARLY_SECONDS)) return null;
    return token;
  }

  private async refresh(key: Buffer, userId: string): Promise<string> {
    const result = await ownDb().transaction(async (tx) => {
      const where = and(eq(apiConnectionsTable.api, this.api), eq(apiConnectionsTable.userId, userId));
      const [connection] = await tx.select().from(apiConnectionsTable).where(where).for("update");
      if (connection === undefined) return null;
      const token = this.usable(key, connection);
      // Another server got a new token first.
      if (token !== null) return token;
      const answer = await this.grant(key, connection);
      if (answer === null) {
        // The user connects the account again.
        await tx.delete(apiConnectionsTable).where(eq(apiConnectionsTable.id, connection.id));
        return null;
      }
      await tx.update(apiConnectionsTable).set(tokenValues(key, this.api, userId, answer)).where(eq(apiConnectionsTable.id, connection.id));
      return answer.access_token;
    });
    if (result === null) throw new NotConnectedError(this.api);
    return result;
  }

  /** Return new tokens for the refresh token, or null if the endpoint does not accept it. */
  private async grant(key: Buffer, connection: Connection): Promise<TokenAnswer | null> {
    const sealed = connection.refreshToken;
    const refresh = sealed ? unseal(key, sealed, contextOf(connection.api, connection.userId, "refresh_token")) : null;
    if (refresh === null) return null;
    const app = oauthApp(nameOf(this.api));
    try {
      return await requestTokens(app, app.refreshUrl, { grant_type: "refresh_token", refresh_token: refresh });
    } catch (error) {
      if (error instanceof GrantError) return null;
      throw error;
    }
  }
}

/** An API with the authorization code flow, and the connection of the signed-in user. */
export type ConnectionState = {
  /** The name of the API in the paths of the connections. */
  api: ConnectionName;
  title: string;
  connected: boolean;
  /** The time of the connection, as an ISO 8601 text, or null. */
  connectedAt: string | null;
};

/** List the APIs with the authorization code flow, with the connections of a user. */
export async function listConnections(userId: string): Promise<ConnectionState[]> {
  const rows = await getDb().select().from(apiConnectionsTable).where(eq(apiConnectionsTable.userId, userId));
  return CONNECTION_NAMES.map((name) => {
    const app = oauthApp(name);
    const row = rows.find((item) => item.api === app.api);
    return { api: name, title: app.title, connected: row !== undefined, connectedAt: row ? row.connectedAt.toISOString() : null };
  });
}

/** Delete the connection of a user to an API, and its tokens. */
export async function deleteConnection(name: ConnectionName, userId: string): Promise<void> {
  const { api } = oauthApp(name);
  await getDb()
    .delete(apiConnectionsTable)
    .where(and(eq(apiConnectionsTable.api, api), eq(apiConnectionsTable.userId, userId)));
}

/** The name of the cookie of the flow of an API. */
export function connectionFlowCookie(name: ConnectionName): string {
  return `connection_flow_${name}`;
}

/** The path of the cookie of the flow: only the routes of the API get it. */
export function connectionFlowPath(name: ConnectionName): string {
  return `${CONNECTIONS_PATH}/${name}`;
}

/** Return the page of the connections with the API of a new connection, or with the message of an error. */
export function connectionsPage(result: { connected: ConnectionName } | { error: unknown }): string {
  if ("connected" in result) {
    return `${CONNECTIONS_PATH}#${new URLSearchParams({ connected: result.connected })}`;
  }
  const message = result.error instanceof ConnectionError ? result.error.message : {{ tr(js("The connection failed.")) }};
  return `${CONNECTIONS_PATH}#${new URLSearchParams({ error: message })}`;
}

/** The values of a flow: the checks of the callback. */
const flowSchema = z.object({
  state: z.string(),
  verifier: z.string(),
  user: z.string(),
  exp: z.number(),
});
export type ConnectionFlow = z.infer<typeof flowSchema>;

function flowSignature(name: ConnectionName, body: string): string {
  return sign(`connection-flow.${name}.${body}`);
}

/** Return the flow of a valid signed text that has not ended, else null. */
export function readConnectionFlow(name: ConnectionName, text: string): ConnectionFlow | null {
  const [body = "", signature = ""] = text.split(".");
  const expected = flowSignature(name, body);
  if (signature.length !== expected.length || !timingSafeEqual(Buffer.from(signature), Buffer.from(expected))) {
    return null;
  }
  try {
    const flow = flowSchema.safeParse(JSON.parse(Buffer.from(body, "base64url").toString()));
    return flow.success && flow.data.exp * 1000 > Date.now() ? flow.data : null;
  } catch {
    return null;
  }
}

/** Return the URL that the authorization server sends the browser back to. */
function callbackUrl(name: ConnectionName): string {
  return `${publicUrl()}${connectionFlowPath(name)}/callback`;
}

/**
 * Start a connection of a user to an API: return the URL of the page where
 * the user allows the access, and the signed flow for the cookie.
 */
export function startConnection(name: ConnectionName, userId: string): { url: string; flow: string } {
  const app = oauthApp(name);
  checkApp(app);
  const [state, verifier] = [randomBytes(32).toString("base64url"), randomBytes(32).toString("base64url")];
  const url = new URL(urlOf(app, app.authorizationUrl));
  const query: Record<string, string> = {
    response_type: "code",
    client_id: app.clientId,
    redirect_uri: callbackUrl(name),
    state,
    code_challenge: createHash("sha256").update(verifier).digest("base64url"),
    code_challenge_method: "S256",
  };
  if (app.scopes.length) query.scope = app.scopes.join(" ");
  for (const [key, value] of Object.entries(query)) {
    url.searchParams.set(key, value);
  }
  const flow: ConnectionFlow = { state, verifier, user: userId, exp: Math.floor(Date.now() / 1000) + FLOW_SECONDS };
  const body = Buffer.from(JSON.stringify(flow)).toString("base64url");
  return { url: url.toString(), flow: `${body}.${flowSignature(name, body)}` };
}

/**
 * Finish a connection: check the answer of the authorization server in the
 * query of the callback, change the code for the tokens of the user, and
 * keep them. The user of the flow must be the signed-in user.
 */
export async function finishConnection(name: ConnectionName, flow: ConnectionFlow, query: URLSearchParams, userId: string | null): Promise<void> {
  const error = query.get("error");
  if (error !== null) {
    throw new ConnectionError({{ js_format("The authorization server gave the error '{error}'.", error="error.slice(0, 200)") }});
  }
  const state = Buffer.from(query.get("state") ?? "");
  if (userId !== flow.user || state.length !== Buffer.byteLength(flow.state) || !timingSafeEqual(state, Buffer.from(flow.state))) {
    throw new ConnectionError({{ tr(js("The state of the callback is not correct. Connect the account again.")) }});
  }
  const code = query.get("code");
  if (code === null) {
    throw new ConnectionError({{ tr(js("The callback has no code. Connect the account again.")) }});
  }
  const app = oauthApp(name);
  let answer: TokenAnswer;
  try {
    answer = await requestTokens(app, app.tokenUrl, {
      grant_type: "authorization_code",
      code,
      redirect_uri: callbackUrl(name),
      code_verifier: flow.verifier,
    });
  } catch (failure) {
    if (failure instanceof GrantError) {
      throw new ConnectionError({{ tr(js("The authorization server did not accept the code. Connect the account again.")) }});
    }
    throw failure;
  }
  const key = encryptionKey();
  const scope = app.scopes.join(" ");
  // A new connection does not keep the refresh token of the old one.
  const values = { refreshToken: null, scope, ...tokenValues(key, app.api, flow.user, answer), connectedAt: new Date() };
  await getDb()
    .insert(apiConnectionsTable)
    .values({ userId: flow.user, api: app.api, ...values })
    .onConflictDoUpdate({ target: [apiConnectionsTable.userId, apiConnectionsTable.api], set: values });
}
