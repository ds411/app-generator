{% set verify = definition.auth.sign_up.verify_email if definition.auth.sign_up else none %}
{% set sf = definition.auth.second_factor %}
{# The sign-in returns a status: only the password reset and the verification return an ActionResult. #}
{% set results = definition.auth.password_reset or verify %}
{% set signs_out = definition.auth.providers.values() | selectattr("sign_out") | list %}
{{ trace_header(definition.auth.id) }}
"use server";

import { cookies } from "next/headers";
{% if definition.auth.password %}
import { z } from "zod";
{% if results or i18n %}

{% endif %}
{% if results %}
import type { ActionResult } from "@/shared/api";
{% endif %}
{% if i18n %}
import { inRequestLanguage } from "@/shared/lib/i18n-server";
{% endif %}
{% endif %}

{% if verify %}
import { confirmVerification, findUnverifiedUser, readVerificationToken, sendVerification } from "./email-verification";
{% endif %}
{% if sf %}
import { findCredential, makeChallenge, secondFactorStep } from "./second-factor";
{% endif %}
{% if definition.auth.password_reset %}
import { passwordResetMessage } from "./messages";
import { deliverMessage } from "{{ "./mail" if nextjs.smtp else "./messages.ext" }}";
import {
  MIN_PASSWORD_LENGTH,
  RESET_SECONDS,
  findResetUser,
  makeResetToken,
  readResetToken,
  resetTokenMatches,
} from "./password-reset";
{% endif %}
{% if signs_out %}
import { providerSignOutUrl } from "./providers";
{% endif %}
{% if definition.auth.password_reset %}
import { SESSION_COOKIE, checkPassword, publicUrl, {{ "sessionProvider, " if signs_out }}setPassword, startSession } from "./session";
{% elif definition.auth.password %}
import { SESSION_COOKIE, checkPassword, {{ "sessionProvider, " if signs_out }}startSession } from "./session";
{% else %}
import { SESSION_COOKIE{{ ", sessionProvider" if signs_out }} } from "./session";
{% endif %}
{% if definition.auth.password %}

const signInSchema = z.object({ username: z.string().min(1).max(320), password: z.string().min(1).max(200) });

/**
 * Sign in with a user name and a password, and set the session cookie.
 * A wrong password gives the status `error`.{% if verify %} The correct password of a
 * user who did not confirm the email address gives the status `unverified`
 * (ADR 0023), so the answer tells the state of the account only to a caller
 * who knows the password.{% endif %}{% if sf %} The correct password of a user with
 * a second factor gives the status `second-factor` with a challenge
 * (ADR 0024): `signInWithCodeAction` then signs in.{% endif %}

 */
export async function signInAction(
  username: string,
  password: string,
): Promise<
  | { status: "signed-in" }
  | { status: "error" | "unverified"; message: string }{{ "\n  | { status: \"second-factor\"; challenge: string; setup: boolean }" if sf }}
> {
  const input = signInSchema.safeParse({ username, password });
{% if verify %}
  const user = input.success ? await checkPassword(input.data.username, input.data.password) : null;
  if (user === null) {
{% else %}
  const userId = input.success ? await checkPassword(input.data.username, input.data.password) : null;
  if (userId === null) {
{% endif %}
{% if i18n %}
    const message = await inRequestLanguage(() => {{ tr(js("The user name or the password is not correct.")) }});
    return { status: "error", message };
{% else %}
    return { status: "error", message: "The user name or the password is not correct." };
{% endif %}
  }
{% if verify %}
  if (!user.verified) {
    {{ trace(verify.id) }}
    const message = {{ "await inRequestLanguage(() => " if i18n }}{{ tr(js("Confirm the email address first: open the link in the message.")) }}{{ ")" if i18n }};
    return { status: "unverified", message };
  }
{% endif %}
{% if sf %}
  {{ trace(sf.id) }}
  const credential = await findCredential({{ "user.id" if verify else "userId" }});
  const step = credential === null ? null : await secondFactorStep(credential);
  if (step !== null) {
    return { status: "second-factor", challenge: makeChallenge({{ "user.id" if verify else "userId" }}), setup: step === "setup" };
  }
{% endif %}
{% if verify %}
  await startSession(user.id);
{% else %}
  await startSession(userId);
{% endif %}
  return { status: "signed-in" };
}
{% endif %}

{% if signs_out %}
/**
 * Sign out: delete the session cookie. After a sign-in with a provider
 * with `sign_out`, return the logout URL of the provider, which ends the
 * session there too. Else return null.
 */
export async function signOutAction(): Promise<string | null> {
  const provider = await sessionProvider();
  (await cookies()).delete(SESSION_COOKIE);
  if (provider === null) return null;
  try {
    return await providerSignOutUrl(provider);
  } catch (error) {
    // The session of the app has ended. The provider did not answer.
    console.error(error);
    return null;
  }
}
{% else %}
/** Sign out: delete the session cookie. */
export async function signOutAction(): Promise<void> {
  (await cookies()).delete(SESSION_COOKIE);
}
{% endif %}
{% if definition.auth.password_reset %}

const resetRequestSchema = z.object({ username: z.string().min(1).max(320) });
const resetSchema = z.object({ token: z.string().min(1).max(1000), newPassword: z.string().min(MIN_PASSWORD_LENGTH).max(200) });

/** Send a reset link to a user (ADR 0017). The answer is the same for an unknown user name. */
export async function requestPasswordResetAction(username: string): Promise<ActionResult<null>> { {{ trace(definition.auth.password_reset.id) }}
  const input = resetRequestSchema.safeParse({ username });
  if (!input.success) {
    return { ok: false, error: { name: "Error", message: "Enter a user name." } };
  }
  const user = await findResetUser(input.data.username);
  if (user !== null) {
    try {
      const token = makeResetToken(user.id, user.passwordHash, Math.floor(Date.now() / 1000) + RESET_SECONDS);
      const link = `${publicUrl()}/reset-password?token=${encodeURIComponent(token)}`;
      await deliverMessage(await passwordResetMessage({ id: user.id, to: user.to }, link));
    } catch (error) {
      console.error(error);
      return { ok: false, error: { name: "Error", message: "The app could not send the reset link." } };
    }
  }
  return { ok: true, data: null };
}

/** Set a new password with the token of a reset link. A used or an ended token gives an error. */
export async function confirmPasswordResetAction(token: string, newPassword: string): Promise<ActionResult<null>> { {{ trace(definition.auth.password_reset.id) }}
  const input = resetSchema.safeParse({ token, newPassword });
  if (!input.success) {
    return { ok: false, error: { name: "Error", message: `Use ${MIN_PASSWORD_LENGTH} or more characters.` } };
  }
  const found = readResetToken(input.data.token);
  if (found === null || !(await resetTokenMatches(found))) {
    return { ok: false, error: { name: "Error", message: "The reset link is not valid, was used, or has ended." } };
  }
  await setPassword(found.userId, input.data.newPassword);
  return { ok: true, data: null };
}
{% endif %}
{% if verify %}

const verificationRequestSchema = z.object({ username: z.string().min(1).max(320) });
const verificationSchema = z.object({ token: z.string().min(1).max(1000) });

/** Send a new link that confirms the email address (ADR 0023). The answer is the same for each user name. */
export async function requestEmailVerificationAction(username: string): Promise<ActionResult<null>> { {{ trace(verify.id) }}
  const input = verificationRequestSchema.safeParse({ username });
  if (!input.success) {
    return { ok: false, error: { name: "Error", message: {{ "await inRequestLanguage(() => " if i18n }}{{ tr(js("Enter a value.")) }}{{ ")" if i18n }} } };
  }
  const user = await findUnverifiedUser(input.data.username);
  if (user !== null) {
    try {
      await sendVerification(user);
    } catch (error) {
      console.error(error);
      return { ok: false, error: { name: "Error", message: {{ "await inRequestLanguage(() => " if i18n }}{{ tr(js("The request failed.")) }}{{ ")" if i18n }} } };
    }
  }
  return { ok: true, data: null };
}

/** Confirm the email address of a user with the token of a link. A second confirmation changes nothing. */
export async function confirmEmailVerificationAction(token: string): Promise<ActionResult<null>> { {{ trace(verify.id) }}
  const input = verificationSchema.safeParse({ token });
  const found = input.success ? readVerificationToken(input.data.token) : null;
  if (found === null || !(await confirmVerification(found))) {
    return { ok: false, error: { name: "Error", message: {{ "await inRequestLanguage(() => " if i18n }}{{ tr(js("The link is not valid, or has ended.")) }}{{ ")" if i18n }} } };
  }
  return { ok: true, data: null };
}
{% endif %}
