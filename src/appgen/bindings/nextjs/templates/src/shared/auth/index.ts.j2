{% set verify = definition.auth.sign_up.verify_email if definition.auth.sign_up else none %}
{% set actions = (["confirmEmailVerificationAction"] if verify else []) + (["confirmPasswordResetAction"] if definition.auth.password_reset else []) + (["requestEmailVerificationAction"] if verify else []) + (["requestPasswordResetAction"] if definition.auth.password_reset else []) + (["signInAction"] if definition.auth.password else []) + ["signOutAction"] %}
{% set sf = definition.auth.second_factor %}
{{ trace_header(definition.auth.id) }}
import { {{ actions | join(", ") }} } from "./actions";
{% set basic_users = ts_connections | selectattr("user_basic") | list %}
{% if basic_users %}
import { connectWithCredentialsAction, deleteConnectionAction, listConnectionsAction } from "./connection-actions";
{% elif ts_connections %}
import { deleteConnectionAction, listConnectionsAction } from "./connection-actions";
{% endif %}
{% if sf %}
import {
  confirmSecondFactorAction,
  disableSecondFactorAction,
  readSecondFactorAction,
  setUpSecondFactorAction,
  signInWithCodeAction,
} from "./second-factor-actions";
{% endif %}
{% if definition.auth.password %}

/**
 * The result of a sign-in: the user is signed in, or an error with its
 * message.{% if verify %} `unverified`: the password is correct, but the user must
 * confirm the email address first (ADR 0023).{% endif %}{% if sf %} `second-factor`: the password is
 * correct, and the user signs in with a code and the challenge (ADR 0024).
 * With `setup`, the user must turn on the second factor first.{% endif %}

 */
export type SignInResult =
  | { status: "signed-in" }
  | { status: "error" | "unverified"; message: string }{{ "\n  | { status: \"second-factor\"; challenge: string; setup: boolean }" if sf }};

/** Sign in with a user name and a password. */
export async function signIn(username: string, password: string): Promise<SignInResult> {
  return signInAction(username, password);
}
{% endif %}
{% if definition.auth.providers %}

/**
 * Sign in with a provider (ADR 0020): the browser goes to the provider,
 * and then opens the page `next`. Return null, or the message of the error.
 */
export async function signInWithProvider(name: string, next: string): Promise<string | null> {
  // The start is a route handler, not a page: the browser loads it from the server.
  const start = new URL(`/auth/providers/${encodeURIComponent(name)}/start`, window.location.origin);
  start.searchParams.set("next", next);
  window.location.assign(start);
  return null;
}
{% endif %}

{% if definition.auth.providers.values() | selectattr("sign_out") | list %}
/** Sign out. Return the logout URL of the provider of the session, or null. */
export async function signOut(): Promise<string | null> {
  return signOutAction();
}
{% else %}
/** Sign out. */
export async function signOut(): Promise<void> {
  await signOutAction();
}
{% endif %}
{% if definition.auth.password_reset %}

/** Ask for a reset link: the app sends it to the user. Return null, or the message of the error. */
export async function requestPasswordReset(username: string): Promise<string | null> {
  const result = await requestPasswordResetAction(username);
  return result.ok ? null : result.error.message;
}

/** Set a new password with the token of a reset link. Return null, or the message of the error. */
export async function confirmPasswordReset(token: string, newPassword: string): Promise<string | null> {
  const result = await confirmPasswordResetAction(token, newPassword);
  return result.ok ? null : result.error.message;
}
{% endif %}
{% if verify %}

/** Ask for a new link that confirms the email address. Return null, or the message of the error. */
export async function requestEmailVerification(username: string): Promise<string | null> {
  const result = await requestEmailVerificationAction(username);
  return result.ok ? null : result.error.message;
}

/** Confirm the email address with the token of a link. Return null, or the message of the error. */
export async function confirmEmailVerification(token: string): Promise<string | null> {
  const result = await confirmEmailVerificationAction(token);
  return result.ok ? null : result.error.message;
}
{% endif %}
{% if sf %}

/** The state of the second factor of the signed-in user (ADR 0024). */
export type SecondFactorStatus = { enabled: boolean; required: boolean; recoveryCodesLeft: number };

/** A new secret of the second factor: as text, and as an `otpauth://` URI for a QR code. */
export type SecondFactorSecret = { secret: string; uri: string };

/** A value, or the message of the error. */
export type AuthResult<T> = { ok: true; value: T } | { ok: false; message: string };

/** Sign in with the challenge of a sign-in and a code, or a recovery code. Return null, or the message of the error. */
export async function signInWithCode(challenge: string, code: string): Promise<string | null> { {{ trace(sf.id) }}
  const result = await signInWithCodeAction(challenge, code);
  return result.ok ? null : result.message;
}

/** Return the state of the second factor of the signed-in user. */
export async function readSecondFactor(): Promise<SecondFactorStatus> { {{ trace(sf.id) }}
  const result = await readSecondFactorAction();
  if (!result.ok) throw new Error(result.message);
  return result.value;
}

/** Give a new secret for the authenticator app: for the signed-in user, or for the challenge of a sign-in. */
export async function setUpSecondFactor(challenge: string | null): Promise<AuthResult<SecondFactorSecret>> { {{ trace(sf.id) }}
  return setUpSecondFactorAction(challenge);
}

/** Turn on the second factor with a code, and return the recovery codes. With a challenge, the user is signed in. */
export async function confirmSecondFactor(code: string, challenge: string | null): Promise<AuthResult<string[]>> { {{ trace(sf.id) }}
  return confirmSecondFactorAction(code, challenge);
}

/** Turn off the second factor with a code, or a recovery code. Return null, or the message of the error. */
export async function disableSecondFactor(code: string): Promise<string | null> { {{ trace(sf.id) }}
  const result = await disableSecondFactorAction(code);
  return result.ok ? null : result.message;
}
{% endif %}
{% if ts_connections %}

{% if basic_users %}
/** An API that the users connect, and the connection of the signed-in user (ADR 0033). */
export type Connection = {
  /** The name of the API in the paths of the connections. */
  api: string;
  title: string;
  /** `oauth`: the authorization code flow. `basic`: the user name and the password of the user. */
  kind: "oauth" | "basic";
  connected: boolean;
  /** HTTP Basic: the user name of the connection, or null. */
  username: string | null;
  /** HTTP Basic: true if the API did not accept the credentials. The user gives new ones. */
  rejected: boolean;
  /** The time of the connection, as an ISO 8601 text, or null. */
  connectedAt: string | null;
};

/** List the APIs that the users connect, with the connections of the signed-in user. */
{% else %}
/** An API with the authorization code flow, and the connection of the signed-in user (ADR 0033). */
export type Connection = {
  /** The name of the API in the paths of the connections. */
  api: string;
  title: string;
  connected: boolean;
  /** The time of the connection, as an ISO 8601 text, or null. */
  connectedAt: string | null;
};

/** List the APIs with the authorization code flow, with the connections of the signed-in user. */
{% endif %}
export async function listConnections(): Promise<Connection[]> {
  const result = await listConnectionsAction();
  if (!result.ok) throw new Error(result.message);
  return result.value;
}
{% if ts_code_flows %}

/**
 * Connect an account of an API: the browser goes to the authorization
 * server, and then back to the page of the connections. Return null, or
 * the message of the error.
 */
export async function connectAccount(api: string): Promise<string | null> {
  // The start is a route handler, not a page: the browser loads it from the server.
  window.location.assign(new URL(`/connections/${encodeURIComponent(api)}/start`, window.location.origin));
  return null;
}
{% endif %}
{% if basic_users %}

/** Connect an account of an API with HTTP Basic: the server checks and keeps the credentials. Return null, or the message of the error. */
export async function connectWithCredentials(api: string, username: string, password: string): Promise<string | null> {
  const result = await connectWithCredentialsAction(api, username, password);
  return result.ok ? null : result.message;
}
{% endif %}

/** Delete the connection of the signed-in user to an API. Return null, or the message of the error. */
export async function disconnectAccount(api: string): Promise<string | null> {
  const result = await deleteConnectionAction(api);
  return result.ok ? null : result.message;
}
{% endif %}
