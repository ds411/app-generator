{% set table = nextjs.tables_by_entity[definition.auth.user_entity] %}
{% set fields = definition.entities[definition.auth.user_entity].fields %}
{% set username = table.columns | selectattr("element_id", "eq", fields[definition.auth.username_field].id) | first %}
{% set address = (table.columns | selectattr("element_id", "eq", fields[definition.address_field()].id) | first) if definition.address_field() else username %}
{% set reset = definition.auth.password_reset %}
{{ trace_header(reset.id) }}
import "server-only";

import { createHash, timingSafeEqual } from "node:crypto";

import { eq } from "drizzle-orm";

import { credentialsTable, getDb, {{ table.const }} } from "@/shared/db";

import { sign } from "./session";

// The password reset (ADR 0017). A reset token is a signed text with the
// user ID, the end time, and a tag of the current password hash. A new
// password changes the tag, so it makes the earlier tokens invalid. The
// signed message has a prefix, so that a session token is never valid
// as a reset token, and the reverse.

/** The time that a reset link stays valid: {{ reset.token_minutes }} minutes. */
export const RESET_SECONDS = {{ reset.token_minutes * 60 }};
/** The lowest number of characters of a new password. */
export const MIN_PASSWORD_LENGTH = {{ definition.auth.min_password_length }};

/** Return a short hash of a stored password hash. Each new password gives a new tag. */
export function passwordTag(passwordHash: string | null): string {
  return createHash("sha256")
    .update(passwordHash ?? "")
    .digest("hex")
    .slice(0, 32);
}

function resetSignature(body: string): string {
  return sign(`password-reset.${body}`);
}

/** Return a signed one-time token for a password reset, valid until the time `expires` (in seconds). */
export function makeResetToken(userId: string, passwordHash: string | null, expires: number): string {
  const payload = { sub: userId, exp: expires, pwd: passwordTag(passwordHash) };
  const body = Buffer.from(JSON.stringify(payload)).toString("base64url");
  return `${body}.${resetSignature(body)}`;
}

/** Return the user ID and the password tag of a valid reset token that has not ended, or null. */
export function readResetToken(token: string): { userId: string; tag: string } | null {
  const [body = "", signature = ""] = token.split(".");
  const expected = resetSignature(body);
  if (signature.length !== expected.length || !timingSafeEqual(Buffer.from(signature), Buffer.from(expected))) {
    return null;
  }
  try {
    const payload = JSON.parse(Buffer.from(body, "base64url").toString()) as { sub?: unknown; exp?: unknown; pwd?: unknown };
    if (typeof payload.sub !== "string" || typeof payload.exp !== "number" || typeof payload.pwd !== "string") return null;
    return payload.exp * 1000 > Date.now() ? { userId: payload.sub, tag: payload.pwd } : null;
  } catch {
    return null;
  }
}

/** Return the ID, the address, and the password hash of the user with a user name, or null for an unknown user name. */
export async function findResetUser(username: string): Promise<{ id: string; to: string; passwordHash: string | null } | null> {
  const rows = await getDb()
    .select({ id: {{ table.const }}.id, to: {{ table.const }}.{{ address.key }}, passwordHash: credentialsTable.passwordHash })
    .from({{ table.const }})
    .leftJoin(credentialsTable, eq(credentialsTable.userId, {{ table.const }}.id))
    .where(eq({{ table.const }}.{{ username.key }}, username))
    .limit(1);
  return rows[0] ?? null;
}

/** Return true if a reset token is valid for the current password of its user. */
export async function resetTokenMatches(found: { userId: string; tag: string }): Promise<boolean> {
  const rows = await getDb()
    .select({ passwordHash: credentialsTable.passwordHash })
    .from({{ table.const }})
    .leftJoin(credentialsTable, eq(credentialsTable.userId, {{ table.const }}.id))
    .where(eq({{ table.const }}.id, found.userId))
    .limit(1);
  const [row] = rows;
  if (!row) return false;
  const tag = passwordTag(row.passwordHash);
  return tag.length === found.tag.length && timingSafeEqual(Buffer.from(tag), Buffer.from(found.tag));
}
