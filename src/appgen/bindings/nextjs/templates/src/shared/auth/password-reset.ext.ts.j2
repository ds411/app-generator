import "server-only";

/** A user who asked for a password reset. */
export type ResetUser = { id: string; username: string };

/**
 * Send a reset link to a user, for example by email to `user.username`
 * (ADR 0017). appgen creates this file once and never changes it. The
 * definition does not know the mail service, so write the delivery here.
 *
 * The link is valid for a short time, and only one time. The stub writes
 * the link to the log with ENVIRONMENT=development. Else, it throws an
 * error, so that a production app does not hide a missing delivery.
 */
export async function deliverPasswordReset(user: ResetUser, link: string): Promise<void> {
  // TODO(appgen): send the reset link to the user, for example by email.
  // When it is done, change the kind of the trace in the header from gap to manual.
  if (process.env.ENVIRONMENT === "development") {
    console.warn(`The password reset link of ${user.username}: ${link}`);
    return;
  }
  throw new Error("Not implemented yet: {{ reset.id }}");
}
