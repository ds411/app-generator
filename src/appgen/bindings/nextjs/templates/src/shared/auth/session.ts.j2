{% if guests %}
/** Return the fields of a signed text with a valid signature that has not ended, else null. */
function readSigned(token: string): { sub?: unknown; guest?: unknown } | null {
  const [body = "", signature = ""] = token.split(".");
  const expected = sign(body);
  if (signature.length !== expected.length || !timingSafeEqual(Buffer.from(signature), Buffer.from(expected))) {
    return null;
  }
  try {
    const payload = JSON.parse(Buffer.from(body, "base64url").toString()) as { sub?: unknown; guest?: unknown; exp?: unknown };
    return typeof payload.exp === "number" && payload.exp * 1000 > Date.now() ? payload : null;
  } catch {
    return null;
  }
}

/** Return the user ID of a valid token that has not ended, else null. A guest token has no user ID. */
export function readToken(token: string): string | null {
  const sub = readSigned(token)?.sub;
  return typeof sub === "string" ? sub : null;
}
{% else %}
/** Return the user ID of a valid token that has not ended, else null. */
export function readToken(token: string): string | null {
  const [body = "", signature = ""] = token.split(".");
  const expected = sign(body);
  if (signature.length !== expected.length || !timingSafeEqual(Buffer.from(signature), Buffer.from(expected))) {
    return null;
  }
  try {
    const payload = JSON.parse(Buffer.from(body, "base64url").toString()) as { sub?: unknown; exp?: unknown };
    if (typeof payload.sub !== "string" || typeof payload.exp !== "number") return null;
    return payload.exp * 1000 > Date.now() ? payload.sub : null;
  } catch {
    return null;
  }
}
{% endif %}

/** Return the ID of the signed-in user, or null. */
export async function sessionUserId(): Promise<string | null> {
  const token = (await cookies()).get(SESSION_COOKIE)?.value;
  return token ? readToken(token) : null;
}
{% if guests %}

{{ trace(guests.element_id) }}
// A visitor without a sign-in is a guest (ADR 0050): the guest cookie has
// a signed text with a random guest ID and the end of its time. The guest
// calls the guest operations on its own records: the column `guest_id` of
// {{ guests.names | join(", ") }} holds the guest of a record. At the sign-in and at the
// sign-up, the records of the guest move to the user.

export const GUEST_COOKIE = "guest";
export const GUEST_SECONDS = {{ guests.days * 86400 }};

/** Return a signed guest token for a guest ID. A session token has a user ID, not a guest ID. */
function makeGuestToken(guestId: string): string {
  const exp = Math.floor(Date.now() / 1000) + GUEST_SECONDS;
  const body = Buffer.from(JSON.stringify({ guest: guestId, exp })).toString("base64url");
  return `${body}.${sign(body)}`;
}

/** Return the guest ID of the guest cookie, or null without a valid guest cookie. */
export async function guestId(): Promise<string | null> {
  const token = (await cookies()).get(GUEST_COOKIE)?.value;
  const guest = token ? readSigned(token)?.guest : undefined;
  return typeof guest === "string" ? guest : null;
}

/**
 * Return the guest ID of the visitor. Without a guest cookie, start a guest
 * session: a new guest cookie with a random guest ID. Only a server action
 * or a route handler may set a cookie.
 */
export async function startGuestSession(): Promise<string> {
  const known = await guestId();
  if (known !== null) {
    return known;
  }
  const guest = randomUUID();
  (await cookies()).set(GUEST_COOKIE, makeGuestToken(guest), {
    httpOnly: true,
    sameSite: "lax",
    secure: process.env.NODE_ENV === "production",
    path: "/",
    maxAge: GUEST_SECONDS,
  });
  return guest;
}

/**
 * Give the records of the guest of the guest cookie to a user, and delete
 * the guest cookie: the user becomes the owner of each record. The move
 * changes only the owner and the guest of the records.
 */
async function moveGuestRecords(userId: string): Promise<void> {
  const guest = await guestId();
  if (guest === null) {
    return;
  }
  await getDb().transaction(async (tx) => {
{% for item in guests.entities %}
{% set guest_table = nextjs.tables_by_entity[item.entity].const %}
    await tx.update({{ guest_table }}).set({ {{ item.owner_key }}: userId, guestId: null }).where(eq({{ guest_table }}.guestId, guest));
{% endfor %}
  });
  (await cookies()).delete(GUEST_COOKIE);
}
{% endif %}
{% if signs_out %}

/** Return the provider of the session of the signed-in user, or null: for example after a sign-in with a password. */
export async function sessionProvider(): Promise<string | null> {
  const token = (await cookies()).get(SESSION_COOKIE)?.value ?? "";
  if (readToken(token) === null) return null;
  const payload = JSON.parse(Buffer.from(token.split(".")[0] ?? "", "base64url").toString()) as { idp?: unknown };
  return typeof payload.idp === "string" ? payload.idp : null;
}
{% endif %}

{% if nextjs.me_totals %}
/**
 * Return the ID of the signed-in user of the request, or null: the totals
 * of `$me` read it. Out of a request, for example in a script, no user is
 * signed in.
 */
export async function requestUserId(): Promise<string | null> {
  try {
    return await sessionUserId();
  } catch (error) {
    // Next.js stops the render of a static page with an error: the page is dynamic.
    unstable_rethrow(error);
    return null;
  }
}

{% endif %}
/** Return the ID of the signed-in user. Throw an UnauthorizedError without a session. */
export async function requireUser(): Promise<string> {
  const userId = await sessionUserId();
  if (userId === null) {
    throw new UnauthorizedError();
  }
  return userId;
}

/**
 * Go to the sign-in page if no user is signed in. After the sign-in, the
 * app opens the page again: `path` with the values of its parameters.
 */
export async function requirePageUser(path: string, params: Record<string, string | string[] | undefined> = {}): Promise<void> {
  if ((await sessionUserId()) === null) {
    const next = path.replace(/\{(\w+)\}/g, (_, key: string) => encodeURIComponent(String(params[key] ?? "")));
    redirect(`${SIGN_IN_PATH}?next=${encodeURIComponent(next)}`);
  }
}
