/** Return the URL of the app for the browsers: PUBLIC_URL, or the local URL in development. */
export function publicUrl(): string {
  const url = process.env.PUBLIC_URL?.replace(/\/+$/, "");
  if (url) return url;
  if (process.env.ENVIRONMENT === "development") return `http://localhost:${process.env.PORT ?? "3000"}`;
  throw new Error("Set PUBLIC_URL to the URL of the app for the browsers.");
}
