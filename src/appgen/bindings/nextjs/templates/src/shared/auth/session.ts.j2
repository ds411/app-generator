// The sign-in of the users (ADR 0011). A session is a cookie with a
// signed text: the ID of the user and the end of its time. Set
// AUTH_SECRET to a long random text in each environment.

export const SESSION_COOKIE = "session";
export const SESSION_SECONDS = {{ definition.auth.session_hours * 3600 }};
export const SIGN_IN_PATH = "/sign-in";

/** An action or a page that needs a signed-in user. */
export class UnauthorizedError extends Error {
  constructor() {
    super({{ tr(js("Sign in to do this.")) }});
    this.name = "UnauthorizedError";
  }
}

/** Return AUTH_SECRET: the key of the signed texts{{ " and of the secrets of the second factor" if definition.auth.second_factor }}. */
export function authSecret(): string {
  const value = process.env.AUTH_SECRET;
  if (!value) {
    throw new Error("Set AUTH_SECRET to sign the sessions.");
  }
  return value;
}

/** Return the signature of a text with AUTH_SECRET. */
export function sign(body: string): string {
  return createHmac("sha256", authSecret()).update(body).digest("base64url");
}

{% if signs_out %}
/** Return a signed session token for a user, with the name of the provider of the sign-in. */
export function makeToken(userId: string, provider?: string): string {
  const exp = Math.floor(Date.now() / 1000) + SESSION_SECONDS;
  const body = Buffer.from(JSON.stringify({ sub: userId, exp, idp: provider })).toString("base64url");
  return `${body}.${sign(body)}`;
}

{% else %}
/** Return a signed session token for a user. */
export function makeToken(userId: string): string {
  const exp = Math.floor(Date.now() / 1000) + SESSION_SECONDS;
  const body = Buffer.from(JSON.stringify({ sub: userId, exp })).toString("base64url");
  return `${body}.${sign(body)}`;
}

