{% if verify %}
/**
 * Return the user with a user name and a password, or null. `verified` is
 * false before the user confirms the email address (ADR 0023).
 */
export async function checkPassword(username: string, password: string): Promise<{ id: string; verified: boolean } | null> {
  const rows = await getDb()
    .select({ id: {{ table.const }}.id, passwordHash: credentialsTable.passwordHash, emailVerifiedAt: credentialsTable.emailVerifiedAt })
    .from({{ table.const }})
    .innerJoin(credentialsTable, eq(credentialsTable.userId, {{ table.const }}.id))
    .where(eq({{ table.const }}.{{ username.key }}, username))
    .limit(1);
  const [row] = rows;
  return row && verifyPassword(password, row.passwordHash) ? { id: row.id, verified: row.emailVerifiedAt !== null } : null;
}
{% else %}
/** Return the ID of the user with a user name and a password, or null. */
export async function checkPassword(username: string, password: string): Promise<string | null> {
  const rows = await getDb()
    .select({ id: {{ table.const }}.id, passwordHash: credentialsTable.passwordHash })
    .from({{ table.const }})
    .innerJoin(credentialsTable, eq(credentialsTable.userId, {{ table.const }}.id))
    .where(eq({{ table.const }}.{{ username.key }}, username))
    .limit(1);
  const [row] = rows;
  return row && verifyPassword(password, row.passwordHash) ? row.id : null;
}
{% endif %}

{% if verify %}
/**
 * Store the hash of a new password of a user. The reset link went to the
 * email address, so the address is verified too (ADR 0023).
 */
export async function setPassword(userId: string, password: string): Promise<void> {
  const passwordHash = hashPassword(password);
  const emailVerifiedAt = sql`coalesce(${credentialsTable.emailVerifiedAt}, now())`;
  await getDb()
    .insert(credentialsTable)
    .values({ userId, passwordHash })
    .onConflictDoUpdate({ target: credentialsTable.userId, set: { passwordHash, emailVerifiedAt } });
}
{% else %}
/** Store the hash of a new password of a user. */
export async function setPassword(userId: string, password: string): Promise<void> {
  const passwordHash = hashPassword(password);
  await getDb()
    .insert(credentialsTable)
    .values({ userId, passwordHash })
    .onConflictDoUpdate({ target: credentialsTable.userId, set: { passwordHash } });
}
