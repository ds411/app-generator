{% set reset = definition.auth.password_reset %}
{% set verify = definition.auth.sign_up.verify_email if definition.auth.sign_up else none %}
{% set message_elements = ([reset.id] if reset else []) + ([verify.id] if verify else []) %}
{{ trace_header(*message_elements) }}
import "server-only";

import type { Message } from "./messages";

/**
 * Send a message of the sign-in to a user, for example an email to
 * `message.to` (ADR 0023). appgen creates this file once and never changes
 * it. The definition does not know the mail service, so write the
 * delivery here: one function for all kinds of messages.
 *
 * `message.kind` is the kind of the message, for example `password-reset`.
 * The subject and the text are in the language of the request, and the
 * text holds the link. The stub writes the link to the log with
 * ENVIRONMENT=development. Else, it throws an error, so that a production
 * app does not hide a missing delivery.
 */
export async function deliverMessage(message: Message): Promise<void> {
  // TODO(appgen): send the message to the user, for example by email.
  // When it is done, change the kind of the traces in the header from gap to manual.
  if (process.env.ENVIRONMENT === "development") {
    console.warn(`The ${message.kind} link of ${message.to}: ${message.link}`);
    return;
  }
  throw new Error(`Not implemented yet: the delivery of the ${message.kind} message`);
}
