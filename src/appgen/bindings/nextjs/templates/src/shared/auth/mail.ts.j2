{{ trace_header(*((message_elements | list) + (emails | map(attribute="id") | list))) }}
import "server-only";

import { createTransport } from "nodemailer";

{% if message_elements %}
import type { Message } from "./messages";

{% endif %}
// The delivery of {% if message_elements %}the messages of the sign-in{% endif %}{% if message_elements and emails %} and of {% endif %}{% if emails %}the emails of the notices (ADR 0044){% endif %} by
// SMTP (`auth.delivery: smtp`, ADR 0017). The app sends each email to the
// address of the user, with the SMTP server of the variables `SMTP_*`.
// Without `SMTP_HOST`, the development app writes a note to the log, and
// the production app gives an error.

/** The time in milliseconds that the app waits for each step of the SMTP server. */
const TIMEOUT_MS = 10_000;

/** STARTTLS after the connection, TLS from the start (usually port 465), or none (a local test server). */
type SmtpTls = "starttls" | "tls" | "none";

/** Return the value of `SMTP_TLS`, by default `starttls`. */
function smtpTls(): SmtpTls {
  const value = process.env.SMTP_TLS || "starttls";
  if (value === "starttls" || value === "tls" || value === "none") return value;
  throw new Error(`SMTP_TLS must be starttls, tls, or none, not ${value}.`);
}

/** An email to a user: the address, the subject, and the text. */
export type Email = { to: string; subject: string; text: string };

/**
 * Send an email with the SMTP server of the variables `SMTP_*`. `what`
 * names the emails in the errors. Return false without `SMTP_HOST` in the
 * development app: the caller writes a note to the log. Without
 * `SMTP_HOST`, the production app gives an error.
 */
export async function sendEmail(email: Email, what: string): Promise<boolean> {
  const host = process.env.SMTP_HOST;
  if (!host) {
    if (process.env.ENVIRONMENT === "development") {
      return false;
    }
    throw new Error(`Set SMTP_HOST to send ${what}.`);
  }
  const from = process.env.SMTP_FROM;
  if (!from) throw new Error(`Set SMTP_FROM: the sender of ${what}.`);
  const tls = smtpTls();
  const username = process.env.SMTP_USERNAME;
  const transport = createTransport({
    host,
    port: Number(process.env.SMTP_PORT || "587"),
    secure: tls === "tls",
    requireTLS: tls === "starttls",
    ignoreTLS: tls === "none",
    ...(username ? { auth: { user: username, pass: process.env.SMTP_PASSWORD ?? "" } } : {}),
    connectionTimeout: TIMEOUT_MS,
    greetingTimeout: TIMEOUT_MS,
    socketTimeout: TIMEOUT_MS,
  });
  try {
    await transport.sendMail({ from, to: email.to, subject: email.subject, text: email.text });
  } finally {
    transport.close();
  }
  return true;
}
{% if message_elements %}

/** Send a message of the sign-in to a user by SMTP. */
export async function deliverMessage(message: Message): Promise<void> {
  if (!(await sendEmail(message, "the messages of the sign-in"))) {
    console.warn(`The ${message.kind} link of ${message.to}: ${message.link}`);
  }
}
{% endif %}
