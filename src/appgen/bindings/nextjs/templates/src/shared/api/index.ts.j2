{{ trace_header("app") }}
{% set client_names = ["createEntityApi"] + (["createFileApi"] if definition.storage else []) + (["createHistoryApi"] if has_history(definition) else []) + (["createPresenceApi"] if presences else []) + (["createSharingApi"] if shares else []) + ["type EntityActions"] + (["type FileActions"] if definition.storage else []) + (["type HistoryActions"] if has_history(definition) else []) + (["type PresenceActions"] if presences else []) + (["type SharingActions"] if shares else []) + ["notifyChange"] %}
export { {{ client_names | join(", ") }} } from "./client";
export {
  type ActionError,
  type ActionResult,
  type Issue,
  unwrap,
  ValidationError,
} from "./errors";
export type {
  EntityApi,
  EntityRecord,
{% if definition.storage %}
  FileApi,
  FileValue,
{% endif %}
  Filter,
  FilterOp,
{% if has_points(definition) %}
  GeoPoint,
{% endif %}
{% if has_history(definition) %}
  HistoryAction,
  HistoryApi,
  HistoryEntry,
{% endif %}
  ListQuery,
  ListResult,
{% if has_notices(definition) %}
  Notice,
  NoticeApi,
{% endif %}
{% if has_available(definition) %}
  OwnerRange,
{% endif %}
{% if presences %}
  PresenceApi,
  PresentUser,
{% endif %}
  Search,
{% if shares %}
  SharedRecord,
  ShareLinkCreated,
  ShareLinkState,
  SharingApi,
{% endif %}
  Sort,
  SortDirection,
} from "./types";
{% if query_operations(definition) %}
export { FIRST_ROWS, NotFoundError, pageOfRows, type RowsPage } from "./types";
{% else %}
export { NotFoundError } from "./types";
{% endif %}
