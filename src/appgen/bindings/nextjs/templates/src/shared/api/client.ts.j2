import { type ActionResult, unwrap } from "./errors";
import type { EntityApi, EntityRecord, {{ "FileApi, " if definition.storage }}{{ "HistoryApi, HistoryEntry, " if has_history(definition) }}ListQuery, ListResult{{ ", PresenceApi, PresentUser" if presences }}{{ ", ShareLinkCreated, ShareLinkState, SharingApi" if shares }} } from "./types";

/** The server actions of the data access of one entity. */
export type EntityActions<T extends EntityRecord, TInput, TPatch = Partial<TInput>> = {
  list(query?: ListQuery<T>): Promise<ActionResult<ListResult<T>>>;
  get(id: string): Promise<ActionResult<T>>;
  create(input: TInput): Promise<ActionResult<T>>;
  update(id: string, patch: TPatch): Promise<ActionResult<T>>;
  remove(id: string): Promise<ActionResult<null>>;
};

const listeners = new Map<string, Set<() => void>>();

/** Call the listeners of an entity, or of all entities if there is no entity. */
export function notifyChange(entity?: string): void {
  const sets = entity === undefined ? [...listeners.values()] : [listeners.get(entity)];
  for (const set of sets) {
    for (const listener of set ?? []) {
      listener();
    }
  }
}

function subscribe(entity: string, listener: () => void): () => void {
  let set = listeners.get(entity);
  if (!set) {
    set = new Set();
    listeners.set(entity, set);
  }
  set.add(listener);
  return () => {
    set.delete(listener);
  };
}

/**
 * Return the data access of an entity: it calls the server actions of the
 * entity, and after each change it calls the listeners in this browser tab.
 */
export function createEntityApi<T extends EntityRecord, TInput, TPatch = Partial<TInput>>(
  entity: string,
  actions: EntityActions<T, TInput, TPatch>,
): EntityApi<T, TInput, TPatch> {
  return {
    async list(query) {
      return unwrap(await actions.list(query));
    },
    async get(id) {
      return unwrap(await actions.get(id));
    },
    async create(input) {
      const record = unwrap(await actions.create(input));
      notifyChange(entity);
      return record;
    },
    async update(id, patch) {
      const record = unwrap(await actions.update(id, patch));
      notifyChange(entity);
      return record;
    },
    async remove(id) {
      unwrap(await actions.remove(id));
      notifyChange(entity);
    },
    subscribe(listener) {
      return subscribe(entity, listener);
    },
  };
}
{% if definition.storage %}

/** The server actions of the files of the file fields of one entity (ADR 0027). */
export type FileActions<T extends EntityRecord, TField extends string> = {
  upload(id: string, field: TField, data: FormData): Promise<ActionResult<T>>;
  remove(id: string, field: TField): Promise<ActionResult<T>>;
};

/**
 * Return the data access of the files of an entity: it sends each file to
 * the server action in a form data, and after each change it calls the
 * listeners of the entity in this browser tab.
 */
export function createFileApi<T extends EntityRecord, TField extends string>(
  entity: string,
  actions: FileActions<T, TField>,
): FileApi<T, TField> {
  return {
    async upload(id, field, file) {
      const data = new FormData();
      data.set("file", file);
      const record = unwrap(await actions.upload(id, field, data));
      notifyChange(entity);
      return record;
    },
    async remove(id, field) {
      const record = unwrap(await actions.remove(id, field));
      notifyChange(entity);
      return record;
    },
  };
}
{% endif %}
{% if has_history(definition) %}

/** The server actions of the change log of one entity (ADR 0040). */
export type HistoryActions<T extends EntityRecord> = {
  list(id: string, page?: { page: number; pageSize: number }): Promise<ActionResult<ListResult<HistoryEntry>>>;
  restore(id: string, entryId: string): Promise<ActionResult<T>>;
};

/**
 * Return the change log of an entity: it calls the server actions, and
 * after a restore it calls the listeners of the entity in this browser tab.
 */
export function createHistoryApi<T extends EntityRecord>(entity: string, actions: HistoryActions<T>): HistoryApi<T> {
  return {
    async list(id, page) {
      return unwrap(await actions.list(id, page));
    },
    async restore(id, entryId) {
      const record = unwrap(await actions.restore(id, entryId));
      notifyChange(entity);
      return record;
    },
  };
}
{% endif %}
{% if shares %}

/** The server actions of the secret links of one entity (ADR 0049). */
export type SharingActions = {
  state(id: string): Promise<ActionResult<ShareLinkState>>;
  create(id: string): Promise<ActionResult<ShareLinkCreated>>;
  revoke(id: string): Promise<ActionResult<null>>;
};

/** Return the secret links of an entity: it calls the server actions. */
export function createSharingApi(actions: SharingActions): SharingApi {
  return {
    async state(id) {
      return unwrap(await actions.state(id));
    },
    async create(id) {
      return unwrap(await actions.create(id));
    },
    async revoke(id) {
      unwrap(await actions.revoke(id));
    },
  };
}
{% endif %}
{% if presences %}

/** The server actions of the users on the records of one entity (ADR 0052). */
export type PresenceActions = {
  here(id: string, typing: boolean): Promise<ActionResult<PresentUser[]>>;
  leave(id: string): Promise<ActionResult<null>>;
};

/** Return the users on the records of an entity: it calls the server actions. */
export function createPresenceApi(entity: string, actions: PresenceActions): PresenceApi {
  return {
    entity,
    async here(id, typing) {
      return unwrap(await actions.here(id, typing));
    },
    async leave(id) {
      unwrap(await actions.leave(id));
    },
  };
}
{% endif %}
