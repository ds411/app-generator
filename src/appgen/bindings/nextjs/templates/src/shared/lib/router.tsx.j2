{{ trace_header("app") }}
"use client";

// The router interface of the shared UI code. The UI imports links and
// router hooks from this module, not from Next.js, so that the same UI
// code works with the router of each front-end binding.
import NextLink from "next/link";
import {
  useParams as useNextParams,
  usePathname as useNextPathname,
  useRouter,
} from "next/navigation";
import { type ComponentProps, useMemo } from "react";
{% if definition.access %}

import { useAccess } from "@/shared/lib/access";
import { matchPage } from "@/shared/lib/pages";
{% endif %}

{% if definition.access %}
export type LinkProps = Omit<ComponentProps<typeof NextLink>, "href"> & {
  href: string;
  /** Show the link also if the user may not open its page, for example the link to the start page. */
  always?: boolean;
};
{% else %}
export type LinkProps = Omit<ComponentProps<typeof NextLink>, "href"> & { href: string };
{% endif %}

/** A link to a path of the app.{% if definition.access %} A link to a page that the user may not open shows only its content.{% endif %} */
{% if definition.access %}
export function Link({ always = false, ...props }: LinkProps) {
  const { canOpenPage } = useAccess(); {{ trace(definition.access.id) }}
  const page = always ? undefined : matchPage(props.href.split(/[?#]/)[0] ?? "")?.name;
  if (page !== undefined && !canOpenPage(page)) {
    return <span className={props.className}>{props.children}</span>;
  }
  return <NextLink {...props} />;
}
{% else %}
export function Link(props: LinkProps) {
  return <NextLink {...props} />;
}
{% endif %}

/** Return a function that opens a path of the app. */
export function useNavigate(): (href: string) => void {
  const router = useRouter();
  return (href) => {
    router.push(href);
  };
}

/** Return the path of the current page, for example `/projects/42`. */
export function usePathname(): string {
  return useNextPathname() ?? "/";
}

/** Return the path parameters of the current page. */
export function useParams(): Record<string, string | undefined> {
  const params = useNextParams();
  return useMemo(
    () =>
      Object.fromEntries(
        Object.entries(params ?? {}).map(([key, value]) => [
          key,
          Array.isArray(value) ? value[0] : value,
        ]),
      ),
    [params],
  );
}
