{{ trace_header(definition.access.id) }}
"use client";

// The permissions of the signed-in user in the browser (ADR 0012): the
// menus, the links, and the actions show only the pages and the
// operations that the role allows. The root layout reads the role on the
// server. The server checks each page and each operation again.
import { createContext, type ReactNode, useContext, useMemo } from "react";

import type { PageName } from "@/shared/config/pages";
{% if memberships %}
import { memberGives, useMemberPermissions } from "@/shared/lib/member-access";
{% endif %}
{% if record_rules %}
import { type RecordScope, recordScopeOf, roleMayCall, roleMayOpenPage } from "@/shared/lib/permissions";
{% else %}
import { roleMayCall, roleMayOpenPage } from "@/shared/lib/permissions";
{% endif %}

export type Access = {
  /** Return true if the user may open a page. */
  canOpenPage: (page: PageName) => boolean;
  /** Return true if the user may call an operation. */
  canCall: (operation: string) => boolean;
{% if memberships %}
  /**
   * Return true if the user may call an operation on some records: the role
   * gives it, or a membership gives it in the scope of each record (ADR 0048).
   */
  canCallOn: (operation: string, ids: readonly string[]) => boolean;
{% endif %}
{% if record_rules %}
  /**
   * Return the records that the user may change, of the record rule of the
   * role (ADR 0018, ADR 0025), or null for all records. A form then gives a
   * new record to the user, sets the values that the rule allows, and does
   * not show these fields.
   */
  scopeOf: (entity: string) => RecordScope | null;
{% endif %}
};

{% if record_rules %}
{% if memberships %}
function accessOf(role: string | null, userId: string | null): Access {
  const canCallOn = (operation: string, ids: readonly string[]) =>
    roleMayCall(role, operation) || memberGives(userId, operation, ids);
  return {
    canOpenPage: (page) => roleMayOpenPage(role, page),
    canCall: (operation) => canCallOn(operation, []),
    canCallOn,
    scopeOf: (entity) => recordScopeOf(role, userId, entity, "change"),
  };
}
{% else %}
function accessOf(role: string | null, userId: string | null): Access {
  return {
    canOpenPage: (page) => roleMayOpenPage(role, page),
    canCall: (operation) => roleMayCall(role, operation),
    scopeOf: (entity) => recordScopeOf(role, userId, entity, "change"),
  };
}
{% endif %}

// Without a provider, the user has no role: only the public pages and operations.
const AccessContext = createContext<Access>(accessOf(null, null));

/** Give the role and the ID of the signed-in user to the UI: null without a session or a role. */
export function AccessProvider({
  role,
  userId,
  children,
}: {
  role: string | null;
  userId: string | null;
  children: ReactNode;
}) {
  const access = useMemo(() => accessOf(role, userId), [role, userId]);
{% else %}
function accessOf(role: string | null): Access {
  return {
    canOpenPage: (page) => roleMayOpenPage(role, page),
    canCall: (operation) => roleMayCall(role, operation),
  };
}

// Without a provider, the user has no role: only the public pages and operations.
const AccessContext = createContext<Access>(accessOf(null));

/** Give the role of the signed-in user to the UI: null without a session or a role. */
export function AccessProvider({ role, children }: { role: string | null; children: ReactNode }) {
  const access = useMemo(() => accessOf(role), [role]);
{% endif %}
  return <AccessContext value={access}>{children}</AccessContext>;
}

{% if memberships %}
/**
 * Return the permissions of the signed-in user. The component renders
 * again when the data access gives the operations of the memberships.
 */
export function useAccess(): Access {
  useMemberPermissions();
  return useContext(AccessContext);
}
{% else %}
/** Return the permissions of the signed-in user. */
export function useAccess(): Access {
  return useContext(AccessContext);
}
{% endif %}
