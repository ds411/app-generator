// pnpm db:seed: add the seed records to the database of DATABASE_URL.
// The seed records of the definition go in by ID, and the generated
// records only into empty tables. Apply the migrations first.
import { connect } from "./connect";
import { seedDatabase } from "./seed";

const url = process.env.DATABASE_URL;
if (!url) {
  console.error("Set DATABASE_URL to the connection URL of the database, or to pglite:<folder>.");
  process.exit(1);
}
const added = await seedDatabase(connect(url));
console.log(`The seed added ${added} records.`);
process.exit(0);
