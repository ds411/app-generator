{% set table = nextjs.tables_by_entity[definition.auth.user_entity] %}
{% set verify = definition.auth.sign_up.verify_email if definition.auth.sign_up else none %}
{% set sf = definition.auth.second_factor %}
{% set builders = (["bigint", "integer"] if sf else []) + ["pgTable"] + (["timestamp"] if verify or sf else []) + ["uuid", "varchar"] %}
{{ trace_header(definition.auth.id) }}
import { {{ builders | join(", ") }} } from "drizzle-orm/pg-core";

import { {{ table.const }} } from "./{{ table.module }}";

/**
 * The password hash of each user{{ ", the time of the verification of the email address" if verify }}{{ ", the second factor" if sf }},
 * apart from the records of {{ definition.auth.user_entity }}.
 */
export const credentialsTable = pgTable("credentials", {
  userId: uuid("user_id")
    .primaryKey()
    .references(() => {{ table.const }}.id, { onDelete: "cascade" }),
  passwordHash: varchar("password_hash", { length: 200 }).notNull(),
{% if verify %}
  {{ trace(verify.id) }}
  // The time of the verification of the email address, or null before it. Without a value,
  // the database sets the time, so the users of the seed and the users that exist before
  // the verification are verified (ADR 0023).
  emailVerifiedAt: timestamp("email_verified_at", { withTimezone: true }).defaultNow(),
{% endif %}
{% if sf %}
  {{ trace(sf.id) }}
  // The second factor (ADR 0024): the secret encrypted with a key from AUTH_SECRET, the time
  // that the user turned it on, the last time step of a code, the wrong codes in a row, the
  // end of a lock (seconds since 1970), and the SHA-256 hashes of the recovery codes.
  totpSecret: varchar("totp_secret", { length: 200 }),
  totpEnabledAt: timestamp("totp_enabled_at", { withTimezone: true }),
  totpLastStep: bigint("totp_last_step", { mode: "number" }),
  totpFailures: integer("totp_failures").notNull().default(0),
  totpLockedUntil: bigint("totp_locked_until", { mode: "number" }),
  recoveryCodes: varchar("recovery_codes", { length: 1000 }),
{% endif %}
});
