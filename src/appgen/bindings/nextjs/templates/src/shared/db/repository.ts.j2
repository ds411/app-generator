type Row = Record<string, unknown>;
type Transaction = Parameters<Parameters<Database["transaction"]>[0]>[0];

/** A `many_to_many` relation: the record has a list of IDs, and a join table stores them. */
export type ManyToMany = {
  /** The key of the list in the record, for example `tags`. */
  key: string;
  table: PgTable;
  /** The key of the join table column with the ID of the record, for example `taskId`. */
  ownerKey: string;
  /** The key of the join table column with the ID of the target, for example `tagId`. */
  targetKey: string;
};

/** A `one_to_one` relation whose foreign key is on the target table. */
export type InverseOne = {
  /** The key of the ID in the record, for example `ownerId`. */
  key: string;
  /** The table of the target. */
  table: PgTable & { id: PgColumn };
  /** The key of the foreign key column of the target, for example `profileId`. */
  foreignKey: string;
};

/**
 * A rule that compares two values of a record, for example `endsAt` after
 * `startsAt`.{% if nextjs.total_rules %} A value is a field, or a total of the lines (ADR 0034), for
 * example `sumLinesDebit`.{% endif %}

 */
export type CompareRule = {
  field: string;
  op: "eq" | "ne" | "lt" | "lte" | "gt" | "gte";
  other: string;
  message: string;
};

/** A rule that the time ranges of two records with the same scope do not overlap. */
export type OverlapRule = {
  start: string;
  end: string;
  /** The keys that two records must share to overlap, for example `roomId`. */
  scope: string[];
  message: string;
};

/** A workflow on an enum field: the allowed changes of the field. */
export type Workflow = {
  field: string;
  /** The state of a new record. */
  initial?: string;
  /** The allowed changes: the value before and the value after. */
  transitions: [string, string][];
  message?: string;
};

{% if nextjs.totals %}
/** A function of a total (ADR 0034). */
export type TotalFunction = "count" | "sum" | "avg" | "min" | "max";

/**
 * Return the subquery of a total of the related records (ADR 0034): the
 * function of `value` over the rows of `from` that pass the conditions. A
 * `many_to_many` relation gives the table of the related records and the
 * join table. The count and the sum of no rows are 0, and the others null.
 */
export function total(
  fn: TotalFunction,
  from: PgTable | PgTable[],
  value: Column | null,
  ...conditions: SQL[]
): SQL<number | null> {
  const result =
    fn === "count" ? sql`count(*)` : fn === "sum" ? sql`coalesce(sum(${value}), 0)` : sql`${sql.raw(fn)}(${value})`;
  const tables = sql.join(Array.isArray(from) ? from : [from], sql`, `);
  return sql<number | null>`(select ${result} from ${tables} where ${and(...conditions)})`.mapWith(Number);
}

{% endif %}
{% if nextjs.events %}
/** The custom operation of an event (ADR 0031): it gets the record after the change. */
export type EventOperation<T> = (record: T) => Promise<void>;

/**
 * The events of an entity (ADR 0031): the custom operations that run after
 * a change of a record, in the transaction of the change.
 */
export type Events<T> = {
  created?: EventOperation<T>;
  /** Runs when a field of `keys` has a new value. */
  changed?: { keys: string[]; run: EventOperation<T> };
  deleted?: EventOperation<T>;
  /** The transitions of the workflows with `run`: a change of `field` from a state of `from` to `to`. */
  transitions?: { field: string; from: string[]; to: string; run: EventOperation<T> }[];
};

{% endif %}
{% if record_rules %}
/**
 * The options of a create: the records that the user may use (ADR 0025),
 * which the new record must be part of{% if definition.auth and definition.auth.sign_up %}, and `then`, which writes more rows
 * in the same transaction, for example the credential of a new user
 * (ADR 0016){% endif %}.
 */
export type CreateOptions{{ "<T>" if definition.auth and definition.auth.sign_up }} = {
  scope?: RecordScope | null;
{% if definition.auth and definition.auth.sign_up %}
  then?: (tx: Transaction, record: T) => Promise<void>;
{% endif %}
};

{% endif %}
type JoinTable = ManyToMany & { owner: PgColumn; target: PgColumn };
type ForeignKey = InverseOne & { column: PgColumn };

export type RepositoryOptions<T> = {
  entity: string;
  table: PgTable & { id: PgColumn };
  /** The value of each optional key that the create input does not have. */
  defaults: Partial<Omit<T, "id">>;
  manyToMany?: ManyToMany[];
  inverseOne?: InverseOne[];
  /** The compare rules of the entity. A broken rule gives a ValidationError. */
  compare?: CompareRule[];
  /** The `no_overlap` rules of the entity. A broken rule gives a ValidationError. */
  noOverlap?: OverlapRule[];
  /** The workflows of the entity. A change that no transition allows gives a ValidationError. */
  workflows?: Workflow[];
{% if history %}
  /**
   * The fields and the relations that the change log keeps (ADR 0040): the
   * name in the app definition, and the key of the row. Without them, the
   * entity keeps no change log.
   */
  history?: HistoryMember[];
{% endif %}
{% if nextjs.notices %}
  /**
   * Add the notices of a change of a record (ADR 0041): the row after the
   * change, and the row before it, or undefined for a new record. The
   * repository calls it after the change log.
   */
  notify?: (tx: Database, row: Row, before: Row | undefined) => Promise<void>;
{% endif %}
{% if nextjs.events %}
  /** The events of the entity. An error of an operation rolls back the change. */
  events?: Events<T>;
{% endif %}
{% if nextjs.live %}
  /**
   * True for a live entity (ADR 0051): a create, a change, and a delete of
   * a record give an event after the commit of the transaction.
   */
  live?: boolean;
{% endif %}
{% if nextjs.totals %}
  /**
   * The totals of the related records (ADR 0034): the subquery of each key
   * of the records, of the table of the records with the name `record`.
   */
{% if nextjs.me_totals %}
  totals?: (record: { id: PgColumn }, me: string | null) => Record<string, SQL<number | null>>;
  /** The ID of the signed-in user of the request, or null: the totals of `$me` read it. */
  me?: () => Promise<string | null>;
{% else %}
  totals?: (record: { id: PgColumn }) => Record<string, SQL<number | null>>;
{% endif %}
{% endif %}
{% if nextjs.total_rules %}
  /**
   * The compare rules with totals of the lines (ADR 0034). The repository
   * checks them after a change, with the totals in the database.{% if transactions %} In the work
   * of `inTransaction()`, for example an operation with lines (ADR 0035),
   * the check runs at the end of the work, after the lines.{% endif %} A broken
   * rule gives a ValidationError.
   */
  totalRules?: CompareRule[];
  /** The subqueries of the totals that only the rules use, as `totals`. */
  ruleTotals?: (record: { id: PgColumn }) => Record<string, SQL<number | null>>;
{% endif %}
{% if translatable %}
  /**
   * The keys of the translatable fields (ADR 0026). The table keeps the
   * value of the default language in the column of the field, and the
   * values of the other languages in `<field>Translations`. The records
   * have the value of the language of the request.
   */
  translatable?: string[];
{% endif %}
{% if record_rules %}
  /**
   * The key of the ID of the owner in the record, for an owner rule of one
   * many-to-one relation (ADR 0018).
   */
  owner?: string;
  /**
   * The condition of the records of a user, for an owner path of the
   * record rules (ADR 0025). Without it, the key of the owner gives it.
   */
  belongsTo?: (user: string) => SQL;
{% endif %}
{% if memberships %}
  /**
   * The condition of the records in some scopes of the memberships, for an
   * entity of the scope (ADR 0048): the path to the scope record.
   */
  inScopes?: (scopes: readonly string[]) => SQL;
{% endif %}
{% if storage %}
  /**
   * The file fields (ADR 0027): the key of each one in the record, and the
   * URL of its files, with `{id}` for the ID of the record. The table keeps
   * a `StoredFile`, and a record has a `FileValue` with the URL.
   */
  files?: Record<string, string>;
{% endif %}
};

/** Return a value of a row as a number or a text that `compareValues` can order. */
function orderValue(value: unknown): number | string {
  if (value instanceof Date) return value.getTime();
  if (typeof value === "number") return value;
  const text = String(value);
  return text.trim() !== "" && Number.isFinite(Number(text)) ? Number(text) : text;
}

/** Return True if `a op b`. An empty value passes, as the rules of the fields check it. */
function compareValues(a: unknown, op: CompareRule["op"], b: unknown): boolean {
  if (a === null || a === undefined || b === null || b === undefined) return true;
  const x = orderValue(a);
  const y = orderValue(b);
  const order = typeof x === "number" && typeof y === "number" ? x - y : String(x).localeCompare(String(y));
  switch (op) {
    case "eq":
      return order === 0;
    case "ne":
      return order !== 0;
    case "lt":
      return order < 0;
    case "lte":
      return order <= 0;
    case "gt":
      return order > 0;
    case "gte":
      return order >= 0;
  }
}

function escapeLike(text: string): string {
  return text.replace(/[\\%_]/g, (match) => `\\${match}`);
}

/** Return a value as the column needs it: a timestamp column needs a Date. */
function toColumnValue(column: Column, value: unknown): unknown {
  if (is(column, PgTimestamp) && typeof value === "string") {
    return new Date(value);
  }
  return value;
}

{% if nextjs.events %}
/** Return true if two values of a column are the same: two equal times, or two equal JSON values. */
function sameValue(a: unknown, b: unknown): boolean {
  if (a instanceof Date && b instanceof Date) return a.getTime() === b.getTime();
  return a === b || JSON.stringify(a) === JSON.stringify(b);
}

{% endif %}
/** Return a value of a row as the record has it: a Date becomes an ISO 8601 text. */
function toRecordValue(value: unknown): unknown {
  return value instanceof Date ? value.toISOString() : value;
}
{% if storage %}

/**
 * Return the file of a record for the browser: the name, the size, the
 * type, and the URL (ADR 0027). The last part of the key is new for each
 * upload, so the URL changes with the file.
 */
function toFileValue(file: StoredFile | null | undefined, url: string): FileValue | null {
  if (!file) {
    return null;
  }
  const version = file.key.slice(file.key.lastIndexOf("/") + 1);
  return { name: file.name, size: file.size, type: file.type, url: `${url}?v=${encodeURIComponent(version)}` };
}
{% endif %}

/**
 * The data access of one entity in the Postgres database, with the same
 * interface as the data access in the browser. Use it only on the server.
 */
/** The form of a record ID: the primary keys are UUIDs. */
const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

export class Repository<T extends EntityRecord, TInput extends object>
  implements Omit<EntityApi<T, TInput>, "subscribe">
{
  private readonly entity: string;
  private readonly table: PgTable & { id: PgColumn };
  private readonly columns: Record<string, Column>;
  private readonly defaults: Partial<Omit<T, "id">>;
  private readonly manyToMany: JoinTable[];
  private readonly inverseOne: ForeignKey[];
  private readonly compare: CompareRule[];
  private readonly noOverlap: OverlapRule[];
  private readonly workflows: Workflow[];
{% if history %}
  private readonly history: HistoryMember[];
{% endif %}
{% if nextjs.notices %}
  private readonly notify: RepositoryOptions<T>["notify"];
{% endif %}
{% if nextjs.events %}
  private readonly events: Events<T>;
{% endif %}
{% if nextjs.live %}
  private readonly live: boolean;
{% endif %}
{% if nextjs.totals %}
  private readonly totals: RepositoryOptions<T>["totals"];
{% if nextjs.me_totals %}
  private readonly me: RepositoryOptions<T>["me"];
{% endif %}
{% endif %}
{% if nextjs.total_rules %}
  private readonly totalRules: CompareRule[];
  private readonly ruleTotals: RepositoryOptions<T>["ruleTotals"];
{% endif %}
{% if translatable %}
  private readonly translatable: string[];
{% endif %}
{% if record_rules %}
  private readonly belongsTo: ((user: string) => SQL) | undefined;
{% endif %}
{% if memberships %}
  private readonly inScopes: ((scopes: readonly string[]) => SQL) | undefined;
{% endif %}
{% if storage %}
  private readonly files: Record<string, string>;
{% endif %}

  constructor(options: RepositoryOptions<T>) {
    this.entity = options.entity;
    this.table = options.table;
    this.columns = getTableColumns(options.table);
    this.defaults = options.defaults;
    this.compare = options.compare ?? [];
    this.noOverlap = options.noOverlap ?? [];
    this.workflows = options.workflows ?? [];
{% if history %}
    this.history = options.history ?? [];
{% endif %}
{% if nextjs.notices %}
    this.notify = options.notify;
{% endif %}
{% if nextjs.events %}
    this.events = options.events ?? {};
{% endif %}
{% if nextjs.live %}
    this.live = options.live ?? false;
{% endif %}
{% if nextjs.totals %}
    this.totals = options.totals;
{% if nextjs.me_totals %}
    this.me = options.me;
{% endif %}
{% endif %}
{% if nextjs.total_rules %}
    this.totalRules = options.totalRules ?? [];
    this.ruleTotals = options.ruleTotals;
{% endif %}
{% if translatable %}
    this.translatable = options.translatable ?? [];
{% endif %}
{% if storage %}
    this.files = options.files ?? {};
{% endif %}
{% if record_rules %}
    const owner = options.owner === undefined ? undefined : this.columns[options.owner];
    this.belongsTo = options.belongsTo ?? (owner === undefined ? undefined : (user) => eq(owner, user));
{% endif %}
{% if memberships %}
    this.inScopes = options.inScopes;
{% endif %}
    this.manyToMany = (options.manyToMany ?? []).map((relation) => {
      const columns = getTableColumns(relation.table);
      return {
        ...relation,
        owner: columns[relation.ownerKey] as PgColumn,
        target: columns[relation.targetKey] as PgColumn,
      };
    });
    this.inverseOne = (options.inverseOne ?? []).map((relation) => ({
      ...relation,
      column: getTableColumns(relation.table)[relation.foreignKey] as PgColumn,
    }));
  }

{% if record_rules %}
  /** Return a page of the records. With a scope, only the records of the scope (ADR 0025). */
  async list(query: ListQuery<T> = {}, scope: RecordScope | null = null): Promise<ListResult<T>> {
    const db = getDb();
    const where = and(this.where(query), this.scoped(scope));
{% else %}
  async list(query: ListQuery<T> = {}): Promise<ListResult<T>> {
    const db = getDb();
    const where = this.where(query);
{% endif %}
    const total = await db.$count(this.table, where);
    const pageSize = query.pageSize ?? (total || 1);
    const page = query.page ?? 1;
    const select = db
      .select()
      .from(this.table)
      .where(where)
      .orderBy(...this.orderBy(query.sort ?? []))
      .$dynamic();
    if (query.page !== undefined) {
      select.limit(pageSize).offset((page - 1) * pageSize);
    }
    const rows: Row[] = await select;
    return { items: await this.toRecords(db, rows), total, page, pageSize };
  }

  /** Return true if a record with the ID exists. An ID that is not a UUID does not exist. */
{% if record_rules %}
  async exists(id: string, scope: RecordScope | null = null): Promise<boolean> {
    if (!UUID.test(id)) {
      return false;
    }
    return (await getDb().$count(this.table, this.byId(id, scope))) > 0;
  }

{% if memberships %}
  /** Return the IDs of the records in some scopes of the memberships, of the IDs (ADR 0048). */
  async inScopesOf(ids: string[], scopes: readonly string[]): Promise<Set<string>> {
    const wanted = ids.filter((id) => UUID.test(id));
    if (this.inScopes === undefined || wanted.length === 0) {
      return new Set();
    }
    const rows = await getDb()
      .select({ id: this.table.id })
      .from(this.table)
      .where(and(inArray(this.table.id, wanted), this.inScopes(scopes)));
    return new Set(rows.map((row) => String(row.id)));
  }

{% endif %}
  /** Return the IDs of the records of the scope, of the IDs (the rows of a query, ADR 0045). */
  async visible(ids: string[], scope: RecordScope | null): Promise<Set<string>> {
    if (scope === null || ids.length === 0) {
      return new Set(ids);
    }
    const rows = await getDb()
      .select({ id: this.table.id })
      .from(this.table)
      .where(and(inArray(this.table.id, ids), this.scoped(scope)));
    return new Set(rows.map((row) => String(row.id)));
  }

  async get(id: string, scope: RecordScope | null = null): Promise<T> {
{% if memberships %}
    await this.checkMemberScope(id, scope);
{% endif %}
    const db = getDb();
    const rows: Row[] = await db.select().from(this.table).where(this.byId(id, scope)).limit(1);
{% else %}
  async exists(id: string): Promise<boolean> {
    if (!UUID.test(id)) {
      return false;
    }
    return (await getDb().$count(this.table, eq(this.table.id, id))) > 0;
  }

  async get(id: string): Promise<T> {
    const db = getDb();
    const rows: Row[] = await db.select().from(this.table).where(eq(this.table.id, id)).limit(1);
{% endif %}
    const [record] = await this.toRecords(db, this.found(rows, id));
    return record as T;
  }

{% if shares %}
  /** Return the records with the IDs, without the record rules: the related records of a secret link (ADR 0049). */
  async byIds(ids: readonly string[]): Promise<T[]> {
    const wanted = ids.filter((id) => UUID.test(id));
    if (wanted.length === 0) {
      return [];
    }
    const db = getDb();
    const rows: Row[] = await db.select().from(this.table).where(inArray(this.table.id, wanted));
    return this.toRecords(db, rows);
  }

{% endif %}
{% if record_rules %}
  /** Add a record. A record out of the scope of the options gives a ForbiddenError, and is not added. */
  async create(input: TInput, options: CreateOptions{{ "<T>" if definition.auth and definition.auth.sign_up }} = {}): Promise<T> {
{% elif definition.auth and definition.auth.sign_up %}
  /**
   * Add a record. `then` writes more rows in the same transaction, for
   * example the credential of a new user (ADR 0016).
   */
  async create(input: TInput, then?: (tx: Transaction, record: T) => Promise<void>): Promise<T> {
{% else %}
  async create(input: TInput): Promise<T> {
{% endif %}
{% if translatable %}
    const values: Row = {
      ...this.defaults,
      ...input,
      ...storeTranslations(this.defaults, input, this.translatable, true),
    };
{% else %}
    const values: Row = { ...this.defaults, ...input };
{% endif %}
    return {{ begin }}(async (tx) => {
      const rows: Row[] = await tx.insert(this.table).values(this.toRow(values)).returning();
      const [row] = rows as [Row];
      this.checkWorkflows(undefined, row);
      await this.checkRules(tx, row);
      await this.writeLinks(tx, String(row.id), values);
{% if nextjs.total_rules %}
      await this.checkTotals(tx, String(row.id));
{% endif %}
{% if record_rules %}
      await this.checkScope(tx, String(row.id), options.scope ?? null);
{% endif %}
      const [record] = await this.toRecords(tx, rows);
{% if definition.auth and definition.auth.sign_up %}
      await {{ "options.then" if record_rules else "then" }}?.(tx, record as T);
{% endif %}
{% if nextjs.events %}
      const created = this.events.created;
      if (created !== undefined && (await this.runEvents(tx, record as T, [created]))) {
        // The operation of the event can change the record.
{% if history %}
        await this.log(tx, String(row.id), "created", undefined);
{% endif %}
{% if nextjs.notices %}
        await this.addNotices(tx, String(row.id), undefined);
{% endif %}
{% if live_scoped %}
        await this.noteLive(tx, String(row.id), "created");
{% elif nextjs.live %}
        this.noteLive(String(row.id), "created");
{% endif %}
        return this.reread(tx, String(row.id));
      }
{% endif %}
{% if history %}
      await this.log(tx, String(row.id), "created", undefined);
{% endif %}
{% if nextjs.notices %}
      await this.addNotices(tx, String(row.id), undefined);
{% endif %}
{% if live_scoped %}
      await this.noteLive(tx, String(row.id), "created");
{% elif nextjs.live %}
      this.noteLive(String(row.id), "created");
{% endif %}
      return record as T;
    });
  }

{% if record_rules and history %}
  /**
   * Change a record. With a scope, the record must be in the scope before
   * and after the change. The entry of the change log has the action
   * `action` (ADR 0040).
   */
  async update(
    id: string,
    patch: Partial<TInput>,
    scope: RecordScope | null = null,
    action: HistoryAction = "changed",
  ): Promise<T> {
{% if memberships %}
    await this.checkMemberScope(id, scope);
{% endif %}
    const where = this.byId(id, scope);
{% elif record_rules %}
  /** Change a record. With a scope, the record must be in the scope before and after the change. */
  async update(id: string, patch: Partial<TInput>, scope: RecordScope | null = null): Promise<T> {
{% if memberships %}
    await this.checkMemberScope(id, scope);
{% endif %}
    const where = this.byId(id, scope);
{% elif history %}
  /** Change a record. The entry of the change log has the action `action` (ADR 0040). */
  async update(id: string, patch: Partial<TInput>, action: HistoryAction = "changed"): Promise<T> {
    const where = eq(this.table.id, id);
{% else %}
  async update(id: string, patch: Partial<TInput>): Promise<T> {
    const where = eq(this.table.id, id);
{% endif %}
    return {{ begin }}(async (tx) => {
{% if live_scoped %}
      // The live event goes to the users that may read the record before or after the change.
      const audience = await this.audience(tx, id);
{% endif %}
{% set reads_history = (" || this.history.length > 0" if history else "") ~ (" || this.notify !== undefined" if nextjs.notices else "") %}
{% if translatable %}
      const reads = this.workflows.length > 0 || this.translatable.length > 0{{ " || this.events.changed !== undefined" if nextjs.events }}{{ reads_history }};
      const before: Row[] = reads ? await tx.select().from(this.table).where(where).limit(1) : [];
