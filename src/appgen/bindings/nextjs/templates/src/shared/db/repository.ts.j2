{% else %}
    const records = rows.map((row) =>
      Object.fromEntries(Object.entries(row).map(([key, value]) => [key, toRecordValue(value)])),
    );
{% endif %}
{% if storage %}
    for (const record of records) {
      for (const [key, url] of Object.entries(this.files)) {
        record[key] = toFileValue(record[key] as StoredFile | null, url.replace("{id}", String(record.id)));
      }
    }
{% endif %}
    const ids = records.map((record) => String(record.id));
    for (const relation of this.inverseOne) {
      const targets = new Map<string, string>();
      if (ids.length > 0) {
        const links = await db
          .select({ id: relation.table.id, owner: relation.column })
          .from(relation.table)
          .where(inArray(relation.column, ids));
        for (const link of links) {
          targets.set(String(link.owner), String(link.id));
        }
      }
      for (const record of records) {
        record[relation.key] = targets.get(String(record.id)) ?? null;
      }
    }
    for (const relation of this.manyToMany) {
      const lists = new Map<string, string[]>(ids.map((id) => [id, []]));
      if (ids.length > 0) {
        const links = await db
          .select({ owner: relation.owner, target: relation.target })
          .from(relation.table)
          .where(inArray(relation.owner, ids))
          .orderBy(asc(relation.target));
        for (const link of links) {
          lists.get(String(link.owner))?.push(String(link.target));
        }
      }
      for (const record of records) {
        record[relation.key] = lists.get(String(record.id)) ?? [];
      }
    }
{% if nextjs.totals %}
    if (this.totals !== undefined && ids.length > 0) {
      // The totals (ADR 0034). The query names the table `record`, so that the subquery
      // of a relation of the entity to itself tells the record from its related records.
      const record = alias(this.table, "record");
      const id = getTableColumns(record).id as PgColumn;
{% if nextjs.me_totals %}
      const me = (await this.me?.()) ?? null;
      const rows: Row[] = await db
        .select({ id, ...this.totals({ id }, me) })
{% else %}
      const rows: Row[] = await db
        .select({ id, ...this.totals({ id }) })
{% endif %}
        .from(record)
        .where(inArray(id, ids));
      const totals = new Map(rows.map((row) => [String(row.id), row]));
      for (const item of records) {
        Object.assign(item, totals.get(String(item.id)));
      }
    }
{% endif %}
    return records as T[];
  }
}
