import "server-only";

import { AsyncLocalStorage } from "node:async_hooks";

import { createClient } from "@redis/client";
{% if scoped %}
import { eq, getTableColumns } from "drizzle-orm";
import type { PgColumn, PgTable } from "drizzle-orm/pg-core";
{% elif presence %}
import { eq } from "drizzle-orm";
{% endif %}

{% if access %}
import { roleMayCall } from "@/shared/lib/permissions";

{% endif %}
import { afterCommit{{ ", type Database" if scoped }}{{ ", getDb" if presence }} } from "./client";
{% if owned %}
import { pathUsers, type PathStep } from "./paths";
{% endif %}
{% if tables %}
import { {{ tables | join(", ") }} } from "./schema";
{% endif %}

{{ ("// The live updates of the records (ADR 0051). A create, a change, and a delete of a record of a live entity in a repository give a change after the commit of the transaction. The route `/api/live` sends the changes as server-sent events to the clients that may read the records: " ~ readers ~ ". An event has the entity and the ID of the record, but no values: a client reads the record again. With the setting LIVE_EVENTS_URL, the processes send the changes through Redis, so that each replica gets the changes of all replicas. Without it, each process sends only its own changes.") | wordwrap(72, break_long_words=False, wrapstring="\n// ") }}
{% if presence %}
//
// The broker also keeps the signed-in users on the pages of the records
// (ADR 0052). A page notes its user each few seconds, and the broker
// forgets a user after PRESENCE_MS without a call. A change of the users
// on a record gives the event `presence` to the other users on it. With
// Redis, the calls of the pages go through the channel too.
{% endif %}

/** The Redis channel of the changes. */
const CHANNEL = {{ (app.name ~ ":live") | tojson }};
/** The events that wait for a slow client. With more, the client gets `reset`. */
const QUEUE_SIZE = 100;
/** The time between two pings of an open stream, in milliseconds, so that a proxy keeps it open. */
export const PING_MS = 15_000;
/**
 * The time to wait for a connection of Redis, in milliseconds. Without
 * Redis, the changes go to the clients of the process.
 */
const CONNECT_TIMEOUT_MS = 1_000;
{% if presence %}
/** The time after the last call of a page when the broker forgets its user, in milliseconds. */
const PRESENCE_MS = 15_000;
{% endif %}

export type LiveAction = "created" | "changed" | "deleted";
{% if presence %}

/** A signed-in user on the page of a record (ADR 0052). */
export type PresentUser = { id: string; name: string; typing: boolean };

/**
 * An event of the stream. `open`: the stream is open, and the changes from
 * now on follow. `created`, `changed`, `deleted`: a change of a record.
 * `reset`: the stream lost events, so read all records again. `presence`:
 * the other users on the page of a record changed.
 */
export type LiveEvent =
  | { type: "open" | "reset" }
  | { type: LiveAction; entity: string; id: string }
  | { type: "presence"; entity: string; id: string; users: PresentUser[] };
{% else %}

/**
 * An event of the stream. `open`: the stream is open, and the changes from
 * now on follow. `created`, `changed`, `deleted`: a change of a record.
 * `reset`: the stream lost events, so read all records again.
 */
export type LiveEvent = { type: "open" | "reset" } | { type: LiveAction; entity: string; id: string };
{% endif %}
{% if scoped %}

/** A value of a condition of a record rule. */
type RuleValue = string | number | boolean;

/**
 * The record rule of a role for the reads of an entity (ADR 0025): the
 * records of the user, or the records with some values.
 */
type ReadRule = { owner?: true; where?: Readonly<Record<string, readonly RuleValue[]>> };
{% endif %}

/** An entity with live updates: the operations that read its records{{ ", and the record rules of the reads" if scoped }}. */
type LiveEntity = {
  /** The list and the read operations: a {{ "role" if access else "user" }} that may call one of them gets the events. */
  readers: readonly string[];
  /** True if a list or a read operation is public: all clients get the events. */
  public: boolean;
{% if scoped %}
  /** The record rules of the reads, by role. */
  rules?: Readonly<Record<string, ReadRule>>;
  /** The table of the records, for the values of the conditions of the rules. */
  table?: PgTable & { id: PgColumn };
{% if owned %}
  /** The steps from a record to the users of the owner path of the rules. */
  ownerPath?: readonly PathStep[];
{% endif %}
{% endif %}
};

const LIVE: Readonly<Record<string, LiveEntity>> = {
{% for e in live %}
{% if e.rules %}
  {{ e.name | tojson }}: { {{ trace(e.id) }}
    readers: {{ e.readers | list | tojson }},
    public: {{ e.public | tojson }},
    rules: {
{% for role, rule in e.rules.items() %}
      {{ role | tojson }}: {{ rule.entry() }},
{% endfor %}
    },
    table: {{ nextjs.tables_by_entity[e.name].const }},
{% if e.owner_path %}
    ownerPath: [
{% for step in e.owner_path %}
      {{ step }},
{% endfor %}
    ],
{% endif %}
  },
{% else %}
  {{ e.name | tojson }}: { readers: {{ e.readers | list | tojson }}, public: {{ e.public | tojson }} }, {{ trace(e.id) }}
{% endif %}
{% endfor %}
};
{% if scoped %}

/** The users that may read a record at one time, by the record rules of the roles. */
export type Audience = {
  /** The roles whose rule conditions the record meets. */
  roles: string[];
  /** The users at the end of the owner path of the record. */
  owners: string[];
};
{% endif %}

/** A create, a change, or a delete of a record of a live entity, after the commit. */
export type Change = {
  entity: string;
  id: string;
  action: LiveAction;
{% if scoped %}
  /**
   * The audiences of the record before and after the change, or null
   * without a record rule for the reads of the entity: all users that may
   * read the entity see the change.
   */
  audiences: Audience[] | null;
{% endif %}
};
{% if presence %}

/** A call of the page of a record: its user is on the record, or left it (ADR 0052). */
export type Here = { entity: string; id: string; user: string; name: string; typing: boolean; left: boolean };

/** A message of the Redis channel: a change of a record, or a call of a record page. */
type Message = Change | { presence: Here };

/** A user on the page of a record: its name, its typing, and the end of its presence. */
type Present = { name: string; typing: boolean; until: number };
{% else %}

/** A message of the Redis channel: a change of a record. */
type Message = Change;
{% endif %}

/** A client of the stream: the entities whose events it gets{{ ", and its user" if auth }}. */
export type Viewer = {
  entities: ReadonlySet<string>;
{% if auth %}
  /** The signed-in user, or null. */
  user: string | null;
{% endif %}
{% if access %}
  /** The role of the signed-in user, or null. */
  role: string | null;
{% endif %}
};

/**
 * Return the client of a stream, or the status of an error. The client
 * gets the events of the entities of the names, by default of all live
 * entities that it may read. A name that is not a live entity gives 400.
 * An entity that the client may not read gives {{ "401 without a user, else 403" if access else "401" }}.
 */
{% if access %}
export function liveViewer(names: string[], user: string | null, role: string | null): Viewer | 400 | 401 | 403 {
{% elif auth %}
export function liveViewer(names: string[], user: string | null): Viewer | 400 | 401 {
{% else %}
export function liveViewer(names: string[]): Viewer | 400 {
{% endif %}
  if (names.some((name) => !Object.hasOwn(LIVE, name))) {
    return 400;
  }
  const wanted = names.length > 0 ? names : Object.keys(LIVE);
{% if access %}
  const readable = wanted.filter(
    (name) =>
      LIVE[name]?.public || (role !== null && LIVE[name]?.readers.some((operation) => roleMayCall(role, operation))),
  );
  if (readable.length === 0 || (names.length > 0 && readable.length !== wanted.length)) {
    return user === null ? 401 : 403;
  }
  return { entities: new Set(readable), user, role };
{% elif auth %}
  const readable = wanted.filter((name) => LIVE[name]?.public || user !== null);
  if (readable.length === 0 || (names.length > 0 && readable.length !== wanted.length)) {
    return 401;
  }
  return { entities: new Set(readable), user };
{% else %}
  return { entities: new Set(wanted) };
{% endif %}
}

/** Return true if a client may see a change: it may read the record. */
function sees(viewer: Viewer, change: Change): boolean {
{% if scoped %}
  if (!viewer.entities.has(change.entity)) {
    return false;
  }
  const live = LIVE[change.entity];
  const role = viewer.role;
  const rule = role === null ? undefined : live?.rules?.[role];
  // A record rule does not apply to the public operations (ADR 0025).
  if (role === null || rule === undefined || change.audiences === null || live?.public) {
    return true;
  }
  return change.audiences.some(
    (audience) =>
      audience.roles.includes(role) &&
      (rule.owner !== true || (viewer.user !== null && audience.owners.includes(viewer.user))),
  );
{% else %}
  return viewer.entities.has(change.entity);
{% endif %}
}

/** The events of one client: the changes that it may see, in a queue. */
export class Subscription {
  private readonly queue: LiveEvent[] = [];
  private wake: (() => void) | undefined;
  /** True if the queue was full: the client gets `reset`. */
  private lost = false;
  /** True if the stream ends, for example because the server stops. */
  private ended = false;

  constructor(readonly viewer: Viewer) {}

  /** Add a change to the queue if the client may see it. */
  offer(change: Change): void {
    if (sees(this.viewer, change)) {
      this.put({ type: change.action, entity: change.entity, id: change.id });
    }
  }

  /** Tell the client to read all records again, for example after a loss of events. */
  reset(): void {
    this.put({ type: "reset" });
  }
{% if presence %}

  /** Add the users on the page of a record to the queue, without the user of the client. */
  show(entity: string, id: string, users: PresentUser[]): void {
    this.put({ type: "presence", entity, id, users: users.filter((user) => user.id !== this.viewer.user) });
  }
{% endif %}

  /** End the stream. The client opens a new one, for example at another replica. */
  end(): void {
    this.ended = true;
    this.wake?.();
  }

  private put(event: LiveEvent): void {
    if (this.queue.length < QUEUE_SIZE) {
      this.queue.push(event);
    } else {
      this.lost = true;
    }
    this.wake?.();
  }

  /**
   * Return the next event, null after PING_MS without an event (a ping),
   * or undefined at the end of the stream. After a full queue, return
   * `reset` and drop the queue.
   */
  async next(): Promise<LiveEvent | null | undefined> {
    if (!this.ended && !this.lost && this.queue.length === 0) {
      await new Promise<void>((resolve) => {
        const timer = setTimeout(resolve, PING_MS);
        this.wake = () => {
          clearTimeout(timer);
          resolve();
        };
      });
      this.wake = undefined;
    }
    if (this.ended) {
      return undefined;
    }
    if (this.lost) {
      this.lost = false;
      this.queue.length = 0;
      return { type: "reset" };
    }
    return this.queue.shift() ?? null;
  }
}

/**
 * Return a client of Redis. A client without the offline queue does not
 * keep a command while it connects again: the command fails at once.
 */
function redisClient(url: string, offlineQueue: boolean) {
  return createClient({
    url,
    disableOfflineQueue: !offlineQueue,
    socket: {
      connectTimeout: CONNECT_TIMEOUT_MS,
      reconnectStrategy: (retries: number) => Math.min(100 * (retries + 1), 1_000),
    },
  });
}

type RedisClient = ReturnType<typeof redisClient>;

/** Return the message of an error, for the log. */
function messageOf(error: unknown): string {
  return error instanceof Error ? error.message : String(error);
}

/**
 * The changes of the process, and with Redis the changes of all replicas.
 *
 * Without a URL, `publish` gives the changes to the subscriptions of the
 * process. With a URL, it sends them to the Redis channel, and a second
 * connection gives the changes of the channel to the subscriptions, so
 * that each replica gets the changes of all replicas. The connections
 * start with the first change or subscription. When Redis is not
 * available, the process logs a warning and gives its changes to its own
 * subscriptions. When Redis is back, the subscriptions get `reset`.
{% if presence %}
 *
 * `here` and `leave` send the calls of the record pages in the same way.
 * Each broker keeps the users on the records from the calls, and forgets
 * a user after PRESENCE_MS without a call.
{% endif %}
 */
export class Broker {
  private readonly subscriptions = new Set<Subscription>();
{% if presence %}
  /** The users on the pages of the records, by entity and ID (`<entity>:<id>`), and by user. */
  private readonly present = new Map<string, Map<string, Present>>();
  /** The timer that forgets the users without a call. */
  private sweeper: ReturnType<typeof setInterval> | undefined;
{% endif %}
  private publisher: Promise<RedisClient | undefined> | undefined;
  private subscriber: RedisClient | undefined;
  /** False after an error of Redis, until Redis is back: one warning for each loss. */
  private available = true;
  /** True when the server stops: the streams end. */
  private ended = false;

  constructor(private readonly url: string | null) {}

  /** Send the changes of a transaction after its commit. */
  publish(messages: Message[]): void {
    if (this.url === null) {
      this.deliver(messages);
      return;
    }
    this.start();
    for (const message of messages) {
      void this.send(message);
    }
  }

  /** Give the messages to the subscriptions of the process. */
  deliver(messages: Message[]): void {
    for (const message of messages) {
{% if presence %}
      if ("presence" in message) {
        this.arrive(message.presence);
        continue;
      }
{% endif %}
      for (const subscription of this.subscriptions) {
        subscription.offer(message);
      }
    }
  }
{% if presence %}

  /** Note a user on the page of a record, and return the other users on the record. */
  here(entity: string, id: string, user: string, name: string, typing: boolean): PresentUser[] {
    this.publish([{ presence: { entity, id, user, name, typing, left: false } }]);
    return this.users(entity, id).filter((other) => other.id !== user);
  }

  /** End the presence of a user on a record: the page closed. */
  leave(entity: string, id: string, user: string): void {
    this.publish([{ presence: { entity, id, user, name: "", typing: false, left: true } }]);
  }

  /** Return the users on the page of a record. */
  users(entity: string, id: string): PresentUser[] {
    const present = this.present.get(`${entity}:${id}`) ?? new Map<string, Present>();
    return [...present].map(([user, state]) => ({ id: user, name: state.name, typing: state.typing }));
  }

  /** Note a call of a page in the users on its record, and tell the other users of a change. */
  arrive(here: Here): void {
    const key = `${here.entity}:${here.id}`;
    const present = this.present.get(key) ?? new Map<string, Present>();
    const before = present.get(here.user);
    present.delete(here.user);
    if (!here.left) {
      present.set(here.user, { name: here.name, typing: here.typing, until: Date.now() + PRESENCE_MS });
    }
    if (present.size > 0) {
      this.present.set(key, present);
    } else {
      this.present.delete(key);
    }
    if (before === undefined && here.left) {
      return;
    }
    if (before === undefined || here.left || before.name !== here.name || before.typing !== here.typing) {
      this.tell(here.entity, here.id, new Set([here.user]));
    }
    if (this.sweeper === undefined) {
      this.sweeper = setInterval(() => this.forget(), 1_000);
      // The timer does not keep the process alive.
      this.sweeper.unref();
    }
  }

  /** Forget the users without a call in PRESENCE_MS, and tell the other users. */
  forget(now: number = Date.now()): void {
    for (const [key, present] of this.present) {
      const gone = new Set([...present].filter(([, state]) => state.until <= now).map(([user]) => user));
      if (gone.size === 0) {
        continue;
      }
      for (const user of gone) {
        present.delete(user);
      }
      if (present.size === 0) {
        this.present.delete(key);
      }
      const split = key.indexOf(":");
      this.tell(key.slice(0, split), key.slice(split + 1), gone);
    }
  }

  /** Send the users on a record to the streams of its other users. */
  private tell(entity: string, id: string, changed: ReadonlySet<string>): void {
    const users = this.users(entity, id);
    const others = new Set(users.map((user) => user.id).filter((user) => !changed.has(user)));
    for (const subscription of this.subscriptions) {
      const viewer = subscription.viewer;
      if (viewer.user !== null && others.has(viewer.user) && viewer.entities.has(entity)) {
        subscription.show(entity, id, users);
      }
    }
  }
{% endif %}

  /** Return a new subscription of a client. */
  subscribe(viewer: Viewer): Subscription {
    this.start();
    const subscription = new Subscription(viewer);
    this.subscriptions.add(subscription);
    if (this.ended) {
      subscription.end();
    }
    return subscription;
  }

  /** Remove the subscription of a client that left. */
  unsubscribe(subscription: Subscription): void {
    this.subscriptions.delete(subscription);
  }

  /** End the open streams and the new ones, so that the server can stop. */
  endStreams(): void {
    this.ended = true;
    for (const subscription of this.subscriptions) {
      subscription.end();
    }
  }

  /**
   * Close the connections of Redis at once. A command that waits for a
   * connection, for example the subscription to the channel, fails.
   */
  async close(): Promise<void> {
{% if presence %}
    clearInterval(this.sweeper);
    this.sweeper = undefined;
{% endif %}
    const publisher = await this.publisher;
    this.publisher = undefined;
    const subscriber = this.subscriber;
    this.subscriber = undefined;
    for (const client of [publisher, subscriber]) {
      if (client?.isOpen) {
        client.destroy();
      }
    }
  }

  /** Start the connections of Redis, if the broker has a URL and they do not run. */
  private start(): void {
    if (this.url === null || this.publisher !== undefined) {
      return;
    }
    // A change does not wait while the client connects again: it goes to the clients of the process.
    const publisher = redisClient(this.url, false);
    publisher.on("error", (error: unknown) => this.failed(error));
    this.publisher = this.connected(publisher);
    const subscriber = redisClient(this.url, true);
    subscriber.on("error", (error: unknown) => this.failed(error));
    subscriber.on("ready", () => this.back());
    this.subscriber = subscriber;
    void subscriber.connect().catch((error: unknown) => this.failed(error));
    void subscriber
      .subscribe(CHANNEL, (message) => this.deliver([JSON.parse(message) as Message]))
      .catch((error: unknown) => this.failed(error));
  }

  /** Return the client after its first connection, or after CONNECT_TIMEOUT_MS without one. */
  private async connected(client: RedisClient): Promise<RedisClient | undefined> {
    const connection = client.connect().then(
      () => client,
      (error: unknown) => {
        this.failed(error);
        return client;
      },
    );
    let timer: ReturnType<typeof setTimeout> | undefined;
    const timeout = new Promise<RedisClient>((resolve) => {
      timer = setTimeout(() => resolve(client), CONNECT_TIMEOUT_MS);
    });
    try {
      return await Promise.race([connection, timeout]);
    } finally {
      clearTimeout(timer);
    }
  }

  /** Send a message to the channel. Without Redis, give it to the subscriptions of the process. */
  private async send(message: Message): Promise<void> {
    try {
      const publisher = await this.publisher;
      if (publisher !== undefined && this.available && publisher.isReady) {
        await publisher.publish(CHANNEL, JSON.stringify(message));
        return;
      }
      this.failed(new Error("The client of Redis is not connected."));
    } catch (error) {
      this.failed(error);
    }
    this.deliver([message]);
  }

  private failed(error: unknown): void {
    if (this.available) {
      this.available = false;
      console.warn(`The Redis of the live events is not available: ${messageOf(error)}`);
    }
  }

  /** The subscriber is connected again: the subscriptions can have missed the changes of the time without Redis. */
  private back(): void {
    if (!this.available) {
      this.available = true;
      for (const subscription of this.subscriptions) {
        subscription.reset();
      }
    }
  }
}

const globalForLive = globalThis as unknown as { appgenLive?: Broker };

/** Return the broker of the process. In development, it survives hot reloads. */
export function liveBroker(): Broker {
  globalForLive.appgenLive ??= new Broker(process.env.LIVE_EVENTS_URL || null);
  return globalForLive.appgenLive;
}
{% if presence %}

/**
 * Note the signed-in user on the page of a record, with its name, and
 * return the other users on the record (ADR 0052). The caller checks that
 * the user may read the record.
 */
export async function notePresence(entity: string, id: string, user: string, typing: boolean): Promise<PresentUser[]> {
  const [row] = await getDb()
    .select({ name: {{ users.const }}.{{ history_user_key(definition) }} })
    .from({{ users.const }})
    .where(eq({{ users.const }}.id, user))
    .limit(1);
  return liveBroker().here(entity, id, user, String(row?.name ?? ""), typing);
}
{% endif %}
{% if scoped %}

/**
 * Return who may read a record of a live entity now, as the transaction
 * has it (ADR 0025): the roles with a rule for the reads whose conditions
 * the record meets, and the users of the owner path, if a rule of these
 * roles has `owner`. Return undefined without a record rule for the reads
 * of the entity.
 */
export async function liveAudience(tx: Database, entity: string, id: string): Promise<Audience | undefined> {
  const live = LIVE[entity];
  if (live?.rules === undefined || live.table === undefined) {
    return undefined;
  }
  let roles = Object.keys(live.rules);
  const keys = [...new Set(Object.values(live.rules).flatMap((rule) => Object.keys(rule.where ?? {})))];
  if (keys.length > 0) {
    const columns: Record<string, PgColumn> = getTableColumns(live.table);
    const fields = Object.fromEntries(keys.map((key) => [key, columns[key] as PgColumn]));
    const [row] = await tx.select(fields).from(live.table).where(eq(live.table.id, id)).limit(1);
    if (row === undefined) {
      return { roles: [], owners: [] };
    }
    const values = row as Record<string, unknown>;
    roles = roles.filter((role) =>
      Object.entries(live.rules?.[role]?.where ?? {}).every(([key, allowed]) =>
        allowed.includes(values[key] as RuleValue),
      ),
    );
  }
{% if owned %}
  const owned = live.ownerPath !== undefined && roles.some((role) => live.rules?.[role]?.owner === true);
  return { roles, owners: owned ? await pathUsers(tx, id, live.ownerPath ?? []) : [] };
{% else %}
  return { roles, owners: [] };
{% endif %}
}
{% endif %}

/** A change of a record in the open work{{ ", with the audiences before the first change and after the last" if scoped }}. */
type Noted = {
  entity: string;
  id: string;
  action: LiveAction;
{% if scoped %}
  /** The audience before the first change, or undefined for a new record. */
  before: Audience | undefined;
  /** The audience after the last change, or undefined for a deleted record. */
  after: Audience | undefined;
  /** True if a record rule limits the reads of the entity. */
  limited: boolean;
{% endif %}
};

/** The changes of the open work of `liveChanges()`. */
const pending = new AsyncLocalStorage<Noted[]>();

/**
 * Run the work of a change in a repository, and send the changes that it
 * notes after the commit of its transaction. In the work of another
 * change, for example an event (ADR 0031), the changes join the changes of
 * that work. An error of the work drops them.
 */
export async function liveChanges<T>(work: () => Promise<T>): Promise<T> {
  const outer = pending.getStore();
  const changes: Noted[] = [];
  const result = await pending.run(changes, work);
  if (outer !== undefined) {
    outer.push(...changes);
  } else if (changes.length > 0) {
    afterCommit(() => liveBroker().publish(merged(changes)));
  }
  return result;
}

{% if scoped %}
/**
 * Note a change of a record in the work of `liveChanges()`. `before` is the
 * audience of the record before the change (`liveAudience()`), or undefined
 * for a new record. The audience after the change comes from the transaction.
 */
export async function noteChange(
  tx: Database,
  entity: string,
  id: string,
  action: LiveAction,
  before?: Audience,
): Promise<void> {
  const changes = pending.getStore();
  if (changes === undefined || !Object.hasOwn(LIVE, entity)) {
    return;
  }
  const after = action === "deleted" ? undefined : await liveAudience(tx, entity, id);
  const limited = LIVE[entity]?.rules !== undefined;
  changes.push({ entity, id, action, before, after, limited });
}
{% else %}
/** Note a change of a record in the work of `liveChanges()`. */
export function noteChange(entity: string, id: string, action: LiveAction): void {
  if (Object.hasOwn(LIVE, entity)) {
    pending.getStore()?.push({ entity, id, action });
  }
}
{% endif %}

/**
 * Return one change for each record: the first action, or `deleted`, or
{% if scoped %}
 * nothing for a record that the work adds and deletes. A change has the
 * audiences before the first change and after the last.
{% else %}
 * nothing for a record that the work adds and deletes.
{% endif %}
 */
function merged(changes: Noted[]): Change[] {
  const byRecord = new Map<string, Noted>();
  for (const change of changes) {
    const key = `${change.entity}:${change.id}`;
    const last = byRecord.get(key);
    if (last === undefined) {
      byRecord.set(key, change);
    } else if (last.action === "created" && change.action === "deleted") {
      // A record of the work only: the clients never saw it.
      byRecord.delete(key);
    } else {
      const action = last.action === "created" ? "created" : change.action;
      byRecord.set(key, { ...change, action{{ ", before: last.before" if scoped }} });
    }
  }
{% if scoped %}
  return [...byRecord.values()].map(({ entity, id, action, before, after, limited }) => ({
    entity,
    id,
    action,
    audiences: limited ? [before, after].filter((audience) => audience !== undefined) : null,
  }));
{% else %}
  return [...byRecord.values()];
{% endif %}
}
