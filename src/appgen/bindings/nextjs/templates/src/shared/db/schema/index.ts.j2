{{ trace_header("app") }}
// The Drizzle schema: one module for each entity of the app definition.
{% for table in nextjs.tables %}
export * from "./{{ table.module }}"; {{ trace(table.element_id) }}
{% endfor %}
{% if definition.auth and definition.auth.password %}
export * from "./credentials"; {{ trace(definition.auth.id) }}
{% endif %}
{% if ts_connections %}
// The tokens of the users for the APIs (ADR 0033).
export * from "./api-connections";
{% for api in ts_connections %}
{{ trace(api.id) }}
{% endfor %}
{% endif %}
{% if nextjs.jobs %}
// The runs of the jobs (ADR 0029).
export * from "./job-runs";
{% endif %}
{% if ts_webhooks %}
export * from "./webhook-events";
{% for w in ts_webhooks.values() %}
{{ trace(w.id) }}
{% endfor %}
{% endif %}
{% if has_history(definition) %}
// The change log of the records (ADR 0040).
export * from "./history-entries";
{% for entity in definition.entities.values() if entity.history %}
{{ trace(entity.history.id) }}
{% endfor %}
{% endif %}
{% if has_notices(definition) %}
// The notices of the users (ADR 0041).
export * from "./notices";
{% endif %}
