{{ trace_header("app") }}
// The Drizzle schema: one module for each entity of the app definition.
{% for table in nextjs.tables %}
export * from "./{{ table.module }}"; {{ trace(table.element_id) }}
{% endfor %}
{% if definition.auth and definition.auth.password %}
export * from "./credentials"; {{ trace(definition.auth.id) }}
{% endif %}
{% if ts_webhooks %}
export * from "./webhook-events";
{% for w in ts_webhooks.values() %}
{{ trace(w.id) }}
{% endfor %}
{% endif %}
