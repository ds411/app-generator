import type { PgliteDatabase } from "drizzle-orm/pglite";
import { migrate as migratePglite } from "drizzle-orm/pglite/migrator";
import type { PostgresJsDatabase } from "drizzle-orm/postgres-js";
import { migrate as migratePostgres } from "drizzle-orm/postgres-js/migrator";

import { getDb, usesPglite } from "./client";
import type * as schema from "./schema";

/** Apply the migrations in `drizzle/` (from `pnpm db:generate`) to the database. */
export async function migrateDatabase(): Promise<void> {
  const config = { migrationsFolder: "drizzle" };
  if (usesPglite()) {
    await migratePglite(getDb() as PgliteDatabase<typeof schema>, config);
  } else {
    await migratePostgres(getDb() as PostgresJsDatabase<typeof schema>, config);
  }
}
