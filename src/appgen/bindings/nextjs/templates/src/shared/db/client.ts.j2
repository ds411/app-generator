{{ trace_header("app") }}
import "server-only";

{% set ambient = nextjs.jobs or nextjs.events or lines_ops %}
{% set transactions = nextjs.jobs or lines_ops %}
{% if ambient %}
import { AsyncLocalStorage } from "node:async_hooks";

{% endif %}
import { connect, type Database{{ ", usesPglite" if ambient and ts_connections }} } from "./connect";

export { type Database, usesPglite } from "./connect";

const globalForDb = globalThis as unknown as { appgenDb?: Database };
{% if ambient %}

/** The transaction of {{ "the work in `inTransaction()`" if transactions }}{{ " and of " if transactions and nextjs.events }}{{ "the operation of an event" if nextjs.events }}. */
const ambient = new AsyncLocalStorage<Database>();
{% endif %}
{% if nextjs.events %}

/** True in the operation of an event (ADR 0031). */
const inEvent = new AsyncLocalStorage<true>();
{% endif %}

/**
 * Return the database client. It connects on the first call, so that
 * `next build` needs no database. In development, the client survives
 * hot reloads.{% if transactions %} In the work of `inTransaction()`, it returns the
 * transaction.{% endif %}{% if nextjs.events %} In the operation of an event, it returns the
 * transaction of the change.{% endif %}

 */
export function getDb(): Database {
{% if ambient %}
  const transaction = ambient.getStore();
  if (transaction) {
    return transaction;
  }
{% endif %}
  if (!globalForDb.appgenDb) {
    const url = process.env.DATABASE_URL;
    if (!url) {
      throw new Error(
        "Set DATABASE_URL to the connection URL of the Postgres database, or to pglite:<folder>.",
      );
    }
    globalForDb.appgenDb = connect(url);
  }
  return globalForDb.appgenDb;
}
{% if ts_connections %}

{% if ambient %}
/**
 * Return the database client outside the transaction of {{ "the work in `inTransaction()`" if transactions }}{{ " and of " if transactions and nextjs.events }}{{ "the operation of an event" if nextjs.events }}.
 * A write in it stays after an error of the work: for example a new
 * token of a user (ADR 0033). PGlite has one connection, so with PGlite
 * it returns the transaction.
 */
export function ownDb(): Database {
  return usesPglite() ? getDb() : ambient.exit(getDb);
}
{% else %}
/**
 * Return the database client for a write that must stay after an error of
 * the work, for example a new token of a user (ADR 0033). The app has no
 * transaction around the work, so it is `getDb()`.
 */
export function ownDb(): Database {
  return getDb();
}
{% endif %}
{% endif %}
{% if transactions %}

/**
 * Run work in one transaction, for example {{ "a run of a job (ADR 0029)" if nextjs.jobs else "an operation with lines (ADR 0035)" }}. In
 * the work, `getDb()` returns the transaction, so the repositories write
 * in it too: a transaction of a repository becomes a savepoint. An error
 * rolls back all the writes of the work.
 */
{% if nextjs.total_rules %}
export async function inTransaction<T>(work: () => Promise<T>): Promise<T> {
  return getDb().transaction((transaction) =>
    ambient.run(transaction, async () => {
      const pending: Check[] = [];
      const result = await checks.run(pending, work);
      for (const check of pending) {
        await check();
      }
      return result;
    }),
  );
}

/** A check of a change that runs at the end of the work of `inTransaction()`. */
type Check = () => Promise<void>;

/** The checks of the work of `inTransaction()`. */
const checks = new AsyncLocalStorage<Check[]>();

/**
 * Run a check of a change at the end of the work of `inTransaction()`, in
 * its transaction, for example the compare rules with totals after the
 * lines of an operation (ADR 0034). Outside the work, the check runs now,
 * in the transaction `db` of the change.
 */
export async function checkAtEnd(db: Database, check: (db: Database) => Promise<void>): Promise<void> {
  const pending = checks.getStore();
  if (pending === undefined) {
    await check(db);
    return;
  }
  pending.push(() => check(getDb()));
}
{% else %}
export async function inTransaction<T>(work: () => Promise<T>): Promise<T> {
  return getDb().transaction((transaction) => ambient.run(transaction, work));
}
{% endif %}
{% endif %}
{% if nextjs.events %}

/**
 * Run the operation of an event (ADR 0031) in the transaction of a change.
 * In the operation, `getDb()` returns the transaction, so the repositories
 * write in it, and an error rolls back the change. A change in the
 * operation starts no event: the events stop after one level. Return
 * false if the operation does not run, because the change is in the
 * operation of an event.
 */
export async function runEvent(transaction: Database, operation: () => Promise<void>): Promise<boolean> {
  if (inEvent.getStore()) {
    return false;
  }
  await inEvent.run(true, () => ambient.run(transaction, operation));
  return true;
}
{% endif %}
