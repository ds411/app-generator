import "server-only";

import { connect, type Database } from "./connect";

export { type Database, usesPglite } from "./connect";

const globalForDb = globalThis as unknown as { appgenDb?: Database };

/**
 * Return the database client. It connects on the first call, so that
 * `next build` needs no database. In development, the client survives
 * hot reloads.
 */
export function getDb(): Database {
  if (!globalForDb.appgenDb) {
    const url = process.env.DATABASE_URL;
    if (!url) {
      throw new Error(
        "Set DATABASE_URL to the connection URL of the Postgres database, or to pglite:<folder>.",
      );
    }
    globalForDb.appgenDb = connect(url);
  }
  return globalForDb.appgenDb;
}
