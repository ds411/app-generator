{% set w = ts_webhooks[name] %}
{{ trace_header(element_id) }}
/*
 * The event of the webhook `{{ w.name }}`: the types of the schema of the
 * body, with the keys of the JSON body. The endpoint checks each event
 * with the zod schemas.
 */
import { z } from "zod";
{% for type in w.types %}

{% if type.description %}
/** {{ type.description }} */
{% endif %}
{% if type.properties is none %}
export type {{ type.name }} = {{ type.alias }};
{% else %}
export interface {{ type.name }} {
{% for p in type.properties %}
{% if p.description %}
  /** {{ p.description }} */
{% endif %}
  {{ p.line() }}
{% endfor %}
}
{% endif %}
{% endfor %}
{% for schema in w.schemas %}

{% if schema.keys is none %}
export const {{ schema.name }}: z.ZodType = {{ schema.expression }};
{% elif schema.keys %}
export const {{ schema.name }}: z.ZodType = z.object({
{% for key in schema.keys %}
  {{ key }},
{% endfor %}
});
{% else %}
export const {{ schema.name }}: z.ZodType = z.object({});
{% endif %}
{% endfor %}
