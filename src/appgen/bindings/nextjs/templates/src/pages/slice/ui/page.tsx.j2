{% set info = nextjs.pages[name] %}
{{ trace_header(element_id) }}
{% if nextjs.mode_toggle %}
import { ModeToggle } from "@/features/toggle-theme";

{% endif %}
{% if info.params %}
export type {{ info.component }}Props = {
  params: { {% for param in info.params %}{{ param }}: string{{ "; " if not loop.last }}{% endfor %} };
};

export function {{ info.component }}({ params }: {{ info.component }}Props) {
{% else %}
export function {{ info.component }}() {
{% endif %}
  return (
    <main className="mx-auto flex max-w-5xl flex-col gap-2 p-6">
      <header className="flex items-center justify-between gap-4">
        <h1 className="text-2xl font-semibold tracking-tight">{{ element.title }}</h1>
{% if nextjs.mode_toggle %}
        <ModeToggle />
{% endif %}
      </header>
{% if element.description %}
      <p className="text-muted-foreground">{{ element.description }}</p>
{% endif %}
{% for param in info.params %}
      <p className="text-sm text-muted-foreground">{{ param }}: {params.{{ param }}}</p>
{% endfor %}
    </main>
  );
}
