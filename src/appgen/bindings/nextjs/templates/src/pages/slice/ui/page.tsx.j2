{% set info = nextjs.pages[name] %}
{% set custom = element.content is not none and element.content.custom %}
{% set view = element.content.view if element.content is not none and element.content.view in ui_views.list_views else none %}
{% set detail = element.content.view if info.params and element.content is not none and element.content.view in ui_views.detail_views else none %}
{% set dashboard = element.content.dashboard if element.content is not none and element.content.dashboard else none %}
{% set id_param = info.params[-1] if detail else none %}
{{ trace_header(element_id) }}
"use client";

{% if info.params and not view and not dashboard %}
import { useParams } from "@/shared/lib/router";
{% endif %}
{% if dashboard %}
import { {{ dashboard | pascal }}Dashboard } from "@/widgets/{{ dashboard | kebab }}";
{% endif %}
import { PageHeader } from "@/widgets/page-header";
{% if view or detail %}
import { {{ (view or detail) | pascal }}View } from "@/widgets/{{ (view or detail) | kebab }}";
{% endif %}
{% if custom %}

import { {{ name | pascal }}Content } from "./{{ info.slice }}-content.gen";
{% endif %}

export function {{ info.component }}() {
{% if custom and element.entity %}
  const params = useParams();
{% elif detail %}
  const { {{ id_param }} } = useParams();
{% elif info.params and not view and not dashboard %}
  const { {% for param in info.params %}{{ param }}{% if param != param | camel %}: {{ param | camel }}{% endif %}{{ ", " if not loop.last }}{% endfor %} } = useParams();
{% endif %}
  return (
    <>
      <PageHeader
        title={{ jsx_attr(element.title) }}
{% if element.description %}
        description={{ jsx_attr(element.description) }}
{% endif %}
      />
{% if custom %}
      <{{ name | pascal }}Content{% if element.entity %} params={params}{% endif %} />
{% elif view %}
      <{{ view | pascal }}View /> {{ trace(element.content.id, jsx=True) }}
{% elif detail %}
      <{{ detail | pascal }}View id={ {{- id_param }} ?? ""} /> {{ trace(element.content.id, jsx=True) }}
{% elif dashboard %}
      <{{ dashboard | pascal }}Dashboard /> {{ trace(element.content.id, jsx=True) }}
{% else %}
{% for param in info.params %}
      <p>{{ param }}: {{ "{" }}{{ param | camel }}{{ "}" }}</p>
{% endfor %}
{% endif %}
    </>
  );
}
