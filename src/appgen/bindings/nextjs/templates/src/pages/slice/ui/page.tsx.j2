{% set info = nextjs.pages[name] %}
{% set custom = element.content is not none and element.content.custom %}
{{ trace_header(element_id) }}
"use client";

{% if info.params %}
import { useParams } from "@/shared/lib/router";
{% endif %}
import { PageHeader } from "@/widgets/page-header";
{% if custom %}

import { {{ name | pascal }}Content } from "./{{ info.slice }}-content.gen";
{% endif %}

export function {{ info.component }}() {
{% if custom and element.entity %}
  const params = useParams();
{% elif info.params %}
  const { {% for param in info.params %}{{ param }}{% if param != param | camel %}: {{ param | camel }}{% endif %}{{ ", " if not loop.last }}{% endfor %} } = useParams();
{% endif %}
  return (
    <>
      <PageHeader
        title={{ jsx_attr(element.title) }}
{% if element.description %}
        description={{ jsx_attr(element.description) }}
{% endif %}
      />
{% if custom %}
      <{{ name | pascal }}Content{% if element.entity %} params={params}{% endif %} />
{% else %}
{% for param in info.params %}
      <p>{{ param }}: {{ "{" }}{{ param | camel }}{{ "}" }}</p>
{% endfor %}
{% endif %}
    </>
  );
}
