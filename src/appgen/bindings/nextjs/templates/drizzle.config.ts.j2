import { defineConfig } from "drizzle-kit";

// pnpm db:generate writes the SQL migrations of the schema into drizzle/.
// The migrations belong to the app: appgen does not write them.
// A DATABASE_URL that starts with pglite: selects the data folder of PGlite.
const url = process.env.DATABASE_URL ?? "postgres://postgres:postgres@localhost:5432/{{ app.name | snake }}";
const pglite = "pglite:";

export default url.startsWith(pglite)
  ? defineConfig({
      dialect: "postgresql",
      driver: "pglite",
      schema: "./src/shared/db/schema/index.ts",
      out: "./drizzle",
      dbCredentials: { url: url.slice(pglite.length) },
    })
  : defineConfig({
      dialect: "postgresql",
      schema: "./src/shared/db/schema/index.ts",
      out: "./drizzle",
      dbCredentials: { url },
    });
