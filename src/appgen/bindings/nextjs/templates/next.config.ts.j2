{{ trace_header("app") }}
import type { NextConfig } from "next";

/** The header that names the websites that can show a page in a frame. */
const FRAME_HEADER = "Content-Security-Policy";

const nextConfig: NextConfig = {
  // The Docker image builds the standalone server (see the Dockerfile).
  // `pnpm start` needs the default output.
  output: process.env.NEXT_OUTPUT === "standalone" ? "standalone" : undefined,
  // PGlite (the local database) loads its WebAssembly files from node_modules.
  serverExternalPackages: ["@electric-sql/pglite"],
{% if nextjs.upload_limit %}
  {{ trace(definition.storage.id) }}
  experimental: {
    // The upload of a file in a server action (ADR 0027): the largest file
    // of the file fields, and 1 MB for the rest of the form data.
    serverActions: { bodySizeLimit: {{ nextjs.upload_limit }} },
{% if nextjs.upload_limit > 10 * 1024 * 1024 %}
    // The proxy (proxy.ts) reads the bodies of the requests up to this size.
    proxyClientMaxBodySize: {{ nextjs.upload_limit }},
{% endif %}
  },
{% endif %}
  // Other websites cannot show the pages in a frame (clickjacking).
{% if nextjs.frame_headers %}
  // A page with `embed` allows the origins of the app definition (ADR 0032):
  // the last header of a path wins.
{% endif %}
  async headers() {
    return [
      { source: "/:path*", headers: [{ key: FRAME_HEADER, value: "frame-ancestors 'self'" }] },
{% for id, source, ancestors in nextjs.frame_headers %}
      {{ trace(id) }}
      { source: {{ js(source) }}, headers: [{ key: FRAME_HEADER, value: {{ js("frame-ancestors " ~ ancestors) }} }] },
{% endfor %}
    ];
  },
};

export default nextConfig;
