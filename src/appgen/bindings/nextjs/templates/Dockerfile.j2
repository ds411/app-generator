# syntax=docker/dockerfile:1
{{ trace_header("app") }}
# Build the app with pnpm as a standalone Next.js server, and run it as a
# non-root user on port 3000. Set DATABASE_URL, and DATABASE_MIGRATE=true
# to apply the migrations in drizzle/ when the server starts. The command
# `node migrate.mjs` applies the migrations and stops (the migration Job
# of deploy/). The build argument NODE_IMAGE selects another image, for
# example a mirror of the registry.

ARG NODE_IMAGE=node:{{ nextjs.node_version }}-alpine

FROM ${NODE_IMAGE} AS base
WORKDIR /app
RUN corepack enable

FROM base AS deps
COPY package.json pnpm-lock.yaml* pnpm-workspace.yaml ./
# A BuildKit cache keeps the pnpm store between builds, so a new build
# downloads only the packages that changed.
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --store-dir /pnpm/store

FROM base AS build
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1 NEXT_OUTPUT=standalone
# The migrations belong to the app (pnpm db:generate). Without them, the
# build writes the first migration from the schema.
RUN if [ ! -d drizzle ]; then pnpm db:generate; fi
RUN pnpm build && pnpm build:migrate

FROM ${NODE_IMAGE} AS run
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
COPY --from=build --chown=node:node /app/.next/standalone ./
COPY --from=build --chown=node:node /app/.next/static ./.next/static
COPY --from=build --chown=node:node /app/drizzle ./drizzle
COPY --from=build --chown=node:node /app/.next/migrate.mjs ./migrate.mjs
{% if definition.storage %}
# The folder of the files of the file fields: a volume keeps the files.
RUN install -d -o node -g node /app/uploads
{% endif %}
USER node
EXPOSE 3000
CMD ["node", "server.js"]
