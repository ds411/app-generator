{{ trace_header("app") }}
# Run the app with a Postgres database: docker compose up --build
# The app applies the migrations in drizzle/ when it starts, and fills
# the empty tables with the seed records.
{% if nextjs.redis %}
# With Redis for the rate limit of all replicas:
#   RATE_LIMIT_PER_MINUTE=1200 RATE_LIMIT_STORE_URL=redis://redis:6379/0 \
#     docker compose --profile redis up --build
{% endif %}
services:
  db:
    image: ${POSTGRES_IMAGE:-postgres:18-alpine}
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: {{ app.name | snake }}
    volumes:
      - db-data:/var/lib/postgresql
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres -d {{ app.name | snake }}"]
      interval: 2s
      timeout: 5s
      retries: 30

  app:
    build: .
    environment:
      DATABASE_URL: postgres://postgres:postgres@db:5432/{{ app.name | snake }}
      DATABASE_MIGRATE: "true"
      DATABASE_SEED: "true"
      # The requests of each client in each minute. A page view makes 10 to
      # 25 requests, so local runs have no limit (0) by default.
      RATE_LIMIT_PER_MINUTE: ${RATE_LIMIT_PER_MINUTE:-0}
{% if nextjs.redis %}
      RATE_LIMIT_STORE_URL: ${RATE_LIMIT_STORE_URL:-}
{% endif %}
{% if definition.auth %}
      # Set AUTH_SECRET in the shell or in .env: a long random text.
      AUTH_SECRET: ${AUTH_SECRET:?Set AUTH_SECRET}
{% if definition.auth.password %}
      SEED_PASSWORD: ${SEED_PASSWORD:-}
{% endif %}
{% if definition.auth.password_reset or definition.auth.providers or (definition.auth.sign_up and definition.auth.sign_up.verify_email) %}
      PUBLIC_URL: ${PUBLIC_URL:-http://localhost:3000}
{% endif %}
{% if nextjs.smtp %}
      # The SMTP server of the messages of the sign-in (see .env.example).
      SMTP_HOST: ${SMTP_HOST:-}
      SMTP_PORT: ${SMTP_PORT:-587}
      SMTP_USERNAME: ${SMTP_USERNAME:-}
      SMTP_PASSWORD: ${SMTP_PASSWORD:-}
      SMTP_FROM: ${SMTP_FROM:-}
      SMTP_TLS: ${SMTP_TLS:-starttls}
{% endif %}
{% for name, p in definition.auth.providers.items() %}
      {{ trace(p.id) }}
      {{ name | upper }}_ISSUER: ${{ "{" }}{{ name | upper }}_ISSUER:-{{ p.issuer }}{{ "}" }}
      {{ p.client_id_env }}: ${{ "{" }}{{ p.client_id_env }}:-{{ "}" }}
      {{ p.client_secret_env }}: ${{ "{" }}{{ p.client_secret_env }}:-{{ "}" }}
{% endfor %}
{% endif %}
{% for api in ts_apis.values() %}
      {{ trace(api.id) }}
      {{ api.url_env }}: ${{ "{" }}{{ api.url_env }}:-{{ api.base_url }}{{ "}" }}
{% if api.client_id_env %}
      {{ api.client_id_env }}: ${{ "{" }}{{ api.client_id_env }}:-{{ "}" }}
{% endif %}
{% if api.secret_env %}
      {{ api.secret_env }}: ${{ "{" }}{{ api.secret_env }}:-{{ "}" }}
{% endif %}
{% endfor %}
    ports:
      - "3000:3000"
    depends_on:
      db:
        condition: service_healthy
{% if nextjs.redis %}

  redis:
    image: ${REDIS_IMAGE:-redis:8-alpine}
    profiles: [redis]
{% endif %}

volumes:
  db-data:
