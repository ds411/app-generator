{{ trace_header("app") }}
# Run the app with a Postgres database: docker compose up --build
# The app applies the migrations in drizzle/ when it starts, and fills
# the empty tables with the seed records.
services:
  db:
    image: ${POSTGRES_IMAGE:-postgres:18-alpine}
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: {{ app.name | snake }}
    volumes:
      - db-data:/var/lib/postgresql
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres -d {{ app.name | snake }}"]
      interval: 2s
      timeout: 5s
      retries: 30

  app:
    build: .
    environment:
      DATABASE_URL: postgres://postgres:postgres@db:5432/{{ app.name | snake }}
      DATABASE_MIGRATE: "true"
      DATABASE_SEED: "true"
{% if definition.auth %}
      # Set AUTH_SECRET in the shell or in .env: a long random text.
      AUTH_SECRET: ${AUTH_SECRET:?Set AUTH_SECRET}
      SEED_PASSWORD: ${SEED_PASSWORD:-}
{% endif %}
    ports:
      - "3000:3000"
    depends_on:
      db:
        condition: service_healthy

volumes:
  db-data:
