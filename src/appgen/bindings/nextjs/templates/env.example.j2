{{ trace_header("app") }}
# Copy this file to .env.local and change the values.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/{{ app.name | snake }}
# For a local run without a Postgres server, use PGlite (an embedded
# Postgres) with its data in the folder .pglite:
# DATABASE_URL=pglite:./.pglite
# Set to true to apply the migrations in drizzle/ when the server starts.
DATABASE_MIGRATE=false
# Set to true to add the seed records when the server starts (after the
# migrations). `pnpm db:seed` does the same.
DATABASE_SEED=false
# The requests that each client can send in each minute (0: no limit).
RATE_LIMIT_PER_MINUTE=0
# The addresses at the end of X-Forwarded-For that your proxies add (1: an
# ingress or Cloud Run, 2: a load balancer of Google Cloud that adds its
# own address). The limit counts the requests of the first of them.
RATE_LIMIT_TRUSTED_HOPS=1
{% if nextjs.redis %}
# The Redis of the rate limit, for all processes. Empty: each process counts.
RATE_LIMIT_STORE_URL=
# true: give 503 when Redis is not available. false: let the requests through.
RATE_LIMIT_FAIL_CLOSED=false
{% endif %}
{% if nextjs.live %}
# The Redis of the live events (ADR 0051), so that each process sends the
# changes of all processes. Empty: each process sends its own changes.
LIVE_EVENTS_URL=
{% endif %}
{% if nextjs.jobs %}
# The secret of the routes of the jobs (/api/jobs/<job>): a scheduler sends
# it in the header `Authorization: Bearer <secret>`. Use a long random text.
JOBS_SECRET=
# A call of the route of a job runs the times of the last minutes (default 60).
JOBS_WINDOW_MINUTES=60
# true: the parameter `now` of the routes of the jobs sets the time of the
# call. Use it only for tests.
JOBS_FIXED_CLOCK=false
{% endif %}
{% if definition.auth %}
# The secret key of the sessions. Use a long random text, for example the
# output of `openssl rand -base64 32`.
AUTH_SECRET=
{% if definition.auth.password %}
# With a value, the seed gives each seed user this password. Use it only
# for local runs and tests.
SEED_PASSWORD=
{% endif %}
{% for name, p in definition.auth.providers.items() %}
{{ trace(p.id) }}
# The provider {{ name }} (OpenID Connect). Register the redirect URI
# PUBLIC_URL/auth/providers/{{ name }}/callback at the provider. For a test
# provider, change the issuer.
{{ name | upper }}_ISSUER={{ p.issuer }}
{{ p.client_id_env }}=
{{ p.client_secret_env }}=
{% endfor %}
{% endif %}
{% if ui_views.map_tiles %}
# The URL of the map tiles, with {z}, {x}, and {y}, and their attribution
# as HTML. The build reads them. Empty: the tiles of OpenStreetMap.
NEXT_PUBLIC_MAP_TILES=
NEXT_PUBLIC_MAP_ATTRIBUTION=
{% endif %}
{% for api in ts_apis.values() %}
{{ trace(api.id) }}
# The API {{ api.name }} ({{ api.title }}). Without a value, the app uses
# the server of the OpenAPI document.
{{ api.url_env }}={{ api.base_url }}
{% if api.client_id_env %}
{{ api.client_id_env }}=
{% endif %}
{% if api.secret_env %}
{{ api.secret_env }}=
{% endif %}
{% endfor %}
{% for w in ts_webhooks.values() %}
{{ trace(w.id) }}
# {{ w.secret_comment }}
{{ w.secret_env }}=
{% endfor %}
{% if definition.storage %}
{% set st = definition.storage %}
{{ trace(st.id) }}
# The folder of the files of the file fields.
{{ st.folder_env }}=uploads
{% if st.kind == "s3" %}
# The bucket of the files in an S3-compatible service. Empty: the folder.
{{ st.bucket_env }}=
{{ st.region_env }}=
# The URL of a service that is not Amazon S3, for example MinIO.
{{ st.endpoint_env }}=
# The keys of the bucket. Empty: the AWS configuration of the machine.
{{ st.access_key_env }}=
{{ st.secret_key_env }}=
{% endif %}
{% endif %}
{% set verify = definition.auth.sign_up.verify_email if definition.auth and definition.auth.sign_up else none %}
{% set links = definition.auth and (definition.auth.password_reset or verify) %}
{% set users = (["the links of the messages"] if links else []) + (["the sign-in with the providers"] if definition.auth and definition.auth.providers else []) + (["the connections to the APIs"] if ts_connections else []) + (["the links of the emails of the notices"] if has_notice_emails(definition) else []) %}
{% if users %}
{% set subject = users[0] if users | length == 1 else (users[:-1] | join(", ")) ~ ("," if users | length > 2 else "") ~ " and " ~ users[-1] %}
# The URL of the app for the browsers, for example https://app.example.com.
# {{ subject[0] | upper }}{{ subject[1:] }} {{ "uses" if users == ["the sign-in with the providers"] else "use" }} it.
PUBLIC_URL=http://localhost:3000
{% elif definition.pages.values() | selectattr("meta") | list %}
# The URL of the app for the browsers, for example https://app.example.com.
# The sitemap and the previews of the links use it. Empty: the host of the request.
PUBLIC_URL=
{% endif %}
{% if nextjs.smtp %}
# The SMTP server of the messages of the sign-in.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
# starttls, tls (TLS from the start, usually port 465), or none (a local test server).
SMTP_TLS=starttls
# development: without SMTP_HOST, the app writes the links of the messages to the log.
ENVIRONMENT=development
{% elif links %}
# development: the app writes the links of the messages to the log.
ENVIRONMENT=development
{% endif %}
