{{ trace_header("app") }}
# Copy this file to secret.env, and set the values. Do not commit secret.env.
DATABASE_URL=postgres://app:change-me@postgres.example.com:5432/{{ app.name | snake }}
{% if nextjs.redis %}
# The Redis of the rate limit, so that all replicas share one limit. Empty: each replica counts.
RATE_LIMIT_STORE_URL=redis://:change-me@redis.example.com:6379/0
{% endif %}
{% if definition.auth %}
# A long random text, for example the output of `openssl rand -base64 32`.
AUTH_SECRET=
{% for name, p in definition.auth.providers.items() %}
{{ trace(p.id) }}
# The client secret of the app at the provider {{ name }}.
{{ p.client_secret_env }}=
{% endfor %}
{% endif %}
{% for api in ts_apis.values() if api.secret_env %}
{{ trace(api.id) }}
{{ api.secret_env }}=
{% endfor %}
