{{ trace_header("app") }}
# Copy this file to secret.env, and set the values. Do not commit secret.env.
DATABASE_URL=postgres://app:change-me@postgres.example.com:5432/{{ app.name | snake }}
{% if nextjs.redis %}
# The Redis of the rate limit, so that all replicas share one limit. Empty: each replica counts.
RATE_LIMIT_STORE_URL=redis://:change-me@redis.example.com:6379/0
{% endif %}
{% if nextjs.live %}
# The Redis of the live events, so that each replica sends the changes of all replicas.
LIVE_EVENTS_URL=redis://:change-me@redis.example.com:6379/0
{% endif %}
{% if nextjs.jobs %}
# The secret of the routes of the jobs, for the CronJobs of jobs.yaml: a long random text.
JOBS_SECRET=
{% endif %}
{% if definition.auth %}
# A long random text, for example the output of `openssl rand -base64 32`.
AUTH_SECRET=
{% if nextjs.smtp %}
# The password at the SMTP server of the messages of the sign-in.
SMTP_PASSWORD=
{% endif %}
{% for name, p in definition.auth.providers.items() %}
{{ trace(p.id) }}
# The client secret of the app at the provider {{ name }}.
{{ p.client_secret_env }}=
{% endfor %}
{% endif %}
{% if definition.storage and definition.storage.kind == "s3" %}
{{ trace(definition.storage.id) }}
# The keys of the bucket. Empty: the role of the pod, for example IAM roles for service accounts.
{{ definition.storage.access_key_env }}=
{{ definition.storage.secret_key_env }}=
{% endif %}
{% for api in ts_apis.values() if api.secret_env %}
{{ trace(api.id) }}
{{ api.secret_env }}=
{% endfor %}
{% for w in ts_webhooks.values() %}
{{ trace(w.id) }}
# The secret of the signatures of the webhook {{ w.name }}.
{{ w.secret_env }}=
{% endfor %}
