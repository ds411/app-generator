{{ trace_header("app") }}
# The settings of the app that are not secret (see .env.example).
# A page view makes 10 to 25 requests: the page, the prefetches of its
# links, and the data of its views.
{% if nextjs.redis %}
# The limit of all replicas with RATE_LIMIT_STORE_URL (secret.env), else of each replica.
RATE_LIMIT_PER_MINUTE=1200
# true: give 503 when Redis is not available. false: let the requests through.
RATE_LIMIT_FAIL_CLOSED=false
{% else %}
# The limit of each replica: the app allows this number times the replicas.
RATE_LIMIT_PER_MINUTE=1200
{% endif %}
# The addresses at the end of X-Forwarded-For that the ingress and the load balancers add.
RATE_LIMIT_TRUSTED_HOPS=1
{% if definition.auth and (definition.auth.password_reset or definition.auth.providers or (definition.auth.sign_up and definition.auth.sign_up.verify_email)) %}
# The URL of the app for the browsers.
PUBLIC_URL=https://app.example.com
{% endif %}
{% if nextjs.smtp %}
# The SMTP server of the messages of the sign-in. SMTP_PASSWORD is in secret.env.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=no-reply@example.com
SMTP_FROM=no-reply@example.com
SMTP_TLS=starttls
{% endif %}
{% if definition.auth %}
{% for name, p in definition.auth.providers.items() %}
{{ trace(p.id) }}
{{ name | upper }}_ISSUER={{ p.issuer }}
{{ p.client_id_env }}=
{% endfor %}
{% endif %}
{% for api in ts_apis.values() %}
{{ trace(api.id) }}
{{ api.url_env }}={{ api.base_url }}
{% if api.client_id_env %}
{{ api.client_id_env }}=
{% endif %}
{% endfor %}
