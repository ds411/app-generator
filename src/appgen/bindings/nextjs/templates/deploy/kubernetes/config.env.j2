{{ trace_header("app") }}
# The settings of the app that are not secret (see .env.example).
# A page view makes 10 to 25 requests: the page, the prefetches of its
# links, and the data of its views.
{% if nextjs.redis %}
# The limit of all replicas with RATE_LIMIT_STORE_URL (secret.env), else of each replica.
RATE_LIMIT_PER_MINUTE=1200
# true: give 503 when Redis is not available. false: let the requests through.
RATE_LIMIT_FAIL_CLOSED=false
{% else %}
# The limit of each replica: the app allows this number times the replicas.
RATE_LIMIT_PER_MINUTE=1200
{% endif %}
# The addresses at the end of X-Forwarded-For that the ingress and the load balancers add.
RATE_LIMIT_TRUSTED_HOPS=1
{% if nextjs.jobs %}
# A call of the route of a job runs the times of the last minutes (jobs.yaml).
JOBS_WINDOW_MINUTES=60
{% endif %}
{% if definition.auth and (definition.auth.password_reset or definition.auth.providers or (definition.auth.sign_up and definition.auth.sign_up.verify_email) or ts_code_flows or has_notice_emails(definition)) %}
# The URL of the app for the browsers.
PUBLIC_URL=https://app.example.com
{% endif %}
{% if nextjs.smtp %}
# The SMTP server of the messages of the sign-in. SMTP_PASSWORD is in secret.env.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=no-reply@example.com
SMTP_FROM=no-reply@example.com
SMTP_TLS=starttls
{% endif %}
{% if definition.auth %}
{% for name, p in definition.auth.providers.items() %}
{{ trace(p.id) }}
{{ name | upper }}_ISSUER={{ p.issuer }}
{{ p.client_id_env }}=
{% endfor %}
{% endif %}
{% if definition.storage %}
{% set st = definition.storage %}
{{ trace(st.id) }}
{% if st.kind == "s3" %}
# The bucket of the files of the file fields. Its keys are in secret.env.
{{ st.bucket_env }}={{ app.name }}-files
{{ st.region_env }}=eu-central-1
# The URL of a service that is not Amazon S3. Empty: Amazon S3.
{{ st.endpoint_env }}=
{% else %}
# The folder of the files of the file fields: the volume of all replicas (files-volume.yaml).
{{ st.folder_env }}=/app/uploads
{% endif %}
{% endif %}
{% for api in ts_apis.values() %}
{{ trace(api.id) }}
{{ api.url_env }}={{ api.base_url }}
{% if api.client_id_env %}
{{ api.client_id_env }}=
{% endif %}
{% endfor %}
