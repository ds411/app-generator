{% set name = app.name ~ "-web" %}
{{ trace_header("app") }}
# A Knative Service of the app. Google Cloud Run accepts the same file.
# Run the migrations first (README.md, section "Production"), then:
#   kubectl apply -f deploy/knative/service.yaml               (Knative)
#   gcloud run services replace deploy/knative/service.yaml    (Cloud Run)
# The file uses only the fields of Knative that Cloud Run supports, so it
# has no envFrom and no securityContext. The Dockerfile sets a non-root
# user.
apiVersion: serving.knative.dev/v1
kind: Service
metadata:
  name: {{ name }}
spec:
  template:
    metadata:
      annotations:
        # 0 instances when there are no requests. The first request then
        # waits for an instance to start. Each instance has its own pool of
        # database connections: maxScale times the pool must stay below
        # the connection limit of the database.
        autoscaling.knative.dev/minScale: "0"
        autoscaling.knative.dev/maxScale: "10"
    spec:
      containerConcurrency: 80
      timeoutSeconds: 60
      containers:
        - name: web
          # Set the registry and the tag of the image that you push.
          image: registry.example.com/{{ name }}:0.1.0
          ports:
            - name: http1
              containerPort: 3000
          env:
            # The server listens on the address of HOSTNAME: all addresses.
            - name: HOSTNAME
              value: 0.0.0.0
            # The settings that are not secret (see .env.example). A page view
            # makes 10 to 25 requests: the page, the prefetches of its links,
            # and the data of its views.
{% if nextjs.redis %}
            # The limit of all instances with RATE_LIMIT_STORE_URL, else of each instance.
            - name: RATE_LIMIT_PER_MINUTE
              value: "1200"
            # true: give 503 when Redis is not available. false: let the requests through.
            - name: RATE_LIMIT_FAIL_CLOSED
              value: "false"
{% else %}
            # The limit of each instance: the app allows this number times the instances.
            - name: RATE_LIMIT_PER_MINUTE
              value: "1200"
{% endif %}
            # Cloud Run adds the address of the client to the end of X-Forwarded-For.
            - name: RATE_LIMIT_TRUSTED_HOPS
              value: "1"
{% if nextjs.jobs %}
            # A call of the route of a job runs the times of the last minutes.
            - name: JOBS_WINDOW_MINUTES
              value: "60"
{% endif %}
{% if definition.auth and (definition.auth.password_reset or definition.auth.providers or (definition.auth.sign_up and definition.auth.sign_up.verify_email) or ts_connections or has_notice_emails(definition)) %}
            # The URL of the app for the browsers.
            - name: PUBLIC_URL
              value: https://app.example.com
{% endif %}
{% if nextjs.smtp %}
            # The SMTP server of the messages of the sign-in.
            - name: SMTP_HOST
              value: smtp.example.com
            - name: SMTP_PORT
              value: "587"
            - name: SMTP_USERNAME
              value: no-reply@example.com
            - name: SMTP_FROM
              value: no-reply@example.com
            - name: SMTP_TLS
              value: starttls
{% endif %}
{% if definition.auth %}
{% for provider, p in definition.auth.providers.items() %}
            {{ trace(p.id) }}
            - name: {{ provider | upper }}_ISSUER
              value: {{ p.issuer | tojson }}
            - name: {{ p.client_id_env }}
              value: ""
{% endfor %}
{% endif %}
{% for api in ts_apis.values() %}
            {{ trace(api.id) }}
            - name: {{ api.url_env }}
              value: {{ api.base_url | tojson }}
{% if api.client_id_env %}
            - name: {{ api.client_id_env }}
              value: ""
{% endif %}
{% endfor %}
{% if definition.storage %}
{% set st = definition.storage %}
            {{ trace(st.id) }}
{% if st.kind == "s3" %}
            # The bucket of the files of the file fields.
            - name: {{ st.bucket_env }}
              value: {{ app.name }}-files
            - name: {{ st.region_env }}
              value: eu-central-1
            # The URL of a service that is not Amazon S3. Empty: Amazon S3.
            - name: {{ st.endpoint_env }}
              value: ""
{% else %}
            # The folder of the files of the file fields. The instances do not
            # share it, and a new instance starts without the files: use the
            # storage kind s3 for more than one instance.
            - name: {{ st.folder_env }}
              value: /app/uploads
{% endif %}
{% endif %}
            # The secrets. In Cloud Run, `name` is a secret of Secret Manager
            # and `key` its version. In Knative, `name` is a Kubernetes Secret
            # and `key` the key of the value in it.
            - name: DATABASE_URL
              valueFrom:
                secretKeyRef:
                  name: {{ name }}-database-url
                  key: latest
{% if nextjs.jobs %}
            # The secret of the routes of the jobs (jobs.yaml, or Cloud Scheduler).
            - name: JOBS_SECRET
              valueFrom:
                secretKeyRef:
                  name: {{ name }}-jobs-secret
                  key: latest
{% endif %}
{% if nextjs.redis %}
            - name: RATE_LIMIT_STORE_URL
              valueFrom:
                secretKeyRef:
                  name: {{ name }}-rate-limit-store-url
                  key: latest
{% endif %}
{% if nextjs.live %}
            - name: LIVE_EVENTS_URL
              valueFrom:
                secretKeyRef:
                  name: {{ name }}-live-events-url
                  key: latest
{% endif %}
{% if definition.auth %}
            - name: AUTH_SECRET
              valueFrom:
                secretKeyRef:
                  name: {{ name }}-auth-secret
                  key: latest
{% if nextjs.smtp %}
            - name: SMTP_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: {{ name }}-smtp-password
                  key: latest
{% endif %}
{% for p in definition.auth.providers.values() %}
            {{ trace(p.id) }}
            - name: {{ p.client_secret_env }}
              valueFrom:
                secretKeyRef:
                  name: {{ name }}-{{ p.client_secret_env | lower | replace("_", "-") }}
                  key: latest
{% endfor %}
{% endif %}
{% if definition.storage and definition.storage.kind == "s3" %}
            {{ trace(definition.storage.id) }}
{% for env in (definition.storage.access_key_env, definition.storage.secret_key_env) %}
            - name: {{ env }}
              valueFrom:
                secretKeyRef:
                  name: {{ name }}-{{ env | lower | replace("_", "-") }}
                  key: latest
{% endfor %}
{% endif %}
{% for api in ts_apis.values() if api.secret_env %}
            {{ trace(api.id) }}
            - name: {{ api.secret_env }}
              valueFrom:
                secretKeyRef:
                  name: {{ name }}-{{ api.secret_env | lower | replace("_", "-") }}
                  key: latest
{% endfor %}
{% for w in ts_webhooks.values() %}
            {{ trace(w.id) }}
            - name: {{ w.secret_env }}
              valueFrom:
                secretKeyRef:
                  name: {{ name }}-{{ w.secret_env | lower | replace("_", "-") }}
                  key: latest
{% endfor %}
          resources:
            limits:
              cpu: "1"
              memory: 512Mi
          # /health checks the database too, so a new instance gets requests
          # only when it reaches the database (at most 60 s to start). The
          # liveness probe restarts an instance after 3 failed checks (90 s).
          startupProbe:
            httpGet:
              path: /health
            periodSeconds: 2
            failureThreshold: 30
          livenessProbe:
            httpGet:
              path: /health
            periodSeconds: 30
            timeoutSeconds: 5
            failureThreshold: 3
