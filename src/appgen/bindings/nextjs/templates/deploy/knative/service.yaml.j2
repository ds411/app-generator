{% set name = app.name ~ "-web" %}
{{ trace_header("app") }}
# A Knative Service of the app. Google Cloud Run accepts the same file.
# Run the migrations first (README.md, section "Production"), then:
#   kubectl apply -f deploy/knative/service.yaml               (Knative)
#   gcloud run services replace deploy/knative/service.yaml    (Cloud Run)
# The file uses only the fields of Knative that Cloud Run supports, so it
# has no envFrom and no securityContext. The Dockerfile sets a non-root
# user.
apiVersion: serving.knative.dev/v1
kind: Service
metadata:
  name: {{ name }}
spec:
  template:
    metadata:
      annotations:
        # 0 instances when there are no requests. The first request then
        # waits for an instance to start. Each instance has its own pool of
        # database connections: maxScale times the pool must stay below
        # the connection limit of the database.
        autoscaling.knative.dev/minScale: "0"
        autoscaling.knative.dev/maxScale: "10"
    spec:
      containerConcurrency: 80
      timeoutSeconds: 60
      containers:
        - name: web
          # Set the registry and the tag of the image that you push.
          image: registry.example.com/{{ name }}:0.1.0
          ports:
            - name: http1
              containerPort: 3000
          env:
            # The server listens on the address of HOSTNAME: all addresses.
            - name: HOSTNAME
              value: 0.0.0.0
            # The settings that are not secret (see .env.example). A page view
            # makes 10 to 25 requests: the page, the prefetches of its links,
            # and the data of its views.
{% if nextjs.redis %}
            # The limit of all instances with RATE_LIMIT_STORE_URL, else of each instance.
            - name: RATE_LIMIT_PER_MINUTE
              value: "1200"
            # true: give 503 when Redis is not available. false: let the requests through.
            - name: RATE_LIMIT_FAIL_CLOSED
              value: "false"
{% else %}
            # The limit of each instance: the app allows this number times the instances.
            - name: RATE_LIMIT_PER_MINUTE
              value: "1200"
{% endif %}
            # Cloud Run adds the address of the client to the end of X-Forwarded-For.
            - name: RATE_LIMIT_TRUSTED_HOPS
              value: "1"
{% if definition.auth and (definition.auth.password_reset or definition.auth.providers) %}
            # The URL of the app for the browsers.
            - name: PUBLIC_URL
              value: https://app.example.com
{% endif %}
{% if definition.auth %}
{% for provider, p in definition.auth.providers.items() %}
            {{ trace(p.id) }}
            - name: {{ provider | upper }}_ISSUER
              value: {{ p.issuer | tojson }}
            - name: {{ p.client_id_env }}
              value: ""
{% endfor %}
{% endif %}
{% for api in ts_apis.values() %}
            {{ trace(api.id) }}
            - name: {{ api.url_env }}
              value: {{ api.base_url | tojson }}
{% if api.client_id_env %}
            - name: {{ api.client_id_env }}
              value: ""
{% endif %}
{% endfor %}
            # The secrets. In Cloud Run, `name` is a secret of Secret Manager
            # and `key` its version. In Knative, `name` is a Kubernetes Secret
            # and `key` the key of the value in it.
            - name: DATABASE_URL
              valueFrom:
                secretKeyRef:
                  name: {{ name }}-database-url
                  key: latest
{% if nextjs.redis %}
            - name: RATE_LIMIT_STORE_URL
              valueFrom:
                secretKeyRef:
                  name: {{ name }}-rate-limit-store-url
                  key: latest
{% endif %}
{% if definition.auth %}
            - name: AUTH_SECRET
              valueFrom:
                secretKeyRef:
                  name: {{ name }}-auth-secret
                  key: latest
{% for p in definition.auth.providers.values() %}
            {{ trace(p.id) }}
            - name: {{ p.client_secret_env }}
              valueFrom:
                secretKeyRef:
                  name: {{ name }}-{{ p.client_secret_env | lower | replace("_", "-") }}
                  key: latest
{% endfor %}
{% endif %}
{% for api in ts_apis.values() if api.secret_env %}
            {{ trace(api.id) }}
            - name: {{ api.secret_env }}
              valueFrom:
                secretKeyRef:
                  name: {{ name }}-{{ api.secret_env | lower | replace("_", "-") }}
                  key: latest
{% endfor %}
          resources:
            limits:
              cpu: "1"
              memory: 512Mi
          # /health checks the database too, so a new instance gets requests
          # only when it reaches the database (at most 60 s to start). The
          # liveness probe restarts an instance after 3 failed checks (90 s).
          startupProbe:
            httpGet:
              path: /health
            periodSeconds: 2
            failureThreshold: 30
          livenessProbe:
            httpGet:
              path: /health
            periodSeconds: 30
            timeoutSeconds: 5
            failureThreshold: 3
