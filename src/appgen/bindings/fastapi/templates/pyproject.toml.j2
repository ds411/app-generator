{{ trace_header("app") }}

[project]
name = {{ app.name | tojson }}
version = "0.1.0"
description = {{ (app.description or app.title) | tojson }}
requires-python = ">=3.14"
dependencies = [
    "aiosqlite>=0.22",
    "alembic>=1.20",
    "asyncpg>=0.32",
{% if py.storage and py.storage.s3 %}
    "boto3>=1.43",
{% endif %}
{% if py_connections %}
    "cryptography>=46",
{% endif %}
    "fastapi[standard]>=0.161,<0.162",
{% if py_apis or py.providers %}
    "httpx>=0.28",
{% endif %}
    "pydantic-settings>=2.16",
{% if py.providers %}
    "pyjwt[crypto]>=2.15",
{% endif %}
{% if py.redis %}
    "redis>=8.0",
{% endif %}
    "sqlalchemy[asyncio]>=2.1",
]

[dependency-groups]
dev = [
    "httpx>=0.28",
{% if py.storage and py.storage.s3 %}
    "moto[s3]>=5.2",
{% endif %}
    "pyright>=1.1.414",
    "pytest>=9.1",
    "ruff>=0.17",
    "testcontainers[postgres]>=4.14",
{% if py.storage and py.storage.s3 %}
    "types-boto3-lite[s3]>=1.43",
{% endif %}
]

[tool.uv]
package = false

[tool.ruff]
line-length = 100
target-version = "py314"

[tool.ruff.lint]
select = ["E", "W", "F", "I", "B", "UP", "SIM", "RUF"]
# The formatter keeps the code lines short. Trace comments can be longer.
ignore = ["E501"]
{% if i18n %}

[tool.ruff.lint.per-file-ignores]
# The translations can have any character, also one that looks like another.
"app/core/i18n.py" = ["RUF001"]
{% endif %}

[tool.pyright]
include = ["app", "tests"]
pythonVersion = "3.14"
typeCheckingMode = "strict"

[tool.pytest.ini_options]
testpaths = ["tests"]
pythonpath = ["."]
addopts = ["--strict-markers", "--strict-config"]
{% if py.events %}
markers = [
    "events(*entities): run the events of the entities, or of all entities (ADR 0031)",
]
{% endif %}
