"""The Alembic environment: it runs the migrations with the async engine of the app."""

import asyncio
from logging.config import fileConfig
from typing import Literal

from alembic import context
{% if py.full_text %}
from alembic.autogenerate import Rewriter, render_op_text, renderers
{% endif %}
from alembic.autogenerate.api import AutogenContext
{% if py.full_text %}
from alembic.migration import MigrationContext
from alembic.operations import ops
{% endif %}
from sqlalchemy import pool
from sqlalchemy.dialects.postgresql import JSONB
from sqlalchemy.engine import Connection
from sqlalchemy.ext.asyncio import async_engine_from_config

from app.core.config import Settings
from app.core.db import Base
from app.models import configure_models

config = context.config
if config.config_file_name is not None and config.attributes.get("configure_logger", True):
    fileConfig(config.config_file_name)
if not config.get_main_option("sqlalchemy.url"):
    config.set_main_option("sqlalchemy.url", Settings().database_url.replace("%", "%%"))

configure_models()
target_metadata = Base.metadata
{% if py.full_text %}


class PostgresOnly(ops.MigrateOperation):
    """An operation of a new migration that runs only on Postgres: a GIN index of the search."""

    def __init__(self, operation: ops.MigrateOperation) -> None:
        self.operation = operation


def _render_postgres_only(context: AutogenContext, op: PostgresOnly) -> list[str]:
    """Write the operation under a test of the dialect, so that the migration runs on SQLite."""
    body = render_op_text(context, op.operation).splitlines()
    return ['if op.get_bind().dialect.name == "postgresql":', *body, ""]


def _postgres_only(
    context: MigrationContext, revision: object, op: ops.CreateIndexOp | ops.DropIndexOp
) -> ops.MigrateOperation:
    """Keep a GIN index of the full-text search out of the migrations of other databases."""
    return PostgresOnly(op) if op.kw.get("postgresql_using") == "gin" else op


renderers.dispatch_for(PostgresOnly)(_render_postgres_only)
# `alembic revision --autogenerate` on Postgres writes a new GIN index under a test of the
# dialect. On SQLite, Alembic does not compare the indexes of an expression.
rewriter = Rewriter()
rewriter.rewrites(ops.CreateIndexOp)(_postgres_only)
rewriter.rewrites(ops.DropIndexOp)(_postgres_only)
{% endif %}


def run_migrations_offline() -> None:
    """Write the SQL of the migrations, without a database connection."""
    context.configure(
        url=config.get_main_option("sqlalchemy.url"),
        target_metadata=target_metadata,
        literal_binds=True,
        dialect_opts={"paramstyle": "named"},
    )
    with context.begin_transaction():
        context.run_migrations()


def render_item(type_: str, obj: object, autogen_context: AutogenContext) -> str | Literal[False]:
    """Write the JSON type of Postgres as the first migration writes it.

    Alembic writes `postgresql.JSONB(astext_type=Text())`, without an import of `Text`.
    """
    if type_ == "type" and isinstance(obj, JSONB):
        autogen_context.imports.add("from sqlalchemy.dialects import postgresql")
        return "postgresql.JSONB()"
    return False


def do_run_migrations(connection: Connection) -> None:
    # SQLite cannot alter a table: batch mode copies the table for each change.
    context.configure(
        connection=connection,
        target_metadata=target_metadata,
        render_as_batch=connection.dialect.name == "sqlite",
        render_item=render_item,
{% if py.full_text %}
        process_revision_directives=rewriter,
{% endif %}
    )
    with context.begin_transaction():
        context.run_migrations()


async def run_async_migrations() -> None:
    engine = async_engine_from_config(
        config.get_section(config.config_ini_section, {}),
        prefix="sqlalchemy.",
        poolclass=pool.NullPool,
    )
    async with engine.connect() as connection:
        await connection.run_sync(do_run_migrations)
    await engine.dispose()


if context.is_offline_mode():
    run_migrations_offline()
else:
    asyncio.run(run_async_migrations())
