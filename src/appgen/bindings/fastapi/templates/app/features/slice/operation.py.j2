) -> Page[{{ e.name }}Read]:
    """{{ op.description or ("Return a page of the records of the entity " ~ e.name ~ ".") }}"""
    statement = select({{ e.name }})
{% for f in e.filters %}
    if query.{{ f.attr }} is not None:
        statement = statement.where({{ e.name }}.{{ f.attr }} == query.{{ f.attr }})
{% endfor %}
{% for r in e.fk_relations %}
    if query.{{ r.fk_attr }} is not None:
        statement = statement.where({{ e.name }}.{{ r.fk_attr }} == query.{{ r.fk_attr }})
{% endfor %}
    total = await session.scalar(select(func.count()).select_from(statement.subquery()))
    order = sort_order(query.sort, SORTABLE, {{ e.name }}.id)
    records = await session.scalars(
        statement.order_by(*order).limit(query.limit).offset(query.offset)
    )
    return Page[{{ e.name }}Read](
        items=[{{ e.name }}Read.model_validate(record) for record in records],
        total=total or 0,
        limit=query.limit,
        offset=query.offset,
    )
