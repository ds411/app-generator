    session: SessionDep,
    user: CurrentUser,
    ids: Annotated[list[UUID] | None, Query(max_length=1000)] = None,
) -> MemberPermissions:
    """Return the operations of the memberships of the user: in some scope, and on each record.

    `ids` gives the records. The operations that the role of the user gives
    are not part of the answer.
    """
    wanted = ids or []
