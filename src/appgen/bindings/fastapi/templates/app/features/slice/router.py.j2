{{ trace_header(element_id) }}
{% set e = py.entity(name) %}
"""The router of the slice `{{ e.slice }}`: the endpoints of the entity {{ e.name }}."""

{{ e.router_imports() }}

router = APIRouter(tags=[{{ e.plural_label | tojson }}])
{% if e.operations %}

{% for op in e.operations %}
{{ trace(op.id) }}
{% set dependencies = e.router_dependencies(op) %}
{% if dependencies %}
router.include_router({{ op.module }}.router, dependencies=[{{ dependencies | join(", ") }}])
{% else %}
router.include_router({{ op.module }}.router)
{% endif %}
{% endfor %}
{% endif %}
{% if e.file_endpoints %}
{% for f in e.files %}
{{ trace(f.id) }}
{% endfor %}
{% set dependencies = e.file_dependencies() %}
{% if dependencies %}
router.include_router(files.router, dependencies=[{{ dependencies | join(", ") }}])
{% else %}
router.include_router(files.router)
{% endif %}
{% endif %}
{% if e.history_endpoints %}
{{ trace(e.history.id) }}
router.include_router(history.router)
{% endif %}
