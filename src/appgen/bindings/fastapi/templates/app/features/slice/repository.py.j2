async def _apply(session: AsyncSession, record: {{ e.name }}, values: dict[str, Any]) -> None:
    """Set the values of a request on a record. Check that the related records exist."""
{% for r in e.fk_relations %}
    {{ trace(r.id) }}
    if values.get("{{ r.fk_attr }}") is not None:
        await ensure_exists(session, {{ r.target }}, values["{{ r.fk_attr }}"], "{{ r.fk_attr }}")
{% endfor %}
{% for r in e.m2m_relations %}
    {{ trace(r.id) }}
    if (ids := values.pop("{{ r.ids_field }}", None)) is not None:
        record.{{ r.attr }} = await load_all(session, {{ r.target }}, ids, "{{ r.ids_field }}")
{% endfor %}
    for name, value in values.items():
        setattr(record, name, value)
