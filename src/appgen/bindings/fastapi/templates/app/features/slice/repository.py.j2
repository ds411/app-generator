def owned(
    statement: Select[{{ e.name }}],
    owner: UUID | None,
) -> Select[{{ e.name }}]:
    """Return the statement for the records of an owner, or for all records without an owner.

    The owner rules of the roles (ADR 0018) give the owner of a request.
    """
    if owner is None:
        return statement
    return statement.where({{ e.name }}.{{ e.owner.fk_attr }} == owner)


async def get(session: AsyncSession, id: UUID, owner: UUID | None = None) -> {{ e.name }}:
    """Return the record with an ID, with fresh data. Give a 404 error if it does not exist.

    With an owner, a record of another user also gives 404, so that a
    caller cannot find the IDs of the records of other users.
    """
    record = await session.get({{ e.name }}, id, populate_existing=True)
    if record is None or (owner is not None and record.{{ e.owner.fk_attr }} != owner):
        {{ py.problem(404, "No {entity} has the ID {id}.", 8, entity=e.name | tojson, id="id") }}
    return record
{% else %}
async def get(session: AsyncSession, id: UUID) -> {{ e.name }}:
    """Return the record with an ID, with fresh data. Give a 404 error if it does not exist."""
    record = await session.get({{ e.name }}, id, populate_existing=True)
    if record is None:
        {{ py.problem(404, "No {entity} has the ID {id}.", 8, entity=e.name | tojson, id="id") }}
