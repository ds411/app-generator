async def get(session: AsyncSession, id: UUID) -> {{ e.name }}:
    """Return the record with an ID, with fresh data. Give a 404 error if it does not exist."""
    record = await session.get({{ e.name }}, id, populate_existing=True)
    if record is None:
        raise ProblemError(404, f"No {{ e.name }} has the ID {id}.")
    return record


async def create(session: AsyncSession, data: {{ e.name }}Create) -> {{ e.name }}:
    """Validate and store a new record, and return it."""
    record = {{ e.name }}()
    await _apply(session, record, data.model_dump(by_alias=False))
{% if e.workflows %}
    check_workflows(record, None)
{% endif %}
{% if e.check_rules %}
    await check_rules(session, record)
{% endif %}
    await validate(session, record, created=True)
    session.add(record)
    await commit(session)
    return await get(session, record.id)


async def update(session: AsyncSession, record: {{ e.name }}, data: {{ e.name }}Update) -> {{ e.name }}:
    """Change the fields that the request gives, validate the record, and return it."""
{% if e.workflows %}
    before = { {%- for w in e.workflows %}"{{ w.attr }}": record.{{ w.attr }}{{ ", " if not loop.last }}{% endfor -%} }
{% endif %}
    await _apply(session, record, data.model_dump(by_alias=False, exclude_unset=True))
{% if e.workflows %}
    check_workflows(record, before)
{% endif %}
{% if e.check_rules %}
    await check_rules(session, record)
{% endif %}
    await validate(session, record, created=False)
    await commit(session)
    return await get(session, record.id)


async def delete(session: AsyncSession, record: {{ e.name }}) -> None:
    """Delete a record."""
    await session.delete(record)
    await commit(session)


