async def add(
    session: AsyncSession,
    data: {{ e.name }}Create,
    owner: UUID | None = None,
) -> {{ e.name }}:
    """Validate a new record, and add it to the session without a commit. Return the record.

    With an owner, the record belongs to the owner, whatever the request gives.
    """
    record = {{ e.name }}(id=uuid4())
    values = data.model_dump(by_alias=False)
    if owner is not None:
        values["{{ e.owner.fk_attr }}"] = owner
    await _apply(session, record, values)
{% else %}
async def add(session: AsyncSession, data: {{ e.name }}Create) -> {{ e.name }}:
    """Validate a new record, and add it to the session without a commit. Return the record."""
    record = {{ e.name }}(id=uuid4())
    await _apply(session, record, data.model_dump(by_alias=False))
{% endif %}
{% if e.workflows %}
    check_workflows(record, None)
{% endif %}
{% if e.check_rules %}
    await check_rules(session, record)
{% endif %}
    await validate(session, record, created=True)
    session.add(record)
    return record


{% if e.owner %}
async def create(
    session: AsyncSession,
    data: {{ e.name }}Create,
    owner: UUID | None = None,
) -> {{ e.name }}:
    """Validate and store a new record, and return it. With an owner, it belongs to the owner."""
    record = await add(session, data, owner)
{% else %}
async def create(session: AsyncSession, data: {{ e.name }}Create) -> {{ e.name }}:
    """Validate and store a new record, and return it."""
    record = await add(session, data)
{% endif %}
    await commit(session)
    return await get(session, record.id)


