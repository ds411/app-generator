{{ op.decorator() }}
{% set args = ["query: Annotated[" ~ op.query_class ~ ", Query()]", "session: SessionDep"] + (["scope: Scope"] if owner else []) %}
{{ py.signature("async def run_" ~ op.name, args, " -> Page[" ~ op.row_class ~ "]:") }}
    """{{ op.description or ("Return a page of the rows of the query " ~ op.name ~ ".") }}"""
    rows = await {{ op.name }}(session{{ ", query" if op.params }})
{% if owner and r.scoped %}
    # The record rules of the role (ADR 0025): only the records that the user may read.
    shown = await {{ repo }}.visible(session, [row.id for row in rows], scope)
    rows = [row for row in rows if row.id in shown]
{% endif %}
    page = rows[query.offset : query.offset + query.limit]
{% if owner and r.hides %}
    items = [{{ op.row_class }}.model_validate(row) for row in page]
    await {{ repo }}.hide(session, items, scope)
{% else %}
    items = [{{ op.row_class }}.model_validate(row) for row in page]
{% endif %}
    return Page[{{ op.row_class }}](
        items=items,
        total=len(rows),
        limit=query.limit,
        offset=query.offset,
    )
