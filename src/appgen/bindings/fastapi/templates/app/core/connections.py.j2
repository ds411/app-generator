def callback_url(request: Request, api: str) -> str:
    """Return the URL that the authorization server sends the browser back to."""
    public_url: str = request.app.state.settings.public_url
    if public_url:
        return f"{public_url.rstrip('/')}/auth/connections/{api}/callback"
    return str(request.url_for("finish_connection", api=api))


def _verifier(key: bytes, nonce: str) -> str:
    """Return the PKCE verifier of a flow: an HMAC of its nonce (RFC 7636)."""
    digest = hmac.new(key, f"api-connections.verifier.{nonce}".encode(), hashlib.sha256)
    return base64.urlsafe_b64encode(digest.digest()).rstrip(b"=").decode()


