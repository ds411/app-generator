async def check_credentials(
    http: httpx.AsyncClient, target: BasicApi, username: str, password: str
) -> None:
    """Call the check operation of an API with new credentials, if the API has one.

    Give 422 if the API does not accept them (401 or 403), and 502 if it
    gives another error or no answer.
    """
    if target.check is None:
        return
    method, path = target.check
    url = target.base_url.rstrip("/") + path
    headers = {
        "Accept": "application/json",
        "Authorization": basic_authorization(username, password),
    }
    try:
        response = await http.request(method, url, headers=headers)
    except httpx.HTTPError:
        response = None
    if response is not None and response.status_code in (401, 403):
        {{ py.problem(422, "The API {api} did not accept the user name and the password.", 8, api="target.api") }}
    if response is None or response.is_error:
        {{ py.problem(502, "The API {api} gave no valid answer.", 8, api="target.api") }}


async def connect_with_credentials(
    request: Request,
    session: AsyncSession,
    client: httpx.AsyncClient,
    api: str,
    user_id: UUID,
    data: ConnectionCredentials,
) -> ConnectionRead:
    """Check the credentials of a user at an API with HTTP Basic, and keep them."""
    name = NAMES[api]
    settings: Settings = request.app.state.settings
    key = encryption_key(settings)
    await check_credentials(client, basic_api(settings, name), data.username, data.password)
    connection = await find_connection(session, name, user_id)
    if connection is None:
        connection = ApiConnection(user_id=user_id, api=name, scope="")
        session.add(connection)
    else:
        connection.connected_at = dt.datetime.now(dt.UTC)
    connection.username = data.username
    connection.access_token = seal(key, data.password, _context(connection, "access_token"))
    connection.rejected_at = None
    await commit(session)
    await session.refresh(connection)
    return _read(api, connection)


