class UserCredentials:
    """The user name and the password of a user for an API with HTTP Basic: the token source
    of a client.

    The source reads the credentials of the user in the table `api_connections`, and gives the
    Base64 of `<user name>:<password>` (RFC 7617): the client sends it with the scheme
    `Basic`. If the API does not accept the credentials (401), the source marks the connection
    as rejected, and the user gives new credentials.
    """

    def __init__(
        self,
        settings: Settings,
        api: str,
        sessions: async_sessionmaker[AsyncSession],
        user_id: UUID | None,
    ) -> None:
        self.settings = settings
        self.api = api
        self.sessions = sessions
        self.user_id = user_id
        self._rejected: str | None = None

    async def get(self, http: httpx.AsyncClient) -> str:
        """Return the credentials of the user. Raise NotConnectedError without a connection, or
        when the API did not accept the credentials."""
        if self.user_id is None:
            raise NotConnectedError(self.api)
        key = encryption_key(self.settings)
        async with self.sessions() as session:
            connection = await find_connection(session, self.api, self.user_id)
            if connection is None:
                raise NotConnectedError(self.api)
            value = self._value(key, connection)
            if value is None or value == self._rejected:
                # The API did not accept the credentials, or a new AUTH_SECRET ended them.
                if connection.rejected_at is None:
                    connection.rejected_at = dt.datetime.now(dt.UTC)
                    await session.commit()
                raise NotConnectedError(self.api, rejected=True)
        return value

    def reset(self, token: str) -> None:
        """Keep credentials that the API did not accept: `get` rejects the connection."""
        self._rejected = token

    @staticmethod
    def _value(key: bytes, connection: ApiConnection) -> str | None:
        """Return the Base64 of the credentials of a connection, or None if it is rejected."""
        if connection.rejected_at is not None or connection.username is None:
            return None
        password = unseal(key, connection.access_token, _context(connection, "access_token"))
        if password is None:
            return None
        return base64.b64encode(f"{connection.username}:{password}".encode()).decode()
