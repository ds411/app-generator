@router.post(
    "/{api}",
    responses=problem_responses(401, 422, 500),
    operation_id="start_connection",
)
async def start_connection(
    api: {{ "FlowApiName" if basic else "ApiName" }}, data: ConnectionStart, request: Request, user: CurrentUser
) -> AuthorizationLink:
    """Give the page where the signed-in user allows the app to use the API in their name."""
    app = oauth_app(request.app.state.settings, NAMES[api])
    app.check()
    if data.return_to is not None:
        _check_return_to(request, data.return_to)
    key = signing_key(request)
    nonce = secrets.token_urlsafe(32)
    flow = {
        "user": str(user.id),
        "nonce": nonce,
        "return_to": data.return_to,
        "exp": int(time.time()) + FLOW_SECONDS,
    }
    challenge = hashlib.sha256(_verifier(key, nonce).encode()).digest()
    query = {
        "response_type": "code",
        "client_id": app.client_id,
        "redirect_uri": callback_url(request, api),
        "state": sign(key, f"api-connection.{api}", flow),
        "code_challenge": base64.urlsafe_b64encode(challenge).rstrip(b"=").decode(),
        "code_challenge_method": "S256",
    }
    if app.scopes:
        query["scope"] = " ".join(app.scopes)
    url = app.url(app.authorization_url)
    separator = "&" if "?" in url else "?"
    return AuthorizationLink(authorization_url=f"{url}{separator}{urlencode(query)}")


async def _connect(
    request: Request,
    session: AsyncSession,
    client: httpx.AsyncClient,
    api: str,
    flow: dict[str, Any],
    code: str | None,
    error: str | None,
) -> ConnectionRead:
    if error is not None:
        {{ py.problem(401, "The authorization server gave the error '{error}'.", 8, error="error") }}
    if code is None:
        {{ py.problem(400, "The callback has no code. Connect the account again.", 8) }}
    name = NAMES[api]
    settings: Settings = request.app.state.settings
    app = oauth_app(settings, name)
    data = {
        "grant_type": "authorization_code",
        "code": code,
        "redirect_uri": callback_url(request, api),
        "code_verifier": _verifier(signing_key(request), str(flow["nonce"])),
    }
    try:
        answer = await request_tokens(client, app, app.token_url, data)
    except GrantError as grant:
        {{ py.problem(401, "The authorization server did not accept the code. Connect the account again.", 8, suffix=" from grant") }}
    except (ApiError, httpx.HTTPError) as failure:
        {{ py.problem(502, "The token endpoint of the API {api} did not answer correctly.", 8, suffix=" from failure", api="name") }}
    user_id = UUID(str(flow["user"]))
    connection = await find_connection(session, name, user_id)
    if connection is None:
        connection = ApiConnection(user_id=user_id, api=name, scope=" ".join(app.scopes))
        session.add(connection)
    else:
        # A new connection does not keep the refresh token of the old one.
        connection.refresh_token = None
        connection.scope = " ".join(app.scopes)
        connection.connected_at = dt.datetime.now(dt.UTC)
    store(encryption_key(settings), connection, answer)
    await commit(session)
    await session.refresh(connection)
    return _read(api, connection)


@router.get(
    "/{api}/callback",
    response_model=ConnectionRead,
    responses={
        303: {"description": "With return_to: the page, with the API or the error."},
        **problem_responses(400, 401, 409, 500, 502),
    },
    operation_id="finish_connection",
)
async def finish_connection(
    api: {{ "FlowApiName" if basic else "ApiName" }},
    request: Request,
    session: SessionDep,
    client: ConnectionClient,
    code: Annotated[str | None, Query(max_length=2000)] = None,
    state: Annotated[str | None, Query(max_length=4000)] = None,
    error: Annotated[str | None, Query(max_length=200)] = None,
) -> ConnectionRead | RedirectResponse:
    """Change the code of the authorization server for the tokens of the user, and keep them."""
    flow = unsign(signing_key(request), f"api-connection.{api}", state or "")
    if flow is None:
        {{ py.problem(400, "The state of the callback is not correct. Connect the account again.", 8) }}
    return_to: str | None = flow.get("return_to")
    try:
        connection = await _connect(request, session, client, api, flow, code, error)
    except ProblemError as problem:
        if return_to is None:
            raise
        message = problem.detail or {{ py.message("The connection failed.") }}
        target = _with_fragment(return_to, {"error": message})
    else:
        if return_to is None:
            return connection
        target = _with_fragment(return_to, {"connected": api})
    return RedirectResponse(target, status_code=303)
