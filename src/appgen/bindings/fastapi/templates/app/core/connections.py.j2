class GrantError(Exception):
    """The token endpoint did not accept the code or the refresh token (400 or 401)."""


class TokenAnswer(BaseModel):
    """The answer of the token endpoint of an API (RFC 6749, section 5.1)."""

    access_token: str
    refresh_token: str | None = None
    expires_in: int | None = None
    scope: str | None = None
{% endif %}


def encryption_key(settings: Settings) -> bytes:
    """Return the key of the tokens: an HMAC of `AUTH_SECRET`. Give 500 without it."""
    if not settings.auth_secret:
        raise ProblemError(500, {{ py.message("The server has no AUTH_SECRET.") }})
    return hmac.new(settings.auth_secret.encode(), b"api-connections", hashlib.sha256).digest()


def seal(key: bytes, value: str, context: str) -> str:
    """Return a token encrypted with AES-256-GCM.

    The context (the API, the user, and the column) is part of the check:
    a value is valid only in its own row and column.
    """
    nonce = secrets.token_bytes(12)
    box = AESGCM(key).encrypt(nonce, value.encode(), context.encode())
    return base64.urlsafe_b64encode(nonce + box).decode()


def unseal(key: bytes, sealed: str, context: str) -> str | None:
    """Return the token of a sealed value, or None if the value or the key is not correct."""
    try:
        data = base64.urlsafe_b64decode(sealed)
        return AESGCM(key).decrypt(data[:12], data[12:], context.encode()).decode()
    except ValueError, InvalidTag:
        return None


def _context(connection: ApiConnection, column: str) -> str:
    return f"{connection.api}.{connection.user_id}.{column}"


{% if oauth %}
def store(key: bytes, connection: ApiConnection, answer: TokenAnswer) -> None:
    """Keep the tokens of an answer of the token endpoint in a connection."""
    connection.access_token = seal(key, answer.access_token, _context(connection, "access_token"))
    if answer.refresh_token is not None:
        # Without a new refresh token, the old one stays valid (RFC 6749, section 6).
        connection.refresh_token = seal(
            key, answer.refresh_token, _context(connection, "refresh_token")
        )
    expires_in = answer.expires_in
    connection.expires_at = int(time.time()) + expires_in if expires_in is not None else None
    if answer.scope is not None:
        connection.scope = answer.scope


