async def request_tokens(
    http: httpx.AsyncClient, app: OAuthApp, url: str, data: dict[str, str]
) -> TokenAnswer:
    """Send a grant to the token endpoint of an API, and return the tokens.

    The app authenticates with HTTP Basic. Raise GrantError if the endpoint
    does not accept the grant (400 or 401), and ApiError for another error.
    """
    app.check()
    # RFC 6749: the client ID and the secret of the basic scheme are URL encoded.
    auth = (quote(app.client_id, safe=""), quote(app.client_secret, safe=""))
    headers = {"Accept": "application/json"}
    response = await http.post(app.url(url), data=data, auth=auth, headers=headers)
    if response.status_code in (400, 401):
        raise GrantError(response.text)
    if response.is_error:
        raise ApiError(app.api, response.status_code, response.text)
    try:
        return TokenAnswer.model_validate(response.json())
    except ValueError as error:
        message = "The token answer has no access_token."
        raise ApiError(app.api, response.status_code, message) from error


_LOCKS: dict[tuple[str, UUID], tuple[asyncio.AbstractEventLoop, asyncio.Lock]] = {}


def _lock(api: str, user_id: UUID) -> asyncio.Lock:
    """Return the lock of the tokens of a user in the event loop that runs."""
    loop = asyncio.get_running_loop()
    found = _LOCKS.get((api, user_id))
    if found is None or found[0] is not loop:
        found = (loop, asyncio.Lock())
        _LOCKS[(api, user_id)] = found
    return found[1]


class UserToken:
    """The access tokens of a user for an API: the token source of a client.

    The source reads the tokens of the user in the table `api_connections`.
    When the access token ends, or the API does not accept it, the source
    gets a new access token with the refresh token. Two requests at the
    same time for a user wait for the same new token. If the token endpoint
    does not accept the refresh token, the source deletes the connection,
    and the user connects the account again.
    """

    def __init__(
        self,
        settings: Settings,
        api: str,
        sessions: async_sessionmaker[AsyncSession],
        user_id: UUID | None,
    ) -> None:
        self.settings = settings
        self.api = api
        self.sessions = sessions
        self.user_id = user_id
        self._rejected: str | None = None

    async def get(self, http: httpx.AsyncClient) -> str:
        """Return the access token of the user. Raise NotConnectedError without a connection."""
        if self.user_id is None:
            raise NotConnectedError(self.api)
        key = encryption_key(self.settings)
        async with self.sessions() as session:
            token = self._usable(key, await find_connection(session, self.api, self.user_id))
        if token is not None:
            return token
        async with _lock(self.api, self.user_id):
            return await self._refresh(http, key, self.user_id)

    def reset(self, token: str) -> None:
        """Forget a token that the API did not accept, so that `get` gets a new token."""
        self._rejected = token

    def _usable(self, key: bytes, connection: ApiConnection | None) -> str | None:
        """Return the access token of a connection, or None if it ended or was rejected."""
        if connection is None:
            raise NotConnectedError(self.api)
        token = unseal(key, connection.access_token, _context(connection, "access_token"))
        ends = connection.expires_at
        if token == self._rejected or (ends is not None and time.time() >= ends - EARLY_SECONDS):
            return None
        return token

    async def _refresh(self, http: httpx.AsyncClient, key: bytes, user_id: UUID) -> str:
        async with self.sessions() as session:
            connection = await find_connection(session, self.api, user_id, lock=True)
            if connection is None:
                raise NotConnectedError(self.api)
            token = self._usable(key, connection)
            if token is not None:
                # Another request got a new token first.
                return token
            answer = await self._grant(http, key, connection)
            if answer is None:
                # The user connects the account again.
                await session.delete(connection)
                await session.commit()
                raise NotConnectedError(self.api)
            store(key, connection, answer)
            await session.commit()
        self._rejected = None
        return answer.access_token

    async def _grant(
        self, http: httpx.AsyncClient, key: bytes, connection: ApiConnection
    ) -> TokenAnswer | None:
        """Return new tokens for the refresh token, or None if the endpoint does not accept it."""
        sealed = connection.refresh_token
        refresh = unseal(key, sealed, _context(connection, "refresh_token")) if sealed else None
        if refresh is None:
            return None
        app = oauth_app(self.settings, self.api)
        data = {"grant_type": "refresh_token", "refresh_token": refresh}
        try:
            return await request_tokens(http, app, app.refresh_url, data)
        except GrantError:
            return None
{% endif %}
