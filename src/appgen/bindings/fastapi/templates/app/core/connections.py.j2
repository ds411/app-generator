async def find_connection(
    session: AsyncSession, api: str, user_id: UUID, *, lock: bool = False
) -> ApiConnection | None:
    """Return the connection of a user to an API, or None. `lock` locks the row (Postgres)."""
    statement = select(ApiConnection).where(
        ApiConnection.api == api, ApiConnection.user_id == user_id
    )
    if lock:
        statement = statement.with_for_update()
    return await session.scalar(statement)


{% if basic %}
async def connected(session: AsyncSession, api: str, user_id: UUID | None) -> bool:
    """Return True if the user has a connection to the API, and the API did not reject it."""
    if user_id is None:
        return False
    connection = await find_connection(session, api, user_id)
    return connection is not None and connection.rejected_at is None


async def require_connection(session: AsyncSession, api: str, user_id: UUID) -> None:
    """Give 409 if the user has no connection to the API, or the API rejected it."""
    connection = await find_connection(session, api, user_id)
    if connection is None:
        raise NotConnectedError(api)
    if connection.rejected_at is not None:
        raise NotConnectedError(api, rejected=True)
{% else %}
