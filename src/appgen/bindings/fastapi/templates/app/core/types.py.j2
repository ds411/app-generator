{% endfor %}
@dataclass
class GeoPoint:
    """A place on the earth, in degrees (WGS 84): the value of a `point` field (ADR 0046).

    The model of a record keeps it in two columns, `<field>_lat` and
    `<field>_lng`, and gives it as one composite attribute.
    """

    lat: Annotated[float, Field(ge=-90, le=90, description="The latitude, from -90 to 90.")]
    lng: Annotated[float, Field(ge=-180, le=180, description="The longitude, from -180 to 180.")]
