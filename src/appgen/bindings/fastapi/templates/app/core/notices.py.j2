@router.get(
    "",
    responses=problem_responses(401),
    summary="List notices",
    operation_id="list_notices",
)
async def list_notices(
    query: Annotated[NoticeQuery, Query()], session: SessionDep, user: CurrentUser
) -> Page[NoticeRead]:
    """Return a page of the notices of the signed-in user, the newest first."""
    where = [Notice.user_id == user.id]
    if query.unread:
        where.append(Notice.read_at.is_(None))
    total = await session.scalar(select(func.count()).select_from(Notice).where(*where))
    statement = (
        select(Notice)
        .where(*where)
        .order_by(Notice.at.desc(), Notice.id.desc())
        .limit(query.limit)
        .offset(query.offset)
    )
    notices = list(await session.scalars(statement))
    return Page[NoticeRead](
        items=await _reads(session, notices),
        total=total or 0,
        limit=query.limit,
        offset=query.offset,
    )


@router.post(
    "/{id}/read",
    responses=problem_responses(401, 404),
    summary="Mark a notice read",
    operation_id="read_notice",
)
async def read_notice(id: UUID, session: SessionDep, user: CurrentUser) -> NoticeRead:
    """Mark a notice of the signed-in user read, and return it. A read notice stays read."""
    notice = await session.get(Notice, id)
    if notice is None or notice.user_id != user.id:
        {{ py.problem(404, "You have no notice with the ID {id}.", 8, id="id") }}
    if notice.read_at is None:
        notice.read_at = dt.datetime.now(dt.UTC)
        await commit(session)
    return (await _reads(session, [notice]))[0]


@router.post(
    "/read",
    status_code=204,
    responses=problem_responses(401),
    summary="Mark all notices read",
    operation_id="read_all_notices",
)
async def read_all_notices(session: SessionDep, user: CurrentUser) -> None:
    """Mark all notices of the signed-in user read."""
    statement = (
        update(Notice)
        .where(Notice.user_id == user.id, Notice.read_at.is_(None))
        .values(read_at=dt.datetime.now(dt.UTC))
    )
    await session.execute(statement)
    await commit(session)
