"""The endpoints of the notices of the signed-in user (ADR 0041): the list, and the reads.

The repositories of the entities add the notices (`app/core/notifications.py`).
"""

import datetime as dt
from collections.abc import Sequence
from typing import Annotated
from uuid import UUID

from fastapi import APIRouter, Query
from sqlalchemy import func, select, update
from sqlalchemy.ext.asyncio import AsyncSession

from app.core.auth import CurrentUser
from app.core.db import SessionDep, commit
from app.core.errors import ProblemError, problem_responses
{% if i18n %}
from app.core.i18n import t
{% endif %}
from app.core.notifications import Notice, NoticeQuery, NoticeRead, notice_text
from app.core.pagination import Page
from app.features.{{ u.slice }}.models import {{ u.name }}

router = APIRouter(prefix="/notices", tags=["notices"])


async def _actors(session: AsyncSession, ids: set[UUID]) -> dict[UUID | None, str]:
    """Return the display value of each user of a set of IDs: `{{ py.user_label_attr }}`."""
    if not ids:
        return {}
    statement = select({{ u.name }}.id, {{ u.name }}.{{ py.user_label_attr }}).where({{ u.name }}.id.in_(ids))
    return {id: str(label) for id, label in await session.execute(statement)}


async def _reads(session: AsyncSession, notices: Sequence[Notice]) -> list[NoticeRead]:
    """Return the notices as the API returns them: with the text and the user of the change."""
    actors = await _actors(session, {n.actor_id for n in notices if n.actor_id is not None})
    return [
        NoticeRead.model_validate(notice).model_copy(
            update={"text": notice_text(notice), "actor": actors.get(notice.actor_id)}
        )
        for notice in notices
    ]


