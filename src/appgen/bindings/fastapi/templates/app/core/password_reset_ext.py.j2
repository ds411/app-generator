"""The delivery of the password reset links (ADR 0017).

appgen creates this file once and never changes it. The definition does
not know the mail service, so write the delivery here.
"""

import logging

from app.core.config import Settings
from app.features.{{ u.slice }}.models import {{ u.name }}

logger = logging.getLogger("app.auth")


async def deliver_password_reset(settings: Settings, user: {{ u.name }}, link: str) -> None:
    """Send a reset link to a user, for example by email to `user.{{ username.attr }}`.

    The link is valid for a short time, and only one time. The stub writes
    the link to the log with `ENVIRONMENT=development`. In production, it
    gives an error (501).
    """
    # TODO(appgen): send the reset link to the user, for example by email.
    if settings.environment == "development":
        logger.warning("The password reset link of %s: %s", user.{{ username.attr }}, link)
        return
    raise NotImplementedError("auth.password_reset")
