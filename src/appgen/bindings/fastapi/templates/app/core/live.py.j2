@dataclass(frozen=True, slots=True)
class Audience:
    """The users that may read a record at one time, by the record rules of the roles."""

    roles: frozenset[str]
    """The roles whose rule conditions the record meets."""
    owners: frozenset[UUID] = frozenset()
    """The users at the end of the owner path of the record."""
{% endif %}


@dataclass(frozen=True, slots=True)
class Change:
    """A create, a change, or a delete of a record of a live entity, after the commit."""

    entity: str
    id: UUID
    action: Action
{% if scoped %}
    audiences: tuple[Audience, ...] | None = None
    """The audiences of the record before and after the change, or None without a record
    rule for the reads of the entity: all users that may read the entity see the change."""
{% endif %}

    def to_json(self) -> str:
        """Return the change as JSON, for the Redis channel."""
{% if scoped %}
        audiences = None
        if self.audiences is not None:
            audiences = [
                {"roles": sorted(a.roles), "owners": sorted(str(o) for o in a.owners)}
                for a in self.audiences
            ]
        data = {"entity": self.entity, "id": str(self.id), "action": self.action}
        return json.dumps({**data, "audiences": audiences})
{% else %}
        return json.dumps({"entity": self.entity, "id": str(self.id), "action": self.action})
{% endif %}

    @classmethod
    def from_json(cls, text: str | bytes) -> Change:
        """Return a change of the Redis channel."""
        data = json.loads(text)
{% if scoped %}
        audiences = None
        if data["audiences"] is not None:
            audiences = tuple(
                Audience(frozenset(a["roles"]), frozenset(UUID(o) for o in a["owners"]))
                for a in data["audiences"]
            )
        return cls(data["entity"], UUID(data["id"]), data["action"], audiences)
{% else %}
        return cls(data["entity"], UUID(data["id"]), data["action"])
{% endif %}
{% if presences %}


@dataclass(frozen=True, slots=True)
class Here:
    """A call of the page of a record: its user is on the record, or left it (ADR 0052)."""

    entity: str
    id: UUID
    user: UUID
    name: str = ""
    typing: bool = False
    left: bool = False

    def to_json(self) -> str:
        """Return the call as JSON, for the Redis channel."""
        data = {"entity": self.entity, "id": str(self.id), "user": str(self.user)}
        state = {"name": self.name, "typing": self.typing, "left": self.left}
        return json.dumps({"presence": {**data, **state}})

    @classmethod
    def from_data(cls, data: dict[str, Any]) -> Here:
        """Return a call of the Redis channel, from the value of its key `presence`."""
        return cls(
            data["entity"],
            UUID(data["id"]),
            UUID(data["user"]),
            data["name"],
            data["typing"],
            data["left"],
        )


type Message = Change | Here
"""A message of the Redis channel: a change of a record, or a call of a record page."""


def message_of(text: str | bytes) -> Message:
    """Return a message of the Redis channel."""
    data = json.loads(text)
    if "presence" in data:
        return Here.from_data(data["presence"])
    return Change.from_json(text)


