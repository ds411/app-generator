@dataclass(frozen=True, slots=True)
class Viewer:
    """A client of the stream: its user, and the entities whose events it gets."""

    entities: frozenset[str]
{% if auth %}
    user: UUID | None = None
    """The signed-in user, or None."""
{% endif %}
{% if access %}
    role: str | None = None
    """The role of the signed-in user, or None."""
{% endif %}

    def sees(self, change: Change) -> bool:
        """Return True if the client may see a change: it may read the record."""
{% if scoped %}
        if change.entity not in self.entities:
            return False
        rule = RECORD_RULES.get(self.role, {}).get(change.entity) if self.role else None
        if change.audiences is None or rule is None or not rule.applies("read"):
            return True
        if NAMES[change.entity].public:
            # A record rule does not apply to the public operations (ADR 0025).
            return True
        return any(
            self.role in audience.roles and (not rule.owner or self.user in audience.owners)
            for audience in change.audiences
        )
{% else %}
        return change.entity in self.entities
{% endif %}


class Subscription:
    """The events of one client: the changes that it may see, in a queue."""

    def __init__(self, viewer: Viewer, size: int = QUEUE_SIZE) -> None:
        self.viewer = viewer
        self.queue: asyncio.Queue[LiveEvent | None] = asyncio.Queue(size)
        self.lost = False
        """True if the queue was full: the client gets `reset`."""
        self.ended = False
        """True if the stream ends, for example because the server stops."""

    def offer(self, change: Change) -> None:
        """Add a change to the queue if the client may see it."""
        if self.viewer.sees(change):
            self._put(LiveEvent(type=change.action, entity=change.entity, id=change.id))

    def reset(self) -> None:
        """Tell the client to read all records again, for example after a loss of events."""
        self._put(LiveEvent(type="reset"))
{% if presences %}

    def show(self, entity: str, id: UUID, users: list[PresentUser]) -> None:
        """Add the users on the page of a record to the queue, without the user of the client."""
        others = [user for user in users if user.id != self.viewer.user]
        self._put(LiveEvent(type="presence", entity=entity, id=id, users=others))
{% endif %}

    def end(self) -> None:
        """End the stream. The client opens a new one, for example at another replica."""
        self.ended = True
        # Wake the stream if it waits. A full queue has no waiting stream.
        with contextlib.suppress(asyncio.QueueFull):
            self.queue.put_nowait(None)

    def _put(self, event: LiveEvent) -> None:
        try:
            self.queue.put_nowait(event)
        except asyncio.QueueFull:
            self.lost = True

    async def next(self) -> LiveEvent | None:
        """Return the next event, or None at the end of the stream.

        After a full queue, return `reset` and drop the queue.
        """
        if self.ended:
            return None
        if self.lost:
            self.lost = False
            while not self.queue.empty():
                self.queue.get_nowait()
            return LiveEvent(type="reset")
        return await self.queue.get()


class Broker:
    """The events of the process, and with Redis the events of all replicas.

    Without a URL, `publish` gives the changes to the subscriptions of the
    process. With a URL, a task sends them to the Redis channel, and
    another task gives the events of the channel to the subscriptions, so
    that each replica gets the events of all replicas. The tasks start
    with the first change or subscription.
{% if presences %}

    `here` and `leave` send the calls of the record pages in the same way.
    Each broker keeps the users on the records from the calls, and forgets
    a user after PRESENCE_SECONDS without a call.
{% endif %}
    """

    def __init__(self, url: str | None = None) -> None:
        self.url = url or None
        self.subscriptions: set[Subscription] = set()
        self.outbox: asyncio.Queue[Message] = asyncio.Queue()
        self.redis: Redis | None = None
        self.tasks: list[asyncio.Task[None]] = []
        self.available = True
        """False after an error of Redis, until the next success: one warning for each loss."""
        self.ended = False
        """True when the server stops: the streams end."""
{% if presences %}
        self.present: dict[tuple[str, UUID], dict[UUID, _Present]] = {}
        """The users on the pages of the records, by entity and ID."""
        self.sweeper: asyncio.Task[None] | None = None
        """The task that forgets the users without a call."""
{% endif %}

    def publish(self, changes: Iterable[Message]) -> None:
        """Send the changes of a transaction after its commit."""
        if self.url is None:
            self.deliver(changes)
            return
        self._start()
        for change in changes:
            self.outbox.put_nowait(change)

    def deliver(self, messages: Iterable[Message]) -> None:
        """Give the messages to the subscriptions of the process."""
        for message in messages:
{% if presences %}
            if isinstance(message, Here):
                self.arrive(message)
                continue
{% endif %}
            for subscription in list(self.subscriptions):
                subscription.offer(message)
{% if presences %}

    def here(self, entity: str, id: UUID, user: UUID, name: str, typing: bool) -> list[PresentUser]:
        """Note a user on the page of a record, and return the other users on the record."""
        self.publish([Here(entity, id, user, name, typing)])
        return [other for other in self.users(entity, id) if other.id != user]

    def leave(self, entity: str, id: UUID, user: UUID) -> None:
        """End the presence of a user on a record: the page closed."""
        self.publish([Here(entity, id, user, left=True)])

    def users(self, entity: str, id: UUID) -> list[PresentUser]:
        """Return the users on the page of a record."""
        present = self.present.get((entity, id), {})
        return [PresentUser(id=u, name=p.name, typing=p.typing) for u, p in present.items()]

    def arrive(self, here: Here) -> None:
        """Note a call of a page in the users on its record, and tell the other users of a change."""
        key = (here.entity, here.id)
        present = self.present.setdefault(key, {})
        before = present.pop(here.user, None)
        if not here.left:
            until = time.monotonic() + PRESENCE_SECONDS
            present[here.user] = _Present(here.name, here.typing, until)
        if not present:
            del self.present[key]
        if before is None and here.left:
            return
        if before is None or here.left or (before.name, before.typing) != (here.name, here.typing):
            self._tell(key, {here.user})
        if self.sweeper is None:
            self.sweeper = asyncio.create_task(self._sweep())

    def forget(self, now: float | None = None) -> None:
        """Forget the users without a call in PRESENCE_SECONDS, and tell the other users."""
        now = time.monotonic() if now is None else now
        for key, present in list(self.present.items()):
            gone = {user for user, state in present.items() if state.until <= now}
            if not gone:
                continue
            for user in gone:
                del present[user]
            if not present:
                del self.present[key]
            self._tell(key, gone)

    def _tell(self, key: tuple[str, UUID], changed: set[UUID]) -> None:
        """Send the users on a record to the streams of its other users."""
        entity, id = key
        users = self.users(entity, id)
        others = {user.id for user in users} - changed
        for subscription in list(self.subscriptions):
            viewer = subscription.viewer
            if viewer.user in others and entity in viewer.entities:
                subscription.show(entity, id, users)

    async def _sweep(self) -> None:
        """Forget the users without a call, each second."""
        while True:
            await asyncio.sleep(1)
            self.forget()
{% endif %}

    def subscribe(self, viewer: Viewer) -> Subscription:
        """Return a new subscription of a client."""
        self._start()
        subscription = Subscription(viewer)
        self.subscriptions.add(subscription)
        if self.ended:
            subscription.end()
        return subscription

    def unsubscribe(self, subscription: Subscription) -> None:
        """Remove the subscription of a client that left."""
        self.subscriptions.discard(subscription)

    def end_streams(self) -> None:
        """End the open streams and the new ones, so that the server can stop."""
        self.ended = True
        for subscription in list(self.subscriptions):
            subscription.end()

    def _start(self) -> None:
        """Start the tasks of Redis, if the broker has a URL and they do not run."""
        if self.url is None or self.tasks:
            return
        # One retry at once, for a connection that Redis closed: without Redis, the changes
        # go to the subscriptions of the process without a wait.
        retry = Retry(NoBackoff(), 1)
        # redis-py does not give the types of the keyword arguments of from_url.
        self.redis = Redis.from_url(self.url, socket_connect_timeout=1, retry=retry)  # pyright: ignore[reportUnknownMemberType]
        self.tasks = [asyncio.create_task(self._send()), asyncio.create_task(self._listen())]

    def _failed(self, error: Exception) -> None:
        if self.available:
            self.available = False
            logger.warning("The Redis of the live events is not available: %s", error)

    async def _send(self) -> None:
        """Send the messages of the outbox to the channel. Without Redis, give them to the process."""
        assert self.redis is not None
        while True:
            message = await self.outbox.get()
            try:
                if not self.available:
                    # The listener tries Redis again each second.
                    self.deliver([message])
                    continue
                await self.redis.publish(CHANNEL, message.to_json())  # pyright: ignore[reportUnknownMemberType]
            except RedisError as error:
                self._failed(error)
                self.deliver([message])
            finally:
                self.outbox.task_done()

    async def _listen(self) -> None:
        """Give the events of the channel to the subscriptions. Connect again after an error."""
        assert self.redis is not None
        while True:
            try:
                async with self.redis.pubsub() as pubsub:  # pyright: ignore[reportUnknownMemberType]
                    await pubsub.subscribe(CHANNEL)
                    if not self.available:
                        # The subscriptions can miss the events of the time without Redis.
                        self.available = True
                        for subscription in list(self.subscriptions):
                            subscription.reset()
                    while True:
                        received = cast(
                            dict[str, Any] | None,
                            await pubsub.get_message(ignore_subscribe_messages=True, timeout=None),
                        )
                        if received is not None:
                            self.deliver([message_of(received["data"])])
            except RedisError as error:
                self._failed(error)
                await asyncio.sleep(1)

    async def close(self, timeout: float = 5) -> None:
        """Send the waiting changes, stop the tasks, and close the connection of Redis."""
{% if presences %}
        if self.sweeper is not None:
            self.sweeper.cancel()
            await asyncio.gather(self.sweeper, return_exceptions=True)
            self.sweeper = None
{% endif %}
        if self.tasks:
            try:
                await asyncio.wait_for(self.outbox.join(), timeout)
            except TimeoutError:
                logger.warning("The live events of %d changes were not sent.", self.outbox.qsize())
            for task in self.tasks:
                task.cancel()
            await asyncio.gather(*self.tasks, return_exceptions=True)
            self.tasks = []
        if self.redis is not None:
            await self.redis.aclose()
            self.redis = None


@dataclass(slots=True)
class _Pending:
    """A change of a record in the open transaction."""

    entity: LiveEntity
    action: Action | None = None
    """None for a record that the transaction did not change yet."""
{% if scoped %}
    before: Audience | None = None
    """The audience before the first change in the transaction, or None for a new record."""
    after: Audience | None = None
    """The audience after the last change, or None for a deleted record."""
{% endif %}


def _pending(session: Session) -> dict[tuple[type[Any], UUID], _Pending]:
    """Return the changes of the open transaction of a session, by model and ID."""
    pending: dict[tuple[type[Any], UUID], _Pending] | None = session.info.get(PENDING_KEY)
    if pending is None:
        pending = session.info[PENDING_KEY] = {}
    return pending
{% if scoped %}


def _path_users(session: Session, model: type[Any], id: UUID, path: Sequence[str]) -> list[UUID]:
    """Return the IDs of the users at the end of a path of relations of a record."""
    ids = [id]
    for attr in path:
        relation = getattr(model, attr)
        target: type[Any] = relation.property.mapper.class_
        step = aliased(target)
        statement = (
            select(step.id).join_from(model, relation.of_type(step)).where(model.id.in_(ids))
        )
        ids = list(session.scalars(statement))
        model = target
    return ids


def _audience(session: Session, model: type[Any], id: UUID) -> Audience:
    """Return who may read a record now, from the database (ADR 0025).

    The roles are the roles with a rule for the reads of the entity whose
    conditions the record meets. The owners are the users at the end of
    the owner path, if a rule of these roles has `owner`.
    """
    live = LIVE[model]
    rules = {
        role: rule
        for role, entities in RECORD_RULES.items()
        if (rule := entities.get(live.name)) is not None and rule.applies("read")
    }
    attrs = sorted({attr for rule in rules.values() for attr in rule.where})
    if attrs:
        statement = select(*(getattr(model, attr) for attr in attrs)).where(model.id == id)
        row = session.execute(statement).one_or_none()
        if row is None:
            return Audience(frozenset())
        values = dict(zip(attrs, row, strict=True))
        rules = {
            role: rule
            for role, rule in rules.items()
            if all(values[attr] in allowed for attr, allowed in rule.where.items())
        }
    owners: frozenset[UUID] = frozenset()
    if live.owner and any(rule.owner for rule in rules.values()):
        owners = frozenset(_path_users(session, model, id, live.owner))
    return Audience(frozenset(rules), owners)


@event.listens_for(Session, "before_flush")
def _before_flush(session: Session, context: UOWTransaction, instances: object) -> None:
    """Keep the audience of each changed or deleted record before its first change."""
    if BROKER_KEY not in session.info:
        return
    pending = _pending(session)
    records: list[Any] = [*session.dirty, *session.deleted]
    for record in records:
        model: type[Any] = record.__class__
        live = LIVE.get(model)
        if live is None or (model, record.id) in pending:
            continue
        pending[model, record.id] = _Pending(live, before=_audience(session, model, record.id))
{% endif %}


@event.listens_for(Session, "after_flush")
def _after_flush(session: Session, context: UOWTransaction) -> None:
    """Note the creates, the changes, and the deletes of the records of the live entities."""
    if BROKER_KEY not in session.info:
        return
    for record in session.new:
        _note(session, record, "created")
    for record in session.dirty:
        if session.is_modified(record):
            _note(session, record, "changed")
    for record in session.deleted:
        _note(session, record, "deleted")


def _note(session: Session, record: Any, action: Action) -> None:
    """Note a change of a record in the changes of the transaction, if its entity is live."""
    model: type[Any] = record.__class__
    live = LIVE.get(model)
    if live is None:
        return
    pending = _pending(session)
    key = (model, record.id)
    item = pending.setdefault(key, _Pending(live))
    if item.action == "created" and action == "deleted":
        # A record of the transaction only: the clients never saw it.
        del pending[key]
        return
    if item.action != "created" or action == "deleted":
        item.action = action
{% if scoped %}
    if action != "deleted":
        item.after = _audience(session, model, record.id)
{% endif %}


@event.listens_for(Session, "after_commit")
def _after_commit(session: Session) -> None:
    """Send the changes of the transaction, after the commit."""
    pending: dict[tuple[type[Any], UUID], _Pending] | None = session.info.pop(PENDING_KEY, None)
    broker: Broker | None = session.info.get(BROKER_KEY)
    if not pending or broker is None:
        return
    changes = [
{% if scoped %}
        Change(item.entity.name, id, item.action, _audiences(item))
{% else %}
        Change(item.entity.name, id, item.action)
{% endif %}
        for (_, id), item in pending.items()
        if item.action is not None
    ]
    if changes:
        broker.publish(changes)


@event.listens_for(Session, "after_rollback")
def _after_rollback(session: Session) -> None:
    """Forget the changes of a transaction that rolls back."""
    session.info.pop(PENDING_KEY, None)
{% if scoped %}


def _audiences(item: _Pending) -> tuple[Audience, ...] | None:
    """Return the audiences of a change, or None if no record rule limits the reads."""
    limited = any(
        (rule := entities.get(item.entity.name)) is not None and rule.applies("read")
        for entities in RECORD_RULES.values()
    )
    if not limited:
        return None
    return tuple(a for a in (item.before, item.after) if a is not None)
{% endif %}


