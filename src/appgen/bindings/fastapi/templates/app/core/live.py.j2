@contextlib.contextmanager
def end_streams_on_exit(broker: Broker) -> Generator[None]:
    """End the open streams at SIGINT and SIGTERM, and then call the handler of the server.

    The server waits for the open requests before it stops, but a stream
    does not end by itself: without this handler, a stream stops a
    deployment or a reload. The server handles the signals in the main
    thread, so the handler does nothing in another thread.
    """
    if threading.current_thread() is not threading.main_thread():
        yield
        return
    loop = asyncio.get_running_loop()
    previous = {number: signal.getsignal(number) for number in (signal.SIGINT, signal.SIGTERM)}

    def handle(number: int, frame: FrameType | None) -> None:
        loop.call_soon_threadsafe(broker.end_streams)
        handler = previous[signal.Signals(number)]
        if callable(handler):
            handler(number, frame)
        elif handler is signal.SIG_DFL:
            signal.signal(number, signal.SIG_DFL)
            signal.raise_signal(number)

    for number in previous:
        signal.signal(number, handle)
    try:
        yield
    finally:
        for number, handler in previous.items():
            if handler is not None:
                signal.signal(number, handler)
