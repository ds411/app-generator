async def live_events(
    request: Request, viewer: Annotated[Viewer, Depends(live_viewer)]
) -> AsyncIterable[LiveEvent]:
    """Send the creates, the changes, and the deletes of the records that the client may read.

    The first event is `open`. An event has the entity and the ID of a
    record, but no values: the client reads the record again.
    """
    broker: Broker = request.app.state.live
    subscription = broker.subscribe(viewer)
    try:
        yield LiveEvent(type="open")
        while (event := await subscription.next()) is not None:
            yield event
    finally:
        broker.unsubscribe(subscription)


