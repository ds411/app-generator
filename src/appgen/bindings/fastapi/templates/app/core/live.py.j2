    responses=problem_responses(401),
    summary="Get a ticket for the stream of the changes",
    operation_id="live_ticket",
)
async def live_ticket(request: Request, user: CurrentUser) -> LiveTicket:
    """Return a ticket of the signed-in user for `GET /live?ticket=<ticket>`.

    A browser opens the stream with EventSource, which cannot send the
    header Authorization. The ticket is valid for TICKET_SECONDS: a URL can
    end in the log of a proxy, so the ticket must be short. The stream that
    it opens stays open.
    """
    payload = {"sub": str(user.id), "exp": int(time.time()) + TICKET_SECONDS}
    ticket = sign(signing_key(request), "live", payload)
    return LiveTicket(ticket=ticket, expires_in=TICKET_SECONDS)


