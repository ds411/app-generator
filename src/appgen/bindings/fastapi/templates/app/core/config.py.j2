{{ trace_header("app") }}
"""The settings of the app, from environment variables or a `.env` file."""

{% if definition.auth and definition.auth.password_reset %}
from typing import Literal

{% endif %}
from pydantic_settings import BaseSettings, SettingsConfigDict


class Settings(BaseSettings):
    """Each setting reads the environment variable with the same name in upper case."""

    model_config = SettingsConfigDict(env_file=".env", extra="ignore")

    database_url: str = "postgresql+asyncpg://app:app@localhost:5432/{{ py.package }}"
    """The URL of the database: Postgres with the asyncpg driver, or SQLite with the
    aiosqlite driver for local runs, for example `sqlite+aiosqlite:///./local.db`."""
    cors_origins: list[str] = []
    """The origins of the browser apps that can call the API."""
    log_level: str = "INFO"
    """The lowest level of the log lines: DEBUG, INFO, WARNING, or ERROR."""
    log_json: bool = True
    """Write each log line as a JSON object. Set it to false for plain text."""
    rate_limit_per_minute: int = 0
    """The number of requests that each client can send in each minute. 0 sets no limit."""
{% if definition.auth %}
    auth_secret: str = ""
    """The secret key that signs the sign-in tokens: a long random text (`AUTH_SECRET`)."""
{% endif %}
{% if definition.auth and definition.auth.password_reset %}
    password_reset_url: str = "http://localhost:5173/reset-password"
    """The page of the front end that sets a new password. The reset link adds `?token=...`."""
    environment: Literal["development", "production"] = "production"
    """`development` for a local run: the stub of the reset delivery writes the link to the log."""
{% endif %}
