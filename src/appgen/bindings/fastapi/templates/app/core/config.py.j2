{{ trace_header("app") }}
"""The settings of the app, from environment variables or a `.env` file."""

{% if py.message_elements or py.notice_emails %}
from typing import Literal

{% endif %}
{% if py.providers %}
from pydantic import Field
{% endif %}
from pydantic_settings import BaseSettings, SettingsConfigDict


class Settings(BaseSettings):
    """Each setting reads the environment variable with the same name in upper case."""

    model_config = SettingsConfigDict(env_file=".env", extra="ignore")

    database_url: str = "postgresql+asyncpg://app:app@localhost:5432/{{ py.package }}"
    """The URL of the database: Postgres with the asyncpg driver, or SQLite with the
    aiosqlite driver for local runs, for example `sqlite+aiosqlite:///./local.db`."""
    database_seed: bool = False
    """True: add the seed records when the app starts (`app/core/seed.py`)."""
{% if definition.auth and definition.auth.password %}
    seed_password: str = ""
    """With a value, the seed gives each new seed user this password. Use it only for
    local runs and tests."""
{% endif %}
    cors_origins: list[str] = []
    """The origins of the browser apps that can call the API."""
    log_level: str = "INFO"
    """The lowest level of the log lines: DEBUG, INFO, WARNING, or ERROR."""
    log_json: bool = True
    """Write each log line as a JSON object. Set it to false for plain text."""
    rate_limit_per_minute: int = 0
    """The number of requests that each client can send in each minute. 0 sets no limit."""
{% if py.redis %}
    rate_limit_store_url: str | None = None
    """The Redis of the rate limit, for example `redis://localhost:6379/0`, so that all
    replicas share one limit. Without it, each process counts in its memory."""
    rate_limit_fail_closed: bool = False
    """True: give 503 when the Redis of the rate limit is not available. False: log a
    warning, and let the request through."""
{% endif %}
{% if py.live %}
{% for id in py.live_ids %}
    {{ trace(id) }}
{% endfor %}
    live_events_url: str | None = None
    """The Redis of the live events, for example `redis://localhost:6379/0`, so that each
    replica gets the events of all replicas. Without it, each process sends only its own
    events (ADR 0051)."""
{% endif %}
{% if py.jobs %}
    jobs_interval_seconds: float = 60
    """The time between two passes of the worker over the jobs, in seconds."""
    jobs_window_minutes: int = 60
    """A pass runs the times of the jobs in the last minutes that are not done. A longer
    window catches up after a longer stop of the workers."""
    worker_port: int = 8001
    """The port of the health endpoint of the worker (`GET /health`). 0: no endpoint."""
{% endif %}
{% if definition.auth %}
    auth_secret: str = ""
    """The secret key that signs the sign-in tokens: a long random text (`AUTH_SECRET`)."""
{% endif %}
{% if definition.auth and definition.auth.password_reset %}
    password_reset_url: str = "http://localhost:5173/reset-password"
    """The page of the front end that sets a new password. The reset link adds `?token=...`."""
{% endif %}
{% if definition.auth and definition.auth.sign_up and definition.auth.sign_up.verify_email %}
    {{ trace(definition.auth.sign_up.verify_email.id) }}
    email_verify_url: str = "http://localhost:5173/verify-email"
    """The page of the front end that confirms an email address. The link adds `?token=...`."""
{% endif %}
{% if py.message_elements or py.notice_emails %}
    environment: Literal["development", "production"] = "production"
{% if py.smtp and not py.message_elements %}
    """`development` for a local run: without `SMTP_HOST`, the app writes the emails to the log."""
{% elif py.smtp %}
    """`development` for a local run: without `SMTP_HOST`, the app writes the links to the log."""
{% else %}
    """`development` for a local run: the stub of the delivery writes the links to the log."""
{% endif %}
{% endif %}
{% if py.smtp %}
    smtp_host: str = ""
    """The SMTP server that sends the messages of the sign-in. Empty: no delivery."""
    smtp_port: int = 587
    """The port of the SMTP server: usually 587 with `starttls`, and 465 with `tls`."""
    smtp_username: str = ""
    """The user name at the SMTP server. Empty: no sign-in at the server."""
    smtp_password: str = ""
    """The password at the SMTP server. Keep it out of the code."""
    smtp_from: str = ""
    """The sender of the messages, for example `Example <no-reply@example.com>`."""
    smtp_tls: Literal["starttls", "tls", "none"] = "starttls"
    """`starttls`: the connection changes to TLS. `tls`: TLS from the start. `none`: no
    TLS, only for a local test server."""
{% endif %}
{% if py.notice_emails %}
    front_end_url: str = "http://localhost:5173"
    """The URL of the front end for the browsers. The links of the emails of the notices
    start with it (ADR 0044)."""
{% endif %}
{% for api in py_apis.values() %}
    {{ trace(api.id) }}
    {{ api.url_setting }}: str = {{ api.base_url | tojson }}
    """The base URL of the API `{{ api.name }}` ({{ api.title }}): `{{ api.url_env }}`."""
{% if api.client_id_setting %}
    {{ api.client_id_setting }}: str = ""
    """The OAuth 2.0 client ID of the API `{{ api.name }}`: `{{ api.client_id_env }}`."""
{% endif %}
{% if api.username_setting %}
    {{ api.username_setting }}: str = ""
    """The user name of HTTP Basic of the API `{{ api.name }}`: `{{ api.username_env }}`."""
{% endif %}
{% if api.secret_setting %}
    {{ api.secret_setting }}: str = ""
    """The secret of the API `{{ api.name }}`: `{{ api.secret_env }}`. Keep it out of the code."""
{% endif %}
{% endfor %}
{% for w in py_webhooks.values() %}
    {{ trace(w.id) }}
    {{ w.secret_setting }}: str = ""
    """The secret of the signatures of the webhook `{{ w.name }}`: `{{ w.secret_env }}`."""
{% endfor %}
{% if py.storage %}
    {{ trace(py.storage.id) }}
    {{ py.storage.setting("folder_env") }}: str = "uploads"
{% if py.storage.s3 %}
    """The folder of the files of the file fields while `{{ py.storage.variables["bucket_env"] }}` has no value
    (`{{ py.storage.variables["folder_env"] }}`)."""
    {{ trace(py.storage.id) }}
    {{ py.storage.setting("bucket_env") }}: str = ""
    """The bucket of the files in an S3-compatible service (`{{ py.storage.variables["bucket_env"] }}`). Empty: the
    folder."""
    {{ trace(py.storage.id) }}
    {{ py.storage.setting("region_env") }}: str = ""
    """The region of the bucket (`{{ py.storage.variables["region_env"] }}`). Empty: the region of the AWS
    configuration of the machine."""
    {{ trace(py.storage.id) }}
    {{ py.storage.setting("endpoint_env") }}: str = ""
    """The URL of an S3-compatible service (`{{ py.storage.variables["endpoint_env"] }}`), for example
    `http://localhost:9000`. Empty: Amazon S3."""
    {{ trace(py.storage.id) }}
    {{ py.storage.setting("access_key_env") }}: str = ""
    """The access key ID of the bucket (`{{ py.storage.variables["access_key_env"] }}`). Empty: the AWS
    configuration of the machine, for example its role."""
    {{ trace(py.storage.id) }}
    {{ py.storage.setting("secret_key_env") }}: str = ""
    """The secret access key of the bucket (`{{ py.storage.variables["secret_key_env"] }}`). Keep it out of the
    code."""
{% else %}
    """The folder of the files of the file fields (`{{ py.storage.variables["folder_env"] }}`)."""
{% endif %}
    storage_link_secret: str = ""
    """The secret key that signs the links of the files: a long random text. Empty: each
    process signs with a random key, so a link works only in its process."""
    storage_link_seconds: int = 3600
    """The time that a link of a file works, in seconds."""
{% endif %}
{% if py.providers or py.storage or py_connections %}
    public_url: str = ""
{% if py.providers or py_connections %}
{% if py.providers and py_connections %}
    """The URL of the API for the browsers, for example `https://api.example.com`. The
    providers and the authorization servers of the APIs send the users back to it. Empty:
    the URL of each request."""
{% elif py.providers %}
    """The URL of the API for the browsers, for example `https://api.example.com`. The
    providers send the users back to it. Empty: the URL of each request."""
{% else %}
    """The URL of the API for the browsers, for example `https://api.example.com`. The
    authorization servers of the APIs send the users back to it. Empty: the URL of each
    request."""
{% endif %}
{% else %}
    """The URL of the API for the browsers, for example `https://api.example.com`. The
    links of the files start with it. Empty: the URL of each request."""
{% endif %}
{% endif %}
{% if py.providers %}
{% for p in py.providers %}
    {{ trace(p.id) }}
    {{ p.name }}_issuer: str = {{ p.issuer | tojson }}
    """The issuer URL of the provider `{{ p.name }}` (`{{ p.name | upper }}_ISSUER`)."""
    {{ p.name }}_client_id: str = Field(default="", validation_alias="{{ p.client_id_env }}")
    """The client ID of the app at the provider `{{ p.name }}` (`{{ p.client_id_env }}`)."""
    {{ p.name }}_client_secret: str = Field(default="", validation_alias="{{ p.client_secret_env }}")
    """The client secret of the app at the provider `{{ p.name }}` (`{{ p.client_secret_env }}`)."""
{% endfor %}
{% endif %}
