"""Errors in one JSON format: the problem details of RFC 9457 (`application/problem+json`)."""

from http import HTTPStatus
from typing import Any

from fastapi import FastAPI, Request
from fastapi.encoders import jsonable_encoder
from fastapi.exceptions import RequestValidationError
from fastapi.responses import JSONResponse
from pydantic import BaseModel
from starlette.exceptions import HTTPException
{% if i18n %}

from app.core.i18n import t
{% endif %}

PROBLEM_JSON = "application/problem+json"


class ProblemItem(BaseModel):
    """One error of the input."""

    loc: list[str | int]
    """The place of the error, for example `["body", "title"]`."""
    msg: str
    type: str


class Problem(BaseModel):
    """The body of an error response."""

    type: str = "about:blank"
    title: str
    status: int
    detail: str | None = None
    instance: str | None = None
    errors: list[ProblemItem] | None = None


class ProblemError(Exception):
    """An error that the API returns as problem details."""

    def __init__(self, status: int, detail: str | None = None) -> None:
        super().__init__(detail or HTTPStatus(status).phrase)
        self.status = status
        self.detail = detail


def problem_response(
    request: Request,
    status: int,
    detail: str | None = None,
    errors: list[ProblemItem] | None = None,
) -> JSONResponse:
    """Return an error response in the problem details format."""
    problem = Problem(
{% if i18n %}
        title=t(HTTPStatus(status).phrase),
{% else %}
        title=HTTPStatus(status).phrase,
{% endif %}
        status=status,
        detail=detail,
        instance=request.url.path,
        errors=errors,
    )
    return JSONResponse(
        problem.model_dump(mode="json", exclude_none=True),
        status_code=status,
        media_type=PROBLEM_JSON,
    )


def problem_responses(*statuses: int) -> dict[int | str, dict[str, Any]]:
    """Return the OpenAPI description of the error responses of an endpoint."""
    return {
        status: {
            "model": Problem,
            "description": HTTPStatus(status).phrase,
            "content": {PROBLEM_JSON: {}},
        }
        for status in statuses
    }


async def _problem_error(request: Request, error: Exception) -> JSONResponse:
    assert isinstance(error, ProblemError)
    return problem_response(request, error.status, error.detail)


async def _http_error(request: Request, error: Exception) -> JSONResponse:
    assert isinstance(error, HTTPException)
    detail = None if error.detail == HTTPStatus(error.status_code).phrase else str(error.detail)
{% if i18n %}
    return problem_response(request, error.status_code, detail and t(detail))
{% else %}
    return problem_response(request, error.status_code, detail)
{% endif %}


{% if i18n %}
def _input_message(item: dict[str, Any]) -> str:
    """Return the message of an input error in the language of the request.

    The messages are the messages of the form fields of the front ends.
    """
    context: dict[str, Any] = item.get("ctx") or {}
    match item["type"]:
        case "missing":
            return t("Enter a value.")
        case "string_too_short":
            return t("Use {count} or more characters.", count=context["min_length"])
        case "string_too_long":
            return t("Use {count} or fewer characters.", count=context["max_length"])
        case "greater_than_equal":
            return t("Use {count} or more.", count=context["ge"])
        case "less_than_equal":
            return t("Use {count} or less.", count=context["le"])
        case "int_type" | "int_parsing" | "int_from_float":
            return t("Enter a whole number.")
        case "decimal_type" | "decimal_parsing" | "float_type" | "float_parsing":
            return t("Enter a number.")
        case "string_pattern_mismatch":
            return t("Use the correct format.")
        case "enum" | "literal_error":
            return t("Select a value.")
        case kind if kind.startswith("url_"):
            return t("Enter a valid URL.")
        case "value_error" if str(item["msg"]).startswith("value is not a valid email address"):
            return t("Enter a valid email address.")
        case _:
            return t("The value is not valid.")


{% endif %}
async def _validation_error(request: Request, error: Exception) -> JSONResponse:
    assert isinstance(error, RequestValidationError)
    items = [
{% if i18n %}
        ProblemItem(loc=list(item["loc"]), msg=_input_message(item), type=str(item["type"]))
{% else %}
        ProblemItem(loc=list(item["loc"]), msg=str(item["msg"]), type=str(item["type"]))
{% endif %}
        for item in jsonable_encoder(error.errors())
    ]
    return problem_response(request, 422, {{ py.message("The request is not valid.") }}, items)


async def _not_implemented(request: Request, error: Exception) -> JSONResponse:
    return problem_response(request, 501, str(error) or None)


def add_problem_handlers(app: FastAPI) -> None:
    """Make the app return all errors as problem details."""
    app.add_exception_handler(ProblemError, _problem_error)
    app.add_exception_handler(HTTPException, _http_error)
    app.add_exception_handler(RequestValidationError, _validation_error)
    app.add_exception_handler(NotImplementedError, _not_implemented)
