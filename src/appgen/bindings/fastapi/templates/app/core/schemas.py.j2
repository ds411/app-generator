"""The base classes of the schemas of all slices."""

from pydantic import BaseModel, ConfigDict


class InputModel(BaseModel):
    """The base of the input schemas. It rejects unknown fields."""

    model_config = ConfigDict(
        extra="forbid",
        validate_by_name=True,
        validate_by_alias=True,
        serialize_by_alias=True,
    )


class ReadModel(BaseModel):
    """The base of the read schemas. It reads the attributes of a model object."""

    model_config = ConfigDict(
        from_attributes=True,
        validate_by_name=True,
        validate_by_alias=True,
        serialize_by_alias=True,
    )


def reject_null[M: BaseModel](model: M, *names: str) -> M:
    """Reject null for the fields that the request gives and that cannot be null."""
    for name in names:
        if name in model.model_fields_set and getattr(model, name) is None:
            raise ValueError(f"The field '{name}' cannot be null.")
    return model
