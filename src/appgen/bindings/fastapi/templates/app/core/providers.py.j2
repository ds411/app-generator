def callback_url(request: Request, name: str) -> str:
    """Return the URL that the provider sends the browser back to."""
    public_url: str = request.app.state.settings.public_url
    if public_url:
        return f"{public_url.rstrip('/')}/auth/providers/{name}/callback"
    return str(request.url_for("finish_provider_sign_in", name=name))


def _cookie(name: str) -> str:
    return f"provider_flow_{name}"


def _check_return_to(request: Request, return_to: str) -> None:
    origins: list[str] = request.app.state.settings.cors_origins
    parts = urlsplit(return_to)
    origin = f"{parts.scheme}://{parts.netloc}"
    if parts.scheme not in ("http", "https") or origin not in {o.rstrip("/") for o in origins}:
        {{ py.problem(422, "The origin of return_to is not in CORS_ORIGINS.", 8) }}


def _with_fragment(url: str, values: dict[str, Any]) -> str:
    return f"{url.partition('#')[0]}#{urlencode(values)}"


router = APIRouter(prefix="/auth/providers", tags=["Auth"])


@router.get(
    "/{name}/start",
    status_code=302,
    response_class=RedirectResponse,
    responses=problem_responses(422, 500, 502),
    operation_id="start_provider_sign_in",
)
async def start_provider_sign_in(
    name: ProviderName,
    request: Request,
    client: ProviderClient,
    return_to: Annotated[str | None, Query(max_length=2000)] = None,
) -> RedirectResponse:
    """Send the browser to the sign-in page of a provider."""
    provider = provider_of(request.app.state.settings, name)
    if return_to is not None:
        _check_return_to(request, return_to)
    metadata = await discover(client, provider)
    state, nonce, verifier = (secrets.token_urlsafe(32) for _ in range(3))
    challenge = base64.urlsafe_b64encode(hashlib.sha256(verifier.encode()).digest())
    redirect_uri = callback_url(request, name)
    # The parameters of the flow come last: the definition cannot change them.
    query = {
        **dict(provider.authorize_params),
        "response_type": "code",
        "client_id": provider.client_id,
        "redirect_uri": redirect_uri,
        "scope": provider.scope,
        "state": state,
        "nonce": nonce,
        "code_challenge": challenge.rstrip(b"=").decode(),
        "code_challenge_method": "S256",
    }
    separator = "&" if "?" in metadata.authorization_endpoint else "?"
    response = RedirectResponse(
        f"{metadata.authorization_endpoint}{separator}{urlencode(query)}", status_code=302
    )
    flow = {
        "state": state,
        "nonce": nonce,
        "verifier": verifier,
        "return_to": return_to,
        "exp": int(time.time()) + FLOW_SECONDS,
    }
    response.set_cookie(
        _cookie(name),
        sign(signing_key(request), f"provider-flow.{name}", flow),
        max_age=FLOW_SECONDS,
        httponly=True,
        samesite="lax",
        secure=redirect_uri.startswith("https://"),
    )
    return response


async def _sign_in(
    request: Request,
    session: AsyncSession,
    client: httpx.AsyncClient,
    name: ProviderName,
    flow: dict[str, Any],
    code: str | None,
    state: str | None,
    error: str | None,
) -> Token:
    if error is not None:
        {{ py.problem(401, "The provider gave the error '{error}'.", 8, error="error") }}
    if code is None or state is None or not hmac.compare_digest(state, str(flow["state"])):
        {{ py.problem(400, "The state of the callback is not correct. Sign in again.", 8) }}
    provider = provider_of(request.app.state.settings, name)
    metadata = await discover(client, provider)
    redirect_uri = callback_url(request, name)
    verifier = str(flow["verifier"])
    id_token = await _exchange(client, provider, metadata, code, redirect_uri, verifier)
    claims = await check_id_token(client, provider, metadata, id_token, str(flow["nonce"]))
    user = await user_of(session, provider, claims)
    return Token(access_token=make_token(signing_key(request), user.id))


@router.get(
    "/{name}/callback",
    response_model=Token,
    responses={
        303: {"description": "With return_to: the page, with the token or the error."},
        **problem_responses(400, 401, 403, 500, 502),
    },
    operation_id="finish_provider_sign_in",
)
async def finish_provider_sign_in(
    name: ProviderName,
    request: Request,
    response: Response,
    session: SessionDep,
    client: ProviderClient,
    code: Annotated[str | None, Query(max_length=2000)] = None,
    state: Annotated[str | None, Query(max_length=200)] = None,
    error: Annotated[str | None, Query(max_length=200)] = None,
) -> Token | RedirectResponse:
    """Check the answer of a provider, and give a token for the user."""
    cookie = request.cookies.get(_cookie(name), "")
    flow = unsign(signing_key(request), f"provider-flow.{name}", cookie)
    if flow is None:
        {{ py.problem(400, "The sign-in has no valid flow. Sign in again.", 8) }}
    return_to: str | None = flow.get("return_to")
    try:
        token = await _sign_in(request, session, client, name, flow, code, state, error)
    except ProblemError as problem:
        if return_to is None:
            raise
        target = _with_fragment(return_to, {"error": problem.detail or {{ py.message("The sign-in failed.") }}})
    else:
        if return_to is None:
            response.delete_cookie(_cookie(name))
            return token
        target = _with_fragment(return_to, token.model_dump())
    redirect = RedirectResponse(target, status_code=303)
    redirect.delete_cookie(_cookie(name))
    return redirect
{% if signs_out %}


@router.get(
    "/{name}/sign-out",
    status_code=303,
    response_class=RedirectResponse,
    responses=problem_responses(404, 422, 500, 502),
    operation_id="sign_out_at_provider",
)
async def sign_out_at_provider(
    name: ProviderName,
    request: Request,
    client: ProviderClient,
    return_to: Annotated[str, Query(max_length=2000)],
) -> RedirectResponse:
    """Send the browser to the logout URL of a provider with `sign_out`. The provider ends the
    session of the user, and sends the browser back to `return_to`."""
    provider = provider_of(request.app.state.settings, name)
    if not provider.sign_out:
        {{ py.problem(404, "The provider {name} has no sign-out.", 8, name="name") }}
    _check_return_to(request, return_to)
    endpoint = provider.sign_out_url or (await discover(client, provider)).end_session_endpoint
    if not endpoint:
        # The session of the app has ended, but the provider gives no logout URL.
        logger.warning("The provider %s has no logout URL. Set its sign-out URL.", name)
        return RedirectResponse(return_to, status_code=303)
    query = {"client_id": provider.client_id, provider.sign_out_return_param: return_to}
    separator = "&" if "?" in endpoint else "?"
    return RedirectResponse(f"{endpoint}{separator}{urlencode(query)}", status_code=303)
