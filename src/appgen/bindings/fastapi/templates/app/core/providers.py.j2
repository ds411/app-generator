@dataclass(frozen=True, slots=True)
class Provider:
    """A provider of the definition, with the values of its settings."""

    name: str
    issuer: str
    client_id: str
    client_secret: str
    scope: str
    username_claim: str
    create_users: bool = False
    default_role: str | None = None
    claims: tuple[tuple[str, str], ...] = ()
    """The fields of a new user, and the claims that give their values."""
    authorize_params: tuple[tuple[str, str], ...] = ()
    """The fixed parameters of the authorization request, for example the identity provider."""
    trust_email: bool = False
    """Accept an email address that the ID token does not mark as verified."""
{% if grouped %}
    roles_claim: str | None = None
    """The claim with the groups of the user: the app sets the role at each sign-in."""
    role_map: tuple[tuple[str, str], ...] = ()
    """Each group and its role, in the order of the check."""
{% endif %}
{% if signs_out %}
    sign_out: bool = False
    """End the session at the provider at the sign-out of the app."""
    sign_out_url: str = ""
