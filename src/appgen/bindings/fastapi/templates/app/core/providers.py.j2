FLOW_SECONDS = 600
"""The time that a user has for the sign-in at the provider."""
ALGORITHMS = frozenset(
    {"ES256", "ES384", "ES512", "EdDSA", "PS256", "PS384", "PS512", "RS256", "RS384", "RS512"}
)
"""The signature algorithms of the ID tokens that the app accepts: no symmetric algorithm."""
LEEWAY_SECONDS = 60
"""The difference of the clocks of the app and of a provider that the checks accept."""

