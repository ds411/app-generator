FLOW_SECONDS = 600
"""The time that a user has for the sign-in at the provider."""
ALGORITHMS = frozenset(
    {"ES256", "ES384", "ES512", "EdDSA", "PS256", "PS384", "PS512", "RS256", "RS384", "RS512"}
)
"""The signature algorithms of the ID tokens that the app accepts: no symmetric algorithm."""
LEEWAY_SECONDS = 60
"""The difference of the clocks of the app and of a provider that the checks accept."""

ProviderName = Literal[{{ py.providers | map(attribute="name") | map("tojson") | join(", ") }}]
"""The names of the providers."""


@dataclass(frozen=True, slots=True)
class Provider:
    """A provider of the definition, with the values of its settings."""

    name: str
    issuer: str
    client_id: str
    client_secret: str
    scope: str
    username_claim: str
    create_users: bool = False
    default_role: str | None = None
    claims: tuple[tuple[str, str], ...] = ()
    """The fields of a new user, and the claims that give their values."""


def provider_of(settings: Settings, name: ProviderName) -> Provider:
    """Return a provider with the values of its settings. Give 500 without a client ID."""
    providers = {
{% for p in py.providers %}
        {{ trace(p.id) }}
        "{{ p.name }}": Provider(
            name="{{ p.name }}",
            issuer=settings.{{ p.name }}_issuer,
            client_id=settings.{{ p.name }}_client_id,
            client_secret=settings.{{ p.name }}_client_secret,
            scope={{ p.scope | tojson }},
            username_claim={{ p.username_claim | tojson }},
{% if p.create_users %}
            create_users=True,
{% if p.default_role and role %}
            default_role="{{ p.default_role }}",
{% endif %}
{% if p.claims %}
            claims=({% for f, claim in p.claims %}("{{ f.attr }}", {{ claim | tojson }}),{% if not loop.last %} {% endif %}{% endfor %}),
{% endif %}
{% endif %}
        ),
{% endfor %}
    }
    provider = providers[name]
    if not provider.client_id or not provider.client_secret:
        {{ py.problem(500, "The server has no client ID or client secret for {name}.", 8, name="name") }}
    return provider


class ProviderMetadata(BaseModel):
    """The parts of the discovery document of a provider that the app uses."""

    issuer: str
    authorization_endpoint: str
    token_endpoint: str
    jwks_uri: str


class TokenAnswer(BaseModel):
    """The part of the answer of the token endpoint of a provider that the app uses."""

    id_token: str


async def provider_client() -> AsyncIterator[httpx.AsyncClient]:
    """The HTTP client for the requests to the providers. The tests replace it."""
    async with httpx.AsyncClient(timeout=10) as client:
        yield client


ProviderClient = Annotated[httpx.AsyncClient, Depends(provider_client)]


async def _get_json(client: httpx.AsyncClient, url: str) -> Any:
    try:
        response = await client.get(url, headers={"Accept": "application/json"})
        response.raise_for_status()
        return response.json()
    except (httpx.HTTPError, ValueError) as error:
        {{ py.problem(502, "The provider did not answer correctly: {url}", 8, suffix=" from error", url="url") }}


async def discover(client: httpx.AsyncClient, provider: Provider) -> ProviderMetadata:
    """Return the discovery document of a provider. Its issuer must be the issuer of the settings."""
    url = provider.issuer.rstrip("/") + "/.well-known/openid-configuration"
    try:
        metadata = ProviderMetadata.model_validate(await _get_json(client, url))
    except ValueError as error:
        {{ py.problem(502, "The discovery document of the provider is not valid.", 8, suffix=" from error") }}
    if metadata.issuer != provider.issuer:
        {{ py.problem(502, "The discovery document of the provider has another issuer.", 8) }}
    return metadata


async def _exchange(
    client: httpx.AsyncClient,
    provider: Provider,
    metadata: ProviderMetadata,
    code: str,
    redirect_uri: str,
    verifier: str,
) -> str:
    """Change the code of the callback for an ID token at the token endpoint of a provider."""
    data = {
        "grant_type": "authorization_code",
        "code": code,
        "redirect_uri": redirect_uri,
        "code_verifier": verifier,
    }
    # RFC 6749: the client ID and the secret of the basic scheme are URL encoded.
    auth = (quote(provider.client_id, safe=""), quote(provider.client_secret, safe=""))
    try:
        response = await client.post(
            metadata.token_endpoint, data=data, auth=auth, headers={"Accept": "application/json"}
        )
    except httpx.HTTPError as error:
        {{ py.problem(502, "The token endpoint of the provider did not answer.", 8, suffix=" from error") }}
    if response.status_code in (400, 401):
        {{ py.problem(401, "The provider did not accept the code. Start the sign-in again.", 8) }}
    try:
        response.raise_for_status()
        return TokenAnswer.model_validate(response.json()).id_token
    except (httpx.HTTPError, ValueError) as error:
        {{ py.problem(502, "The token endpoint of the provider gave no ID token.", 8, suffix=" from error") }}


async def check_id_token(
    client: httpx.AsyncClient,
    provider: Provider,
    metadata: ProviderMetadata,
    id_token: str,
    nonce: str,
) -> dict[str, Any]:
    """Return the claims of a valid ID token, else give 401.

    The signature must come from a key of the provider (its JWKS), and the
    token must have the issuer, the audience (the client ID), a time that
    has not ended, and the nonce of the flow.
    """
    try:
        kid = jwt.get_unverified_header(id_token).get("kid")
        keys = jwt.PyJWKSet.from_dict(await _get_json(client, metadata.jwks_uri)).keys
        found = [k for k in keys if kid is None or k.key_id == kid]
        if len(found) != 1 or found[0].algorithm_name not in ALGORITHMS:
            {{ py.problem(401, "The ID token is not valid: the provider has no key for it.", 12) }}
        claims = jwt.decode(
            id_token,
            found[0].key,
            algorithms=[found[0].algorithm_name],
            audience=provider.client_id,
            issuer=provider.issuer,
            leeway=LEEWAY_SECONDS,
            options={"require": ["aud", "exp", "iat", "iss", "nonce", "sub"]},
        )
    except jwt.PyJWTError as error:
        {{ py.problem(401, "The ID token is not valid: {error}", 8, suffix=" from error", error="error") }}
    if not hmac.compare_digest(str(claims["nonce"]), nonce):
        {{ py.problem(401, "The ID token is not valid: the nonce is not the one of the flow.", 8) }}
    return claims


async def user_of(
    session: AsyncSession,
    provider: Provider,
    claims: dict[str, Any],
) -> {{ u.name }}:
    """Return the user of the claims of an ID token. With `create_users`, make a new user."""
    username = claims.get(provider.username_claim)
    if not isinstance(username, str) or not username:
        {{ py.problem(401, "The ID token has no claim '{claim}'.", 8, claim="provider.username_claim") }}
    if provider.username_claim == "email" and claims.get("email_verified") in (False, "false"):
        {{ py.problem(401, "The provider did not verify the email address.", 8) }}
    user = await find_user(session, username)
    if user is not None:
{% if verify %}
        {{ trace(verify.id) }}
        email = claims.get("email")
        if claims.get("email_verified") in (True, "true") and email == user.{{ address.attr }}:
            await remove_unverified_password(session, user)
{% endif %}
        return user
{% if creates %}
    if not provider.create_users:
        {{ py.problem(403, "No user has the user name {username}. Ask an administrator.", 8, username="username") }}
    values: dict[str, Any] = {attr: claims.get(claim) for attr, claim in provider.claims}
    values["{{ username.attr }}"] = username
{% if role %}
