EVENT_KEY = "appgen.event"
"""The key of `session.info` while the operation of an event runs (ADR 0031)."""


{% endif %}
{% if py.history and definition.auth %}
USER_KEY = "appgen.user"
"""The key of `session.info` with the ID of the signed-in user, for the change log (ADR 0040)."""


{% endif %}
async def commit(session: AsyncSession) -> None:
{% if py.events %}
    """Commit the session. A broken constraint gives a 409 Conflict error.

    In the operation of an event, it only writes the changes to the
    database: the change that started the event commits them, so that an
    error rolls back the change and the work of the operation together.
    """
    if session.info.get(EVENT_KEY):
        await flush(session)
        return
{% else %}
    """Commit the session. A broken constraint gives a 409 Conflict error."""
{% endif %}
    try:
        await session.commit()
    except IntegrityError as error:
        await session.rollback()
        raise ProblemError(409, {{ "t(CONFLICT)" if i18n else "CONFLICT" }}) from error


async def flush(session: AsyncSession) -> None:
    """Write the changes to the database in the open transaction, without a commit.

    A broken constraint gives a 409 Conflict error.
    """
    try:
        await session.flush()
    except IntegrityError as error:
        await session.rollback()
        raise ProblemError(409, {{ "t(CONFLICT)" if i18n else "CONFLICT" }}) from error


{% if py.events %}
async def run_event[**P](
    session: AsyncSession,
    operation: Callable[P, Awaitable[object]],
    *args: P.args,
    **kwargs: P.kwargs,
) -> None:
    """Run the operation of an event in the transaction of the change that started it.

    A change in the operation of an event starts no other event: the
    events stop after one level, so that two events cannot start each
    other without end. In the operation, `commit()` does not commit.
    """
    if session.info.get(EVENT_KEY):
        return
    session.info[EVENT_KEY] = True
    try:
        await operation(*args, **kwargs)
    finally:
        del session.info[EVENT_KEY]


{% endif %}
async def ensure_exists[M: Record](
    session: AsyncSession, model: type[M], id: UUID, field: str
) -> None:
    """Check that the record of a foreign key exists. Else give a 422 error."""
    if await session.get(model, id) is None:
{% if i18n %}
        raise ProblemError(
            422,
            t(
                "The field '{field}' refers to {entity} {id}, which does not exist.",
                field=field,
                entity=model.__name__,
                id=id,
            ),
        )
{% else %}
        raise ProblemError(
            422, f"The field '{field}' refers to {model.__name__} {id}, which does not exist."
        )
{% endif %}


async def load_all[M: Record](
    session: AsyncSession, model: type[M], ids: Sequence[UUID], field: str
) -> list[M]:
    """Return the records of a list of IDs. Give a 422 error if one does not exist."""
    records = list(await session.scalars(select(model).where(model.id.in_(ids))))
    missing = set(ids) - {record.id for record in records}
    if missing:
        names = ", ".join(sorted(str(id) for id in missing))
{% if i18n %}
        raise ProblemError(
            422,
            t(
                "The field '{field}' refers to {entity} records that do not exist: {ids}.",
                field=field,
                entity=model.__name__,
                ids=names,
            ),
        )
{% else %}
        raise ProblemError(
            422,
            f"The field '{field}' refers to {model.__name__} records that do not exist: {names}.",
        )
{% endif %}
    return records
