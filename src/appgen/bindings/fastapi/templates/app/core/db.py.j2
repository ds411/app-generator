"""The database: the model base class, the engine, and one session for each request."""

import datetime as dt
from collections.abc import AsyncIterator, Sequence
from enum import StrEnum
from typing import Annotated, Any
from uuid import UUID, uuid4

from fastapi import Depends, Request
from sqlalchemy import JSON, DateTime, Dialect, Enum, MetaData, TypeDecorator, event, select
from sqlalchemy.dialects.postgresql import JSONB
from sqlalchemy.exc import IntegrityError
from sqlalchemy.ext.asyncio import (
    AsyncEngine,
    AsyncSession,
    async_sessionmaker,
    create_async_engine,
)
from sqlalchemy.orm import DeclarativeBase, Mapped, mapped_column

from app.core.errors import ProblemError
{% if i18n %}
from app.core.i18n import t
{% endif %}

# Fixed names for the constraints, so that the migrations and the models agree.
NAMING_CONVENTION = {
    "ix": "ix_%(table_name)s_%(column_0_name)s",
    "uq": "uq_%(table_name)s_%(column_0_name)s",
    "fk": "fk_%(table_name)s_%(column_0_name)s_%(referred_table_name)s",
    "pk": "pk_%(table_name)s",
}


class Base(DeclarativeBase):
    """The base class of the models of all slices."""

    metadata = MetaData(naming_convention=NAMING_CONVENTION)


class Record(Base):
    """The base class of the models of the entities: each has a UUID as primary key."""

    __abstract__ = True

    id: Mapped[UUID] = mapped_column(primary_key=True, default=uuid4)


def _enum_values(enum: type[StrEnum]) -> list[str]:
    return [member.value for member in enum]


def enum_type(enum: type[StrEnum], name: str) -> Enum:
    """Return a column type for an enum: text with a check constraint, not a Postgres enum."""
    return Enum(
        enum,
        name=name,
        native_enum=False,
        create_constraint=True,
        length=max(len(member.value) for member in enum),
        values_callable=_enum_values,
        validate_strings=True,
    )


JSON_TYPE = JSON().with_variant(JSONB(), "postgresql")
"""The column type of JSON values: JSONB on Postgres, and JSON text on SQLite."""


class Timestamp(TypeDecorator[dt.datetime]):
    """A date and time with a time zone.

    Postgres keeps the time zone. SQLite does not, so on SQLite the type
    stores the time in UTC and reads it back as UTC.
    """

    impl = DateTime(timezone=True)
    cache_ok = True

    def process_bind_param(self, value: dt.datetime | None, dialect: Dialect) -> dt.datetime | None:
        if value is not None and dialect.name == "sqlite" and value.tzinfo is not None:
            return value.astimezone(dt.UTC).replace(tzinfo=None)
        return value

    def process_result_value(
        self, value: dt.datetime | None, dialect: Dialect
    ) -> dt.datetime | None:
        if value is not None and value.tzinfo is None:
            return value.replace(tzinfo=dt.UTC)
        return value


def _enable_foreign_keys(connection: Any, _record: Any) -> None:
    cursor = connection.cursor()
    cursor.execute("PRAGMA foreign_keys=ON")
    cursor.close()


def make_engine(database_url: str) -> AsyncEngine:
    """Return the engine of the app. It connects only when a session needs it.

    The URL selects the database: Postgres (`postgresql+asyncpg://`), or
    SQLite (`sqlite+aiosqlite://`) for local runs. SQLite checks the
    foreign keys only when each connection turns the check on.
    """
    engine = create_async_engine(database_url, pool_pre_ping=True)
    if engine.dialect.name == "sqlite":
        event.listen(engine.sync_engine, "connect", _enable_foreign_keys)
    return engine


def make_sessions(engine: AsyncEngine) -> async_sessionmaker[AsyncSession]:
    """Return the factory of the sessions. The objects stay usable after a commit."""
    return async_sessionmaker(engine, expire_on_commit=False)


async def get_session(request: Request) -> AsyncIterator[AsyncSession]:
    """Give each request its own session, and close the session after the response."""
    sessions: async_sessionmaker[AsyncSession] = request.app.state.sessions
    async with sessions() as session:
        yield session


SessionDep = Annotated[AsyncSession, Depends(get_session)]
"""The type of an endpoint parameter that gets the session of the request."""


CONFLICT = (
    "The change breaks a rule of the data: a value must be unique, "
    "or other records refer to this record."
)


async def commit(session: AsyncSession) -> None:
    """Commit the session. A broken constraint gives a 409 Conflict error."""
    try:
        await session.commit()
    except IntegrityError as error:
        await session.rollback()
        raise ProblemError(409, {{ "t(CONFLICT)" if i18n else "CONFLICT" }}) from error


async def flush(session: AsyncSession) -> None:
    """Write the changes to the database in the open transaction, without a commit.

    A broken constraint gives a 409 Conflict error.
    """
    try:
        await session.flush()
    except IntegrityError as error:
        await session.rollback()
        raise ProblemError(409, {{ "t(CONFLICT)" if i18n else "CONFLICT" }}) from error


async def ensure_exists[M: Record](
    session: AsyncSession, model: type[M], id: UUID, field: str
) -> None:
    """Check that the record of a foreign key exists. Else give a 422 error."""
    if await session.get(model, id) is None:
{% if i18n %}
        raise ProblemError(
            422,
            t(
                "The field '{field}' refers to {entity} {id}, which does not exist.",
                field=field,
                entity=model.__name__,
                id=id,
            ),
        )
{% else %}
        raise ProblemError(
            422, f"The field '{field}' refers to {model.__name__} {id}, which does not exist."
        )
{% endif %}


async def load_all[M: Record](
    session: AsyncSession, model: type[M], ids: Sequence[UUID], field: str
) -> list[M]:
    """Return the records of a list of IDs. Give a 422 error if one does not exist."""
    records = list(await session.scalars(select(model).where(model.id.in_(ids))))
    missing = set(ids) - {record.id for record in records}
    if missing:
        names = ", ".join(sorted(str(id) for id in missing))
{% if i18n %}
        raise ProblemError(
            422,
            t(
                "The field '{field}' refers to {entity} records that do not exist: {ids}.",
                field=field,
                entity=model.__name__,
                ids=names,
            ),
        )
{% else %}
        raise ProblemError(
            422,
            f"The field '{field}' refers to {model.__name__} records that do not exist: {names}.",
        )
{% endif %}
    return records
