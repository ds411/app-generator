"""Pagination, sorting, search, and date ranges of the list endpoints."""

import datetime as dt
from collections.abc import Mapping
from typing import Any

from pydantic import BaseModel, Field
from sqlalchemy import ColumnElement, ScalarSelect, UnaryExpression, select
from sqlalchemy.orm import InstrumentedAttribute

from app.core.errors import ProblemError
{% if i18n %}
from app.core.i18n import t
{% endif %}


class PageParams(BaseModel):
    """The query parameters of the page of a list endpoint or a query endpoint."""

    limit: int = Field(default=50, ge=1, le=200, description="The maximum count of items.")
    offset: int = Field(default=0, ge=0, description="The count of items to skip.")


class PageQuery(PageParams):
    """The query parameters of a list endpoint for the page and the order."""

    sort: str | None = Field(
        default=None,
        description="Sort keys, with a comma between them. A `-` before a key sorts "
        "in descending order, for example `-due_date,title`. Empty values come last.",
    )


class Page[T](BaseModel):
    """One page of the items of a list endpoint or a query endpoint."""

    items: list[T]
    total: int
    """The count of all items that agree with the filters."""
    limit: int
    offset: int


def sort_order(
    sort: str | None,
    columns: Mapping[str, InstrumentedAttribute[Any] | ColumnElement[Any]],
    default: InstrumentedAttribute[Any],
{% if py.full_text %}
    rank: ColumnElement[float] | None = None,
{% endif %}
) -> list[UnaryExpression[Any]]:
    """Return the ORDER BY terms for a sort parameter. The default column ends the order.

    Empty values come last in both directions, on Postgres and on SQLite.
{% if py.full_text %}
    Without a sort, the rank of the full-text search comes first, if any.
{% endif %}
    """
    terms: list[UnaryExpression[Any]] = []
    for part in (sort or "").split(","):
        name = part.strip()
        if not name:
            continue
        descending = name.startswith("-")
        column = columns.get(name.removeprefix("-"))
        if column is None:
            names = ", ".join(sorted(columns))
{% if i18n %}
            raise ProblemError(
                422, t("Cannot sort by '{name}'. Use one of: {names}.", name=name, names=names)
            )
{% else %}
            raise ProblemError(422, f"Cannot sort by '{name}'. Use one of: {names}.")
{% endif %}
        terms.append((column.desc() if descending else column.asc()).nulls_last())
{% if py.full_text %}
    if not terms and rank is not None:
        terms.append(rank.desc())
{% endif %}
    terms.append(default.asc())
    return terms


def lookup(column: InstrumentedAttribute[Any], *where: ColumnElement[bool]) -> ScalarSelect[Any]:
    """Return the value of a related record, for a sort key of a field path."""
    return select(column).where(*where).scalar_subquery()


def search_words(text: str | None) -> list[str]:
    """Return the words of a search. A record must have each word in one of its fields."""
    return (text or "").split()


def contains(column: InstrumentedAttribute[Any], word: str) -> ColumnElement[bool]:
    """Return a condition: the text column contains the word, in any case.

    The condition is `ILIKE` on Postgres and `LIKE` on SQLite. The `%` and
    `_` of the word are plain characters.
    """
    escaped = word.replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_")
    return column.ilike(f"%{escaped}%", escape="\\")


def day_start(day: dt.date, days: int = 0) -> dt.datetime:
    """Return the start of a day in UTC, a number of days later.

    A date range on a date-time field takes the records from the start of
    the first day to the start of the day after the last day.
    """
    return dt.datetime.combine(day + dt.timedelta(days=days), dt.time.min, tzinfo=dt.UTC)
{% if py.free_dates %}


def range_end(first: dt.date, end: dt.date | None) -> dt.date:
    """Return the end of the days of an available filter of date fields (ADR 0047).

    The days are a range as the ranges of the related records: `end` is the
    first day after the range, for example a check-out. Without an end after
    the first day, the range is the first day.
    """
    return end if end is not None and end > first else first + dt.timedelta(days=1)
{% endif %}
