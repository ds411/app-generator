"""Pagination and sorting of the list endpoints."""

from collections.abc import Mapping
from typing import Any

from pydantic import BaseModel, Field
from sqlalchemy import UnaryExpression
from sqlalchemy.orm import InstrumentedAttribute

from app.core.errors import ProblemError


class PageQuery(BaseModel):
    """The query parameters of a list endpoint for the page and the order."""

    limit: int = Field(default=50, ge=1, le=200, description="The maximum count of items.")
    offset: int = Field(default=0, ge=0, description="The count of items to skip.")
    sort: str | None = Field(
        default=None,
        description="Field names, with a comma between them. A `-` before a name sorts "
        "in descending order, for example `-due_date,title`.",
    )


class Page[T](BaseModel):
    """One page of the items of a list endpoint."""

    items: list[T]
    total: int
    """The count of all items that agree with the filters."""
    limit: int
    offset: int


def sort_order(
    sort: str | None,
    columns: Mapping[str, InstrumentedAttribute[Any]],
    default: InstrumentedAttribute[Any],
) -> list[UnaryExpression[Any]]:
    """Return the ORDER BY terms for a sort parameter. The default column ends the order."""
    terms: list[UnaryExpression[Any]] = []
    for part in (sort or "").split(","):
        name = part.strip()
        if not name:
            continue
        descending = name.startswith("-")
        column = columns.get(name.removeprefix("-"))
        if column is None:
            names = ", ".join(sorted(columns))
            raise ProblemError(422, f"Cannot sort by '{name}'. Use one of: {names}.")
        terms.append(column.desc() if descending else column.asc())
    terms.append(default.asc())
    return terms
