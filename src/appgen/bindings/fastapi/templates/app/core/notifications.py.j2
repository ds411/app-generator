"""The notices of the users (ADR 0041): who gets a notice when a record changes, and its text.

A change of a record that a notification of the app definition names
adds a notice for each receiver, except the user that made the change,
in the transaction of the change. The repository of the entity adds the
notices, after the events and the change log, so that the generated and
the custom operations both add them. A notice keeps the values of its
text from the time of the change, and the text has the language of the
request that lists it (`app/core/notices.py`).
{% if py.mentions %}

A `text` field with mentions (ADR 0043) gives a notice to each user that
a new or a changed text mentions for the first time. A mention is
`@[<name>](<ID of the user>)`.
{% endif %}
{% if py.notice_emails %}

The notices of a notification with `email: true` (ADR 0044) wait for
their emails: the job `notice_emails` sends them. The table
`notice_settings` keeps the choices of the users about the emails.
{% endif %}
"""

import datetime as dt
import re
from collections.abc import Iterable, Mapping, Sequence
from decimal import Decimal
from enum import Enum
from typing import Any
from uuid import UUID, uuid4

from pydantic import BaseModel, Field
from sqlalchemy import ForeignKey, {{ "Index, " if py.notice_emails }}String, select
from sqlalchemy.ext.asyncio import AsyncSession
from sqlalchemy.orm import InstrumentedAttribute, Mapped, aliased, mapped_column

from app.core.db import JSON_TYPE, USER_KEY, Base, Timestamp, flush
{% if i18n %}
from app.core.i18n import t
{% endif %}
from app.core.schemas import ReadModel

{% if py.mentions %}
MENTION = "@mention"
"""The notification of the mentions: a notification of the definition has no `@`."""
{% endif %}
TEXTS: dict[str, str] = {
{% for n in py.notifications %}
    {{ trace(n.id) }}
    {{ py.string(n.name) }}: {{ py.string(n.text) }},
{% endfor %}
{% if py.mentions %}
    MENTION: "You are mentioned in {record}.",
{% endif %}
}
"""The text of each notification, by name: a name in braces is a value of the record."""
{% if py.notice_emails %}
EMAILS = frozenset(
    {
{% for name in py.notice_emails.names %}
        {{ py.string(name) }},
{% endfor %}
    }
)
"""The notifications with emails (ADR 0044): their notices wait for the job `notice_emails`."""
{% endif %}
_VALUE = re.compile(r"\{(\w+)\}")
{% if py.mentions %}
_UUID = r"[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"
_MENTION = re.compile(r"@\[([^\[\]\n]+)\]\((" + _UUID + r")\)")
"""A mention of a user in a text: the name and the ID of the user."""
{% endif %}


class Notice(Base):
    """A notice for a user: a change of a record that concerns the user."""

    __tablename__ = "notices"

    id: Mapped[UUID] = mapped_column(primary_key=True, default=uuid4)
{% set fk = 'ForeignKey("' ~ u.table ~ '.id", ondelete="CASCADE"), index=True' %}
{% if (fk | length) + 43 <= 100 %}
