def text_value(value: object) -> str:
    """Return a value of a record as text, for the text of a notice.

    An enum gives its value, a decimal number has no zeros at the end, a
    time is in UTC, and an empty value is an empty text.
    """
    if value is None:
        return ""
    if isinstance(value, Enum):
        return str(value.value)
    if isinstance(value, Decimal):
        return format(value.normalize(), "f")
    if isinstance(value, dt.datetime):
        return value.astimezone(dt.UTC).strftime("%Y-%m-%d %H:%M UTC")
    if isinstance(value, dt.date):
        return value.isoformat()
    return str(value)


async def record_text(
    session: AsyncSession,
    label: InstrumentedAttribute[Any],
    key: InstrumentedAttribute[UUID],
    id: UUID | None,
) -> str:
    """Return the display value of the record of a relation: `label` of the record with the ID."""
    if id is None:
        return ""
    return text_value(await session.scalar(select(label).where(key == id)))


def changed(record: object, before: Mapping[str, Any], attrs: Iterable[str]) -> bool:
    """Return True if a change gave one of the attributes of a record a new value."""
    return any(getattr(record, attr) != before[attr] for attr in attrs)


async def path_users(
    session: AsyncSession, model: type[Any], record_id: UUID, path: Sequence[str]
) -> list[UUID]:
    """Return the IDs of the users at the end of a path of relations of a record.

    Each step is a many-to-one or a many-to-many relation. The changes of
    the transaction go to the database first, so that the new links count.
    """
    await flush(session)
    ids = [record_id]
    for attr in path:
        relation = getattr(model, attr)
        target: type[Any] = relation.property.mapper.class_
        step = aliased(target)
        statement = (
            select(step.id).join_from(model, relation.of_type(step)).where(model.id.in_(ids))
        )
        ids = list(await session.scalars(statement))
        model = target
    return ids


def add_notices(
    session: AsyncSession,
    notification: str,
    entity: str,
    record_id: UUID,
    users: Iterable[UUID | None],
    values: Mapping[str, str],
) -> list[Notice]:
    """Add a notice for each user to the session, without a commit, and return the notices.

    Each user gets one notice. The user that made the change gets none.
    """
    actor: UUID | None = session.info.get(USER_KEY)
    at = dt.datetime.now(dt.UTC)
{% if py.notice_emails %}
    # A notice of a notification with emails waits for its email (ADR 0044).
    email = notification in EMAILS
{% endif %}
    notices = [
        Notice(
            id=uuid4(),
            user_id=user,
            notification=notification,
            entity=entity,
            record_id=record_id,
            actor_id=actor,
            values=dict(values),
            at=at,
{% if py.notice_emails %}
            email=email,
{% endif %}
        )
        for user in dict.fromkeys(users)
        if user is not None and user != actor
    ]
    session.add_all(notices)
    return notices


{% if py.mentions %}
def mentioned(text: str | None) -> list[UUID]:
    """Return the IDs of the users that a text mentions, each one time, in their order."""
    return list(dict.fromkeys(UUID(match[2]) for match in _MENTION.finditer(text or "")))


async def add_mentions(
    session: AsyncSession,
    users: InstrumentedAttribute[UUID],
    entity: str,
    record_id: UUID,
    record: str,
    text: str | None,
    before: str | None,
) -> list[Notice]:
    """Add a notice for each user that a text mentions and the text before did not.

    `users` is the ID column of the users: a mention of an ID without a
    user gives no notice. The user that made the change gets none.
    """
    old = set(mentioned(before))
    new = [user for user in mentioned(text) if user not in old]
    if not new:
        return []
    found = set(await session.scalars(select(users).where(users.in_(new))))
    users_found = [user for user in new if user in found]
    return add_notices(session, MENTION, entity, record_id, users_found, {"record": record})


{% endif %}
def notice_text(notice: Notice) -> str:
    """Return the text of a notice in the language of the request, with its values.

    A value can have any name, also `text`, so the values go into the
    translation here, and not as the arguments of `t`.
    """
{% if i18n %}
    text = t(TEXTS.get(notice.notification, notice.notification))
{% else %}
    text = TEXTS.get(notice.notification, notice.notification)
{% endif %}
    values = notice.values
    return _VALUE.sub(lambda m: values.get(m[1], m[0]), text)
