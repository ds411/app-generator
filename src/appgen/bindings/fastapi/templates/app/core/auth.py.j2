async def send_verification(request: Request, user: {{ u.name }}) -> None:
    """Send a user the message with the link that confirms the email address."""
    settings = request.app.state.settings
    expires = int(time.time()) + VERIFY_SECONDS
    token = make_verification_token(signing_key(request), user.id, user.{{ address.attr }}, expires)
    link = f"{settings.email_verify_url}?token={token}"
    await deliver_message(settings, email_verification_message(user, link))
