class PasswordResetRequest(BaseModel):
    """The user name of a user who forgot the password."""

    username: str = Field(min_length=1, max_length=320)


class PasswordResetRequested(BaseModel):
    """The answer to a reset request. It is the same for each user name."""

    detail: str = "If the user name exists, the user gets a message with a reset link."


class PasswordReset(BaseModel):
    """The token of a reset link, and the new password."""

    token: str = Field(min_length=1, max_length=1000)
    new_password: str = Field(min_length=MIN_PASSWORD_LENGTH, max_length=200)
