def password_tag(password_hash: str | None) -> str:
    """Return a short hash of a stored password hash. Each new password gives a new tag."""
    return hashlib.sha256((password_hash or "").encode()).hexdigest()[:32]


def make_reset_token(key: bytes, user_id: UUID, password_hash: str | None, expires: int) -> str:
    """Return a signed one-time token for a password reset, valid until the time `expires`.

    The token holds the tag of the current password hash, so that a new
    password (also the one of the reset) makes the token invalid.
    """
    payload = {"sub": str(user_id), "exp": expires, "pwd": password_tag(password_hash)}
    return sign(key, "password-reset", payload)


def read_reset_token(key: bytes, token: str) -> tuple[UUID, str] | None:
    """Return the user ID and the password tag of a valid reset token that has not ended."""
    payload = unsign(key, "password-reset", token)
    try:
        return (UUID(str(payload["sub"])), str(payload["pwd"])) if payload else None
    except ValueError, KeyError:
        return None
