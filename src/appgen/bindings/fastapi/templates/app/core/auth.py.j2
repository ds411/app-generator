@router.post(
    "/sign-up", status_code=201, responses=problem_responses(409, 422), operation_id="sign_up"
)
async def sign_up(data: {{ u.name }}SignUp, request: Request, session: SessionDep) -> Token:
    """Make a new user with a password, and return a token. A user name that exists gives 409."""
    values = data.model_dump(by_alias=False, exclude={"password"})
{% if default_role %}
    values["{{ role.attr }}"] = "{{ default_role }}"
{% endif %}
    user = await repository.add(session, {{ u.name }}Create.model_validate(values))
    # The record and its credential are in one transaction. The record
    # must be in the database before its credential.
    await flush(session)
    session.add(Credential(user_id=user.id, password_hash=hash_password(data.password)))
    await commit(session)
    return Token(access_token=make_token(signing_key(request), user.id))
{% endif %}


