{{ trace(reset.id) }}
def password_tag(password_hash: str | None) -> str:
    """Return a short hash of a stored password hash. Each new password gives a new tag."""
    return hashlib.sha256((password_hash or "").encode()).hexdigest()[:32]


def make_reset_token(key: bytes, user_id: UUID, password_hash: str | None, expires: int) -> str:
    """Return a signed one-time token for a password reset, valid until the time `expires`.

    The token holds the tag of the current password hash, so that a new
    password (also the one of the reset) makes the token invalid.
    """
    payload = {"sub": str(user_id), "exp": expires, "pwd": password_tag(password_hash)}
    return sign(key, "password-reset", payload)


def read_reset_token(key: bytes, token: str) -> tuple[UUID, str] | None:
    """Return the user ID and the password tag of a valid reset token that has not ended."""
    payload = unsign(key, "password-reset", token)
    try:
        return (UUID(str(payload["sub"])), str(payload["pwd"])) if payload else None
    except ValueError, KeyError:
        return None
{% endif %}


_bearer = HTTPBearer(auto_error=False)


async def current_user(
    request: Request,
    session: SessionDep,
    credentials: Annotated[HTTPAuthorizationCredentials | None, Depends(_bearer)],
) -> {{ u.name }}:
    """Return the signed-in user. Give a 401 error without a valid token."""
    user_id = read_token(signing_key(request), credentials.credentials) if credentials else None
    user = await session.get({{ u.name }}, user_id) if user_id else None
    if user is None:
        raise ProblemError(401, "Sign in to use this endpoint.")
    return user


CurrentUser = Annotated[{{ u.name }}, Depends(current_user)]
"""The signed-in user, as a parameter of an endpoint."""
{% if password %}


async def set_password(session: AsyncSession, user: {{ u.name }}, password: str) -> None:
    """Store the hash of a new password of a user."""
    credential = await session.get(Credential, user.id)
    if credential is None:
        session.add(Credential(user_id=user.id, password_hash=hash_password(password)))
    else:
        credential.password_hash = hash_password(password)
    await commit(session)
{% endif %}


async def find_user(session: AsyncSession, username: str) -> {{ u.name }} | None:
    """Return the user with a user name, or None."""
    result = await session.execute(select({{ u.name }}).where({{ u.name }}.{{ username.attr }} == username))
    return result.scalar_one_or_none()


