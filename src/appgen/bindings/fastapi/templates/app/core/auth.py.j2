def _encode(data: bytes) -> str:
    return base64.urlsafe_b64encode(data).rstrip(b"=").decode()


def _decode(text: str) -> bytes:
    return base64.urlsafe_b64decode(text + "=" * (-len(text) % 4))


def signing_key(request: Request) -> bytes:
    """Return the key that signs the tokens: the setting `AUTH_SECRET`."""
    secret: str = request.app.state.settings.auth_secret
    if not secret:
        raise ProblemError(500, {{ py.message("The server has no AUTH_SECRET.") }})
    return secret.encode()


def _signature(key: bytes, purpose: str, body: str) -> str:
    # The purpose is part of the message, so that a text of one purpose is
    # never valid for another purpose.
    message = f"{purpose}.{body}".encode()
    return _encode(hmac.new(key, message, hashlib.sha256).digest())


def sign(key: bytes, purpose: str, payload: dict[str, Any]) -> str:
    """Return a signed text with a payload. The payload has the end of its time in `exp`."""
    body = _encode(json.dumps(payload, separators=(",", ":")).encode())
    return f"{body}.{_signature(key, purpose, body)}"


def unsign(key: bytes, purpose: str, text: str) -> dict[str, Any] | None:
    """Return the payload of a signed text of a purpose that has not ended, else None."""
    body, _, signature = text.partition(".")
    if not hmac.compare_digest(signature, _signature(key, purpose, body)):
        return None
    try:
        payload: dict[str, Any] = json.loads(_decode(body))
        return payload if int(payload["exp"]) >= time.time() else None
    except ValueError, KeyError, TypeError:
        return None


def make_token(key: bytes, user_id: UUID) -> str:
    """Return a signed token for a user."""
    return sign(key, "session", {"sub": str(user_id), "exp": int(time.time()) + SESSION_SECONDS})


def read_token(key: bytes, token: str) -> UUID | None:
    """Return the user ID of a valid token that has not ended, else None."""
    payload = unsign(key, "session", token)
    try:
        return UUID(str(payload["sub"])) if payload else None
    except ValueError, KeyError:
        return None
