def address_tag(address: str) -> str:
    """Return a short hash of an email address. Another address gives another tag."""
    return hashlib.sha256(address.encode()).hexdigest()[:32]


def make_verification_token(key: bytes, user_id: UUID, address: str, expires: int) -> str:
    """Return a signed token that confirms the email address of a user until the time `expires`.

    The token holds the tag of the address, so that it does not confirm
    another address of the user.
    """
    payload = {"sub": str(user_id), "exp": expires, "adr": address_tag(address)}
    return sign(key, "email-verification", payload)


def read_verification_token(key: bytes, token: str) -> tuple[UUID, str] | None:
    """Return the user ID and the address tag of a valid verification token that has not ended."""
    payload = unsign(key, "email-verification", token)
    try:
        return (UUID(str(payload["sub"])), str(payload["adr"])) if payload else None
    except ValueError, KeyError:
        return None
