async def remove_unverified_password(session: AsyncSession, user: {{ u.name }}) -> None:
    """Remove the password of a user whose email address is not verified.

    A provider calls it when it verifies the address. Nobody proved that
    the person who chose the password at the sign-up owns the address, so
    the password must not give access to the account. The user can set a
    new password with a reset link.
    """
    credential = await session.get(Credential, user.id)
    if credential is not None and credential.email_verified_at is None:
        await session.delete(credential)
        await commit(session)


