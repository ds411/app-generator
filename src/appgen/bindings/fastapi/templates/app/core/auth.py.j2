{{ trace(reset.id) }}
@router.post(
    "/password-reset",
    status_code=202,
    responses=problem_responses(422, 501),
    operation_id="request_password_reset",
)
async def request_password_reset(
    data: PasswordResetRequest, request: Request, session: SessionDep
) -> PasswordResetRequested:
    """Send a reset link to a user. The answer is the same for an unknown user name."""
    user = await find_user(session, data.username)
    if user is not None:
        credential = await session.get(Credential, user.id)
        expires = int(time.time()) + RESET_SECONDS
        password_hash = credential.password_hash if credential else None
        token = make_reset_token(signing_key(request), user.id, password_hash, expires)
        settings = request.app.state.settings
        await deliver_password_reset(settings, user, f"{settings.password_reset_url}?token={token}")
    return PasswordResetRequested()


{{ trace(reset.id) }}
@router.post(
    "/password-reset/confirm",
    status_code=204,
    responses=problem_responses(400, 422),
    operation_id="confirm_password_reset",
)
async def confirm_password_reset(
    data: PasswordReset, request: Request, session: SessionDep
) -> None:
    """Set a new password with the token of a reset link. A used or an ended token gives 400."""
    found = read_reset_token(signing_key(request), data.token)
    user = await session.get({{ u.name }}, found[0]) if found else None
    credential = await session.get(Credential, user.id) if user else None
    tag = password_tag(credential.password_hash if credential else None)
    if found is None or user is None or not hmac.compare_digest(found[1], tag):
        raise ProblemError(400, "The reset link is not valid, was used, or has ended.")
    await set_password(session, user, data.new_password)
{% endif %}
