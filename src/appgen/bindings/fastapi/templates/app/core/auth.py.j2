async def current_user(
    request: Request,
    session: SessionDep,
    credentials: Annotated[HTTPAuthorizationCredentials | None, Depends(_bearer)],
) -> {{ u.name }}:
    """Return the signed-in user. Give a 401 error without a valid token."""
    user_id = read_token(signing_key(request), credentials.credentials) if credentials else None
    user = await session.get({{ u.name }}, user_id) if user_id else None
    if user is None:
        raise ProblemError(401, {{ py.message("Sign in to use this endpoint.") }})
    return user


