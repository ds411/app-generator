def get_storage(request: Request) -> Storage:
    """Return the storage of the app."""
    storage: Storage = request.app.state.storage
    return storage


StorageDep = Annotated[Storage, Depends(get_storage)]
"""The type of an endpoint parameter that gets the storage of the app."""


@dataclass(frozen=True, slots=True)
class LinkedFile:
    """The file of a valid link."""

    key: str
    name: str
    type: str
    expires: int
    """The end of the link, in seconds since 1970 (Unix time)."""

    def headers(self) -> dict[str, str]:
        """Return the headers of the response with the file.

        A browser shows an image or a PDF file in a tab, and downloads the
        other files. A file cannot run scripts, and the browser keeps the
        media type of the app.
        """
        disposition = "inline" if self.type in INLINE_TYPES else "attachment"
        headers = {
            "Content-Disposition": f"{disposition}; filename*=UTF-8''{quote(self.name)}",
            "Cache-Control": f"private, max-age={max(0, self.expires - int(time.time()))}",
            "X-Content-Type-Options": "nosniff",
        }
        if self.type != "application/pdf":
            # A browser does not show a PDF file in a sandbox.
            headers["Content-Security-Policy"] = SANDBOX
        return headers


@dataclass(frozen=True, slots=True)
class FileLinks:
    """The signed links of the files: `<base URL>/file-links/<token>`.

    The token holds the key, the name, the media type, and the end of the
    link, and an HMAC-SHA256 signature with the secret key.
    """

    secret: bytes
    seconds: int
    """The time that a link works, in seconds. A link ends at the next multiple of 5 minutes."""
    base_url: str = ""
    """The URL of the app: `PUBLIC_URL`, else the URL of the request."""

    def url(self, stored: StoredFile, now: float | None = None) -> str:
        """Return the link of a file."""
        moment = time.time() if now is None else now
        expires = math.ceil((moment + self.seconds) / LINK_STEP) * LINK_STEP
        data = [stored["key"], stored["name"], stored["type"], expires]
        payload = _encode(json.dumps(data, separators=(",", ":"), ensure_ascii=False).encode())
        return f"{self.base_url}/file-links/{payload}.{self._sign(payload)}"

    def open(self, token: str, now: float | None = None) -> LinkedFile | None:
        """Return the file of a token, or None if the token is not valid or has ended."""
        payload, _, signature = token.partition(".")
        if not hmac.compare_digest(signature.encode(), self._sign(payload).encode()):
            return None
        try:
            key, name, media_type, expires = json.loads(_decode(payload))
            found = LinkedFile(str(key), str(name), str(media_type), int(expires))
        except ValueError, TypeError:
            return None
        return found if found.expires > (time.time() if now is None else now) else None

    def _sign(self, payload: str) -> str:
        return _encode(hmac.new(self.secret, payload.encode(), hashlib.sha256).digest())


def _encode(data: bytes) -> str:
    return base64.urlsafe_b64encode(data).rstrip(b"=").decode()


def _decode(text: str) -> bytes:
    return base64.urlsafe_b64decode(text + "=" * (-len(text) % 4))


def make_links(settings: Settings) -> FileLinks:
    """Return the links of the settings.

    Without `STORAGE_LINK_SECRET`, each process has a random key: a link
    works only in the process that gives it, until the process stops.
    """
    secret = settings.storage_link_secret.encode()
    if not secret:
        logger.warning("STORAGE_LINK_SECRET has no value: each process signs its own links.")
        secret = secrets.token_bytes(32)
    return FileLinks(secret, settings.storage_link_seconds)


_links: ContextVar[FileLinks | None] = ContextVar("file_links", default=None)


class FileLinkMiddleware:
    """Give the links of the files of each request the URL of the app."""

    def __init__(self, app: ASGIApp, links: FileLinks, public_url: str = "") -> None:
        self.app = app
        self.links = links
        self.public_url = public_url.rstrip("/")

    async def __call__(self, scope: Scope, receive: Receive, send: Send) -> None:
        if scope["type"] != "http":
            await self.app(scope, receive, send)
            return
        base_url = self.public_url or str(Request(scope).base_url).rstrip("/")
        token = _links.set(replace(self.links, base_url=base_url))
        try:
            await self.app(scope, receive, send)
        finally:
            _links.reset(token)


def file_url(stored: StoredFile) -> str:
    """Return the link of a file for the request."""
    links = _links.get()
    if links is None:
        raise RuntimeError("A link of a file needs a request through FileLinkMiddleware.")
    return links.url(stored)


def _stored_file(value: object) -> StoredFile | None:
    """Return the value of a file field in the database, or None for another value."""
    if isinstance(value, dict) and "key" in value:
        return cast(StoredFile, value)
    return None


class FileRead(BaseModel):
    """A file of a record, as the API returns it."""

    name: str
    """The name of the file, for example `screenshot.png`."""
    size: int
    """The size of the file, in bytes."""
    type: str
    """The media type, for example `image/png`."""
    url: str
    """A signed link to the file. It works without a sign-in, until it ends."""

    @model_validator(mode="before")
    @classmethod
    def _link(cls, value: object) -> object:
        """Give a stored file (`StoredFile`) its link."""
        stored = _stored_file(value)
        if stored is None:
            return value
        return {
            "name": stored["name"],
            "size": stored["size"],
            "type": stored["type"],
            "url": file_url(stored),
        }


async def upload(storage: Storage, file: UploadFile, rule: FileRule, folder: str) -> StoredFile:
    """Check an uploaded file against the rule of its field, save it, and return its value.

    A file that is larger than the rule allows gives a 413 error, and a
    media type that the rule does not allow gives a 415 error. The key of
    the file is new: `<folder>/<random hex>`.
    """
    content = await file.read(rule.max_size + 1)
    if len(content) > rule.max_size:
        {{ py.problem(413, "The file is larger than {size}.", 8, size="size_text(rule.max_size)") }}
    media_type = media_type_of(content, file.content_type)
    if not rule.allows(media_type):
        types = ", ".join(rule.types)
        {{ py.problem(415, "The type {type} is not allowed. Use one of: {types}.", 8, type="media_type", types="types") }}
    key = f"{folder}/{uuid4().hex}"
    await storage.save(key, content, media_type)
    return StoredFile(key=key, name=file_name(file.filename), size=len(content), type=media_type)


async def delete_files(storage: Storage, files: Iterable[StoredFile | None]) -> None:
    """Delete the files that a commit removed from their records.

    A delete that fails leaves the file in the storage, and writes a
    warning to the log: the record does not name the file any more.
    """
    for stored in files:
        if stored is None:
            continue
        try:
            await storage.delete(stored["key"])
        except Exception:
            logger.warning("Cannot delete the file %s.", stored["key"], exc_info=True)


async def replace_file(
    session: AsyncSession,
    storage: Storage,
    record: Record,
    attr: str,
    stored: StoredFile | None,
) -> None:
    """Give a file field of a record a new file, or None, and commit. Then delete the old file.

    If the commit fails, the app deletes the new file.
    """
    old: StoredFile | None = getattr(record, attr)
    setattr(record, attr, stored)
    try:
        await commit(session)
    except BaseException:
        await delete_files(storage, [stored])
        raise
    await delete_files(storage, [old])


router = APIRouter(tags=["Files"])


@router.get(
    "/file-links/{token}",
    response_class=Response,
    responses={
        200: {"content": {"application/octet-stream": {}}, "description": "The file."},
        **problem_responses(404),
    },
    summary="Read file link",
    operation_id="read_file_link",
)
async def read_file_link(token: str, storage: StorageDep) -> Response:
    """Return a file by its signed link. The link works without a sign-in, until it ends."""
    links = _links.get()
    found = links.open(token) if links is not None else None
    content = await storage.read(found.key) if found is not None else None
    if found is None or content is None:
        {{ py.problem(404, "The link is not valid, or has ended.", 8) }}
    return Response(content, media_type=found.type, headers=found.headers())
