logger = logging.getLogger("app.storage")

LINK_STEP = 300
"""A link ends at a multiple of 5 minutes, so that the link of a file stays the same for 5
minutes, and a browser can keep the file in its cache."""
INLINE_TYPES = frozenset(
    {"image/png", "image/jpeg", "image/gif", "image/webp", "image/avif", "application/pdf"}
)
"""The media types that a browser shows in a tab. It downloads the other files."""
SANDBOX = "default-src 'none'; style-src 'unsafe-inline'; sandbox"
"""The content security policy of a file: a file cannot run scripts."""
_SIGNATURES = (
    (b"\x89PNG\r\n\x1a\n", "image/png"),
    (b"\xff\xd8\xff", "image/jpeg"),
    (b"GIF87a", "image/gif"),
    (b"GIF89a", "image/gif"),
    (b"%PDF-", "application/pdf"),
)
"""The first bytes of the media types that the app knows (and WebP, see `media_type_of`)."""
_KNOWN_TYPES = frozenset({media_type for _, media_type in _SIGNATURES} | {"image/webp"})


@dataclass(frozen=True, slots=True)
class FileRule:
    """The largest file and the media types of a file field."""

    max_size: int
    """The largest file, in bytes."""
    types: tuple[str, ...] = ()
    """The media types that the field allows, for example `image/*`. Empty: all types."""

    def allows(self, media_type: str) -> bool:
        """Return True if the field allows a media type."""
        group = media_type.partition("/")[0]
        return not self.types or any(item in (media_type, f"{group}/*") for item in self.types)


def size_text(size: int) -> str:
    """Return a size as a short text with a unit, for example `5 MB` or `1.5 KB`."""
    for unit, factor in (("GB", 1024**3), ("MB", 1024**2), ("KB", 1024)):
        if size >= factor:
            return f"{size / factor:.1f}".removesuffix(".0") + f" {unit}"
    return f"{size} B"


def media_type_of(content: bytes, given: str | None) -> str:
    """Return the media type of a file.

    The first bytes give the type of the files that the app knows (PNG,
    JPEG, GIF, WebP, and PDF), else the client gives the type. A file that
    has the type of a known file, but not its first bytes, gets the type
    `application/octet-stream`.
    """
    for signature, media_type in _SIGNATURES:
        if content.startswith(signature):
            return media_type
    if content[:4] == b"RIFF" and content[8:12] == b"WEBP":
        return "image/webp"
    media_type = (given or "").partition(";")[0].strip().lower()
    if not media_type or media_type in _KNOWN_TYPES:
        return "application/octet-stream"
    return media_type


def file_name(name: str | None) -> str:
    """Return the name of an uploaded file without its folders and control characters."""
    base = PurePosixPath((name or "").replace("\\", "/")).name
    clean = "".join(char for char in base if char.isprintable()).strip()
    return clean[-200:] or "file"


class Storage(Protocol):
    """The place of the files{{ ": a folder, or a bucket of an S3-compatible service" if st.s3 else ": a folder of the server" }}."""

    async def save(self, key: str, content: bytes, media_type: str) -> None:
        """Save a file with a key."""
        ...

    async def read(self, key: str) -> bytes | None:
        """Return the content of a file, or None if no file has the key."""
        ...

    async def delete(self, key: str) -> None:
        """Delete a file. A key without a file is no error."""
        ...


class FolderStorage:
    """The files in a folder of the server: one file for each key."""

    def __init__(self, folder: Path) -> None:
        self.folder = folder.resolve()

    def _path(self, key: str) -> anyio.Path:
        path = (self.folder / key).resolve()
        if not path.is_relative_to(self.folder):
            raise ValueError(f"The key '{key}' is not in the folder.")
        return anyio.Path(path)

    async def save(self, key: str, content: bytes, media_type: str) -> None:
        path = self._path(key)
        await path.parent.mkdir(parents=True, exist_ok=True)
        await path.write_bytes(content)

    async def read(self, key: str) -> bytes | None:
        try:
            return await self._path(key).read_bytes()
        except FileNotFoundError, IsADirectoryError:
            return None

    async def delete(self, key: str) -> None:
        await self._path(key).unlink(missing_ok=True)
{% if st.s3 %}


class BucketStorage:
    """The files in a bucket of an S3-compatible service: one object for each key.

    The client of boto3 blocks, so each call runs in a worker thread.
    """

    def __init__(self, settings: Settings) -> None:
        endpoint = settings.{{ st.setting("endpoint_env") }}
        self.bucket = settings.{{ st.setting("bucket_env") }}
        self.client: S3Client = boto3.client(
            "s3",
            region_name=settings.{{ st.setting("region_env") }} or None,
            endpoint_url=endpoint or None,
            aws_access_key_id=settings.{{ st.setting("access_key_env") }} or None,
            aws_secret_access_key=settings.{{ st.setting("secret_key_env") }} or None,
            config=Config(
                s3={"addressing_style": "path" if endpoint else "auto"},
                # Not all S3-compatible services accept the newer checksums.
                request_checksum_calculation="when_required",
                response_checksum_validation="when_required",
            ),
        )

    async def save(self, key: str, content: bytes, media_type: str) -> None:
        def put() -> None:
            self.client.put_object(
                Bucket=self.bucket, Key=key, Body=content, ContentType=media_type
            )

        await anyio.to_thread.run_sync(put)

    async def read(self, key: str) -> bytes | None:
        def get() -> bytes | None:
            try:
                response = self.client.get_object(Bucket=self.bucket, Key=key)
            except self.client.exceptions.NoSuchKey:
                return None
            return response["Body"].read()

        return await anyio.to_thread.run_sync(get)

    async def delete(self, key: str) -> None:
        def remove() -> None:
            self.client.delete_object(Bucket=self.bucket, Key=key)

        await anyio.to_thread.run_sync(remove)
{% endif %}


