"""The delivery of {% if py.message_elements %}the messages of the sign-in{% endif %}{% if py.message_elements and py.notice_emails %} and of {% endif %}{% if py.notice_emails %}the emails of the notices (ADR 0044){% endif %} by
SMTP (`auth.delivery: smtp`).

The app sends each email with the SMTP server of the settings `SMTP_*`,
to the address of the user. `smtplib` blocks, so the delivery runs in a
thread. Without `SMTP_HOST`, the development app writes a note to the
log, and the production app gives an error{{ " (501 for a message of the sign-in)" if py.message_elements }}.
"""

import asyncio
{% if py.message_elements %}
import logging
{% endif %}
import smtplib
import ssl
from email.message import EmailMessage
from email.utils import formatdate, make_msgid

from app.core.config import Settings
{% if py.message_elements %}
from app.core.messages import Message
{% endif %}

{% if py.message_elements %}
logger = logging.getLogger("app.auth")

{% endif %}
TIMEOUT_SECONDS = 10
"""The time that the app waits for each answer of the SMTP server."""


def new_email(settings: Settings, to: str, subject: str, text: str) -> EmailMessage:
    """Return an email from `SMTP_FROM` to an address, with a subject and a plain text."""
    email = EmailMessage()
    email["From"] = settings.smtp_from
    email["To"] = to
    email["Subject"] = subject
    email["Date"] = formatdate(localtime=False)
    email["Message-ID"] = make_msgid()
    email.set_content(text)
    return email
{% if py.message_elements %}


def email_message(settings: Settings, message: Message) -> EmailMessage:
    """Return the email of a message: from `SMTP_FROM` to the address of the user."""
    return new_email(settings, message.to, message.subject, message.text)
{% endif %}


def send_email(settings: Settings, email: EmailMessage) -> None:
    """Send an email with the SMTP server of the settings. The call blocks."""
    context = ssl.create_default_context()
    if settings.smtp_tls == "tls":
        client = smtplib.SMTP_SSL(
            settings.smtp_host, settings.smtp_port, timeout=TIMEOUT_SECONDS, context=context
        )
    else:
        client = smtplib.SMTP(settings.smtp_host, settings.smtp_port, timeout=TIMEOUT_SECONDS)
    with client:
        if settings.smtp_tls == "starttls":
            client.starttls(context=context)
        if settings.smtp_username:
            client.login(settings.smtp_username, settings.smtp_password)
        client.send_message(email)


async def deliver_email(settings: Settings, email: EmailMessage, what: str) -> bool:
    """Send an email by SMTP in a thread. `what` names the emails in the errors.

    Return False without `SMTP_HOST` in the development app: the caller
    writes a note to the log. Without `SMTP_HOST`, the production app gives
    an error.
    """
    if not settings.smtp_host:
        if settings.environment == "development":
            return False
        raise NotImplementedError(f"Set SMTP_HOST to send {what}.")
    if not settings.smtp_from:
        raise NotImplementedError(f"Set SMTP_FROM: the sender of {what}.")
    await asyncio.to_thread(send_email, settings, email)
    return True
{% if py.message_elements %}


async def deliver_message(settings: Settings, message: Message) -> None:
    """Send a message of the sign-in to a user by SMTP."""
    email = email_message(settings, message)
    if not await deliver_email(settings, email, "the messages of the sign-in"):
        logger.warning("The %s link of %s: %s", message.kind, message.to, message.link)
{% endif %}
