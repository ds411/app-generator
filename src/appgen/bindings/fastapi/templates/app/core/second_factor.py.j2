"""The second factor of the sign-in (ADR 0024): the codes of an authenticator app.

The codes follow RFC 6238 (TOTP): HMAC-SHA-1, 6 digits, and a new code
each 30 seconds. A user turns the factor on in two steps: `POST
/auth/second-factor/setup` gives a new secret and its `otpauth://` URI,
and `POST /auth/second-factor/confirm` with a valid code turns it on and
gives 10 recovery codes one time. Then a sign-in with the password gives
a challenge, and `POST /auth/sign-in/second-factor` with the challenge
and a code, or a recovery code, gives the token. Each code is valid one
time. After 5 wrong codes in a row, the app refuses the codes of the user
for 15 minutes.

The table `credentials` keeps the secret encrypted with a key from
`AUTH_SECRET`, and only the SHA-256 hashes of the recovery codes.
"""

import base64
import hashlib
import hmac
import secrets
import struct
import time
from datetime import UTC, datetime
from typing import Annotated
from urllib.parse import quote

from fastapi import APIRouter, Depends, Request
from fastapi.security import HTTPAuthorizationCredentials, HTTPBearer
from pydantic import BaseModel, Field
from sqlalchemy.ext.asyncio import AsyncSession

