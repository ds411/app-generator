{{ trace_header(definition.access.id) }}
{% set u = py.entity(definition.auth.user_entity) %}
{% set role = u.fields | selectattr("name", "eq", definition.access.role_field) | first %}
{% set rules = definition.access.roles.values() | map(attribute="records") | select | list %}
"""The permissions of the roles (ADR 0012): the operations that each role may call.

The field `{{ role.name }}` of {{ u.name }} gives the role of a user. Each endpoint that
is not public checks the role of the signed-in user, by the operation ID
of its route.{% if rules %} The record rules (ADR 0018, ADR 0025) limit a role to some
records: the records of its user, and the records with the values of the
conditions.{% endif %}
"""

{% if rules %}
from collections.abc import Awaitable, Callable, Mapping
from dataclasses import dataclass, field, replace
from uuid import UUID

{% endif %}
from fastapi import Request

from app.core.auth import CurrentUser
from app.core.errors import ProblemError
{% if i18n %}
from app.core.i18n import t
{% endif %}
{% if rules %}
from app.features.{{ u.slice }}.models import {{ u.name }}
{% endif %}

ALL = "*"
PERMISSIONS: dict[str, frozenset[str]] = {
{% for name, r in definition.access.roles.items() %}
    {{ trace(r.id) }}
{% if r.operations %}
    "{{ name }}": frozenset(
        {
{% for op_name in r.operations %}
            "{{ op_name }}",
{% endfor %}
        }
    ),
{% else %}
    "{{ name }}": frozenset[str](),
{% endif %}
{% endfor %}
}
"""The operations of each role. `*` stands for all operations."""


def allows(role: object, operation: str) -> bool:
    """Return True if a role may call an operation."""
    operations = PERMISSIONS.get(str(getattr(role, "value", role)), frozenset[str]())
    return ALL in operations or operation in operations


async def check_access(request: Request, user: CurrentUser) -> None:
    """Give a 403 error if the role of the signed-in user may not call the operation."""
    operation = getattr(request.scope.get("route"), "operation_id", None)
    if operation is None or not allows(user.{{ role.attr }}, str(operation)):
        raise ProblemError(403, {{ py.message("Your role may not do this operation.") }})
{% if rules %}


@dataclass(frozen=True, slots=True)
class RecordRule:
    """A record rule of a role (ADR 0025): the records of an entity that the role may use."""

    actions: frozenset[str]
    """`read` (the lists and the reads), `change` (the other operations), or both."""
    owner: bool = False
    """True if the records belong to the user, through the owner path of the entity."""
    where: Mapping[str, tuple[object, ...]] = field(default_factory=dict[str, tuple[object, ...]])
    """The conditions, by attribute: the records have one of the values of each attribute."""

    def applies(self, action: str) -> bool:
        """Return True if the rule applies to an action.

        A rule for `read` also applies to `change`: a user cannot change a
        record that it cannot see.
        """
        return action == "change" or action in self.actions


RECORD_RULES: dict[str, dict[str, RecordRule]] = {
{% for name, r in definition.access.roles.items() if r.records %}
    "{{ name }}": {
{% for entity, rule in r.records.items() %}
        {{ trace(rule.id) }}
        {{ py.record_rule(entity, rule) }}
{% endfor %}
    },
{% endfor %}
}
"""The record rules of each role, by entity."""


@dataclass(frozen=True, slots=True)
class RecordScope:
    """The records that a request may use: the signed-in user, its role, and the action."""

    user: UUID
    role: str
    action: str
    """`read` (a list or a read), or `change` (a create, a change, a delete, or a custom one)."""

    def rule(self, entity: str, action: str | None = None) -> RecordRule | None:
        """Return the rule of the role for the records of an entity, or None for all records.

        Without an action, the rule is for the action of the request.
        """
        rule = RECORD_RULES.get(self.role, {}).get(entity)
        return rule if rule is not None and rule.applies(action or self.action) else None

    def reading(self) -> RecordScope:
        """Return the scope of the reads of the same user, for example for the embedded records."""
        return replace(self, action="read")


def record_scope(user: {{ u.name }} | None, action: str) -> RecordScope | None:
    """Return the scope of a request of a user (`read` or `change`), or None without a user."""
    if user is None:
        return None
    role = getattr(user.{{ role.attr }}, "value", user.{{ role.attr }})
    return RecordScope(user.id, str(role), action)


def scope_of(action: str) -> Callable[[{{ u.name }}], Awaitable[RecordScope | None]]:
    """Return a dependency: the scope of the records that a request may use (ADR 0025)."""

    async def scope(user: CurrentUser) -> RecordScope | None:
        return record_scope(user, action)

    return scope
{% endif %}
