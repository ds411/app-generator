def allows(role: object, operation: str) -> bool:
    """Return True if a role may call an operation."""
    operations = PERMISSIONS.get(str(getattr(role, "value", role)), frozenset[str]())
    return ALL in operations or operation in operations


{% if m %}
def operation_of(request: Request) -> str | None:
    """Return the operation of the route of a request, or the operation that the route needs."""
    operation = getattr(request.scope.get("route"), "operation_id", None)
    if operation is None:
        return None
{% if needs %}
    return NEEDS.get(str(operation), str(operation))
{% else %}
    return str(operation)
{% endif %}


async def member_scopes(
    session: AsyncSession, user: UUID, operation: str | None = None
) -> frozenset[UUID]:
    """Return the IDs of the scopes of the memberships of a user (ADR 0048).

    With an operation, only the scopes of the roles that give it.
    """
    statement = select({{ m.entity.name }}.{{ m.scope.fk_attr }}).where({{ m.entity.name }}.{{ m.user.fk_attr }} == user)
    if operation is not None:
        roles = [role for role, operations in MEMBER_ROLES.items() if operation in operations]
        statement = statement.where({{ m.entity.name }}.{{ m.role.attr }}.in_(roles))
    return frozenset(await session.scalars(statement))


async def check_access(request: Request, user: CurrentUser, session: SessionDep) -> None:
    """Give a 403 error if the role of the signed-in user may not call the operation.

    A role of a membership of the user (ADR 0048) also gives its operations,
    on the records of its scope: the repositories filter the records.
    """
    operation = operation_of(request)
    if operation is not None and allows(user.{{ role.attr }}, operation):
        return
    if operation in MEMBER_OPERATIONS and await member_scopes(session, user.id, operation):
        return
    raise ProblemError(403, {{ py.message("Your role may not do this operation.") }})
{% else %}
async def check_access(request: Request, user: CurrentUser) -> None:
    """Give a 403 error if the role of the signed-in user may not call the operation."""
    operation = getattr(request.scope.get("route"), "operation_id", None)
{% if needs %}
    if operation is not None:
        operation = NEEDS.get(str(operation), str(operation))
{% endif %}
    if operation is None or not allows(user.{{ role.attr }}, str(operation)):
        raise ProblemError(403, {{ py.message("Your role may not do this operation.") }})
{% endif %}
