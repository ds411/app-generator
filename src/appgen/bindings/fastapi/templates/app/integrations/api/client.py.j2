def {{ api.client_for }}(
    settings: Settings, sessions: async_sessionmaker[AsyncSession], user_id: UUID | None
) -> {{ api.client }}:
    """Return a client that sends the access token of a user.

    A request raises NotConnectedError (409) if the user is None, or has no
    connection to the API.
    """
    token = UserToken(settings, {{ api.name | tojson }}, sessions, user_id)
    return {{ api.client }}(settings.{{ api.url_setting }}, token=token)


async def {{ api.dependency }}(
    request: Request, user: CurrentUser, session: SessionDep
) -> AsyncIterator[{{ api.client }}]:
    """Give an endpoint a client with the token of the signed-in user (a FastAPI dependency).

    Give 409 if the user has no connection to the API.
    """
    await require_connection(session, {{ api.name | tojson }}, user.id)
    client = {{ api.client_for }}(request.app.state.settings, request.app.state.sessions, user.id)
    async with client:
        yield client
{% else %}


async def {{ api.dependency }}(request: Request) -> AsyncIterator[{{ api.client }}]:
    """Give an endpoint a client with the settings of the app (a FastAPI dependency)."""
    settings: Settings = request.app.state.settings
    {{ api.construction() }}
    async with client:
        yield client
{% endif %}


{{ api.dependency_type }} = Annotated[{{ api.client }}, Depends({{ api.dependency }})]
