{% if sf %}
"""Commands of the app for an administrator.

- `uv run python -m app.cli set-password <user name>` reads the new
  password from the terminal, or from the environment variable
  `APP_PASSWORD`, and stores its hash.
- `uv run python -m app.cli disable-second-factor <user name>` turns off
  the second factor of a user who lost the authenticator app and the
  recovery codes (ADR 0024). The user can turn it on again.
"""
{% else %}
"""Commands of the app: `uv run python -m app.cli set-password <user name>`.

The command reads the new password from the terminal, or from the
environment variable `APP_PASSWORD`, and stores its hash.
"""
{% endif %}

import asyncio
import getpass
import os
import sys

{% if sf %}
from app.core.auth import MIN_PASSWORD_LENGTH, Credential, find_user, set_password
{% else %}
from app.core.auth import MIN_PASSWORD_LENGTH, find_user, set_password
{% endif %}
from app.core.config import Settings
from app.core.db import {{ "commit, " if sf }}make_engine, make_sessions
{% if sf %}
from app.core.second_factor import remove_second_factor
{% endif %}
from app.models import configure_models
{% if sf %}

USAGE = """Usage:
  python -m app.cli set-password <user name>
  python -m app.cli disable-second-factor <user name>"""
{% endif %}


async def _set_password(username: str, password: str) -> int:
    configure_models()
    engine = make_engine(Settings().database_url)
    try:
        async with make_sessions(engine)() as session:
            user = await find_user(session, username)
            if user is None:
                print(f"No user has the user name {username}.", file=sys.stderr)
                return 1
            await set_password(session, user, password)
    finally:
        await engine.dispose()
    print(f"The password of {username} is set.")
    return 0
{% if sf %}


{{ trace(sf.id) }}
async def _disable_second_factor(username: str) -> int:
    configure_models()
    engine = make_engine(Settings().database_url)
    try:
        async with make_sessions(engine)() as session:
            user = await find_user(session, username)
            credential = await session.get(Credential, user.id) if user else None
            if credential is None or credential.totp_enabled_at is None:
                print(f"The user {username} has no second factor.", file=sys.stderr)
                return 1
            remove_second_factor(credential)
            await commit(session)
    finally:
        await engine.dispose()
    print(f"The second factor of {username} is off.")
    return 0
{% endif %}


def main(args: list[str]) -> int:
    """Run a command. Return the exit code."""
{% if sf %}
    if len(args) == 2 and args[0] == "disable-second-factor":
        return asyncio.run(_disable_second_factor(args[1]))
    if len(args) != 2 or args[0] != "set-password":
        print(USAGE, file=sys.stderr)
        return 2
{% else %}
    if len(args) != 2 or args[0] != "set-password":
        print("Usage: python -m app.cli set-password <user name>", file=sys.stderr)
        return 2
{% endif %}
    password = os.environ.get("APP_PASSWORD") or getpass.getpass("New password: ")
    if len(password) < MIN_PASSWORD_LENGTH:
        print(f"The password needs {MIN_PASSWORD_LENGTH} or more characters.", file=sys.stderr)
        return 1
    return asyncio.run(_set_password(args[1], password))


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
