logger = logging.getLogger("app.seed")


@asynccontextmanager
async def lifespan(app: FastAPI) -> AsyncGenerator[None]:
    """Add the seed records with DATABASE_SEED=true when the app starts. Close the
    connections of the database{{ " and of Redis" if py.redis }} when the app stops."""
    settings: Settings = app.state.settings
    if settings.database_seed:
        async with app.state.sessions() as session:
{% if definition.auth and definition.auth.password %}
            added = await seed_database(session, settings.seed_password)
{% else %}
            added = await seed_database(session)
{% endif %}
        logger.info("The seed added %d records.", added)
    yield
    await app.state.engine.dispose()
{% if py.redis %}
    limiter = getattr(app.state, "rate_limiter", None)
    if isinstance(limiter, RedisRateLimiter):
        await limiter.redis.aclose()
{% endif %}


def create_app(settings: Settings | None = None) -> FastAPI:
    """Return the FastAPI app with the routers of all slices."""
    settings = settings or Settings()
    configure_logging(settings.log_level, as_json=settings.log_json)
    configure_models()
    app = FastAPI(
        title={{ app.title | tojson }},
        version="0.1.0",
{% if app.description %}
        description={{ app.description | tojson }},
{% endif %}
        lifespan=lifespan,
    )
    app.state.settings = settings
    app.state.engine = make_engine(settings.database_url)
    app.state.sessions = make_sessions(app.state.engine)
    app.add_middleware(
        CORSMiddleware,
        allow_origins=settings.cors_origins,
        allow_methods=["*"],
        allow_headers=["*"],
        expose_headers=["X-Request-ID"],
    )
    if settings.rate_limit_per_minute > 0:
{% if py.redis %}
        limit, store = settings.rate_limit_per_minute, settings.rate_limit_store_url
        limiter: Limiter = RedisRateLimiter(limit, store) if store else RateLimiter(limit)
        app.state.rate_limiter = limiter
        fail_closed = settings.rate_limit_fail_closed
        app.add_middleware(RateLimitMiddleware, limiter=limiter, fail_closed=fail_closed)
{% else %}
        app.state.rate_limiter = RateLimiter(settings.rate_limit_per_minute)
        app.add_middleware(RateLimitMiddleware, limiter=app.state.rate_limiter)
{% endif %}
{% if i18n %}
    {{ trace(i18n.element_id) }}
    # The language middleware runs before the rate limit, so a 429 has the language too.
    app.add_middleware(LanguageMiddleware)
{% endif %}
    # The last middleware runs first, so the log has each response, also a 429.
    app.add_middleware(RequestLogMiddleware)
    add_problem_handlers(app)
    app.include_router(health_router)
{% if definition.auth %}
    {{ trace(definition.auth.id) }}
    app.include_router(auth_router)
{% endif %}
{% for p in py.providers %}
    {{ trace(p.id) }}
{% endfor %}
{% if py.providers %}
    app.include_router(providers_router)
{% endif %}
{% if sf %}
    {{ trace(sf.id) }}
    app.include_router(second_factor_router)
{% endif %}
{% for e in py.entity_order() %}
    {{ trace(e.id) }}
    app.include_router({{ e.slice }}_router)
{% endfor %}
{% for api in exposed %}
    {{ trace(api.id) }}
{% if definition.auth %}
    app.include_router({{ api.module }}_router, dependencies=[Depends(current_user)])
{% else %}
    app.include_router({{ api.module }}_router)
{% endif %}
{% endfor %}
{% for d in py.dashboards.values() %}
    {{ trace(d.id) }}
{% endfor %}
{% if py.dashboards %}
    app.include_router(dashboards_router)
{% endif %}
{% for w in py_webhooks.values() %}
    {{ trace(w.id) }}
    app.include_router({{ w.module }}_webhook)
{% endfor %}
    # The hand-written routers come after the generated routers.
    for router in ROUTERS:
        app.include_router(router)
    return app


app = create_app()
