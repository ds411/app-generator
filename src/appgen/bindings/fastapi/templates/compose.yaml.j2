{{ trace_header("app") }}
{# The environment of the API, and of the worker without the seed and the rate limit. #}
{% macro environment(worker=False) %}
      DATABASE_URL: postgresql+asyncpg://app:app@db:5432/{{ py.package }}
{% if not worker %}
      DATABASE_SEED: "true"
      RATE_LIMIT_PER_MINUTE: ${RATE_LIMIT_PER_MINUTE:-600}
{% if py.redis %}
      RATE_LIMIT_STORE_URL: ${RATE_LIMIT_STORE_URL:-}
{% endif %}
{% endif %}
{% if py.live %}
      LIVE_EVENTS_URL: ${LIVE_EVENTS_URL:-}
{% endif %}
{% if definition.auth %}
      # Set AUTH_SECRET in the shell or in .env: a long random text.
      AUTH_SECRET: ${AUTH_SECRET:?Set AUTH_SECRET}
{% if definition.auth.password and not worker %}
      SEED_PASSWORD: ${SEED_PASSWORD:-}
{% endif %}
{% endif %}
{% if py.storage %}
      {{ trace(py.storage.id) }}
      {{ py.storage.variables["folder_env"] }}: /app/uploads
{% if py.storage.s3 %}
{% for key in ("bucket_env", "region_env", "endpoint_env", "access_key_env", "secret_key_env") %}
      {{ py.storage.variables[key] }}: ${{ "{" }}{{ py.storage.variables[key] }}:-{{ "}" }}
{% endfor %}
{% endif %}
      STORAGE_LINK_SECRET: ${STORAGE_LINK_SECRET:-}
{% endif %}
{% for api in py_apis.values() %}
      {{ trace(api.id) }}
      {{ api.url_env }}: ${{ "{" }}{{ api.url_env }}:-{{ api.base_url }}{{ "}" }}
{% if api.client_id_env %}
      {{ api.client_id_env }}: ${{ "{" }}{{ api.client_id_env }}:-{{ "}" }}
{% endif %}
{% if api.secret_env %}
      {{ api.secret_env }}: ${{ "{" }}{{ api.secret_env }}:-{{ "}" }}
{% endif %}
{% endfor %}
{% endmacro %}
# Start Postgres, run the migrations, and start the API on port 8000 with
# the seed records{{ " and the worker of the jobs" if py.jobs }}:
#   docker compose up --build
{% if py.redis %}
# With Redis for the rate limit of all replicas:
#   RATE_LIMIT_STORE_URL=redis://redis:6379/0 docker compose --profile redis up --build
{% endif %}
{% if py.live %}
# With Redis for the live events of all replicas{{ " and of the worker" if py.jobs }}:
#   LIVE_EVENTS_URL=redis://redis:6379/0 docker compose --profile redis up --build
{% endif %}

name: {{ app.name | tojson }}

services:
  db:
    image: ${POSTGRES_IMAGE:-postgres:18}
    environment:
      POSTGRES_USER: app
      POSTGRES_PASSWORD: app
      POSTGRES_DB: {{ py.package }}
    volumes:
      - db-data:/var/lib/postgresql
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U app -d {{ py.package }}"]
      interval: 2s
      timeout: 3s
      retries: 30

  migrate:
    build: .
    image: {{ app.name }}-api
    command: ["alembic", "upgrade", "head"]
    environment:
      DATABASE_URL: postgresql+asyncpg://app:app@db:5432/{{ py.package }}
    depends_on:
      db:
        condition: service_healthy

  api:
    image: {{ app.name }}-api
    environment:
{{ environment().rstrip() }}
    ports:
      - "8000:8000"
{% if py.storage %}
    volumes:
      - files:/app/uploads
{% endif %}
    depends_on:
      migrate:
        condition: service_completed_successfully
{% if py.jobs %}

  worker:
    image: {{ app.name }}-api
    command: ["python", "-m", "app.worker"]
    environment:
{{ environment(worker=True).rstrip() }}
{% if py.storage %}
    volumes:
      - files:/app/uploads
{% endif %}
    depends_on:
      migrate:
        condition: service_completed_successfully
{% endif %}
{% if py.redis or py.live %}

  redis:
    image: ${REDIS_IMAGE:-redis:8-alpine}
    profiles: [redis]
{% endif %}

volumes:
  db-data:
{% if py.storage %}
  files:
{% endif %}
