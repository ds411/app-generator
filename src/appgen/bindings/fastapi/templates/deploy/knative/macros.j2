{# The environment of the containers of the API and of the worker (`env`). #}
{% macro env() %}
            # The settings that are not secret (see app/core/config.py).
            - name: LOG_LEVEL
              value: INFO
            - name: LOG_JSON
              value: "true"
{% if py.redis %}
            # The limit of all instances with RATE_LIMIT_STORE_URL, else of each instance.
            - name: RATE_LIMIT_PER_MINUTE
              value: "600"
            # true: give 503 when Redis is not available. false: let the requests through.
            - name: RATE_LIMIT_FAIL_CLOSED
              value: "false"
{% else %}
            # The limit of each instance: the API allows this number times the instances.
            - name: RATE_LIMIT_PER_MINUTE
              value: "600"
{% endif %}
            - name: CORS_ORIGINS
              value: "[]"
{% if definition.auth and definition.auth.password_reset %}
            # The page of the front end that sets a new password with a reset link.
            - name: PASSWORD_RESET_URL
              value: https://app.example.com/reset-password
{% endif %}
{% if definition.auth and definition.auth.sign_up and definition.auth.sign_up.verify_email %}
            # The page of the front end that confirms an email address with a link.
            - name: EMAIL_VERIFY_URL
              value: https://app.example.com/verify-email
{% endif %}
{% if py.smtp %}
            # The SMTP server of the messages of the sign-in.
            - name: SMTP_HOST
              value: smtp.example.com
            - name: SMTP_PORT
              value: "587"
            - name: SMTP_USERNAME
              value: no-reply@example.com
            - name: SMTP_FROM
              value: no-reply@example.com
            - name: SMTP_TLS
              value: starttls
{% endif %}
{% for api in py_apis.values() %}
            {{ trace(api.id) }}
            - name: {{ api.url_env }}
              value: {{ api.base_url | tojson }}
{% if api.client_id_env %}
            - name: {{ api.client_id_env }}
              value: ""
{% endif %}
{% endfor %}
{% if py.storage %}
{% set st = py.storage %}
            {{ trace(st.id) }}
{% if st.s3 %}
            # The bucket of the files of the file fields.
            - name: {{ st.variables["bucket_env"] }}
              value: {{ app.name }}-files
            - name: {{ st.variables["region_env"] }}
              value: eu-central-1
            # The URL of a service that is not Amazon S3. Empty: Amazon S3.
            - name: {{ st.variables["endpoint_env"] }}
              value: ""
{% else %}
            # The folder of the files of the file fields. The instances do not
            # share it, and a new instance starts without the files: use the
            # storage kind s3 for more than one instance.
            - name: {{ st.variables["folder_env"] }}
              value: /app/uploads
{% endif %}
            # The time that a link of a file works, in seconds.
            - name: STORAGE_LINK_SECONDS
              value: "3600"
{% endif %}
{% if py.providers %}
            # The URL of the API for the browsers: the providers send the users back to it.
            - name: PUBLIC_URL
              value: https://api.example.com
{% for p in py.providers %}
            {{ trace(p.id) }}
            - name: {{ p.name | upper }}_ISSUER
              value: {{ p.issuer | tojson }}
            - name: {{ p.client_id_env }}
              value: ""
{% endfor %}
{% endif %}
            # The secrets. In Cloud Run, `name` is a secret of Secret Manager
            # and `key` its version. In Knative, `name` is a Kubernetes Secret
            # and `key` the key of the value in it.
            - name: DATABASE_URL
              valueFrom:
                secretKeyRef:
                  name: {{ app.name }}-database-url
                  key: latest
{% if py.redis %}
            - name: RATE_LIMIT_STORE_URL
              valueFrom:
                secretKeyRef:
                  name: {{ app.name }}-rate-limit-store-url
                  key: latest
{% endif %}
{% if definition.auth %}
            - name: AUTH_SECRET
              valueFrom:
                secretKeyRef:
                  name: {{ app.name }}-auth-secret
                  key: latest
{% endif %}
{% if py.smtp %}
            - name: SMTP_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: {{ app.name }}-smtp-password
                  key: latest
{% endif %}
{% if py.storage %}
            {{ trace(py.storage.id) }}
{% set secrets = ["STORAGE_LINK_SECRET"] + ([py.storage.variables["access_key_env"], py.storage.variables["secret_key_env"]] if py.storage.s3 else []) %}
{% for name in secrets %}
            - name: {{ name }}
              valueFrom:
                secretKeyRef:
                  name: {{ app.name }}-{{ name | lower | replace("_", "-") }}
                  key: latest
{% endfor %}
{% endif %}
{% for api in py_apis.values() if api.secret_env %}
            {{ trace(api.id) }}
            - name: {{ api.secret_env }}
              valueFrom:
                secretKeyRef:
                  name: {{ app.name }}-{{ api.secret_env | lower | replace("_", "-") }}
                  key: latest
{% endfor %}
{% for w in py_webhooks.values() %}
            {{ trace(w.id) }}
            - name: {{ w.secret_env }}
              valueFrom:
                secretKeyRef:
                  name: {{ app.name }}-{{ w.secret_env | lower | replace("_", "-") }}
                  key: latest
{% endfor %}
{% for p in py.providers %}
            {{ trace(p.id) }}
            - name: {{ p.client_secret_env }}
              valueFrom:
                secretKeyRef:
                  name: {{ app.name }}-{{ p.client_secret_env | lower | replace("_", "-") }}
                  key: latest
{% endfor %}
{% endmacro %}
