{{ trace_header("app") }}
# Copy this file to secret.env, and set the values. Do not commit secret.env.
DATABASE_URL=postgresql+asyncpg://app:change-me@postgres.example.com:5432/{{ py.package }}
{% if py.redis %}
# The Redis of the rate limit, so that all replicas share one limit. Empty: each replica counts.
RATE_LIMIT_STORE_URL=redis://:change-me@redis.example.com:6379/0
{% endif %}
{% if py.live %}
# The Redis of the live events, so that each replica sends the changes of all replicas.
LIVE_EVENTS_URL=redis://:change-me@redis.example.com:6379/0
{% endif %}
{% if definition.auth %}
# A long random text, for example from `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
AUTH_SECRET=
{% endif %}
{% if py.smtp %}
# The password at the SMTP server of the messages of the sign-in.
SMTP_PASSWORD=
{% endif %}
{% if py.storage %}
{{ trace(py.storage.id) }}
# The secret key of the links of the files: a long random text, the same in all replicas.
STORAGE_LINK_SECRET=
{% if py.storage.s3 %}
# The keys of the bucket. Empty: the role of the pod, for example IAM roles for service accounts.
{{ py.storage.variables["access_key_env"] }}=
{{ py.storage.variables["secret_key_env"] }}=
{% endif %}
{% endif %}
{% for api in py_apis.values() if api.secret_env %}
{{ trace(api.id) }}
{% for env in api.secret_envs %}
{{ env }}=
{% endfor %}
{% endfor %}
{% for w in py_webhooks.values() %}
{{ trace(w.id) }}
# The secret of the signatures of the webhook {{ w.name }}.
{{ w.secret_env }}=
{% endfor %}
{% for p in py.providers %}
{{ trace(p.id) }}
# The client secret of the app at the provider {{ p.name }}.
{{ p.client_secret_env }}=
{% endfor %}
