{{ trace_header("app") }}
# Copy this file to secret.env, and set the values. Do not commit secret.env.
DATABASE_URL=postgresql+asyncpg://app:change-me@postgres.example.com:5432/{{ py.package }}
{% if py.redis %}
# The Redis of the rate limit, so that all replicas share one limit. Empty: each replica counts.
RATE_LIMIT_STORE_URL=redis://:change-me@redis.example.com:6379/0
{% endif %}
{% if definition.auth %}
# A long random text, for example from `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
AUTH_SECRET=
{% endif %}
{% for api in py_apis.values() if api.secret_env %}
{{ trace(api.id) }}
{{ api.secret_env }}=
{% endfor %}
