{{ trace_header("app") }}
# The settings of the API that are not secret (see app/core/config.py).
LOG_LEVEL=INFO
LOG_JSON=true
{% if py.redis %}
# The limit of all replicas with RATE_LIMIT_STORE_URL (secret.env), else of each replica.
RATE_LIMIT_PER_MINUTE=600
# true: give 503 when Redis is not available. false: let the requests through.
RATE_LIMIT_FAIL_CLOSED=false
{% else %}
# The limit of each replica: the API allows this number times the replicas.
RATE_LIMIT_PER_MINUTE=600
{% endif %}
CORS_ORIGINS=[]
{% if py.jobs %}
# The passes of the worker of the jobs: the time between two passes, and
# the window of the runs that a pass catches up.
JOBS_INTERVAL_SECONDS=60
JOBS_WINDOW_MINUTES=60
{% endif %}
{% if definition.auth and definition.auth.password_reset %}
# The page of the front end that sets a new password with a reset link.
PASSWORD_RESET_URL=https://app.example.com/reset-password
{% endif %}
{% if definition.auth and definition.auth.sign_up and definition.auth.sign_up.verify_email %}
# The page of the front end that confirms an email address with a link.
EMAIL_VERIFY_URL=https://app.example.com/verify-email
{% endif %}
{% if py.smtp %}
# The SMTP server of the messages of the sign-in. SMTP_PASSWORD is in secret.env.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=no-reply@example.com
SMTP_FROM=no-reply@example.com
SMTP_TLS=starttls
{% endif %}
{% for api in py_apis.values() %}
{{ trace(api.id) }}
{{ api.url_env }}={{ api.base_url }}
{% if api.client_id_env %}
{{ api.client_id_env }}=
{% endif %}
{% endfor %}
{% if py.storage %}
{% set st = py.storage %}
{{ trace(st.id) }}
{% if st.s3 %}
# The bucket of the files of the file fields. Its keys are in secret.env.
{{ st.variables["bucket_env"] }}={{ app.name }}-files
{{ st.variables["region_env"] }}=eu-central-1
# The URL of a service that is not Amazon S3. Empty: Amazon S3.
{{ st.variables["endpoint_env"] }}=
{% else %}
# The folder of the files of the file fields: the volume of all replicas (files-volume.yaml).
{{ st.variables["folder_env"] }}=/app/uploads
{% endif %}
# The time that a link of a file works, in seconds.
STORAGE_LINK_SECONDS=3600
{% endif %}
{% if py.providers %}
# The URL of the API for the browsers: the providers send the users back to it.
PUBLIC_URL=https://api.example.com
{% for p in py.providers %}
{{ trace(p.id) }}
{{ p.name | upper }}_ISSUER={{ p.issuer }}
{{ p.client_id_env }}=
{% endfor %}
{% endif %}
