{{ trace_header("app") }}
# The settings of the API that are not secret (see app/core/config.py).
LOG_LEVEL=INFO
LOG_JSON=true
{% if py.redis %}
# The limit of all replicas with RATE_LIMIT_STORE_URL (secret.env), else of each replica.
RATE_LIMIT_PER_MINUTE=600
# true: give 503 when Redis is not available. false: let the requests through.
RATE_LIMIT_FAIL_CLOSED=false
{% else %}
# The limit of each replica: the API allows this number times the replicas.
RATE_LIMIT_PER_MINUTE=600
{% endif %}
CORS_ORIGINS=[]
{% if definition.auth and definition.auth.password_reset %}
# The page of the front end that sets a new password with a reset link.
PASSWORD_RESET_URL=https://app.example.com/reset-password
{% endif %}
{% if definition.auth and definition.auth.sign_up and definition.auth.sign_up.verify_email %}
# The page of the front end that confirms an email address with a link.
EMAIL_VERIFY_URL=https://app.example.com/verify-email
{% endif %}
{% for api in py_apis.values() %}
{{ trace(api.id) }}
{{ api.url_env }}={{ api.base_url }}
{% endfor %}
{% if py.providers %}
# The URL of the API for the browsers: the providers send the users back to it.
PUBLIC_URL=https://api.example.com
{% for p in py.providers %}
{{ trace(p.id) }}
{{ p.name | upper }}_ISSUER={{ p.issuer }}
{{ p.client_id_env }}=
{% endfor %}
{% endif %}
