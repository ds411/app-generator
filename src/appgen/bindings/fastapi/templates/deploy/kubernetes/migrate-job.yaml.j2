{{ trace_header("app") }}
# Run the migrations of the database (alembic upgrade head) once.
apiVersion: batch/v1
kind: Job
metadata:
  name: {{ app.name }}-migrate
spec:
  backoffLimit: 3
  ttlSecondsAfterFinished: 86400
  template:
    metadata:
      labels:
        app.kubernetes.io/component: migrate
    spec:
      restartPolicy: Never
      securityContext:
        runAsNonRoot: true
        runAsUser: 10001
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: migrate
          image: {{ app.name }}-api
          command: ["alembic", "upgrade", "head"]
          envFrom:
            - secretRef:
                name: {{ app.name }}-secret
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
