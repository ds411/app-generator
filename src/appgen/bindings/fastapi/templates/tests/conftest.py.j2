"""The functions of the repositories that run the events (ADR 0031)."""


async def _no_event(*args: object) -> None:
    """Run no event."""


@pytest.fixture(autouse=True)
def turn_off_events(request: pytest.FixtureRequest, monkeypatch: pytest.MonkeyPatch) -> None:
    """Turn off the events of the entities, so that the operations of the events do not run.

    The tests of the other features do not depend on the logic of these
    operations. A test with the mark `events` runs the events of all
    entities, and `events("{{ event_entities[0].name }}")` runs the events of one entity.
    """
    marker = request.keywords.get("events")
    for entity, repository, name in EVENTS:
        if marker is None or (marker.args and entity not in marker.args):
            monkeypatch.setattr(repository, name, _no_event)
