async def test_a_client_that_reads_too_slowly_gets_reset() -> None:
    subscription = Subscription(Viewer(frozenset({"{{ py.live[0].name }}"})), size=1)
    for _ in range(2):
        subscription.offer(Change("{{ py.live[0].name }}", uuid4(), "created"))

    assert await subscription.next() == LiveEvent(type="reset")


async def test_the_streams_end_when_the_server_stops() -> None:
    broker = Broker()
    viewer = Viewer(frozenset({"{{ py.live[0].name }}"}))
    waiting = asyncio.create_task(broker.subscribe(viewer).next())
    await asyncio.sleep(0)

    broker.end_streams()

    assert await asyncio.wait_for(waiting, 2) is None
    assert await broker.subscribe(viewer).next() is None


async def test_sigterm_ends_the_streams_and_then_calls_the_server() -> None:
    calls: list[int] = []

    def server(number: int, frame: FrameType | None) -> None:
        calls.append(number)

    before = signal.signal(signal.SIGTERM, server)
    broker = Broker()
    subscription = broker.subscribe(Viewer(frozenset({"{{ py.live[0].name }}"})))
    try:
        with end_streams_on_exit(broker):
            signal.raise_signal(signal.SIGTERM)
            assert await asyncio.wait_for(subscription.next(), 2) is None
        assert signal.getsignal(signal.SIGTERM) is server
    finally:
        signal.signal(signal.SIGTERM, before)

    assert calls == [signal.SIGTERM]


async def test_without_redis_the_process_gets_its_own_events(
    caplog: pytest.LogCaptureFixture,
) -> None:
    # Nothing listens on the port: each call of Redis fails.
    broker = Broker("redis://127.0.0.1:9/0")
    subscription = broker.subscribe(Viewer(frozenset({"{{ py.live[0].name }}"})))
    value = Change("{{ py.live[0].name }}", uuid4(), "created")

    broker.publish([value])
    event = await asyncio.wait_for(subscription.next(), 5)
    await broker.close()

    assert event == LiveEvent(type="created", entity="{{ py.live[0].name }}", id=value.id)
    assert "The Redis of the live events is not available" in caplog.text
