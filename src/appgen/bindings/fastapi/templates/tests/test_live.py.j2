async def test_a_ticket_opens_the_stream_of_its_user(app: FastAPI) -> None:
    async with sessions_of(app)() as session:
        _, headers = await headers_of(session{{ (", " ~ (role | tojson)) if access }})
    async with AsyncClient(transport=ASGITransport(app=app), base_url="http://test") as client:
        response = await client.post("/live/ticket", headers=headers)
        assert response.status_code == 200
        ticket = response.json()["ticket"]
        assert response.json()["expires_in"] == 30
        assert (await client.post("/live/ticket")).status_code == 401
    async with (
        sessions_of(app)() as session,
        open_stream(app, f"entity={{ first.name }}&ticket={ticket}") as stream,
    ):
        record = await make_{{ first.snake }}(session)
        assert await stream.next() == change("created", "{{ first.name }}", record.id)
    # A token of a session is not a ticket.
    token = headers["Authorization"].removeprefix("Bearer ")
    async with open_stream(app, f"entity={{ first.name }}&ticket={token}") as stream:
        assert stream.status == 401
