def sessions_of(app: FastAPI) -> async_sessionmaker[AsyncSession]:
    """Return the sessions of the app: the broker of the app sends their changes."""
    return app.state.sessions


class Stream:
    """An open stream of `GET /live`: its status, its body, and its events."""

    def __init__(self) -> None:
        self.status = 0
        self.body = ""
        self.events: asyncio.Queue[dict[str, Any]] = asyncio.Queue()

    def feed(self, text: str) -> None:
        """Read the events of a part of the stream. An empty line ends an event."""
        self.body += text
        while self.status == 200 and "\n\n" in self.body:
            block, self.body = self.body.split("\n\n", 1)
            data = [line[6:] for line in block.splitlines() if line.startswith("data: ")]
            if data:
                self.events.put_nowait(json.loads("\n".join(data)))

    async def next(self) -> dict[str, Any]:
        """Return the next event. An event takes less than two seconds."""
        return await asyncio.wait_for(self.events.get(), 2)


@asynccontextmanager
async def open_stream(
    app: FastAPI, query: str = "", headers: dict[str, str] | None = None
) -> AsyncGenerator[Stream]:
    """Open `GET /live?<query>`, and wait for the event `open`. Close the stream at the end."""
    stream = Stream()
    started = asyncio.Event()
    closed = asyncio.Event()

    async def receive() -> Message:
        await closed.wait()
        return {"type": "http.disconnect"}

    async def send(message: Message) -> None:
        if message["type"] == "http.response.start":
            stream.status = message["status"]
            started.set()
        elif message["type"] == "http.response.body":
            stream.feed(message.get("body", b"").decode())

    scope: Scope = {
        "type": "http",
        "asgi": {"version": "3.0"},
        "http_version": "1.1",
        "method": "GET",
        "scheme": "http",
        "path": "/live",
        "raw_path": b"/live",
        "query_string": query.encode(),
        "headers": [(k.lower().encode(), v.encode()) for k, v in (headers or {}).items()],
        "client": ("127.0.0.1", 50000),
        "server": ("test", 80),
        "root_path": "",
    }
    task = asyncio.create_task(app(scope, receive, send))
    try:
        await asyncio.wait_for(started.wait(), 5)
        if stream.status == 200:
            assert await stream.next() == {"type": "open"}
        yield stream
    finally:
        closed.set()
        await asyncio.wait_for(task, 5)


def change(action: str, entity: str, id: UUID) -> dict[str, Any]:
    """Return the event of a change of a record."""
    return {"type": action, "entity": entity, "id": str(id)}
