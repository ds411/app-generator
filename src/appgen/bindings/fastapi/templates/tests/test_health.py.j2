import pytest
from httpx import AsyncClient

pytestmark = pytest.mark.anyio


async def test_the_health_check_returns_ok(client: AsyncClient) -> None:
    response = await client.get("/health")

    assert response.status_code == 200
    assert response.json() == {"status": "ok"}


async def test_the_openapi_document_has_the_title_of_the_app(client: AsyncClient) -> None:
    response = await client.get("/openapi.json")

    assert response.status_code == 200
    assert response.json()["info"]["title"] == {{ app.title | tojson }}
