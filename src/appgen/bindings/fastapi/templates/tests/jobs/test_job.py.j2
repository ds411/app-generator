async def run_of(session: AsyncSession, key: str) -> JobRun | None:
    """Return the run of a key, with fresh data."""
    statement = select(JobRun).where(JobRun.key == key)
    return await session.scalar(statement.execution_options(populate_existing=True))
{% set key_expr = 'f"' ~ job.name ~ ':{record}:{TIME:%Y-%m-%dT%H:%M:%SZ}"' if e else 'f"' ~ job.name ~ ':-:{TIME:%Y-%m-%dT%H:%M:%SZ}"' %}


async def test_the_job_runs_once_for_each_{{ "record_and_" if e }}time(
    sessions: async_sessionmaker[AsyncSession],
    settings: Settings,
    session: AsyncSession,
    calls: list[{{ record_type }}],
) -> None:
{% if job.at %}
    record = await make_record(session)
{% if job.at.type == "date" %}
    await make_record(session, VALUE + dt.timedelta(days=1))
    await make_record(session, VALUE - dt.timedelta(days=1))
{% else %}
    await make_record(session, VALUE + dt.timedelta(hours=1))
    await make_record(session, VALUE - WINDOW)
{% endif %}

    assert await {{ call }} == 1
    assert await {{ call }} == 0

    assert calls == [record]
{% elif e %}
    record = await make_record(session)

    assert await {{ call }} == 1
    assert await {{ call }} == 0
{% if job.fixed_filter %}
    assert await {{ job.module }}.run(sessions, settings, NEXT, WINDOW) == 1

    assert calls == [record, record]
{% else %}

    assert calls == [record]
{% endif %}
{% else %}
    assert await {{ call }} == 1
    assert await {{ call }} == 0
    assert await {{ job.module }}.run(sessions, settings, NEXT, WINDOW) == 1

    assert calls == [TIME, NEXT]
{% endif %}
    run = await run_of(session, {{ key_expr }})
    assert run is not None
    assert run.status == "done"
    assert run.attempts == 1
{% if job.at and job.fixed_filter %}


async def test_the_job_runs_again_after_a_change_of_the_time(
    sessions: async_sessionmaker[AsyncSession],
    settings: Settings,
    session: AsyncSession,
    calls: list[UUID],
) -> None:
    record = await make_record(session)
    assert await {{ call }} == 1

{% if job.at.type == "date" %}
    later = VALUE + dt.timedelta(days=1)
    statement = update({{ e.name }}).where({{ e.name }}.id == record).values({{ job.at.attr }}=later)
    await session.execute(statement)
    await session.commit()

    now = NOW + dt.timedelta(days=1)
    assert await {{ job.module }}.run(sessions, settings, now, WINDOW) == 1
{% else %}
    later = VALUE + dt.timedelta(minutes=30)
    statement = update({{ e.name }}).where({{ e.name }}.id == record).values({{ job.at.attr }}=later)
    await session.execute(statement)
    await session.commit()

    now = NOW + dt.timedelta(minutes=30)
    assert await {{ job.module }}.run(sessions, settings, now, WINDOW) == 1
{% endif %}

    assert calls == [record, record]
{% endif %}
{% if t and t.failing %}


