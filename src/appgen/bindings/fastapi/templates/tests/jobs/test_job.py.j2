async def test_two_workers_run_each_run_once(
    migrated_url: str,
    sessions: async_sessionmaker[AsyncSession],
    settings: Settings,
    session: AsyncSession,
    calls: list[{{ record_type }}],
) -> None:
{% if e %}
    record = await make_record(session)
{% endif %}
    engine = make_engine(migrated_url)
    try:
        other = make_sessions(engine)
        counts = await asyncio.gather(
            {{ job.module }}.run(sessions, settings, NOW, WINDOW),
            {{ job.module }}.run(other, settings, NOW, WINDOW),
        )
    finally:
        await engine.dispose()

    assert sorted(counts) == [0, 1]
    assert calls == [{{ "record" if e else "TIME" }}]


async def test_a_failed_run_is_in_the_log_and_runs_again(
    monkeypatch: pytest.MonkeyPatch,
    sessions: async_sessionmaker[AsyncSession],
    settings: Settings,
    session: AsyncSession,
    calls: list[{{ record_type }}],
    caplog: pytest.LogCaptureFixture,
) -> None:
{% if e %}
    record = await make_record(session)
{% endif %}
    attempts: list[int] = []

{% if e %}
    async def failing(session: AsyncSession, record: {{ e.name }}, *args: object) -> None:
{% else %}
    async def failing(session: AsyncSession, settings: Settings, time: dt.datetime) -> None:
{% endif %}
        attempts.append(len(attempts) + 1)
        if len(attempts) == 1:
            raise RuntimeError("The first attempt fails.")

    monkeypatch.setattr({{ target }}, "{{ function }}", failing)
    with caplog.at_level(logging.ERROR, logger="app.jobs"):
        assert await {{ call }} == 0
    assert await {{ call }} == 1

    [entry] = [r for r in caplog.records if r.name == "app.jobs"]
    assert entry.__dict__["job"] == "{{ job.name }}"
    assert entry.__dict__["record_id"] == {{ "str(record)" if e else '"-"' }}
    assert attempts == [1, 2]
    run = await run_of(session, {{ key_expr }})
    assert run is not None
    assert run.status == "done"
    assert run.attempts == 2
