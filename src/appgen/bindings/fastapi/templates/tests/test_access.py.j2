async def test_the_record_rule_limits_the_role_{{ t.name }}(
    anonymous_client: AsyncClient, session: AsyncSession
) -> None:
    {{ "user_id" if t.owner else "_" }}, headers = await _headers_of(session, "{{ t.role }}")
{% if t.owner %}
    other_id, _ = await _headers_of(session, "{{ t.role }}")
