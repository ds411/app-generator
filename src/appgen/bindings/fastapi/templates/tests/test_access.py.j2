async def _headers_of(
    client: AsyncClient,
    session: AsyncSession,
    role: str,
) -> tuple[str, dict[str, str]]:
    """Store a user with a role and a password, sign in, and return the user ID and the headers."""
    user = await make_{{ u.snake }}(session, {{ role_field.name }}=role)
    await set_password(session, user, PASSWORD)
    response = await client.post(
        "/auth/sign-in", json={"username": user.{{ username.attr }}, "password": PASSWORD}
    )
    assert response.status_code == 200, response.text
    return str(user.id), {"Authorization": f"Bearer {response.json()['access_token']}"}


{{ trace(oc.rule.id) }}
async def test_an_owner_rule_limits_the_role_{{ oc.role }}_to_its_{{ e.slice }}(
    anonymous_client: AsyncClient, session: AsyncSession
) -> None:
    user_id, headers = await _headers_of(anonymous_client, session, "{{ oc.role }}")
    other_id, _ = await _headers_of(anonymous_client, session, "{{ oc.role }}")
    mine = await make_{{ e.snake }}(session, {{ fk }}=user_id)
    theirs = await make_{{ e.snake }}(session, {{ fk }}=other_id)
{% if reads and "list" in ops %}

    response = await anonymous_client.get("{{ e.path }}{{ ops["list"].path }}", headers=headers)
    assert response.status_code == 200, response.text
    assert [item["id"] for item in response.json()["items"]] == [str(mine.id)]
{% endif %}
{% if reads and "read" in ops %}
    path = "{{ e.path }}{{ ops["read"].path | replace('{id}', '') }}"
    assert (await anonymous_client.get(f"{path}{mine.id}", headers=headers)).status_code == 200
    assert_problem(await anonymous_client.get(f"{path}{theirs.id}", headers=headers), 404)
{% endif %}
{% if "update" in ops %}
    path = "{{ e.path }}{{ ops["update"].path | replace('{id}', '') }}"
    response = await anonymous_client.patch(f"{path}{theirs.id}", json={}, headers=headers)
    assert_problem(response, 404)
{% endif %}
{% if "custom" in ops %}
    path = f"{{ e.path }}{{ ops["custom"].path | replace('{id}', '{theirs.id}') }}"
    assert_problem(await anonymous_client.post(path, json={}, headers=headers), 404)
{% endif %}
{% if "delete" in ops %}
    path = "{{ e.path }}{{ ops["delete"].path | replace('{id}', '') }}"
    assert_problem(await anonymous_client.delete(f"{path}{theirs.id}", headers=headers), 404)
{% endif %}
{% if "create" in ops %}
    payload = await {{ e.snake }}_input(session, {{ fk }}=other_id)
    path = "{{ e.path }}{{ ops["create"].path }}"
    response = await anonymous_client.post(path, json=payload, headers=headers)
    assert response.status_code == 201, response.text
    assert response.json()["{{ fk }}"] == user_id
{% endif %}
{% if oc.other and "list" in ops and roles[oc.other].allows_operation(ops["list"].name) %}


{{ trace(oc.rule.id) }}
async def test_the_role_{{ oc.other }}_without_an_owner_rule_sees_all_{{ e.slice }}(
    anonymous_client: AsyncClient, session: AsyncSession
) -> None:
    _, headers = await _headers_of(anonymous_client, session, "{{ oc.other }}")
    first = await make_{{ e.snake }}(session)
    second = await make_{{ e.snake }}(session)

    response = await anonymous_client.get("{{ e.path }}{{ ops["list"].path }}", headers=headers)

    assert response.status_code == 200, response.text
    assert {item["id"] for item in response.json()["items"]} == {str(first.id), str(second.id)}
{% endif %}
