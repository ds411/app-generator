pytestmark = pytest.mark.anyio

PASSWORD = "correct-horse-battery"


def test_each_role_has_its_operations() -> None:
{% for name, r in roles.items() %}
{% for op_name in definition.operations %}
    assert allows("{{ name }}", "{{ op_name }}") is {{ r.allows_operation(op_name) }}  {{ trace(r.id) }}
{% endfor %}
{% endfor %}
    assert allows("no-such-role", "{{ definition.operations | first }}") is False
