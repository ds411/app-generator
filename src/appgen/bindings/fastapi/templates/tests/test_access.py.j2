async def _token(client: AsyncClient, session: AsyncSession, role: str) -> str:
    """Store a user with a role and a password, sign in, and return the token."""
    user = await make_{{ u.snake }}(session, {{ role_field.name }}=role)
    await set_password(session, user, PASSWORD)
    response = await client.post(
        "/auth/sign-in", json={"username": user.{{ username.attr }}, "password": PASSWORD}
    )
    assert response.status_code == 200, response.text
    return response.json()["access_token"]


{{ trace(op.id) }}
async def test_a_role_calls_only_its_operations(
    anonymous_client: AsyncClient, session: AsyncSession
) -> None:
    for role, status in (("{{ deny }}", 403), ("{{ allow }}", {{ op.status }})):
        headers = {"Authorization": f"Bearer {await _token(anonymous_client, session, role)}"}
{% if op.kind == "create" %}
        payload = await {{ e.snake }}_input(session)
        response = await anonymous_client.post("{{ e.path }}{{ op.path }}", json=payload, headers=headers)
{% else %}
        response = await anonymous_client.get("{{ e.path }}{{ op.path }}", headers=headers)
{% endif %}

        assert response.status_code == status, response.text
{% endif %}
