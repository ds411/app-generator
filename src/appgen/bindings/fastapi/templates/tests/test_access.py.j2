async def _headers_of(session: AsyncSession, role: str) -> tuple[str, dict[str, str]]:
    """Store a user with a role, and return the user ID and the headers with a token."""
    user = await make_{{ u.snake }}(session, {{ role_field.name }}=role)
    return str(user.id), {"Authorization": f"Bearer {make_token(b'test-secret', user.id)}"}
