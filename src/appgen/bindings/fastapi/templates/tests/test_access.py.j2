    owner = await _{{ e.snake }}_owner(session, user_id)
    other_owner = await _{{ e.snake }}_owner(session, other_id)
{% endif %}
{% if conditions %}
    inside: dict[str, Any] = {{ t.inside }}
{% endif %}
    mine = await make_{{ e.snake }}(session, {{ args(mine_owner) }})
{% if t.owner %}
    theirs = await make_{{ e.snake }}(session, {{ args(their_owner) }})
{% endif %}
{% for values in t.outside %}
    out_{{ loop.index }}: dict[str, Any] = {{ values }}
    outside_{{ loop.index }} = await make_{{ e.snake }}(session, {{ args(mine_owner, "out_" ~ loop.index) }})
{% endfor %}
{% set ns_others = namespace(names=(["theirs"] if t.owner else [])) %}
{% for values in t.outside %}
{% set ns_others.names = ns_others.names + ["outside_" ~ loop.index] %}
{% endfor %}
{% set others = ns_others.names %}
{% if t.reads and "list" in ops %}

    response = await anonymous_client.get("{{ e.path }}{{ ops["list"].path }}", headers=headers)
    assert response.status_code == 200, response.text
    assert [item["id"] for item in response.json()["items"]] == [str(mine.id)]
{% endif %}
{% if "read" in ops %}
    path = "{{ e.path }}{{ ops["read"].path | replace('{id}', '') }}"
    assert (await anonymous_client.get(f"{path}{mine.id}", headers=headers)).status_code == 200
{% for other in others %}
{% if t.reads %}
    assert_problem(await anonymous_client.get(f"{path}{ {{- other }}.id}", headers=headers), 404)
{% else %}
    # The rule limits only the changes: the role reads all records.
    response = await anonymous_client.get(f"{path}{ {{- other }}.id}", headers=headers)
    assert response.status_code == 200, response.text
{% endif %}
{% endfor %}
{% endif %}
