{{ trace(r.id) }}
async def test_the_role_{{ t.role }}_sees_no_hidden_{{ r.attr }}_in_the_{{ e.slice }}(
    anonymous_client: AsyncClient, session: AsyncSession
) -> None:
    _, headers = await _headers_of(session, "{{ t.role }}")
    values: dict[str, Any] = {{ t.values }}
    inside: dict[str, Any] = {{ t.inside }}
    outside: dict[str, Any] = {{ t.outside }}
{% if r.side == "fk" %}
    shown = await make_{{ target.snake }}(session, **inside)
    hidden = await make_{{ target.snake }}(session, **outside)
    first = await make_{{ e.snake }}(session, {{ r.fk_attr }}=str(shown.id), **values)
    second = await make_{{ e.snake }}(session, {{ r.fk_attr }}=str(hidden.id), **values)
    path = "{{ e.path }}{{ t.read.path | replace('{id}', '') }}"

    response = await anonymous_client.get(f"{path}{first.id}", headers=headers)
    assert response.status_code == 200, response.text
    assert response.json()["{{ r.attr }}"]["id"] == str(shown.id)
    # A hidden record of one gives null, and its ID stays.
    response = await anonymous_client.get(f"{path}{second.id}", headers=headers)
    assert response.status_code == 200, response.text
    assert response.json()["{{ r.attr }}"] is None
    assert response.json()["{{ r.fk_attr }}"] == str(hidden.id)
{% elif r.side == "m2m" %}
    shown = await make_{{ target.snake }}(session, **inside)
    hidden = await make_{{ target.snake }}(session, **outside)
    ids = [str(shown.id), str(hidden.id)]
    record = await make_{{ e.snake }}(session, {{ r.ids_field }}=ids, **values)
    path = "{{ e.path }}{{ t.read.path | replace('{id}', '') }}"

    response = await anonymous_client.get(f"{path}{record.id}", headers=headers)
    assert response.status_code == 200, response.text
    # A hidden record is not in the embedded list.
    assert [item["id"] for item in response.json()["{{ r.attr }}"]] == [str(shown.id)]
{% elif r.many %}
    record = await make_{{ e.snake }}(session, **values)
    shown = await make_{{ target.snake }}(session, {{ t.link }}=str(record.id), **inside)
    await make_{{ target.snake }}(session, {{ t.link }}=str(record.id), **outside)
    path = "{{ e.path }}{{ t.read.path | replace('{id}', '') }}"

    response = await anonymous_client.get(f"{path}{record.id}", headers=headers)
    assert response.status_code == 200, response.text
    # A hidden record is not in the embedded list.
    assert [item["id"] for item in response.json()["{{ r.attr }}"]] == [str(shown.id)]
{% else %}
    record = await make_{{ e.snake }}(session, **values)
    await make_{{ target.snake }}(session, {{ t.link }}=str(record.id), **outside)
    path = "{{ e.path }}{{ t.read.path | replace('{id}', '') }}"

    response = await anonymous_client.get(f"{path}{record.id}", headers=headers)
    assert response.status_code == 200, response.text
    assert response.json()["{{ r.attr }}"] is None
{% endif %}
