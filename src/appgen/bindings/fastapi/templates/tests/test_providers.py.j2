async def test_a_provider_that_verifies_the_address_removes_a_password_that_is_not_verified(
    browser: AsyncClient, session: AsyncSession, provider: FakeProvider
) -> None:
    user = await make_{{ u.snake }}(session)
    password_hash = hash_password("a-password-of-a-sign-up")
    session.add(Credential(user_id=user.id, password_hash=password_hash, email_verified_at=null()))
    await session.commit()
    claims = {"email": user.{{ address.attr }}, "email_verified": True}

    response = await _sign_in(browser, provider, claims | {"{{ p.username_claim }}": user.{{ username.attr }}})

    assert response.status_code == 200, response.text
    session.expunge_all()
    assert await session.get(Credential, user.id) is None
