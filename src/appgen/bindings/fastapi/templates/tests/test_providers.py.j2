async def test_an_id_token_that_is_not_valid_gives_401(
    browser: AsyncClient, session: AsyncSession, provider: FakeProvider, change: dict[str, Any]
) -> None:
    user = await make_{{ u.snake }}(session)
    claims = {"{{ p.username_claim }}": user.{{ username.attr }}} | change

    response = await _sign_in(browser, provider, claims)

    assert_problem(response, 401)


async def test_an_id_token_with_the_signature_of_another_key_gives_401(
    browser: AsyncClient, session: AsyncSession, provider: FakeProvider
) -> None:
    user = await make_{{ u.snake }}(session)
    claims = {"{{ p.username_claim }}": user.{{ username.attr }}}
    callback = provider.sign_in(await _start(browser), claims, key=_rsa_key())

    response = await browser.get(callback)

    assert_problem(response, 401)


async def test_a_callback_with_another_state_gives_400(
    browser: AsyncClient, provider: FakeProvider
) -> None:
    callback = provider.sign_in(await _start(browser), {})
    code = parse_qs(urlsplit(callback).query)["code"][0]

    response = await browser.get(CALLBACK, params={"code": code, "state": "another-state"})

    assert_problem(response, 400)


async def test_a_callback_without_the_flow_cookie_gives_400(
    browser: AsyncClient, provider: FakeProvider
) -> None:
    callback = provider.sign_in(await _start(browser), {})
    browser.cookies.clear()

    response = await browser.get(callback)

    assert_problem(response, 400)
