async def test_the_callback_sends_the_token_to_the_page_of_return_to(
    browser: AsyncClient, session: AsyncSession, provider: FakeProvider
) -> None:
    user = await make_{{ u.snake }}(session)
    claims = {"{{ p.username_claim }}": user.{{ username.attr }}}

    response = await _sign_in(browser, provider, claims, return_to=f"{FRONT_END}/home")

    assert response.status_code == 303, response.text
    page, _, fragment = response.headers["location"].partition("#")
    assert page == f"{FRONT_END}/home"
    token = parse_qs(fragment)["access_token"][0]
    assert (await _me(browser, token))["id"] == str(user.id)


async def test_the_callback_sends_an_error_to_the_page_of_return_to(
    browser: AsyncClient, provider: FakeProvider
) -> None:
    location = await _start(browser, return_to=f"{FRONT_END}/home")
    state = parse_qs(urlsplit(location).query)["state"][0]

    response = await browser.get(CALLBACK, params={"error": "access_denied", "state": state})

    assert response.status_code == 303, response.text
    fragment = response.headers["location"].partition("#")[2]
    assert "access_denied" in parse_qs(fragment)["error"][0]


async def test_a_return_to_of_another_origin_gives_422(browser: AsyncClient) -> None:
    response = await browser.get(
        "/auth/providers/{{ p.name }}/start", params={"return_to": "https://another.test/"}
    )

    assert_problem(response, 422)


