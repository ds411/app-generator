ISSUER = "https://provider.test"
CLIENT_ID = "test-client"
CLIENT_SECRET = "test-client-secret"
FRONT_END = "http://front-end.test"
CALLBACK = "/auth/providers/{{ p.name }}/callback"


def _rsa_key() -> rsa.RSAPrivateKey:
    return rsa.generate_private_key(public_exponent=65537, key_size=2048)


class FakeProvider:
    """An OpenID Connect provider in the same process, for the tests."""

    def __init__(self) -> None:
        self.key = _rsa_key()
        self.flows: dict[str, dict[str, Any]] = {}

    def sign_in(
        self, location: str, claims: dict[str, Any], key: rsa.RSAPrivateKey | None = None
    ) -> str:
        """Sign in a user at the provider: the claims are the ones of the ID token.

        Return the URL of the callback, with the code and the state.
        """
        assert location.startswith(f"{ISSUER}/authorize?")
        query = {k: v[0] for k, v in parse_qs(urlsplit(location).query).items()}
        assert query["client_id"] == CLIENT_ID
        assert query["code_challenge_method"] == "S256"
        assert "openid" in query["scope"].split()
        code = f"code-{len(self.flows)}"
        self.flows[code] = {"query": query, "claims": claims, "key": key or self.key}
        return f"{query['redirect_uri']}?code={code}&state={query['state']}"

    def handle(self, request: httpx.Request) -> httpx.Response:
        """Answer a request of the app."""
        if request.url.path == "/.well-known/openid-configuration":
            return httpx.Response(
                200,
                json={
                    "issuer": ISSUER,
                    "authorization_endpoint": f"{ISSUER}/authorize",
                    "token_endpoint": f"{ISSUER}/token",
                    "jwks_uri": f"{ISSUER}/jwks",
                },
            )
        if request.url.path == "/jwks":
            jwk = RSAAlgorithm.to_jwk(self.key.public_key(), as_dict=True)
            return httpx.Response(200, json={"keys": [jwk | {"kid": "test-key", "alg": "RS256"}]})
        if request.url.path == "/token":
            return self._token(request)
        return httpx.Response(404)

    def _token(self, request: httpx.Request) -> httpx.Response:
        basic = base64.b64encode(f"{CLIENT_ID}:{CLIENT_SECRET}".encode()).decode()
        assert request.headers["authorization"] == f"Basic {basic}"
        form = {k: v[0] for k, v in parse_qs(request.content.decode()).items()}
        flow = self.flows.pop(form["code"], None)
        if flow is None:
            return httpx.Response(400, json={"error": "invalid_grant"})
        query: dict[str, str] = flow["query"]
        digest = hashlib.sha256(form["code_verifier"].encode()).digest()
        challenge = base64.urlsafe_b64encode(digest).rstrip(b"=").decode()
        if challenge != query["code_challenge"] or form["redirect_uri"] != query["redirect_uri"]:
            return httpx.Response(400, json={"error": "invalid_grant"})
        now = int(time.time())
        claims = {
            "iss": ISSUER,
            "aud": CLIENT_ID,
            "sub": "user-1",
            "iat": now,
            "exp": now + 300,
            "nonce": query["nonce"],
        }
        claims |= flow["claims"]
        token = jwt.encode(claims, flow["key"], algorithm="RS256", headers={"kid": "test-key"})
        return httpx.Response(200, json={"token_type": "Bearer", "id_token": token})


@pytest.fixture
def provider() -> FakeProvider:
    return FakeProvider()


@pytest.fixture
async def browser(
    migrated_url: str,
    session: AsyncSession,
    provider: FakeProvider,
    monkeypatch: pytest.MonkeyPatch,
) -> AsyncIterator[AsyncClient]:
    """An HTTP client that calls the app as a browser does, with the fake provider."""
    monkeypatch.setenv("{{ p.name | upper }}_ISSUER", ISSUER)
    monkeypatch.setenv("{{ p.client_id_env }}", CLIENT_ID)
    monkeypatch.setenv("{{ p.client_secret_env }}", CLIENT_SECRET)
    settings = Settings(
        database_url=migrated_url,
        auth_secret="test-secret",
        cors_origins=[FRONT_END],
        public_url="",
    )
    app = create_app(settings)

    async def client() -> AsyncIterator[httpx.AsyncClient]:
        async with httpx.AsyncClient(transport=httpx.MockTransport(provider.handle)) as client:
            yield client

    app.dependency_overrides[provider_client] = client
    async with AsyncClient(transport=ASGITransport(app=app), base_url="http://test") as browser:
        yield browser
    await app.state.engine.dispose()


async def _start(browser: AsyncClient, return_to: str | None = None) -> str:
    """Start the sign-in, and return the URL of the sign-in page of the provider."""
    params = {"return_to": return_to} if return_to else {}
    response = await browser.get("/auth/providers/{{ p.name }}/start", params=params)
    assert response.status_code == 302, response.text
    return response.headers["location"]


async def _sign_in(
    browser: AsyncClient,
    provider: FakeProvider,
    claims: dict[str, Any],
    return_to: str | None = None,
) -> httpx.Response:
    """Do the steps of the browser, and return the response of the callback."""
    callback = provider.sign_in(await _start(browser, return_to), claims)
    return await browser.get(callback)


async def _me(browser: AsyncClient, token: str) -> dict[str, Any]:
    response = await browser.get("/auth/me", headers={"Authorization": f"Bearer {token}"})
    assert response.status_code == 200, response.text
    return response.json()


async def test_a_user_signs_in_with_the_provider_{{ p.name }}(
    browser: AsyncClient, session: AsyncSession, provider: FakeProvider
) -> None:
    user = await make_{{ u.snake }}(session)

    response = await _sign_in(browser, provider, {"{{ p.username_claim }}": user.{{ username.attr }}})

    assert response.status_code == 200, response.text
    assert (await _me(browser, response.json()["access_token"]))["id"] == str(user.id)
    assert "provider_flow_{{ p.name }}" not in browser.cookies
