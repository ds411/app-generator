"""The tests of the connections of the users to the APIs with HTTP Basic (ADR 0033).

A mock API answers the requests of the app. The tests sign in a user with
a token, and connect an account of the API `{{ api.name }}` with a user name and a
password. They check the encrypted password in the table, the answers
without the password, and the rejection of the credentials after an
answer with the status 401.
"""

import base64
from collections.abc import AsyncIterator
from uuid import UUID

import httpx
import pytest
from httpx import ASGITransport, AsyncClient
from sqlalchemy import select
from sqlalchemy.ext.asyncio import AsyncSession

from app.core.auth import make_token
from app.core.config import Settings
from app.core.connections import (
    ApiConnection,
    NotConnectedError,
    UserCredentials,
    connection_client,
    require_connection,
)
from app.core.db import make_engine, make_sessions
from app.integrations.{{ api.module }}.client import {{ api.client }}
from app.main import create_app
from tests.factories import make_{{ u.snake }}
from tests.problems import assert_problem

pytestmark = pytest.mark.anyio

PATH = "{{ path }}"
"""The path of the connection to the API `{{ api.name }}`."""
USERNAME = "zoë@example.com"
"""A user name that is not ASCII: the header has the Base64 of its UTF-8 bytes (RFC 7617)."""
PASSWORD = "api-token"
WRONG = "wrong-token"
"""A password that the mock API does not accept."""


def _basic(username: str, password: str) -> str:
    return "Basic " + base64.b64encode(f"{username}:{password}".encode()).decode()


class MockApi:
    """A mock API: it keeps each request, and answers 401 for the password `WRONG`."""

    def __init__(self) -> None:
        self.requests: list[httpx.Request] = []

    def handle(self, request: httpx.Request) -> httpx.Response:
        self.requests.append(request)
        if request.headers.get("Authorization") == _basic(USERNAME, WRONG):
            return httpx.Response(401, json={"message": "The credentials are not valid."})
        return httpx.Response(200, json={})


@pytest.fixture
def api() -> MockApi:
    return MockApi()


@pytest.fixture
def settings(migrated_url: str) -> Settings:
    return Settings(
        database_url=migrated_url,
        auth_secret="test-secret",
{% for c in basic %}
        {{ c.url_setting }}={{ c.test_url | tojson }},
{% endfor %}
    )


@pytest.fixture
async def app_client(settings: Settings, api: MockApi) -> AsyncIterator[AsyncClient]:
    """An HTTP client that calls the app, with the mock API for the checks."""
    app = create_app(settings)

    async def mock_client() -> AsyncIterator[httpx.AsyncClient]:
        async with httpx.AsyncClient(transport=httpx.MockTransport(api.handle)) as client:
            yield client

    app.dependency_overrides[connection_client] = mock_client
    async with AsyncClient(transport=ASGITransport(app=app), base_url="http://test") as client:
        yield client
    await app.state.engine.dispose()


async def _sign_in(session: AsyncSession) -> tuple[UUID, dict[str, str]]:
    """Store a user, and return the user ID and the header with a token."""
    user = await make_{{ u.snake }}(session)
    return user.id, {"Authorization": f"Bearer {make_token(b'test-secret', user.id)}"}


async def _connect(app_client: AsyncClient, headers: dict[str, str]) -> None:
    body = {"username": USERNAME, "password": PASSWORD}
    response = await app_client.post(PATH, json=body, headers=headers)
    assert response.status_code == 200, response.text


async def test_a_user_connects_an_account_with_a_user_name_and_a_password(
    app_client: AsyncClient, api: MockApi, session: AsyncSession
) -> None:
    user_id, headers = await _sign_in(session)

    body = {"username": USERNAME, "password": PASSWORD}
    response = await app_client.post(PATH, json=body, headers=headers)

    assert response.status_code == 200, response.text
    data = response.json()
    assert (data["kind"], data["connected"], data["username"]) == ("basic", True, USERNAME)
    assert data["rejected"] is False
    assert PASSWORD not in response.text
{% if api.check_method %}
    # The app checks the credentials at the API first.
    [check] = api.requests
    assert (check.method, check.url.path) == ({{ api.check_method | tojson }}, {{ api.check_path | tojson }})
    assert check.headers["Authorization"] == _basic(USERNAME, PASSWORD)
{% else %}
    # The API has no check operation: the app calls the API only in the operations.
    assert api.requests == []
{% endif %}
    connection = await session.scalar(select(ApiConnection))
    assert connection is not None
    assert (connection.user_id, connection.username) == (user_id, USERNAME)
    # The table has the password encrypted.
    assert PASSWORD not in connection.access_token
    listed = await app_client.get("/auth/connections", headers=headers)
    assert listed.status_code == 200, listed.text
    assert PASSWORD not in listed.text
    found = [c["username"] for c in listed.json() if c["api"] == "{{ api.connection_name }}"]
    assert found == [USERNAME]
{% if api.check_method %}


async def test_credentials_that_the_api_does_not_accept_give_422(
    app_client: AsyncClient, session: AsyncSession
) -> None:
    _, headers = await _sign_in(session)

    body = {"username": USERNAME, "password": WRONG}
    response = await app_client.post(PATH, json=body, headers=headers)

    assert_problem(response, 422)
    assert await session.scalar(select(ApiConnection)) is None
{% endif %}


async def test_the_connection_needs_a_signed_in_user(app_client: AsyncClient) -> None:
    response = await app_client.post(PATH, json={"username": USERNAME, "password": PASSWORD})

    assert_problem(response, 401)


async def test_a_client_sends_the_credentials_of_the_user(
    app_client: AsyncClient, settings: Settings, session: AsyncSession
) -> None:
    user_id, headers = await _sign_in(session)
    await _connect(app_client, headers)
    engine = make_engine(settings.database_url)
    credentials = UserCredentials(settings, {{ api.name | tojson }}, make_sessions(engine), user_id)
    calls = MockApi()
    transport = httpx.MockTransport(calls.handle)

    async with {{ api.client }}({{ api.test_url | tojson }}, token=credentials, transport=transport) as client:
        await client.request("GET", "/")
    await engine.dispose()

    assert calls.requests[0].headers["Authorization"] == _basic(USERNAME, PASSWORD)


def _unauthorized(request: httpx.Request) -> httpx.Response:
    return httpx.Response(401, json={"message": "The credentials are not valid."})


async def test_an_answer_with_the_status_401_rejects_the_connection(
    app_client: AsyncClient, settings: Settings, session: AsyncSession
) -> None:
    user_id, headers = await _sign_in(session)
    await _connect(app_client, headers)
    engine = make_engine(settings.database_url)
    credentials = UserCredentials(settings, {{ api.name | tojson }}, make_sessions(engine), user_id)
    transport = httpx.MockTransport(_unauthorized)

    async with {{ api.client }}({{ api.test_url | tojson }}, token=credentials, transport=transport) as client:
        with pytest.raises(NotConnectedError) as error:
            await client.request("GET", "/")
    await engine.dispose()

    assert (error.value.status, error.value.rejected) == (409, True)
    listed = await app_client.get("/auth/connections", headers=headers)
    found = [c["rejected"] for c in listed.json() if c["api"] == "{{ api.connection_name }}"]
    assert found == [True]
    with pytest.raises(NotConnectedError):
        await require_connection(session, {{ api.name | tojson }}, user_id)
    # New credentials end the rejection.
    await _connect(app_client, headers)
    listed = await app_client.get("/auth/connections", headers=headers)
    found = [c["rejected"] for c in listed.json() if c["api"] == "{{ api.connection_name }}"]
    assert found == [False]


async def test_a_user_deletes_a_connection(app_client: AsyncClient, session: AsyncSession) -> None:
    _, headers = await _sign_in(session)
    await _connect(app_client, headers)

    response = await app_client.delete(PATH, headers=headers)

    assert response.status_code == 204, response.text
    listed = await app_client.get("/auth/connections", headers=headers)
    found = [c["connected"] for c in listed.json() if c["api"] == "{{ api.connection_name }}"]
    assert found == [False]
