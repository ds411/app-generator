{% set lt = i18n_test %}
{% set list_op = py.operations.values() | selectattr("kind", "eq", "list") | first | default(none) %}
"""The API gives its messages in the language of the request (ADR 0010)."""
{% if lt %}

import pytest
from httpx import AsyncClient

from app.core.i18n import DEFAULT, LOCALES, match_language
{% if definition.auth or list_op %}
from tests.problems import assert_problem
{% endif %}

pytestmark = pytest.mark.anyio

SECOND = {{ py.string(lt.second.code) }}
"""A language that is not the default language."""


def test_accept_language_selects_a_language_of_the_api() -> None:
    assert match_language(None) == DEFAULT
    assert match_language("") == DEFAULT
    assert match_language("*") == DEFAULT
    assert match_language({{ py.string(lt.unknown_tag) }}) == DEFAULT
    assert match_language({{ py.string(lt.second_tag) }}) == SECOND
    assert match_language({{ py.string(lt.second_tag.upper()) }}) == SECOND
{% if lt.near_tag %}
    assert match_language({{ py.string(lt.near_tag) }}) == SECOND
{% endif %}
    assert match_language({{ py.string(lt.unknown_tag ~ ", " ~ lt.second_tag ~ ";q=0.5") }}) == SECOND
    assert match_language({{ py.string(lt.second_tag ~ ";q=0") }}) == DEFAULT
    assert match_language({{ py.string(lt.second_tag ~ ";q=0.5, *;q=0.8") }}) == DEFAULT


async def test_a_response_has_the_language_of_the_request(client: AsyncClient) -> None:
    for header, language, title in (
        (None, DEFAULT, "Not Found"),
        ({{ py.string(lt.second_tag) }}, SECOND, {{ py.string(lt.text(lt.second, "Not Found")) }}),
    ):
        headers = {"Accept-Language": header} if header else {}
        response = await client.get("/no-such-path", headers=headers)

        assert response.status_code == 404
        assert response.headers["content-language"] == LOCALES[language]
        assert response.json()["title"] == title
{% if definition.auth %}


{{ trace(definition.auth.id) }}
async def test_a_failed_sign_in_has_the_language_of_the_request(client: AsyncClient) -> None:
    {% set key = "The user name or the password is not correct." %}
    for header, detail in (
        (None, {{ py.string(key) }}),
        ({{ py.string(lt.second_tag) }}, {{ py.string(lt.text(lt.second, key)) }}),
    ):
        headers = {"Accept-Language": header} if header else {}
        body = {"username": "nobody", "password": "not the password"}
        response = await client.post("/auth/sign-in", json=body, headers=headers)

        assert_problem(response, 401)
        assert response.json()["detail"] == detail
