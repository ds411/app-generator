async def test_an_input_error_has_the_language_of_the_request(client: AsyncClient) -> None:
    {% set key = "The request is not valid." %}
    {% set message = "Use {count} or more." %}
    for header, detail, message in (
        (None, {{ py.string(key) }}, {{ py.string(lt.text(lt.default, message, count=1)) }}),
        (
            {{ py.string(lt.second_tag) }},
            {{ py.string(lt.text(lt.second, key)) }},
            {{ py.string(lt.text(lt.second, message, count=1)) }},
        ),
    ):
        headers = {"Accept-Language": header} if header else {}
        response = await client.get("{{ py.entity(list_op.entity).path ~ list_op.path }}?limit=0", headers=headers)

        assert_problem(response, 422)
        assert response.json()["detail"] == detail
        assert response.json()["errors"][0]["msg"] == message
