"""The tests of the connections of the users to the APIs (ADR 0033).

A mock token endpoint answers the grants of the flow. The tests sign in a
user with a token, start a connection to the API `{{ api.name }}`, and finish it
with a code. They check the PKCE verifier, the encrypted tokens in the
table, and the refresh of an access token that ended.
"""

import base64
import hashlib
from collections.abc import AsyncIterator
from urllib.parse import parse_qs, urlsplit
from uuid import UUID

import httpx
import pytest
from httpx import ASGITransport, AsyncClient
from sqlalchemy import select, update
from sqlalchemy.ext.asyncio import AsyncSession

from app.core.auth import make_token
from app.core.config import Settings
from app.core.connections import ApiConnection, NotConnectedError, UserToken, connection_client
from app.core.db import make_engine, make_sessions
from app.main import create_app
from tests.factories import make_{{ u.snake }}
from tests.integrations.mocks import mock_transport
from tests.problems import assert_problem

pytestmark = pytest.mark.anyio

FRONT_END = "http://localhost:5173"
API_URL = "https://api.example.com"
PATH = "{{ path }}"
"""The path of the connection to the API `{{ api.name }}`."""


class TokenEndpoint:
    """A mock token endpoint: it keeps the form of each grant, and gives new tokens."""

    def __init__(self) -> None:
        self.grants: list[dict[str, list[str]]] = []
        self.status = 200

    def handle(self, request: httpx.Request) -> httpx.Response:
        self.grants.append(parse_qs(request.content.decode()))
        if self.status != 200:
            return httpx.Response(self.status, json={"error": "invalid_grant"})
        number = len(self.grants)
        tokens = {
            "access_token": f"access-{number}",
            "refresh_token": f"refresh-{number}",
            "token_type": "Bearer",
            "expires_in": 3600,
        }
        return httpx.Response(200, json=tokens)


@pytest.fixture
def endpoint() -> TokenEndpoint:
    return TokenEndpoint()


