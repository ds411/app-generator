async def test_an_error_status_raises_an_api_error_with_the_status_and_the_body() -> None:
{% for line in first.sample_lines() %}
    {{ line }}
{% endfor %}
    async with make_client(status=503) as client:
        with pytest.raises(ApiError) as error:
            {{ first.test_call("await ", 12) }}

    assert error.value.api == {{ api.name | tojson }}
    assert error.value.status == 503
    assert error.value.body == "mock error"


async def test_each_request_has_a_default_timeout() -> None:
    async with make_client() as client:
        assert client.timeout == httpx.Timeout(DEFAULT_TIMEOUT)
{% if api.credential %}


async def test_each_request_sends_the_credential() -> None:
{% for line in first.sample_lines() %}
    {{ line }}
{% endfor %}
    requests: list[httpx.Request] = []
    async with make_client(requests) as client:
        {{ first.test_call("await ") }}

{% if api.credential == "bearer" %}
    assert requests[0].headers["Authorization"] == "Bearer secret"
{% elif api.credential == "basic" %}
    # HTTP Basic: the Base64 of the UTF-8 bytes of "{{ api.test_username }}:secret" (RFC 7617).
    assert requests[0].headers["Authorization"] == {{ api.test_basic_header | tojson }}
{% elif oauth %}
    assert requests[0].headers["Authorization"] == "Bearer mock-token-1"
{% elif api.user_basic %}
    # The client sends the credentials of the user (the value of the token source).
    assert requests[0].headers["Authorization"] == "Basic user-token"
{% elif api.user %}
    # The client sends the access token of the user.
    assert requests[0].headers["Authorization"] == "Bearer user-token"
{% elif api.credential == "header" %}
    assert requests[0].headers[{{ api.credential_name | tojson }}] == "secret"
{% else %}
    assert requests[0].url.params[{{ api.credential_name | tojson }}] == "secret"
{% endif %}
{% endif %}
{% if api.credential == "basic" %}


async def test_a_client_without_the_password_sends_no_credential() -> None:
{% for line in first.sample_lines() %}
    {{ line }}
{% endfor %}
    requests: list[httpx.Request] = []
    transport = mock_transport({{ api.name | tojson }}, requests)
    async with {{ api.client }}({{ api.test_url | tojson }}, transport=transport) as client:
        {{ first.test_call("await ") }}

    assert "Authorization" not in requests[0].headers
{% endif %}
{% if oauth %}


async def test_the_client_gets_one_token_for_the_requests_at_the_same_time() -> None:
{% for line in first.sample_lines() %}
    {{ line }}
{% endfor %}
    tokens: list[httpx.Request] = []
    async with make_client(tokens=tokens) as client:
        await asyncio.gather({{ first.test_call("", 8) }}, {{ first.test_call("", 8) }})

    assert len(tokens) == 1
    # The client authenticates with HTTP Basic: client:secret.
    assert tokens[0].headers["Authorization"] == "Basic Y2xpZW50OnNlY3JldA=="
    assert b"grant_type=client_credentials" in tokens[0].content


async def test_an_answer_with_the_status_401_gets_a_new_token_one_time() -> None:
{% for line in first.sample_lines() %}
    {{ line }}
{% endfor %}
    requests: list[httpx.Request] = []
    tokens: list[httpx.Request] = []
    async with make_client(requests, tokens=tokens, reject=1) as client:
        {{ first.test_call("await ") }}

    assert len(tokens) == 2
    assert [request.headers["Authorization"] for request in requests] == [
        "Bearer mock-token-1",
        "Bearer mock-token-2",
    ]
{% endif %}
