async def test_a_user_of_a_role_with_the_factor_turns_it_on_at_the_sign_in(
    anonymous_client: AsyncClient, session: AsyncSession
) -> None:
    user = await _user(session, {{ role.attr }}={{ py.string(required[0]) }})
    first = await _password_step(anonymous_client, user)
    assert "access_token" not in first
    assert first["second_factor"] == "setup"
    challenge = first["challenge"]
    setup = await anonymous_client.post("/auth/second-factor/setup", json={"challenge": challenge})
    secret = setup.json()["secret"]

    data = {"code": _code(secret), "challenge": challenge}
    confirm = await anonymous_client.post("/auth/second-factor/confirm", json=data)

    assert confirm.status_code == 200, confirm.text
    headers = _bearer(confirm.json()["token"]["access_token"])
    status = await anonymous_client.get("/auth/second-factor", headers=headers)
    assert status.json() == {"enabled": True, "required": True, "recovery_codes_left": 10}
    off = await anonymous_client.post(
        "/auth/second-factor/disable", json={"code": _code(secret, 1)}, headers=headers
    )
    assert_problem(off, 403)
