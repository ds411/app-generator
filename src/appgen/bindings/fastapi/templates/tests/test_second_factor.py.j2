async def test_a_user_turns_off_the_factor_with_a_code(
    anonymous_client: AsyncClient, session: AsyncSession
) -> None:
    user = await _user(session{{ (", " ~ role.attr ~ "=" ~ py.string(free_roles[0])) if role }})
    secret, codes = await _turn_on(anonymous_client, user)
    response = await _second_step(anonymous_client, user, _code(secret, 1))
    headers = _bearer(response.json()["access_token"])
    used = await anonymous_client.post(
        "/auth/second-factor/disable", json={"code": _code(secret, 1)}, headers=headers
    )
    assert_problem(used, 401)

    off = await anonymous_client.post(
        "/auth/second-factor/disable", json={"code": codes[0]}, headers=headers
    )

    assert off.status_code == 204, off.text
    assert "access_token" in await _password_step(anonymous_client, user)
