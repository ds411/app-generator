{% if u %}


async def _headers(session: AsyncSession, role: str) -> tuple[{{ u.name }}, dict[str, str]]:
    """Store a user with a role, and return the user and the headers with a token of the user."""
    user = await make_{{ u.snake }}(session, {{ role_field.name }}=role)
    return user, {"Authorization": f"Bearer {make_token(b'test-secret', user.id)}"}
