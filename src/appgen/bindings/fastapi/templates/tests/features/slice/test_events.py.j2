{% if loop_event %}
{% set op = loop_event.operation.name %}


async def test_a_change_in_the_operation_of_an_event_starts_no_event(
    session: AsyncSession,
    calls: list[Call],
    monkeypatch: pytest.MonkeyPatch,
{% if e.files and loop_event.kind == "deleted" %}
    tmp_path: Path,
{% endif %}
) -> None:
{% if loop_event.kind == "created" %}
    data = {{ e.name }}Create.model_validate(await {{ e.snake }}_input(session))
    other = {{ e.name }}Create.model_validate(await {{ e.snake }}_input(session))
    before = await count(session)

    async def operation(session: AsyncSession, record: {{ e.name }}, *args: Any) -> None:
        calls.append(("{{ op }}", record.id, True))
        await repository.create(session, other)

    monkeypatch.setattr({{ op }}_ext, "{{ op }}", operation)
    record = await repository.create(session, data)

    assert calls == [("{{ op }}", record.id, True)]
    assert await count(session) == before + 2
{% elif loop_event.kind == "deleted" %}
    record = await make_{{ e.snake }}(session)
    other = await make_{{ e.snake }}(session)

    async def operation(session: AsyncSession, record: {{ e.name }}, *args: Any) -> None:
        calls.append(("{{ op }}", record.id, False))
        await repository.delete(session, other{{ storage }})

    monkeypatch.setattr({{ op }}_ext, "{{ op }}", operation)
    calls.clear()
    await repository.delete(session, record{{ storage }})

    assert calls == [("{{ op }}", record.id, False)]
    assert not await stored(session, other.id)
{% else %}
    record = await make_{{ e.snake }}(session)
    first = await {{ e.snake }}_input(session)
    second = await {{ e.snake }}_input(session)
    changes = {{ e.name }}Update.model_validate({name: first[name] for name in CHANGES})
    more = {{ e.name }}Update.model_validate({name: second[name] for name in CHANGES})

    async def operation(session: AsyncSession, record: {{ e.name }}, *args: Any) -> None:
        calls.append(("{{ op }}", record.id, True))
        await repository.update(session, record, more)

    monkeypatch.setattr({{ op }}_ext, "{{ op }}", operation)
    calls.clear()
    record = await repository.update(session, record, changes)

    assert calls == [("{{ op }}", record.id, True)]
{% endif %}
{% endif %}
