"""The tests of the events of {{ e.name }} (ADR 0031).

The tests replace the operations of the events with fakes that record
their calls. A fake also records if the record is in the database at
the time of the call, in the transaction of the change.
"""

{{ e.event_test_imports() }}

pytestmark = [pytest.mark.anyio, pytest.mark.events("{{ e.name }}")]

type Call = tuple[str, UUID, bool]
"""A call of an operation: its name, the record, and true if the record is in the database."""
{% if changes %}
{{ py.literal(changes, "CHANGES = ") }}
"""The fields of a change that runs the event `changed`."""
{% endif %}
{% if others %}
{{ py.literal(others, "OTHERS = ") }}
"""Fields that the event `changed` does not watch."""
{% endif %}


async def stored(session: AsyncSession, id: UUID) -> bool:
    """Return true if the database has the record of an ID, in the open transaction."""
    statement = select(func.count()).select_from({{ e.name }}).where({{ e.name }}.id == id)
    return await session.scalar(statement) == 1


async def count(session: AsyncSession) -> int:
    """Return the count of the records in the database."""
    return await session.scalar(select(func.count()).select_from({{ e.name }})) or 0


async def fail(*args: Any) -> None:
    """An operation that fails."""
    raise RuntimeError("The test fails the operation.")
{% if needs_state %}


async def set_state(session: AsyncSession, record: {{ e.name }}, **values: Any) -> {{ e.name }}:
    """Set values of a record in the database directly, without the workflows, and return it."""
    await session.execute(update({{ e.name }}).where({{ e.name }}.id == record.id).values(**values))
    await session.commit()
    return await repository.get(session, record.id)
{% endif %}


@pytest.fixture(autouse=True)
def calls(monkeypatch: pytest.MonkeyPatch) -> list[Call]:
    """The calls of the operations of the events, in order."""
    found: list[Call] = []

    def fake(name: str) -> Callable[..., Awaitable[None]]:
        async def operation(session: AsyncSession, record: {{ e.name }}, *args: Any) -> None:
            found.append((name, record.id, await stored(session, record.id)))

        return operation

{% for op in e.event_operations %}
    monkeypatch.setattr({{ op.name }}_ext, "{{ op.name }}", fake("{{ op.name }}"))
{% endfor %}
    return found
{% if created %}
{% set op = created.operation.name %}


{{ trace(created.id) }}
async def test_created_runs_{{ op }}_after_the_record_is_stored(
    session: AsyncSession,
    calls: list[Call],
) -> None:
    data = {{ e.name }}Create.model_validate(await {{ e.snake }}_input(session))

    record = await repository.create(session, data)

    assert calls == [("{{ op }}", record.id, True)]


async def test_created_stores_nothing_when_{{ op }}_fails(
    session: AsyncSession,
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    data = {{ e.name }}Create.model_validate(await {{ e.snake }}_input(session))
    other = {{ e.name }}Create.model_validate(await {{ e.snake }}_input(session))
    before = await count(session)

    async def operation(session: AsyncSession, record: {{ e.name }}, *args: Any) -> None:
        # The commit of a change in the operation commits nothing.
        await repository.create(session, other)
        await fail()

    monkeypatch.setattr({{ op }}_ext, "{{ op }}", operation)
    with pytest.raises(RuntimeError):
        await repository.create(session, data)
    await session.rollback()

    assert await count(session) == before
{% endif %}
