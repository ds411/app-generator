async def test_changed_keeps_the_record_when_{{ op }}_fails(
    session: AsyncSession,
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    record = await make_{{ e.snake }}(session)
    id, value = record.id, record.{{ f.attr }}
    other = await {{ e.snake }}_input(session)
    changes = {{ e.name }}Update.model_validate({name: other[name] for name in CHANGES})

    monkeypatch.setattr({{ op }}_ext, "{{ op }}", fail)
    with pytest.raises(RuntimeError):
        await repository.update(session, record, changes)
    await session.rollback()

    assert (await repository.get(session, id)).{{ f.attr }} == value
