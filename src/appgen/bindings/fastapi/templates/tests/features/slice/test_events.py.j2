{% for t in transitions %}
{% set op = t.operation.name %}
{% set w = t.workflow %}
{% set start = t.before[0] %}


{{ trace(t.id) }}
async def test_{{ t.name }}_runs_{{ op }}(
    session: AsyncSession,
    calls: list[Call],
) -> None:
    record = await make_{{ e.snake }}(session)
{% if start != w.start %}
    record = await set_state(session, record, {{ w.attr }}="{{ start }}")
{% endif %}
    changes = {{ e.name }}Update.model_validate({"{{ w.field }}": "{{ t.after }}"})
    calls.clear()

    record = await repository.update(session, record, changes)

    assert calls == [{% for name in e.transition_calls(t) %}("{{ name }}", record.id, True){{ ", " if not loop.last }}{% endfor %}]


async def test_{{ t.name }}_keeps_the_state_when_{{ op }}_fails(
    session: AsyncSession,
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    record = await make_{{ e.snake }}(session)
{% if start != w.start %}
    record = await set_state(session, record, {{ w.attr }}="{{ start }}")
{% endif %}
    id = record.id
    changes = {{ e.name }}Update.model_validate({"{{ w.field }}": "{{ t.after }}"})

    monkeypatch.setattr({{ op }}_ext, "{{ op }}", fail)
    with pytest.raises(RuntimeError):
        await repository.update(session, record, changes)
    await session.rollback()

    assert (await repository.get(session, id)).{{ w.attr }} == "{{ start }}"
