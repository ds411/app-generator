{% endfor %}
    ],
)
async def test_each_file_field_takes_a_file(
    client: AsyncClient, session: AsyncSession, path: str, sample: tuple[str, bytes, str]
) -> None:
    record = await make_{{ e.snake }}(session)

    response = await client.put(f"{{ e.path }}/{record.id}{path}", files={"file": sample})

    assert response.status_code == 200, response.text
