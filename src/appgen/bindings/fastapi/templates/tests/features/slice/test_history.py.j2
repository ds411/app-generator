"""The tests of the change log of {{ e.name }} (ADR 0040).

The repository adds an entry for each create, change, and delete of a
record, in the transaction of the change. A restore gives the old values
of an entry back.
"""

{{ e.history_test_imports() }}

pytestmark = pytest.mark.anyio


async def entries(session: AsyncSession, id: UUID) -> list[HistoryEntry]:
    """Return the entries of the change log of a record, the newest first."""
    statement = (
        select(HistoryEntry)
        .where(HistoryEntry.entity == "{{ e.name }}", HistoryEntry.record_id == id)
        .order_by(HistoryEntry.at.desc())
        .execution_options(populate_existing=True)
    )
    return list(await session.scalars(statement))


async def test_a_create_adds_an_entry_with_the_new_values(session: AsyncSession) -> None:
    record = await make_{{ e.snake }}(session)

    [entry] = await entries(session, record.id)

    assert entry.action == "created"
    assert entry.user_id is None
    values = snapshot(record, HISTORY)
    assert entry.changes == {
        name: {"old": None, "new": json_value(value)}
        for name, value in values.items()
        if value is not None
    }
