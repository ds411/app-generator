async def test_a_restore_gives_the_old_value_back(
    client: AsyncClient, session: AsyncSession
) -> None:
    record = await make_{{ e.snake }}(session)
    old = record.{{ f.attr }}
    other = await {{ e.snake }}_input(session)
    changes = {{ e.name }}Update.model_validate({"{{ f.name }}": other["{{ f.name }}"]})
    await repository.update(session, record, changes)
    changed = (await entries(session, record.id))[0]

    response = await client.post(f"{{ url }}/{changed.id}/restore")

    assert response.status_code == 200, response.text
    record = await repository.get(session, record.id)
    assert record.{{ f.attr }} == old
    assert response.json() == {{ e.name }}Read.model_validate(record).model_dump(mode="json")
    actions = [entry.action for entry in await entries(session, record.id)]
    assert actions == ["restored", "changed", "created"]
{% endif %}


