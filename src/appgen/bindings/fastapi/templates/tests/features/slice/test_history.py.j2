    session: AsyncSession,
) -> None:
    record = await make_{{ e.snake }}(session)
    old = record.{{ f.attr }}
    other = await {{ e.snake }}_input(session)
    changes = {{ e.name }}Update.model_validate({"{{ f.name }}": other["{{ f.name }}"]})

    record = await repository.update(session, record, changes)

    entry = (await entries(session, record.id))[0]
    assert entry.action == "changed"
