"""The tests of the notifications of {{ e.name }} (ADR 0041).

A change of a record adds a notice for each user at the end of the
receiver paths, except the user that made the change. Each test makes a
user a receiver through the first receiver path of the notification.
"""

{{ e.notification_test_imports() }}

pytestmark = pytest.mark.anyio


async def notices(session: AsyncSession, notification: str, id: UUID) -> list[Notice]:
    """Return the notices of a notification for a record."""
    statement = select(Notice).where(Notice.notification == notification, Notice.record_id == id)
    return list(await session.scalars(statement))


{{ py.signature("async def receivers", ["session: AsyncSession", "record: " ~ e.name, "*paths: tuple[str, ...]"], " -> set[UUID]:") }}
    """Return the users at the end of receiver paths of a record."""
    found: set[UUID] = set()
    for path in paths:
        found |= set(await path_users(session, {{ e.name }}, record.id, path))
    return found
{% if e.notification_sets_state %}


async def set_state(session: AsyncSession, record: {{ e.name }}, **values: Any) -> {{ e.name }}:
    """Set values of a record in the database directly, without the workflows, and return it."""
    await session.execute(update({{ e.name }}).where({{ e.name }}.id == record.id).values(**values))
    await session.commit()
    return await repository.get(session, record.id)
{% endif %}
