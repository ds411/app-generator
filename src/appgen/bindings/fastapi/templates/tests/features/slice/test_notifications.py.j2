{% if n.kind != "changed" or changes %}


{{ trace(n.id) }}
{{ py.signature("async def " ~ n.name ~ "_change", ["session: AsyncSession", "user: " ~ u.name], " -> " ~ e.name ~ ":") }}
    """Make the change of the notification for a record with the user as a receiver."""
    values = await {{ receiver.function }}(session, str(user.id))
{% if n.kind == "created" %}
    return await make_{{ e.snake }}(session, **values)
{% elif n.kind == "changed" %}
    record = await make_{{ e.snake }}(session)
    other = await {{ e.snake }}_input(session, **values)
    {{ py.literal(keys, "keys = ", 4) }}
    changes = {{ e.name }}Update.model_validate({name: other[name] for name in keys})
    return await repository.update(session, record, changes)
{% else %}
    record = await make_{{ e.snake }}(session, **values)
{% if n.before[0] != n.workflow.start %}
    record = await set_state(session, record, {{ n.workflow.attr }}="{{ n.before[0] }}")
{% endif %}
    changes = {{ e.name }}Update.model_validate({"{{ n.workflow.field }}": "{{ n.after }}"})
    return await repository.update(session, record, changes)
{% endif %}


{{ py.signature("async def test_" ~ n.name ~ "_gives_each_receiver_a_notice", ["session: AsyncSession"], " -> None:") }}
    user = await make_{{ u.snake }}(session)

    record = await {{ n.name }}_change(session, user)

    {{ n.receivers_call(4) }}
    found = await notices(session, "{{ n.name }}", record.id)
    assert user.id in users
    assert {notice.user_id for notice in found} == users
    assert all("{" not in notice_text(notice) for notice in found)


{{ py.signature("async def test_" ~ n.name ~ "_gives_no_notice_to_the_user_of_the_change", ["session: AsyncSession"], " -> None:") }}
    user = await make_{{ u.snake }}(session)
    session.info[USER_KEY] = user.id

    record = await {{ n.name }}_change(session, user)

    found = await notices(session, "{{ n.name }}", record.id)
    assert user.id not in {notice.user_id for notice in found}
{% endif %}
