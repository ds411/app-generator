{{ sig("test_" ~ op.name ~ "_filters_by_the_free_days_of_" ~ p.attr[:-10], "client: AsyncClient, session: AsyncSession") }}    first, end = "{{ p.name }}", "{{ p.name[:-5] ~ "_to" }}"
