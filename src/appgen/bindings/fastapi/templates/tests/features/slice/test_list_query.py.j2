    ids = await _ids(client, {first: "2030-03-03", end: "2030-03-05"})

    assert free in ids
    assert busy not in ids
{% if r.dates %}
    # A range ends before its end day: the next range can start on that day.
    assert busy in await _ids(client, {first: "2030-03-06", end: "2030-03-09"})
    assert busy in await _ids(client, {first: "2030-02-27", end: "2030-03-02"})
{% else %}
    # The days are whole days, from the start of the first day to the end of the last day.
    assert busy not in await _ids(client, {first: "2030-03-06", end: "2030-03-09"})
    assert busy in await _ids(client, {first: "2030-03-07", end: "2030-03-09"})
    assert busy in await _ids(client, {first: "2030-02-27", end: "2030-03-01"})
{% endif %}
    # Without an end, the range is one day.
    assert busy not in await _ids(client, {first: "2030-03-05"})
