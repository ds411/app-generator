async def _items(client: AsyncClient, params: dict[str, Any]) -> list[dict[str, Any]]:
    """Return the items of the first page of the endpoint, in order."""
    response = await client.get("{{ url }}", params=params)
    assert response.status_code == 200, response.text
    return response.json()["items"]


async def _ids(client: AsyncClient, params: dict[str, Any]) -> list[str]:
    """Return the IDs of the items of the first page of the endpoint, in order."""
    return [item["id"] for item in await _items(client, params)]
