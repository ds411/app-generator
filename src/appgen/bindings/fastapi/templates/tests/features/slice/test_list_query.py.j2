    first = str(records[0].id)
    day = dt.date.fromisoformat(values[0][:10])
    before = (day - dt.timedelta(days=1)).isoformat()
    after = (day + dt.timedelta(days=1)).isoformat()

    ids = await _ids(client, {"{{ p.name }}": day.isoformat(), "{{ to_name }}": day.isoformat()})

    assert first in ids
    if values[1][:10] != values[0][:10]:
        assert str(records[1].id) not in ids
    assert first not in await _ids(client, {"{{ to_name }}": before})
    assert first not in await _ids(client, {"{{ p.name }}": after})
