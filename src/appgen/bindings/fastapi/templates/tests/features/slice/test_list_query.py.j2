    few = str((await make_{{ e.snake }}(session, {{ f.name }}="report draft")).id)
    many = str((await make_{{ e.snake }}(session, {{ f.name }}="report report report")).id)
    other = str((await make_{{ e.snake }}(session, {{ f.name }}="unrelated")).id)

    async def found(text: str) -> list[str]:
        return [i for i in await _ids(client, {"q": text}) if i in (few, many, other)]

    # Without a sort, a record with more of the words comes first.
    assert await found("report") == [many, few]
    assert await found("report -draft") == [many]
    assert await found('"report draft"') == [few]
    assert set(await found("draft or unrelated")) == {few, other}
