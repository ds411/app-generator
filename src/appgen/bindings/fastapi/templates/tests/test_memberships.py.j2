{% for id in e.scope_path.ids %}
{{ trace(id) }}
{% endfor %}
async def _{{ e.snake }}_in(session: AsyncSession, scope: {{ s.name }}) -> dict[str, Any]:
    """Store the records of the path `{{ e.scope_path.path }}`, and return the values of a {{ e.name }}."""
{% for line in e.scope_path.scope_lines("str(scope.id)") %}
    {{ line }}
{% endfor %}
