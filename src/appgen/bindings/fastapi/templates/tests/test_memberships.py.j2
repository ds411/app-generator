"""The tests of the memberships (ADR 0048): a role gives its operations in its scopes only.

A user has one role in a {{ s.name }} record, another role in a second one,
and no membership in a third one. An operation of the first role gives
403 in the second record, and 404 in the third.
"""

{% if paths %}
from typing import Any

{% endif %}
import pytest
from httpx import AsyncClient
from sqlalchemy.ext.asyncio import AsyncSession

from app.core.auth import make_token
{% for e in [s, m.entity] | unique(attribute="name") | sort(attribute="slice") %}
from app.features.{{ e.slice }}.models import {{ e.name }}
{% endfor %}
{% set factories = ["make_" ~ u.snake, "make_" ~ s.snake, "make_" ~ m.entity.snake] %}
{% for t in m.tests %}
{% set _ = factories.append("make_" ~ t.entity.snake) %}
{% if t.creating %}
{% set _ = factories.append(t.entity.snake ~ "_input") %}
{% endif %}
{% for step_entity, _ in t.entity.scope_path.steps[1:] %}
{% set _ = factories.append("make_" ~ step_entity.snake) %}
{% endfor %}
{% endfor %}
{{ py.from_import("tests.factories", factories | unique | list) }}
from tests.problems import assert_problem

pytestmark = pytest.mark.anyio


{{ py.signature("async def _member", ["session: AsyncSession", "role: str", "*roles: str"], " -> tuple[dict[str, str], list[" ~ s.name ~ "], list[" ~ m.entity.name ~ "]]:") }}
    """Store a user with a role, a {{ s.name }} for each role of a membership, and one more.

    Return the headers with a token of the user, the {{ s.name }} records, and
    the memberships. The user has no membership in the last {{ s.name }}.
    """
    {{ py.call("user = await ", "make_" ~ u.snake, ["session", role_field.name ~ "=role"]) }}
    scopes = [await make_{{ s.snake }}(session) for _ in range(len(roles) + 1)]
    members = [
        {{ py.call("await ", "make_" ~ m.entity.snake, ["session", m.user.fk_attr ~ "=str(user.id)", m.scope.fk_attr ~ "=str(scope.id)", m.role.name ~ "=name"], 8) }}
        for scope, name in zip(scopes, roles, strict=False)
    ]
    return {"Authorization": f"Bearer {make_token(b'test-secret', user.id)}"}, scopes, members
