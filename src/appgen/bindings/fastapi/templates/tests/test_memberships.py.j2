{% for t in m.tests %}
{% set e = t.entity %}
{% set op = t.operation %}
{% set members = e.name == m.entity.name and t.listing %}


{{ trace(m.role_ids[t.allowed]) }}
{{ trace(m.role_ids[t.other]) }}
async def test_a_role_of_a_membership_gives_{{ op.name }}_in_its_scope(
    anonymous_client: AsyncClient, session: AsyncSession
) -> None:
    {{ py.call("headers, scopes, " ~ ("members" if members else "_") ~ " = await ", "_member", ["session", py.string(t.app_role), py.string(t.allowed), py.string(t.other)]) }}
    {{ t.records() }}

    path = "{{ e.path }}{{ op.path | replace('{id}', '') }}"
    response = {{ call(op.kind, 0) }}
    assert response.status_code == {{ op.status }}, response.text
    # The role of the second scope does not give the operation, and the user has no
    # membership in the third scope.
    response = {{ call(op.kind, 1) }}
    assert_problem(response, 403)
    response = {{ call(op.kind, 2) }}
    assert_problem(response, 404)
{% if t.listing %}
{% set ns = namespace(items=[]) %}
{% for role in t.listed %}
{% set index = 0 if role == t.allowed else 1 %}
{% set ns.items = ns.items + ["records[" ~ index ~ "]"] + (["members[" ~ index ~ "]"] if members else []) %}
{% endfor %}

    # The list has the records of the scopes whose role gives the list.
    response = await anonymous_client.get("{{ e.path }}{{ t.listing.path }}", headers=headers)
    assert response.status_code == 200, response.text
    found = {item["id"] for item in response.json()["items"]}
    assert found == {str(record.id) for record in ({{ ns.items | join(", ") }}{{ "," if ns.items | length == 1 }})}
{% endif %}
{% if t.creating %}

    path = "{{ e.path }}{{ t.creating.path }}"
    {{ py.call("payload = await ", e.snake ~ "_input", ["session", "**await _" ~ e.snake ~ "_in(session, scopes[0])"]) }}
    response = await anonymous_client.post(path, json=payload, headers=headers)
    assert response.status_code == {{ t.creating.status }}, response.text
    for scope in scopes[1:]:
        {{ py.call("payload = await ", e.snake ~ "_input", ["session", "**await _" ~ e.snake ~ "_in(session, scope)"], 8) }}
        assert_problem(await anonymous_client.post(path, json=payload, headers=headers), 403)
{% endif %}
{% if t.denied %}

    # No role of the user gives {{ t.denied.name }}.
    path = "{{ e.path }}{{ t.denied.path | replace('{id}', '') }}"
    response = {{ call(t.denied.kind, 0) }}
    assert_problem(response, 403)
{% endif %}
{% endfor %}
