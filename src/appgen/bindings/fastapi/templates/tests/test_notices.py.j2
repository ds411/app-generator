"""The tests of the notices of the signed-in user (ADR 0041): the list and the reads."""

from uuid import UUID, uuid4

import pytest
from httpx import AsyncClient
from sqlalchemy import select
from sqlalchemy.ext.asyncio import AsyncSession

from app.core.auth import make_token
from app.core.db import USER_KEY
from app.core.notifications import Notice, add_notices
from app.features.{{ u.slice }}.models import {{ u.name }}
from tests.factories import make_{{ u.snake }}
from tests.problems import assert_problem

pytestmark = pytest.mark.anyio

NAME = {{ py.string(n.name) }}
"""The notification of the notices of the tests."""
ENTITY = {{ py.string(n.entity) }}
{{ py.literal(n.sample_values(), "VALUES: dict[str, str] = ") }}
"""The values of the text of the notices of the tests."""
TEXT = {{ py.string(n.sample_text()) }}
"""The text of the notices of the tests, with `VALUES`."""
{% set translation = n.sample_translation(i18n) %}
{% if translation %}
LANGUAGE = {{ py.string(translation[0]) }}
"""A language that translates the text."""
TRANSLATION = {{ py.string(translation[1]) }}
"""The text of the notices of the tests in `LANGUAGE`, with `VALUES`."""
