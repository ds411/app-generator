async def test_the_text_has_the_language_of_the_request(
    anonymous_client: AsyncClient, session: AsyncSession
) -> None:
    user, headers = await signed_in(session)
    await add(session, user.id)
    headers["Accept-Language"] = LANGUAGE

    response = await anonymous_client.get("/notices", headers=headers)

    [item] = response.json()["items"]
    assert item["text"] == TRANSLATION
