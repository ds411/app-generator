    anonymous_client: AsyncClient, session: AsyncSession, messages: list[Message]
) -> None:
    user = await make_{{ u.snake }}(session)
    await set_password(session, user, PASSWORD)
    token = await _reset_token(anonymous_client, user.{{ username.attr }}, messages)

    response = await anonymous_client.post(
        "/auth/password-reset/confirm", json={"token": token, "new_password": "a-new-password"}
    )

    assert response.status_code == 204, response.text
    credentials = {"username": user.{{ username.attr }}, "password": "a-new-password"}
    assert (await anonymous_client.post("/auth/sign-in", json=credentials)).status_code == 200
