async def test_an_expired_reset_token_gives_400(
    anonymous_client: AsyncClient, session: AsyncSession
) -> None:
    user = await make_{{ u.snake }}(session)
    await set_password(session, user, PASSWORD)
    credential = await session.get(Credential, user.id)
    assert credential is not None
    ended = int(time.time()) - 1
    token = make_reset_token(b"test-secret", user.id, credential.password_hash, ended)

    response = await anonymous_client.post(
        "/auth/password-reset/confirm", json={"token": token, "new_password": "a-new-password"}
    )

    assert_problem(response, 400)


