async def test_a_user_gets_a_new_link_and_an_unknown_user_gets_the_same_answer(
    anonymous_client: AsyncClient, session: AsyncSession, messages: list[Message]
) -> None:
    body = await _sign_up_body(session)
    response = await anonymous_client.post("/auth/sign-up", json=body)
    assert response.status_code == 202, response.text
    username = body["{{ username.name }}"]

    again = await anonymous_client.post("/auth/verify-email", json={"username": username})
    unknown_name = {"username": "nobody@example.com"}
    unknown = await anonymous_client.post("/auth/verify-email", json=unknown_name)

    assert again.status_code == unknown.status_code == 202, again.text
    assert again.json() == unknown.json()
    assert len(messages) == 2
    token = _verification_token(messages[-1])
    confirm = await anonymous_client.post("/auth/verify-email/confirm", json={"token": token})
    assert confirm.status_code == 204, confirm.text
    verified = await anonymous_client.post("/auth/verify-email", json={"username": username})
    assert verified.status_code == 202, verified.text
    assert len(messages) == 2


