async def _sign_up_body(session: AsyncSession) -> dict[str, Any]:
    """Return valid input of a sign-up: the fields of a new user, and the password."""
    data = await {{ u.snake }}_input(session)
    names = {{ u.sign_up_fields | map(attribute="name") | list | tojson }}
    return {name: data[name] for name in names if name in data} | {"password": PASSWORD}


{{ trace(sign_up.id) }}
async def test_a_new_user_signs_up_and_signs_in(
    anonymous_client: AsyncClient, session: AsyncSession
) -> None:
    body = await _sign_up_body(session)

    response = await anonymous_client.post("/auth/sign-up", json=body)

    assert response.status_code == 201, response.text
    headers = {"Authorization": f"Bearer {response.json()['access_token']}"}
    me = await anonymous_client.get("/auth/me", headers=headers)
    assert me.status_code == 200, me.text
    assert me.json()["{{ username.name }}"] == body["{{ username.name }}"]
{% if default_role %}
    assert me.json()["{{ role.name }}"] == "{{ default_role }}"
{% endif %}
    credentials = {"username": body["{{ username.name }}"], "password": PASSWORD}
    sign_in = await anonymous_client.post("/auth/sign-in", json=credentials)
    assert sign_in.status_code == 200, sign_in.text
{% if ns.new_op %}
    {{ trace(ns.new_op.id) }}
    response = await anonymous_client.get("{{ ns.new_entity.path }}{{ ns.new_op.path }}", headers=headers)
    assert response.status_code == 200, response.text
{% endif %}


