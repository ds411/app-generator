async def test_a_protected_endpoint_needs_a_signed_in_user(
    anonymous_client: AsyncClient, session: AsyncSession
) -> None:
    response = await anonymous_client.get("{{ ns.entity.path }}{{ ns.op.path }}")

    assert_problem(response, 401)
    _, token = await _sign_in(anonymous_client, session)
    response = await anonymous_client.get(
        "{{ ns.entity.path }}{{ ns.op.path }}", headers={"Authorization": f"Bearer {token}"}
    )
    assert response.status_code == 200, response.text
