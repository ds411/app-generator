"""The tests of the sign-in: tokens, the auth endpoints, and the protected endpoints."""

import pytest
from httpx import AsyncClient
from sqlalchemy.ext.asyncio import AsyncSession

from app.core.auth import set_password
from tests.factories import make_{{ u.snake }}
from tests.problems import assert_problem

pytestmark = pytest.mark.anyio

PASSWORD = "correct-horse-battery"


async def _sign_in(client: AsyncClient, session: AsyncSession) -> tuple[str, str]:
    """Store a user with a password, sign in, and return the user ID and the token."""
    user = await make_{{ u.snake }}(session)
    await set_password(session, user, PASSWORD)
    response = await client.post(
        "/auth/sign-in", json={"username": user.{{ username.attr }}, "password": PASSWORD}
    )
    assert response.status_code == 200, response.text
    return str(user.id), response.json()["access_token"]


async def test_a_user_signs_in_and_reads_their_record(
    anonymous_client: AsyncClient, session: AsyncSession
) -> None:
    user_id, token = await _sign_in(anonymous_client, session)

    response = await anonymous_client.get("/auth/me", headers={"Authorization": f"Bearer {token}"})

    assert response.status_code == 200, response.text
    assert response.json()["id"] == user_id


async def test_a_wrong_password_gives_401(
    anonymous_client: AsyncClient, session: AsyncSession
) -> None:
    user = await make_{{ u.snake }}(session)
    await set_password(session, user, PASSWORD)

    response = await anonymous_client.post(
        "/auth/sign-in", json={"username": user.{{ username.attr }}, "password": "wrong-password"}
    )

    assert_problem(response, 401)


async def test_a_token_that_is_not_valid_gives_401(anonymous_client: AsyncClient) -> None:
    response = await anonymous_client.get("/auth/me", headers={"Authorization": "Bearer abc.def"})

    assert_problem(response, 401)


async def test_a_user_changes_their_password(
    anonymous_client: AsyncClient, session: AsyncSession
) -> None:
    _, token = await _sign_in(anonymous_client, session)
    headers = {"Authorization": f"Bearer {token}"}

    response = await anonymous_client.put(
        "/auth/password",
        json={"current_password": PASSWORD, "new_password": "another-password"},
        headers=headers,
    )

    assert response.status_code == 204, response.text
