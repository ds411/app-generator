async def _sign_in(client: AsyncClient, session: AsyncSession) -> tuple[str, str]:
    """Store a user with a password, sign in, and return the user ID and the token."""
    user = await make_{{ u.snake }}(session)
    await set_password(session, user, PASSWORD)
    response = await client.post(
        "/auth/sign-in", json={"username": user.{{ username.attr }}, "password": PASSWORD}
    )
    assert response.status_code == 200, response.text
{% if sf_required %}
    return str(user.id), await _token_of(client, response)


async def _token_of(client: AsyncClient, response: Response) -> str:
    """Return the token of a sign-in. A role that must use a second factor turns it on first."""
    body = response.json()
    if "access_token" in body:
        return body["access_token"]
    challenge = body["challenge"]
    assert body["second_factor"] == "setup", body
    setup = await client.post("/auth/second-factor/setup", json={"challenge": challenge})
    assert setup.status_code == 200, setup.text
    code = totp_code(base64.b32decode(setup.json()["secret"]), current_step())
    data = {"challenge": challenge, "code": code}
    confirm = await client.post("/auth/second-factor/confirm", json=data)
    assert confirm.status_code == 200, confirm.text
    return confirm.json()["token"]["access_token"]
{% else %}
    return str(user.id), response.json()["access_token"]
{% endif %}
