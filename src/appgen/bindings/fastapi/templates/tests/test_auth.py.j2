@pytest.fixture
def reset_links(monkeypatch: pytest.MonkeyPatch) -> list[str]:
    """The reset links that the app sends. The tests do not use the delivery of the app."""
    links: list[str] = []

    async def deliver(settings: Settings, user: {{ u.name }}, link: str) -> None:
        links.append(link)

    monkeypatch.setattr(auth, "deliver_password_reset", deliver)
    return links


async def _reset_token(client: AsyncClient, username: str, links: list[str]) -> str:
    """Ask for a reset link, and return the token of the link."""
    response = await client.post("/auth/password-reset", json={"username": username})
    assert response.status_code == 202, response.text
    return links[-1].partition("?token=")[2]


{{ trace(reset.id) }}
async def test_a_user_resets_a_forgotten_password(
    anonymous_client: AsyncClient, session: AsyncSession, reset_links: list[str]
) -> None:
    user = await make_{{ u.snake }}(session)
    await set_password(session, user, PASSWORD)
    token = await _reset_token(anonymous_client, user.{{ username.attr }}, reset_links)

    response = await anonymous_client.post(
        "/auth/password-reset/confirm", json={"token": token, "new_password": "a-new-password"}
    )

    assert response.status_code == 204, response.text
    credentials = {"username": user.{{ username.attr }}, "password": "a-new-password"}
    assert (await anonymous_client.post("/auth/sign-in", json=credentials)).status_code == 200
    credentials["password"] = PASSWORD
    assert_problem(await anonymous_client.post("/auth/sign-in", json=credentials), 401)


