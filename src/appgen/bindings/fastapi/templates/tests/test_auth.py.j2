async def test_a_user_signs_in_and_reads_their_record(
    anonymous_client: AsyncClient, session: AsyncSession
) -> None:
    user_id, token = await _sign_in(anonymous_client, session)

    response = await anonymous_client.get("/auth/me", headers={"Authorization": f"Bearer {token}"})

    assert response.status_code == 200, response.text
    assert response.json()["id"] == user_id
