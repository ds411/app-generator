async def test_a_sign_up_with_a_user_name_that_exists_gives_409(
    anonymous_client: AsyncClient, session: AsyncSession
) -> None:
    body = await _sign_up_body(session)
    first = await anonymous_client.post("/auth/sign-up", json=body)
    assert first.status_code == 201, first.text

    response = await anonymous_client.post("/auth/sign-up", json=body)

    assert_problem(response, 409)


