async def test_an_expired_or_a_changed_verification_token_gives_400(
    anonymous_client: AsyncClient, session: AsyncSession
) -> None:
    user = await make_{{ u.snake }}(session)
    ended = int(time.time()) - 1
    later = int(time.time()) + 60

    tokens = [
        make_verification_token(b"test-secret", user.id, user.{{ address.attr }}, ended),
        make_verification_token(b"test-secret", user.id, "another@example.com", later),
        "abc.def",
    ]

    for token in tokens:
        response = await anonymous_client.post("/auth/verify-email/confirm", json={"token": token})
        assert_problem(response, 400)


