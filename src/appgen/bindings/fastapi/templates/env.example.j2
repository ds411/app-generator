{{ trace_header("app") }}
# Copy this file to .env, and change the values for your machine.
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/{{ py.package }}
# For a local run without Postgres, use SQLite instead:
# DATABASE_URL=sqlite+aiosqlite:///./local.db
CORS_ORIGINS=["http://localhost:5173"]
{% if definition.auth %}
# The secret key of the sign-in tokens. Use a long random text, for example
# the output of `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
AUTH_SECRET=
{% endif %}
