{{ trace_header("app") }}
# Copy this file to .env, and change the values for your machine.
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/{{ py.package }}
# For a local run without Postgres, use SQLite instead:
# DATABASE_URL=sqlite+aiosqlite:///./local.db
CORS_ORIGINS=["http://localhost:5173"]
# The logs: the lowest level, and JSON (true) or plain text (false).
LOG_LEVEL=INFO
LOG_JSON=false
# The requests that each client can send in each minute (0: no limit).
RATE_LIMIT_PER_MINUTE=0
{% if py.redis %}
# The Redis of the rate limit, for all processes. Empty: each process counts.
RATE_LIMIT_STORE_URL=
{% endif %}
{% if definition.auth %}
# The secret key of the sign-in tokens. Use a long random text, for example
# the output of `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
AUTH_SECRET=
{% endif %}
{% if definition.auth and definition.auth.password_reset %}
# The page of the front end that sets a new password with a reset link.
PASSWORD_RESET_URL=http://localhost:5173/reset-password
{% endif %}
{% if definition.auth and definition.auth.sign_up and definition.auth.sign_up.verify_email %}
# The page of the front end that confirms an email address with a link.
EMAIL_VERIFY_URL=http://localhost:5173/verify-email
{% endif %}
{% if py.message_elements %}
# development: the delivery of the messages writes the links to the log.
ENVIRONMENT=development
{% endif %}
{% for api in py_apis.values() %}
{{ trace(api.id) }}
# The API {{ api.name }} ({{ api.title }}). The tests do not call it.
{{ api.url_env }}={{ api.base_url }}
{% if api.secret_env %}
{{ api.secret_env }}=
{% endif %}
{% endfor %}
{% if py.providers %}
# The URL of the API for the browsers. The providers send the users back to
# <PUBLIC_URL>/auth/providers/<name>/callback. Empty: the URL of each request.
PUBLIC_URL=http://localhost:8000
{% for p in py.providers %}
# The provider {{ p.name }}: the issuer, and the client of the app at the provider.
{{ p.name | upper }}_ISSUER={{ p.issuer }}
{{ p.client_id_env }}=
{{ p.client_secret_env }}=
{% endfor %}
{% endif %}
