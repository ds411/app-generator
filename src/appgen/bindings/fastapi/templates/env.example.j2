{{ trace_header("app") }}
# Copy this file to .env, and change the values for your machine.
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/{{ py.package }}
# For a local run without Postgres, use SQLite instead:
# DATABASE_URL=sqlite+aiosqlite:///./local.db
# Set to true to add the seed records when the API starts (after the
# migrations). `uv run python -m app.cli seed` does the same.
DATABASE_SEED=false
CORS_ORIGINS=["http://localhost:5173"]
# The logs: the lowest level, and JSON (true) or plain text (false).
LOG_LEVEL=INFO
LOG_JSON=false
# The requests that each client can send in each minute (0: no limit).
RATE_LIMIT_PER_MINUTE=0
{% if py.jobs %}
# The worker of the jobs (`uv run python -m app.worker`): the seconds between
# two passes, the minutes of the runs that a pass catches up, and the port of
# its health endpoint (0: no endpoint).
JOBS_INTERVAL_SECONDS=60
JOBS_WINDOW_MINUTES=60
WORKER_PORT=8001
{% endif %}
{% if py.redis %}
# The Redis of the rate limit, for all processes. Empty: each process counts.
RATE_LIMIT_STORE_URL=
{% endif %}
{% if py.live %}
# The Redis of the live events (ADR 0051), so that each process sends the
# changes of all processes{{ " and of the worker" if py.jobs }}. Empty: each process sends its own changes.
LIVE_EVENTS_URL=
{% endif %}
{% if definition.auth %}
# The secret key of the sign-in tokens. Use a long random text, for example
# the output of `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
AUTH_SECRET=
{% if definition.auth.password %}
# With a value, the seed gives each new seed user this password. Use it only
# for local runs and tests.
SEED_PASSWORD=
{% endif %}
{% endif %}
{% if definition.auth and definition.auth.password_reset %}
# The page of the front end that sets a new password with a reset link.
PASSWORD_RESET_URL=http://localhost:5173/reset-password
{% endif %}
{% if definition.auth and definition.auth.sign_up and definition.auth.sign_up.verify_email %}
# The page of the front end that confirms an email address with a link.
EMAIL_VERIFY_URL=http://localhost:5173/verify-email
{% endif %}
{% if py.notice_emails %}
# The front end: the links of the emails of the notices start with it.
FRONT_END_URL=http://localhost:5173
{% endif %}
{% if py.smtp %}
# The SMTP server of the messages of the sign-in. Without SMTP_HOST, the
# development app writes the links to the log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
# starttls, tls (TLS from the start, usually port 465), or none (a local test server).
SMTP_TLS=starttls
# development: without SMTP_HOST, the app writes the links to the log.
ENVIRONMENT=development
{% elif py.message_elements %}
# development: the delivery of the messages writes the links to the log.
ENVIRONMENT=development
{% endif %}
{% for api in py_apis.values() %}
{{ trace(api.id) }}
# The API {{ api.name }} ({{ api.title }}). The tests do not call it.
{{ api.url_env }}={{ api.base_url }}
{% if api.client_id_env %}
{{ api.client_id_env }}=
{% endif %}
{% for env in api.secret_envs %}
{{ env }}=
{% endfor %}
{% endfor %}
{% for w in py_webhooks.values() %}
{{ trace(w.id) }}
# {{ w.secret_comment }}
{{ w.secret_env }}=
{% endfor %}
{% if py.storage %}
{% set st = py.storage %}
{{ trace(st.id) }}
# The folder of the files of the file fields.
{{ st.variables["folder_env"] }}=uploads
{% if st.s3 %}
# The bucket of the files in an S3-compatible service. Empty: the folder.
{{ st.variables["bucket_env"] }}=
{{ st.variables["region_env"] }}=
# The URL of a service that is not Amazon S3, for example MinIO.
{{ st.variables["endpoint_env"] }}=
# The keys of the bucket. Empty: the AWS configuration of the machine.
{{ st.variables["access_key_env"] }}=
{{ st.variables["secret_key_env"] }}=
{% endif %}
# The secret key of the links of the files: a long random text. Empty: each
# process signs its own links.
STORAGE_LINK_SECRET=
# The time that a link of a file works, in seconds.
STORAGE_LINK_SECONDS=3600
{% endif %}
{% if py.providers %}
# The URL of the API for the browsers. The providers send the users back to
# <PUBLIC_URL>/auth/providers/<name>/callback. Empty: the URL of each request.
PUBLIC_URL=http://localhost:8000
{% elif py_connections %}
# The URL of the API for the browsers. The authorization servers of the APIs
# send the users back to <PUBLIC_URL>/auth/connections/<api>/callback.
# Empty: the URL of each request.
PUBLIC_URL=http://localhost:8000
{% elif py.storage %}
# The URL of the API for the browsers: the links of the files start with it.
# Empty: the URL of each request.
PUBLIC_URL=
{% endif %}
{% if py.providers %}
{% for p in py.providers %}
# The provider {{ p.name }}: the issuer, and the client of the app at the provider.
{{ p.name | upper }}_ISSUER={{ p.issuer }}
{{ p.client_id_env }}=
{{ p.client_secret_env }}=
{% endfor %}
{% endif %}
