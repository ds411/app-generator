{% set api = ts_apis[name] %}
{% set server = binding.name == "nextjs" %}
{% set mock = binding.name == "react" and not react.api %}
{# The React app calls an exposed API through the FastAPI app (`expose`). #}
{% set endpoint = binding.name == "react" and react.api and api.exposed %}
{{ trace_header(element_id) }}
{% if server %}
import "server-only";

{% endif %}
{% if endpoint %}
import { API_URL, apiFetch } from "@/shared/api/http";
{% endif %}
import { HttpClient, {{ "mockFetch, " if mock }}type ClientOptions } from "@/shared/api/third-party";
{% set types = api.used_types() %}
{% if mock or types %}

{% endif %}
{% if mock %}
import { MOCK_ROUTES } from "./mock";
{% endif %}
{% if types %}
import type { {{ types | join(", ") }} } from "./types";
{% endif %}

/** The base URL of the first server of the OpenAPI document. */
export const {{ api.base_url_const }} = {{ api.base_url | tojson }};

/**
 * The client of the API `{{ api.name }}` ({{ api.title }}), with one method for each
 * operation that the app uses.
{% if api.description %}
 *
 * {{ api.description }}
{% endif %}
{% if endpoint %}
 *
 * The client calls the endpoints of the FastAPI app, which call the API
 * with its secret (`apis.{{ api.name }}.expose`).
{% endif %}
 */
export class {{ api.client }} {
  private readonly http: HttpClient;

  constructor(options: ClientOptions = {}) {
    this.http = new HttpClient({{ api.name | tojson }}, options.baseUrl ?? {{ api.base_url_const }}, {
{% if server and api.credentials() %}
      {{ api.credentials() }}
{% endif %}
      timeoutMs: options.timeoutMs,
      fetch: options.fetch,
    });
  }

  /** The time limit of a request, in milliseconds. */
  get timeoutMs(): number {
    return this.http.timeoutMs;
  }
{% for m in api.methods %}

  {{ trace(m.id) }}
  /**
{% for line in m.doc_lines() %}
   *{{ (" " ~ line) if line }}
{% endfor %}
   */
  async {{ m.name }}({{ m.arguments() }}): Promise<{{ m.returns }}> {
{% set parts = m.request_lines(endpoint) %}
{% set call = "this.http.request(" ~ (m.method.upper() | tojson) ~ ", " ~ ((m.endpoint if endpoint else m.path) | tojson) %}
{% if m.result_type %}
{% if parts %}
    const data = await {{ call }}, {
{% for line in parts %}
      {{ line }}
{% endfor %}
    });
{% else %}
    const data = await {{ call }});
{% endif %}
    return data as {{ m.result_type }};
{% else %}
{% if parts %}
    await {{ call }}, {
{% for line in parts %}
      {{ line }}
{% endfor %}
    });
{% else %}
    await {{ call }});
{% endif %}
{% endif %}
  }
{% endfor %}
}

/**
{% if server %}
 * Return a client with the settings of the environment: the base URL in
 * `{{ api.url_env }}`{% if api.secret_env %}, and the secret in `{{ api.secret_env }}`{% endif %}.
{% elif mock %}
 * Return a client with the mock data of the app: it answers each call with
 * the example of the OpenAPI document, and sends no request to the API.
{% elif endpoint %}
 * Return a client of the FastAPI app, with the URL in `VITE_API_URL`. The
 * client sends the token of the signed-in user.
{% else %}
 * Return a client with the settings of the build: the base URL in
 * `{{ api.browser_env }}`.
{% endif %}
 */
export function {{ api.factory }}(): {{ api.client }} {
  return new {{ api.client }}({
{% if server %}
    baseUrl: process.env.{{ api.url_env }} || undefined,
{% if api.secret_env %}
    secret: process.env.{{ api.secret_env }},
{% endif %}
{% elif mock %}
    fetch: mockFetch(MOCK_ROUTES),
{% elif endpoint %}
    baseUrl: API_URL,
    fetch: apiFetch,
{% else %}
    baseUrl: import.meta.env.{{ api.browser_env }} || undefined,
{% endif %}
  });
}
