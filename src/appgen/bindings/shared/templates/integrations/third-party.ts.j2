{% set server = binding.name == "nextjs" %}
{% set mock = binding.name == "react" and not react.api %}
{% set features = ts_features(ts_apis) %}
{% set forms = "form" in features or "multipart" in features %}
{% set oauth = server and "oauth2" in features %}
{% set user_basic = server and "user_basic" in features %}
{# `basicAuthorization`: HTTP Basic, also with the credentials of each user (ADR 0033). #}
{% set basic = server and ("basic" in features or user_basic) %}
{# The client credentials flow, or the token or the credentials of a user (ADR 0033). #}
{% set tokens = server and ("oauth2" in features or "user" in features) %}
{{ trace_header(*(ts_apis.values() | map(attribute="id"))) }}
{% if server %}
import "server-only";

{% endif %}
{% if mock %}
import { MOCK_LATENCY_MS } from "./mock-store";

{% endif %}
/** The time limit of a request to a third-party API, in milliseconds. */
export const DEFAULT_TIMEOUT_MS = 10_000;

/** An answer of a third-party API with an error status. */
export class ApiError extends Error {
  constructor(
    readonly api: string,
    readonly status: number,
    readonly body: string,
  ) {
    super(`The API ${api} answered with the status ${status}.`);
    this.name = "ApiError";
  }
}

/** The settings of a client of a third-party API. */
export interface ClientOptions {
  /** The base URL. The default is the first server of the OpenAPI document. */
  baseUrl?: string;
{% if server %}
  /** The API key, the bearer token, the password, or the client secret of an API with security. */
  secret?: string;
{% if server and "basic" in features %}
  /** The user name of an API with HTTP Basic. */
  username?: string;
{% endif %}
{% if oauth %}
  /** The client ID of an API with OAuth 2.0. */
  clientId?: string;
{% endif %}
{% if "user" in features %}
  /** The access tokens or the credentials of a user, for an API with the authorization code flow or `per_user`. */
  token?: TokenSource;
{% endif %}
{% endif %}
  /** The time limit of a request, in milliseconds. */
  timeoutMs?: number;
  /** The `fetch` function, for example a mock in a test. */
  fetch?: typeof fetch;
}

type Value = string | number | boolean | null | undefined;

/** The parameters and the body of a request. */
export interface RequestParts {
  path?: Record<string, Value>;
  query?: Record<string, Value | readonly Value[]>;
  headers?: Record<string, Value>;
{% if "cookie" in features %}
  /** The cookie parameters, in the header `Cookie`. */
  cookies?: Record<string, Value>;
{% endif %}
  /** A JSON body. */
  body?: unknown;
{% if forms %}
  /** A form body: an object with a value for each field. */
  form?: object;
  /** True: send the form as `multipart/form-data`, else as `application/x-www-form-urlencoded`. */
  multipart?: boolean;
{% endif %}
{% if "text" in features or "binary" in features %}
  /** How the client reads the answer: as JSON (the default), as text, or as a `Blob`. */
  answer?: "json" | "text" | "binary";
  /** The media type of the answer, for the header `Accept`. */
  accept?: string;
{% endif %}
}
{% if tokens %}

/** The source of the access tokens of an API with OAuth 2.0. */
export interface TokenSource {
  /** Return the access token, and get a new one when it has ended. */
  get(): Promise<string>;
  /** Forget a token that the API did not accept, so that `get` gets a new one. */
  reset(token: string): void;
}
{% endif %}

/** The HTTP part of the clients: it sends the requests and reads the answers. */
export class HttpClient {
  readonly timeoutMs: number;

  constructor(
    readonly api: string,
    readonly baseUrl: string,
    private readonly options: {
      headers?: Record<string, string>;
      query?: Record<string, string>;
{% if user_basic %}
      /** The scheme of the header `Authorization` with the value of the token source: `Basic` for the credentials of a user. The default is `Bearer`. */
      scheme?: string;
{% endif %}
{% if tokens %}
      /** The access tokens of an API with OAuth 2.0. */
      token?: TokenSource;
{% endif %}
      timeoutMs?: number;
      fetch?: typeof fetch;
    } = {},
  ) {
    this.timeoutMs = options.timeoutMs ?? DEFAULT_TIMEOUT_MS;
  }

  /**
   * Send a request, and return the answer: the JSON value, or `null` for an
   * answer without content{% if "text" in features %}, or the text{% endif %}{% if "binary" in features %}, or a `Blob`{% endif %}. An error status throws an
   * `ApiError`.
{% if tokens %}
   * With OAuth 2.0, the request sends the access token, and an answer with
   * the status 401 gets a new token and sends the request one more time.
{% endif %}
   */
  async request(method: string, path: string, parts: RequestParts = {}): Promise<unknown> {
    const filled = path.replace(/\{([^}]+)\}/g, (_match, name: string) =>
      encodeURIComponent(String(parts.path?.[name] ?? "")),
    );
    const url = new URL(this.baseUrl.replace(/\/+$/, "") + filled);
    for (const [name, value] of Object.entries({ ...this.options.query, ...parts.query })) {
      const values: readonly Value[] = Array.isArray(value) ? value : [value as Value];
      for (const item of values) {
        if (item !== null && item !== undefined) url.searchParams.append(name, String(item));
      }
    }
    const headers = new Headers(this.options.headers);
{% if "text" in features or "binary" in features %}
    headers.set("Accept", parts.accept ?? "application/json");
{% else %}
    headers.set("Accept", "application/json");
{% endif %}
    for (const [name, value] of Object.entries(parts.headers ?? {})) {
      if (value !== null && value !== undefined) headers.set(name, String(value));
    }
{% if "cookie" in features %}
    const cookies = Object.entries(parts.cookies ?? {}).flatMap(([name, value]) =>
      value === null || value === undefined ? [] : [`${name}=${encodeURIComponent(String(value))}`],
    );
    if (cookies.length) headers.set("Cookie", cookies.join("; "));
{% endif %}
{% if forms %}
    let body: string | URLSearchParams | FormData | undefined;
    if (parts.form !== undefined) {
      // fetch sets the content type of the form, with the boundary of a multipart form.
      body = parts.multipart ? multipartBody(parts.form) : formBody(parts.form);
    } else if (parts.body !== undefined) {
{% else %}
    let body: string | undefined;
    if (parts.body !== undefined) {
{% endif %}
      headers.set("Content-Type", "application/json");
      body = JSON.stringify(parts.body);
    }
    const send = this.options.fetch ?? fetch;
{% if tokens %}
    const tokens = this.options.token;
    let token = tokens ? await tokens.get() : undefined;
    let response: Response | undefined;
    for (let attempt = 0; attempt < 2; attempt++) {
{% if user_basic %}
      if (token !== undefined) headers.set("Authorization", `${this.options.scheme ?? "Bearer"} ${token}`);
{% else %}
      if (token !== undefined) headers.set("Authorization", `Bearer ${token}`);
{% endif %}
      response = await send(url, {
        method,
        headers,
        body,
        cache: "no-store",
        signal: AbortSignal.timeout(this.timeoutMs),
      });
      if (response.status !== 401 || tokens === undefined || token === undefined || attempt > 0) break;
      // The API did not accept the token: get a new token, one time.
      tokens.reset(token);
      token = await tokens.get();
    }
    if (response === undefined) throw new ApiError(this.api, 0, "No answer.");
{% else %}
    const response = await send(url, {
      method,
      headers,
      body,
      cache: "no-store",
      signal: AbortSignal.timeout(this.timeoutMs),
    });
{% endif %}
{% if "text" in features or "binary" in features %}
    if (!response.ok) throw new ApiError(this.api, response.status, await response.text());
{% if "binary" in features %}
    if (parts.answer === "binary") return await response.blob();
{% endif %}
    const text = await response.text();
{% if "text" in features %}
    if (parts.answer === "text") return text;
{% endif %}
{% else %}
    const text = await response.text();
    if (!response.ok) throw new ApiError(this.api, response.status, text);
{% endif %}
    return text ? (JSON.parse(text) as unknown) : null;
  }
}
{% if forms %}

/** Return the fields of a form, with one entry for each item of a list. */
function formEntries(form: object): [string, unknown][] {
  return Object.entries(form).flatMap(([name, value]: [string, unknown]) =>
    (Array.isArray(value) ? (value as unknown[]) : [value])
      .filter((item) => item !== null && item !== undefined)
      .map((item): [string, unknown] => [name, item]),
  );
}

/** Return a value of a form field as text: an object as JSON. */
function formText(value: unknown): string {
  return typeof value === "object" ? JSON.stringify(value) : String(value);
}
{% if "form" in features %}

/** Return a form as `application/x-www-form-urlencoded`. */
function formBody(form: object): URLSearchParams {
  const body = new URLSearchParams();
  for (const [name, value] of formEntries(form)) body.append(name, formText(value));
  return body;
}
{% endif %}
{% if "multipart" in features %}

/** Return a form as `multipart/form-data`: a `Blob` is a file, with its name if it is a `File`. */
function multipartBody(form: object): FormData {
  const body = new FormData();
  for (const [name, value] of formEntries(form)) {
    if (value instanceof Blob) body.append(name, value, value instanceof File ? value.name : name);
    else body.append(name, formText(value));
  }
  return body;
}
{% endif %}
{% endif %}
{% if basic %}

/**
 * Return the value of the header `Authorization` of HTTP Basic (RFC 7617):
 * the Base64 of the UTF-8 bytes of `<user name>:<password>`.
 */
export function basicAuthorization(username: string, password: string): string {
  return `Basic ${Buffer.from(`${username}:${password}`, "utf8").toString("base64")}`;
}
{% endif %}
{% if oauth %}

/** The settings of the client credentials flow of OAuth 2.0. */
export interface ClientCredentialsOptions {
  tokenUrl: string;
  clientId: string;
  clientSecret: string;
  scopes: readonly string[];
  timeoutMs?: number;
  fetch?: typeof fetch;
}

/** The access tokens of the client credentials flow: one token at a time for each client. */
class ClientCredentials implements TokenSource {
  private token: { value: string; expires: number } | undefined;
  private pending: Promise<string> | undefined;

  constructor(
    private readonly api: string,
    private readonly options: ClientCredentialsOptions,
  ) {}

  get(): Promise<string> {
    if (this.token !== undefined && Date.now() < this.token.expires) {
      return Promise.resolve(this.token.value);
    }
    // Two requests at the same time wait for the same token.
    this.pending ??= this.request().finally(() => {
      this.pending = undefined;
    });
    return this.pending;
  }

  reset(token: string): void {
    if (this.token?.value === token) this.token = undefined;
  }

  private async request(): Promise<string> {
    const { tokenUrl, clientId, clientSecret, scopes } = this.options;
    const body = new URLSearchParams({ grant_type: "client_credentials" });
    if (scopes.length) body.set("scope", scopes.join(" "));
    // HTTP Basic authentication of the client (RFC 6749, section 2.3.1).
    const credentials = `${encodeURIComponent(clientId)}:${encodeURIComponent(clientSecret)}`;
    const send = this.options.fetch ?? fetch;
    const response = await send(tokenUrl, {
      method: "POST",
      headers: { Accept: "application/json", Authorization: `Basic ${btoa(credentials)}` },
      body,
      cache: "no-store",
      signal: AbortSignal.timeout(this.options.timeoutMs ?? DEFAULT_TIMEOUT_MS),
    });
    const text = await response.text();
    if (!response.ok) throw new ApiError(this.api, response.status, text);
    const data = JSON.parse(text) as { access_token?: unknown; expires_in?: unknown };
    if (typeof data.access_token !== "string") {
      throw new ApiError(this.api, response.status, "The token answer has no access_token.");
    }
    const seconds = typeof data.expires_in === "number" ? data.expires_in : 3600;
    // Get a new token a little before the end of this token.
    this.token = { value: data.access_token, expires: Date.now() + Math.max(seconds - 30, 0) * 1000 };
    return data.access_token;
  }
}

/** The token source of each client of an API with OAuth 2.0, for the whole process. */
const TOKEN_SOURCES = new Map<string, TokenSource>();

/**
 * Return the token source of a client. The clients with the same token
 * URL, client ID, and scopes share one source, so that the process keeps
 * one token for them.
 */
export function clientCredentials(api: string, options: ClientCredentialsOptions): TokenSource {
  const key = JSON.stringify([options.tokenUrl, options.clientId, options.scopes]);
  let source = TOKEN_SOURCES.get(key);
  if (source === undefined) {
    source = new ClientCredentials(api, options);
    TOKEN_SOURCES.set(key, source);
  }
  return source;
}

/** Return the token URL of an API: a path is under the base URL. */
export function tokenUrl(url: string, baseUrl: string): string {
  return url.startsWith("/") ? baseUrl.replace(/\/+$/, "") + url : url;
}
{% endif %}
{% if server and ui_views.api_views %}

/** The answer of an operation for a view of API data: the data, or the message of the error. */
export type ViewAnswer<T> = { status: "success"; data: T } | { status: "error"; error: string };

/**
 * Call an operation for a view of API data (ADR 0022). An error of the
 * API gives the error state of the view, not an error page: the server
 * logs the error, and the view gets its message.
 */
export async function viewAnswer<T>(call: () => Promise<T>): Promise<ViewAnswer<T>> {
  try {
    return { status: "success", data: await call() };
  } catch (error) {
    console.error(error);
    return { status: "error", error: error instanceof Error ? error.message : String(error) };
  }
}
{% endif %}
{% if mock %}

/** A route of the mock data of a third-party API. */
export interface MockRoute {
  method: string;
  /** Matches the end of the path of a request. */
  path: RegExp;
  status: number;
  /** The example answer of the OpenAPI document. */
  example: unknown;
{% if "text" in features or "binary" in features %}
  /** The media type of a text or a binary answer: the example is its text. */
  media?: string;
{% endif %}
}

/**
 * Return a `fetch` function that answers each request with the example
 * of its route, after the latency of the mock data. A request without a
 * route gets the status 404. The function sends no request to the API.
 */
export function mockFetch(routes: readonly MockRoute[]): typeof fetch {
  return async (input: RequestInfo | URL, init?: RequestInit): Promise<Response> => {
    await new Promise((resolve) => setTimeout(resolve, MOCK_LATENCY_MS));
    const url = new URL(input instanceof Request ? input.url : input);
    const method = (init?.method ?? "GET").toUpperCase();
    const route = routes.find((item) => item.method === method && item.path.test(url.pathname));
    if (route === undefined) return new Response(null, { status: 404 });
    if ([204, 205, 304].includes(route.status)) return new Response(null, { status: route.status });
{% if "text" in features or "binary" in features %}
    if (route.media !== undefined) {
      return new Response(String(route.example), {
        status: route.status,
        headers: { "Content-Type": route.media },
      });
    }
{% endif %}
    return new Response(JSON.stringify(route.example), {
      status: route.status,
      headers: { "Content-Type": "application/json" },
    });
  };
}
{% endif %}
