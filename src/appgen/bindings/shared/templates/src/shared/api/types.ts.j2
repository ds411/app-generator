// The interface of the data access of each entity. The mock store
// implements it in memory. The HTTP store implements it with the REST API
// of the FastAPI app (`x-react-data: api`).

export type SortDirection = "asc" | "desc";

export type Sort<T> = {
  field: keyof T & string;
  direction: SortDirection;
};

export type FilterOp = "eq" | "ne" | "lt" | "lte" | "gt" | "gte" | "in" | "not_in" | "contains";

export type Filter<T> = {
  field: keyof T & string;
  op: FilterOp;
  value: unknown;
};

export type Search<T> = {
  text: string;
  fields: (keyof T & string)[];
};

export type ListQuery<T> = {
  sort?: Sort<T>[];
  filters?: Filter<T>[];
  search?: Search<T>;
  /** The page number, from 1. Without it, the result has all records. */
  page?: number;
  pageSize?: number;
};

export type ListResult<T> = {
  items: T[];
  total: number;
  page: number;
  pageSize: number;
};
{% if query_operations(definition) %}

/** A page of the rows of a query (ADR 0045): the page number, from 1, and the count of rows of a page. */
export type RowsPage = { page: number; pageSize: number };

/** The first page of the rows of a query. */
export const FIRST_ROWS: RowsPage = { page: 1, pageSize: 50 };

/** Return one page of the rows of a query, in their order. */
export function pageOfRows<T>(rows: readonly T[], { page, pageSize }: RowsPage): ListResult<T> {
  const start = (page - 1) * pageSize;
  return { items: rows.slice(start, start + pageSize), total: rows.length, page, pageSize };
}
{% endif %}

export type EntityRecord = { id: string };

export interface EntityApi<T extends EntityRecord, TInput, TPatch = Partial<TInput>> {
  list(query?: ListQuery<T>): Promise<ListResult<T>>;
  get(id: string): Promise<T>;
  create(input: TInput): Promise<T>;
  update(id: string, patch: TPatch): Promise<T>;
  remove(id: string): Promise<void>;
  /** Call the listener after each change. Return a function that stops the calls. */
  subscribe(listener: () => void): () => void;
}

{% if has_history(definition) %}
/** The kind of change of an entry of the change log (ADR 0040). */
export type HistoryAction = "created" | "changed" | "deleted" | "restored";

/**
 * An entry of the change log of a record (ADR 0040): the old and the new
 * value of each changed field, by its name in the app definition.
 */
export type HistoryEntry = {
  id: string;
  action: HistoryAction;
  /** The ID of the signed-in user of the change, or null. */
  userId: string | null;
  /** The display value of the user, or null. */
  user: string | null;
  /** The time of the change (ISO 8601). */
  at: string;
  changes: Record<string, { old: unknown; new: unknown }>;
};

/** The change log of the records of an entity (ADR 0040). */
export interface HistoryApi<T extends EntityRecord> {
  /** Return a page of the entries of a record, the newest first. */
  list(id: string, page?: { page: number; pageSize: number }): Promise<ListResult<HistoryEntry>>;
  /** Give the fields of the entry of a change their old values back. Return the changed record. */
  restore(id: string, entryId: string): Promise<T>;
}

{% endif %}
{% if shares %}
/** The state of the secret link of a record (ADR 0049): active or not, and the time of the link. */
export type ShareLinkState = { active: boolean; createdAt: string | null };

/** A new link of a record: the token shows one time only. */
export type ShareLinkCreated = { token: string; createdAt: string };

/** The secret links of the records of an entity (ADR 0049). */
export interface SharingApi {
  /** Return the state of the link of a record. */
  state(id: string): Promise<ShareLinkState>;
  /** Make a new link of a record. The old link of the record stops. */
  create(id: string): Promise<ShareLinkCreated>;
  /** Revoke the link of a record. */
  revoke(id: string): Promise<void>;
}

/**
 * The record of a link, and the related records that its page shows, by
 * entity. The FastAPI app gives the related records as JSON, by the JSON
 * name of the entity: the stores of their entities read them.
 */
export type SharedRecord<T extends EntityRecord, R = EntityRecord> = {
  record: T;
  related: Readonly<Record<string, readonly R[]>>;
};

{% endif %}
{% if presences %}
/** A signed-in user on the page of a record (ADR 0052). */
export type PresentUser = { id: string; name: string; typing: boolean };

/** The other users on the pages of the records of an entity (ADR 0052). */
export interface PresenceApi {
  /** The entity: the events `presence` of the stream name it. */
  entity: string;
  /** Note the signed-in user on the page of a record, and return the other users on it. */
  here(id: string, typing: boolean): Promise<PresentUser[]>;
  /** End the presence of the signed-in user on a record: the page closed. */
  leave(id: string): Promise<void>;
}

{% endif %}
{% if has_notices(definition) %}
/** A notice for the signed-in user: a change of a record that concerns the user (ADR 0041). */
export type Notice = {
  id: string;
  /** The name of the notification in the app definition: its text is a key of the translations. */
  notification: string;
  entity: string;
  recordId: string;
  /** The ID of the user that made the change, or null. */
  actorId: string | null;
  /** The display value of the user that made the change, or null. */
  actor: string | null;
  /** The values of the text, by name, as text from the time of the change. */
  values: Record<string, string>;
  /** The time of the change (ISO 8601). */
  at: string;
  /** The time that the user marked the notice read (ISO 8601), or null. */
  readAt: string | null;
};

/** The notices of the signed-in user (ADR 0041). */
export interface NoticeApi {
  /** Return a page of the notices, the newest first. `unread`: only the unread notices. It fails without a signed-in user. */
  list(query?: { unread?: boolean; page?: number; pageSize?: number }): Promise<ListResult<Notice>>;
  /** Mark a notice read, and return it. */
  read(id: string): Promise<Notice>;
  /** Mark all notices of the user read. */
  readAll(): Promise<void>;
  /** Call the listener after a change of the notices. Return the function that stops it. */
  subscribe(listener: () => void): () => void;
}

{% endif %}
{% if has_points(definition) %}
/** A place on the earth: a latitude from -90 to 90 and a longitude from -180 to 180, in degrees (ADR 0046). */
export type GeoPoint = {
  lat: number;
  lng: number;
};

{% endif %}
{% if definition.storage %}
/** A file of a record (ADR 0027): the name, the size in bytes, the media type, and the URL of the file. */
export type FileValue = {
  name: string;
  size: number;
  type: string;
  url: string;
};

/** The upload and the delete of the files of the file fields of an entity (ADR 0027). */
export interface FileApi<T extends EntityRecord, TField extends string> {
  /** Upload the file of a field. A new file replaces the old file. Return the changed record. */
  upload(id: string, field: TField, file: File): Promise<T>;
  /** Delete the file of a field. Return the changed record. */
  remove(id: string, field: TField): Promise<T>;
}

{% endif %}
export class NotFoundError extends Error {
  readonly entity: string;
  readonly id: string;

  constructor(entity: string, id: string) {
    super({{ js_format("{entity} {id} does not exist.", entity="entity", id="id") }});
    this.name = "NotFoundError";
    this.entity = entity;
    this.id = id;
  }
}
