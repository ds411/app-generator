{{ trace_header(element_id) }}
{% set type = name | pascal %}
{% set all = members(name, element) %}
{% set files = all | selectattr("is_file") | list %}
{% if files %}
import type { FileValue } from "@/shared/api";
{% endif %}
{% for m in all if m.field and m.field.type == "enum" %}
{% if loop.first %}

{% endif %}
export const {{ enum_values_name(name, m.name) }} = {{ ts_value(m.field.values) }} as const; {{ trace(m.element_id) }}
export type {{ m.ts_type }} = (typeof {{ enum_values_name(name, m.name) }})[number];
{% endfor %}

{% if element.description %}
/** {{ element.description }} */
{% endif %}
export type {{ type }} = {
  id: string;
{% for m in all %}
  {{ m.key }}: {{ m.ts_type }}{{ " | null" if m.nullable }}; {{ trace(m.element_id) }}
{% endfor %}
};

/** The values that create a {{ type }}. The keys without a value get their defaults.{{ " The files have their own upload." if files }} */
export type {{ type }}Input = {
{% for m in all if m.input %}
  {{ m.key }}{{ "" if m.input_required else "?" }}: {{ m.ts_type }}{{ " | null" if m.nullable }};
{% endfor %}
};

/** The value of each optional key that the create input does not have. */
export const {{ name | camel }}Defaults: Partial<Omit<{{ type }}, "id">> = {
{% for m in all if not m.input_required and m.input %}
  {{ m.key }}: {{ ts_value(m.default) }},
{% endfor %}
};
{% if files %}

/** The file fields of {{ type }} (ADR 0027). */
export type {{ type }}FileField = {{ files | map(attribute="key") | map("tojson") | join(" | ") }};
{% endif %}
{% for op_name, op in operations_of(definition, name) if op.kind == "custom" and op.params %}

/** The parameters of the operation {{ op_name }}. */
export type {{ op_name | pascal }}Params = {
{% for param_name, param in op.params.items() %}
  {{ param_name | camel }}{{ "" if param.required else "?" }}: {{ param_type(param) }}{{ "" if param.required else " | null" }}; {{ trace(param.id) }}
{% endfor %}
};
{% endfor %}
