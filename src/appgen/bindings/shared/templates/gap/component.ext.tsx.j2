{% set spec = gap_spec(definition, element_id, element_kind) %}
{# The element ID helps the developer, but users must not see it (#157). #}
{% set development = 'process.env.NODE_ENV === "development"' if binding.name == "nextjs" else "import.meta.env.DEV" %}
{{ trace_header(element_id) }}
{% for line in spec.imports %}
{{ line }}
{% endfor %}
{% if spec.imports %}

{% endif %}
export function {{ spec.name }}({% if spec.params %}_props: {
{% for key, type in spec.params %}
  {{ key }}: {{ type }};
{% endfor %}
}{% endif %}) {
  // TODO(appgen): write {{ spec.what }}.
  // When it is done, change the kind of the trace in the header from gap to manual.
  return (
    <div role="note" className="rounded-md border border-dashed p-4 text-sm wrap-anywhere text-muted-foreground">
{% if i18n %}
      {{ "{" ~ development ~ " ? " ~ js_format("Not implemented yet: {element}", element=js(spec.element_id)) ~ " : " ~ tr(js("Not available yet.")) ~ "}" }}
{% else %}
      {{ "{" ~ development ~ " ? " }}"Not implemented yet: {{ spec.element_id }}" : "Not available yet."{{ "}" }}
{% endif %}
    </div>
  );
}
