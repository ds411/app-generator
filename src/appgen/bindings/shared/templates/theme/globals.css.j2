{# The global CSS of a front-end app: Tailwind CSS, and the theme from the
   design tokens. The context needs `theme` (appgen.bindings.shared.theme.Theme). #}
{% macro declare(variable) -%}
--{{ variable.name }}: {{ variable.value }};{% if variable.element_id %} {{ trace(variable.element_id) }}{% endif %}
{%- endmacro %}
{{ trace_header("app", *theme.file_ids) }}
@import "tailwindcss";
@import "tw-animate-css";

@custom-variant dark (&:is(.dark *));

:root {
{% for variable in theme.light %}
  {{ declare(variable) }}
{% endfor %}
}

.dark {
{% for variable in theme.dark %}
  {{ declare(variable) }}
{% endfor %}
}

@theme inline {
{% for variable in theme.inline %}
  {{ declare(variable) }}
{% endfor %}
}
{% if theme.static %}

@theme static {
{% for variable in theme.static %}
  {{ declare(variable) }}
{% endfor %}
}
{% endif %}
{% for utility in theme.utilities %}

{{ trace(utility.element_id, "begin") }}
@utility {{ utility.name }} {
{% for prop, value in utility.declarations %}
  {{ prop }}: {{ value }};
{% endfor %}
}
{{ trace(utility.element_id, "end") }}
{% endfor %}
{% if theme.motion_id %}

{{ trace(theme.motion_id, "begin") }}
{% if theme.motion == "full" %}
/* The UI animates its charts, dialogs, menus, and transitions. */
{% else %}
/* No animations{% if theme.motion == "reduced" %} for users who ask for reduced motion{% endif %}. */
{% if theme.motion == "reduced" %}
@media (prefers-reduced-motion: reduce) {
{% endif %}
{% set pad = "  " if theme.motion == "reduced" else "" %}
{{ pad }}*,
{{ pad }}::before,
{{ pad }}::after {
{{ pad }}  animation-duration: 0.01ms !important;
{{ pad }}  animation-iteration-count: 1 !important;
{{ pad }}  transition-duration: 0.01ms !important;
{{ pad }}  scroll-behavior: auto !important;
{{ pad }}}
{% if theme.motion == "reduced" %}
}
{% endif %}
{% endif %}
{{ trace(theme.motion_id, "end") }}
{% endif %}

@layer base {
  * {
    @apply border-border outline-ring/50;
  }
  body {
    @apply bg-background text-foreground{% if theme.body_typography %} {{ theme.body_typography }}{% endif %};
  }
}
