{% import "ui/views/macros.j2" as m with context %}
{% set plan = ui_views.view_plan(name) %}
{% set view = plan.view %}
{% set group = plan.group_by %}
{{ trace_header(element_id) }}
"use client";

{% set ui_lines = ['import { Badge } from "@/shared/ui/badge";'] + (['import { Button } from "@/shared/ui/button";'] if plan.server and not plan.filters else []) + [m.card_imports(plan, true), 'import { DropdownMenuItem, DropdownMenuLabel' ~ (', DropdownMenuSeparator' if plan.row_actions else '') ~ ' } from "@/shared/ui/dropdown-menu";', 'import { ScrollArea, ScrollBar } from "@/shared/ui/scroll-area";', 'import { cn } from "@/shared/lib/utils";'] %}
{% set move_ops = [plan.move_operation, plan.order.operation if plan.order else none] | select | unique | list %}
{% set check_move = definition.access is not none and move_ops %}
{% if check_move %}{% set ui_lines = ui_lines + ['import { useAccess } from "@/shared/lib/access";'] %}{% endif %}
{{ m.imports(plan, "board", lucide=["TriangleAlertIcon"], react=["type CSSProperties", "type ReactNode"], ui=ui_lines) }}

{{ m.data(plan) }}

{{ m.sort_function(plan) }}

{{ m.actions(plan) }}
type BoardColumn = {
  value: {{ plan.type }}[{{ js(view.group_by | camel) }}];
  label: string;
  /** A CSS color for the marker of the column. */
  color?: string;
  /** The work in progress limit. */
  limit?: number;
};

/** The columns of the board: one for each value of {{ group.path }}. */
const COLUMNS: BoardColumn[] = [
{% for c in plan.board_columns %}
  { value: {{ js(c.value) }}, label: {{ text(c.label) }}{% if c.color %}, color: {{ js(c.color) }}{% endif %}{% if c.limit %}, limit: {{ c.limit }}{% endif %} },{% if c.element_id %} {{ trace(c.element_id) }}{% endif %}

{% endfor %}
];

/** Move a record to another column. */
function moveRecord(record: {{ plan.type }}, value: string): Promise<unknown> {
  return {{ plan.move }};
}
{% if plan.server %}

/** The count of cards that a column loads first, and adds for each "Show more". */
const PAGE_SIZE = 20;

type BoardData = { columns: { items: {{ plan.type }}[]; total: number }[]; lookups: Lookups };

/**
 * Load the first cards of each column: one page of the records with the
 * value of the column, and the related records of all cards.
 */
async function loadColumns(params: ApiParams, sizes: Readonly<Record<string, number>>): Promise<BoardData> {
  const columns = await Promise.all(
    COLUMNS.map((column) =>
      {{ plan.var }}Api.page({
        params: { ...params, {{ js(plan.server.group) }}: column.value },
        sort: VIEW_SORT,
        page: 1,
        pageSize: sizes[column.value] ?? PAGE_SIZE,
      }),
    ),
  );
  return { columns, lookups: await loadLookups(columns.flatMap((column) => column.items)) };
}
{% endif %}

{{ m.record_card(plan, true) }}

export type {{ name | pascal }}ViewProps = {
{% if plan.server %}
  /** Query parameters of the list endpoint that the view adds, for example the records of one parent. */
  params?: ApiParams;
{% else %}
  /** Show only the records that pass this test, for example the records of one parent. */
  where?: (record: {{ plan.type }}) => boolean;
{% endif %}
};

{% if view.title %}
/** {{ view.title }}{% if view.description %}: {{ view.description }}{% endif %} */
{% endif %}
{% if plan.server %}
export function {{ name | pascal }}View({ params }: {{ name | pascal }}ViewProps) {
  // The count of cards that each column loads: "Show more" adds a page.
  const [sizes, setSizes] = useState<Record<string, number>>({});
  const resource = useResource(
    JSON.stringify([params, sizes]),
    () => loadColumns(params ?? {}, sizes),
    subscribe,
    { keep: true },
  );
{% else %}
export function {{ name | pascal }}View({ where }: {{ name | pascal }}ViewProps) {
  const resource = useResource({{ js(name) }}, load, subscribe);
{% endif %}
{% if plan.actions or plan.row_actions %}
{{ m.runner(plan) }}
{% endif %}
  const [dragged, setDragged] = useState<string | null>(null);
  const [target, setTarget] = useState<string | null>(null);
{% if plan.order %}
  // The card that a dragged card goes before or after (ADR 0039).
  const [overCard, setOverCard] = useState<string | null>(null);
{% endif %}
{% if check_move and move_ops | length > 1 %}
  // A role that may not call {% for op in move_ops %}{{ js(op) }}{{ " and " if not loop.last }}{% endfor %} cannot move the cards.
  const access = useAccess(); {{ trace(definition.access.id) }}
  const canMove = {% for op in move_ops %}{{ " && " if not loop.first }}access.canCall({{ js(op) }}){% endfor %};
{% elif check_move %}
  // A role that may not call {{ js(move_ops[0]) }} cannot move the cards.
  const canMove = useAccess().canCall({{ js(move_ops[0]) }}); {{ trace(definition.access.id) }}
{% endif %}

{{ m.states(plan, "board") }}

{% if plan.server %}
{% set server_lookups = (m.card_uses_lookups(plan) | trim) or (m.action_lookups(plan) | trim) %}
  const { columns{{ ", lookups" if server_lookups }} } = resource.data;
  const rows = columns.flatMap((column) => column.items);
  const total = columns.reduce((sum, column) => sum + column.total, 0);
{{ m.action_lookups(plan) -}}
{% else %}
  const { records, lookups } = resource.data;
  const all = where ? records.filter(where) : records;
{{ m.action_lookups(plan) -}}
  const rows = sortRecords(all, lookups);
{% endif %}

{% if plan.order %}
  // A move of a card (ADR 0039): to its column, before or after another card, or to the end of the
  // column. The cards of the column get new values of the order field, one update for each card.
  const move = async (record: {{ plan.type }}, value: string, overId: string | null = null) => {
    try {
      if ({{ ui_views.value(plan.entity, view.group_by, row="record").expr }} !== value) await moveRecord(record, value);
{% if plan.server %}
      // The cards that the column does not show yet too: a renumber gives new values to all of them.
      const list = await {{ plan.var }}Api.all({ ...params, {{ js(plan.server.group) }}: value }, VIEW_SORT);
{% else %}
      const list = rows.filter((row) => {{ group.expr }} === value);
{% endif %}
      const order = placeItem(list, record, overId).map((row) => ({ id: row.id, value: row.{{ plan.order.key }} }));
      await writeOrder(orderChanges(order, record.id), (change) => {{ plan.var }}Api.update(change.id, { {{ plan.order.key }}: change.value }));
    } catch (error) {
      toast.error(error instanceof Error ? {{ tr("error.message") }} : {{ tr(js("The card did not move.")) }});
    }
    resource.reload();
  };

  const drop = (value: string, overId: string | null = null) => {
    const record = rows.find((row) => row.id === dragged);
    setDragged(null);
    setTarget(null);
    setOverCard(null);
    if (record && record.id !== overId) void move(record, value, overId);
  };
{% else %}
  const move = async (record: {{ plan.type }}, value: string) => {
    if ({{ ui_views.value(plan.entity, view.group_by, row="record").expr }} === value) return;
    try {
      await moveRecord(record, value);
      resource.reload();
    } catch (error) {
      toast.error(error instanceof Error ? {{ tr("error.message") }} : {{ tr(js("The card did not move.")) }});
    }
  };

  const drop = (value: string) => {
    const record = rows.find((row) => row.id === dragged);
    setDragged(null);
    setTarget(null);
    if (record) void move(record, value);
  };
{% endif %}

  return (
    <div className="space-y-4">
{% if plan.actions %}
      <div className="flex flex-wrap items-center justify-end gap-2">
        {Object.values(viewActions).map((action) => (
          <ActionButton key={action.key} action={action} records={[]} onRun={run} />
        ))}
      </div>
{% endif %}
      {{ "{total === 0 ? (" if plan.server else "{all.length === 0 ? (" }}
{{ m.empty_state(plan) | indent(2, true) }}
      ) : (
        // The columns scroll in a horizontal scroll area with a scroll bar that always shows.
        <ScrollArea type="always" className={{ js(plan.board_area_classes) }}>{{ (" " ~ trace(view.responsive.id, jsx=True)) if view.responsive else "" }}
          <div className={{ js(plan.board_classes) }}>
{% if plan.server %}
            {COLUMNS.map((column, index) => {
              // The server gives the count of the records of the column, and its first cards.
              const cards = columns[index]?.items ?? [];
              const count = columns[index]?.total ?? 0;
              const over = column.limit !== undefined && count > column.limit;
{% else %}
            {COLUMNS.map((column) => {
              const cards = rows.filter((row) => {{ group.expr }} === column.value);
              const count = cards.length;
              const over = column.limit !== undefined && count > column.limit;
{% endif %}
              return (
                <section
                  key={column.value}
                  aria-label={{ '{' ~ tr('column.label') ~ '}' }}
                  style={column.color ? ({ "--column-color": column.color } as CSSProperties) : undefined}
                  className={cn(
                    {{ js(plan.column_classes) }},
                    target === column.value && "border-primary bg-primary/5",
                  )}
                  onDragOver={(event) => {
                    event.preventDefault();
                    setTarget(column.value);
                  }}
                  onDragLeave={() => setTarget((value) => (value === column.value ? null : value))}
                  onDrop={(event) => {
                    event.preventDefault();
                    drop(column.value);
                  }}
                >
                  <header className="flex items-center gap-2 px-1.5 py-1">
                    <span className="size-2.5 shrink-0 rounded-full bg-(--column-color,var(--muted-foreground))" />
                    <h3 className="truncate text-sm font-medium">{{ '{' ~ tr('column.label') ~ '}' }}</h3>
                    <Badge variant={over ? "destructive" : "secondary"} className="ms-auto tabular-nums">
                      {column.limit === undefined ? count : `${count} / ${column.limit}`}
                    </Badge>
                  </header>
                  {over && (
                    <p className="flex items-center gap-1.5 px-1.5 text-xs text-destructive">
                      <TriangleAlertIcon className="size-3.5" />
                      {{ jsx_format("The column has more than {limit} cards.", limit="column.limit") }}
                    </p>
                  )}
                  <div className="flex min-h-24 flex-col gap-2">
                    {cards.map((row) => (
                      <div
                        key={row.id}
                        draggable{{ "={canMove}" if check_move }}
{% if plan.order %}
                        className={cn(
                          "cursor-grab rounded-lg active:cursor-grabbing",
                          dragged === row.id && "opacity-50",
                          overCard === row.id && dragged !== row.id && "ring-2 ring-primary",
                        )}
{% else %}
                        className={cn("cursor-grab active:cursor-grabbing", dragged === row.id && "opacity-50")}
{% endif %}
                        onDragStart={(event) => {
                          event.dataTransfer.setData("text/plain", row.id);
                          event.dataTransfer.effectAllowed = "move";
                          setDragged(row.id);
                        }}
{% if plan.order %}
                        onDragOver={(event) => {
                          if (dragged === null) return;
                          event.preventDefault();
                          setOverCard(row.id);
                        }}
                        onDragLeave={() => setOverCard((value) => (value === row.id ? null : value))}
                        onDrop={(event) => {
                          // The card goes before or after this card, not to the end of the column.
                          event.preventDefault();
                          event.stopPropagation();
                          drop(column.value, row.id);
                        }}
{% endif %}
                        onDragEnd={() => {
                          setDragged(null);
                          setTarget(null);
{% if plan.order %}
                          setOverCard(null);
{% endif %}
                        }}
                      >
                        <RecordCard
                          row={row}
{% if m.card_uses_lookups(plan) | trim %}
                          lookups={lookups}
{% endif %}
                          menu={
                            <RowActionsMenu actions={ {{- "Object.values(rowActions)" if plan.row_actions else "[]" }}} record={row} onRun={ {{- "run" if plan.row_actions else "() => {}" }}}>
{% set move_items %}
{% if plan.row_actions %}
<DropdownMenuSeparator />
{% endif %}
<DropdownMenuLabel>{{ jsx_text("Move to") }}</DropdownMenuLabel>
{COLUMNS.filter((other) => other.value !== column.value).map((other) => (
  <DropdownMenuItem key={other.value} onSelect={() => void move(row, other.value)}>
    {{ '{' ~ tr('other.label') ~ '}' }}
  </DropdownMenuItem>
))}
{% endset %}
{% if check_move %}
                              {canMove && (
                                <>
{{ move_items.rstrip() | indent(34, first=True) }}
                                </>
                              )}
{% else %}
{{ move_items.rstrip() | indent(30, first=True) }}
{% endif %}
                            </RowActionsMenu>
                          }
                        />
                      </div>
                    ))}
                    {cards.length === 0 && (
                      <p className="rounded-lg border border-dashed px-3 py-6 text-center text-xs text-muted-foreground">
                        {{ jsx_text("Drop a card here") }}
                      </p>
                    )}
{% if plan.server %}
                    {cards.length < count && (
                      <Button
                        variant="ghost"
                        size="sm"
                        onClick={() => setSizes((current) => ({ ...current, [column.value]: cards.length + PAGE_SIZE }))}
                      >
                        {{ jsx_text("Show more") }}
                      </Button>
                    )}
{% endif %}
                  </div>
                </section>
              );
            })}
          </div>
          <ScrollBar orientation="horizontal" />
        </ScrollArea>
      )}
{% if plan.actions or plan.row_actions %}
      {dialog}
{% endif %}
{{ m.form_dialogs(plan) }}
    </div>
  );
}
