import { CheckIcon, MinusIcon } from "lucide-react";

import { type Format, formatValue } from "@/shared/lib/format";
import { cn } from "@/shared/lib/utils";

/** A value in a display format. An empty value shows a dash. */
export function FormattedValue({
  value,
  format = "text",
  currency,
  className,
}: {
  value: unknown;
  format?: Format;
  /** The ISO 4217 code of the `currency` format. The default is `CURRENCY`. */
  currency?: string;
  className?: string;
}) {
  if (value === null || value === undefined || value === "" || (Array.isArray(value) && value.length === 0)) {
    return <span className={cn("text-muted-foreground", className)}>—</span>;
  }
  if (format === "boolean") {
    return value ? (
      <CheckIcon aria-label="Yes" className={cn("size-4 text-primary", className)} />
    ) : (
      <MinusIcon aria-label="No" className={cn("size-4 text-muted-foreground", className)} />
    );
  }
  const text = formatValue(value, format, currency);
  if (format === "email") {
    return (
      <a href={`mailto:${text}`} className={cn("underline-offset-4 hover:underline", className)}>
        {text}
      </a>
    );
  }
  if (format === "url") {
    return (
      <a href={text} target="_blank" rel="noreferrer" className={cn("underline-offset-4 hover:underline", className)}>
        {text}
      </a>
    );
  }
  const numeric = format === "number" || format === "currency" || format === "percent";
  return <span className={cn(numeric && "tabular-nums", className)}>{text}</span>;
}
