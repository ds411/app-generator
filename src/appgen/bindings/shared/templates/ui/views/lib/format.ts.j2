{{ trace_header("app") }}
// The display formats of the views: numbers, money, dates, and times.
{% if i18n %}
// The formats use the locale of the selected language.

import { getLocale } from "@/shared/lib/i18n";
{% endif %}

export type Format =
  | "text"
  | "number"
  | "currency"
  | "percent"
  | "date"
  | "datetime"
  | "relative_time"
  | "boolean"
  | "badge"
  | "email"
  | "url"
  | "avatar";

/** The default currency of the `currency` format. A field can give another currency. */
export const CURRENCY = "USD";

{% if i18n %}
/** The formats of each locale. The app makes a format at its first use. */
const formats = new Map<string, Intl.NumberFormat | Intl.DateTimeFormat | Intl.RelativeTimeFormat>();

/** Return a format in the locale of the selected language. */
function localeFormat<T extends Intl.NumberFormat | Intl.DateTimeFormat | Intl.RelativeTimeFormat>(
  key: string,
  make: (locale: string) => T,
): T {
  const locale = getLocale();
  const id = `${locale} ${key}`;
  let format = formats.get(id) as T | undefined;
  if (format === undefined) {
    format = make(locale);
    formats.set(id, format);
  }
  return format;
}

/** Return a number format in the locale of the selected language. */
export function numberFormat(options: Intl.NumberFormatOptions = {}): Intl.NumberFormat {
  return localeFormat(`number ${JSON.stringify(options)}`, (locale) => new Intl.NumberFormat(locale, options));
}

/** Return a date format in the locale of the selected language. */
export function dateTimeFormat(options: Intl.DateTimeFormatOptions): Intl.DateTimeFormat {
  return localeFormat(`date ${JSON.stringify(options)}`, (locale) => new Intl.DateTimeFormat(locale, options));
}

/** The first day of the week in the locale of the selected language: 0 is Sunday, 1 is Monday. */
export function firstWeekday(): 0 | 1 | 2 | 3 | 4 | 5 | 6 {
  type WeekInfo = { firstDay: number };
  const locale = new Intl.Locale(getLocale()) as Intl.Locale & { getWeekInfo?: () => WeekInfo; weekInfo?: WeekInfo };
  // Some browsers do not give the week of a locale: the week starts on Monday (ISO 8601).
  const firstDay = (locale.getWeekInfo?.() ?? locale.weekInfo)?.firstDay ?? 1;
  return (firstDay % 7) as 0 | 1 | 2 | 3 | 4 | 5 | 6;
}

const relativeFormat = () => localeFormat("relative", (locale) => new Intl.RelativeTimeFormat(locale, { numeric: "auto" }));
{% else %}
const numberFormat = new Intl.NumberFormat(undefined, { maximumFractionDigits: 2 });
const currencyFormats = new Map<string, Intl.NumberFormat>();
const percentFormat = new Intl.NumberFormat(undefined, { style: "percent", maximumFractionDigits: 1 });
const dateFormat = new Intl.DateTimeFormat(undefined, { dateStyle: "medium" });
const dateTimeFormat = new Intl.DateTimeFormat(undefined, { dateStyle: "medium", timeStyle: "short" });
const relativeFormat = new Intl.RelativeTimeFormat(undefined, { numeric: "auto" });
{% endif %}

const UNITS: [Intl.RelativeTimeFormatUnit, number][] = [
  ["year", 365 * 24 * 3600],
  ["month", 30 * 24 * 3600],
  ["week", 7 * 24 * 3600],
  ["day", 24 * 3600],
  ["hour", 3600],
  ["minute", 60],
  ["second", 1],
];

{% if not i18n %}
/** Return the number format of a currency (an ISO 4217 code). */
function currencyFormat(currency: string): Intl.NumberFormat {
  let format = currencyFormats.get(currency);
  if (format === undefined) {
    format = new Intl.NumberFormat(undefined, { style: "currency", currency });
    currencyFormats.set(currency, format);
  }
  return format;
}
{% endif %}

/** Return a date (`YYYY-MM-DD`) or a date and time (ISO 8601) as a Date. */
export function toDate(value: string): Date {
  return /^\d{4}-\d{2}-\d{2}$/.test(value) ? new Date(`${value}T00:00:00`) : new Date(value);
}

/** Return a time relative to now, for example "3 days ago". */
export function formatRelative(date: Date, now: Date = new Date()): string {
  const seconds = (date.getTime() - now.getTime()) / 1000;
  for (const [unit, size] of UNITS) {
    if (Math.abs(seconds) >= size || unit === "second") {
      return relativeFormat{{ "()" if i18n }}.format(Math.round(seconds / size), unit);
    }
  }
  return "";
}

/**
 * Return a value as text in a format. An empty value gives an empty text.
 * The `currency` format uses `currency` (an ISO 4217 code), else `CURRENCY`.
 */
export function formatValue(value: unknown, format: Format = "text", currency: string = CURRENCY): string {
  if (value === null || value === undefined || value === "") return "";
  switch (format) {
{% if i18n %}
    case "number":
      return numberFormat({ maximumFractionDigits: 2 }).format(Number(value));
    case "currency":
      return numberFormat({ style: "currency", currency }).format(Number(value));
    case "percent":
      return numberFormat({ style: "percent", maximumFractionDigits: 1 }).format(Number(value));
    case "date":
      return dateTimeFormat({ dateStyle: "medium" }).format(toDate(String(value)));
    case "datetime":
      return dateTimeFormat({ dateStyle: "medium", timeStyle: "short" }).format(toDate(String(value)));
{% else %}
    case "number":
      return numberFormat.format(Number(value));
    case "currency":
      return currencyFormat(currency).format(Number(value));
    case "percent":
      return percentFormat.format(Number(value));
    case "date":
      return dateFormat.format(toDate(String(value)));
    case "datetime":
      return dateTimeFormat.format(toDate(String(value)));
{% endif %}
    case "relative_time":
      return formatRelative(toDate(String(value)));
    case "boolean":
      return value ? {{ tr(js("Yes")) }} : {{ tr(js("No")) }};
    default:
      return Array.isArray(value) ? value.join(", ") : String(value);
  }
}

/** Return the initials of a name, for an avatar: "Ada Lovelace" gives "AL". */
export function initials(name: string): string {
  const parts = name.trim().split(/\s+/).filter(Boolean);
  return parts
    .slice(0, 2)
    .map((part) => part[0]?.toUpperCase() ?? "")
    .join("");
}
{% if definition.storage %}

{% if not i18n %}
const sizeFormat = new Intl.NumberFormat(undefined, { maximumFractionDigits: 1 });

{% endif %}
/** Return the size of a file as a short text with a unit, for example "5 MB" or "1.5 KB". */
export function fileSize(size: number): string {
{% if i18n %}
  const sizeFormat = numberFormat({ maximumFractionDigits: 1 });
{% endif %}
  const units: [string, number][] = [
    ["GB", 1024 ** 3],
    ["MB", 1024 ** 2],
    ["KB", 1024],
  ];
  for (const [unit, factor] of units) {
    if (size >= factor) {
      return `${sizeFormat.format(size / factor)} ${unit}`;
    }
  }
  return `${sizeFormat.format(size)} B`;
}
{% endif %}
