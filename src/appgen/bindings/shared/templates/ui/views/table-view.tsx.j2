{% import "ui/views/macros.j2" as m with context %}
{% set plan = ui_views.view_plan(name) %}
{% set view = plan.view %}
{{ trace_header(element_id) }}
"use client";

{% set ui_lines = ['import { DataTable' ~ (', type ServerPages' if plan.server else '') ~ ' } from "@/shared/ui/data-table";'] %}
{% set check_order = definition.access is not none and plan.order is not none and plan.order.operation is not none %}
{% if check_order %}{% set ui_lines = ui_lines + ['import { useAccess } from "@/shared/lib/access";'] %}{% endif %}
import type { ColumnDef } from "@tanstack/react-table";
{{ m.imports(plan, "table", ui=ui_lines) }}

{{ m.data(plan) }}

{{ m.filters(plan) }}
{{ m.sort_function(plan) }}

{% set code = plan.columns | map(attribute="cell") | join(" ") ~ (plan.columns | map(attribute="value") | map(attribute="sort_expr") | join(" ")) %}
/** The columns of the table. */
function columnsFor({{ lookups_param(code) }}: Lookups): ColumnDef<{{ plan.type }}>[] {
  return [
{% for c in plan.columns %}
    { {{ trace(c.element_id) }}
      id: {{ js(c.name | camel) }},
      header: {{ tr(js(c.header)) }},
      accessorFn: (row) => {{ c.value.sort_expr }},
      cell: ({ row: { original: row } }) => {{ c.cell }},
{% if not c.sortable %}
      enableSorting: false,
{% else %}
      sortUndefined: "last",
{% endif %}
{% if c.classes or c.width %}
      meta: { {% if c.classes %}className: {{ js(c.classes) }}{% endif %}{% if c.classes and c.width %}, {% endif %}{% if c.width %}width: {{ js(c.width) }}{% endif %} },
{% endif %}
    },
{% endfor %}
  ];
}

{{ m.actions(plan) }}
{% if view.pagination %}
const PAGE_SIZE = {{ plan.page_size }}; {{ trace(view.pagination.id) }}
{% else %}
const PAGE_SIZE = {{ plan.page_size }};
{% endif %}
const PAGE_SIZES: number[] = {{ js(plan.page_sizes) }};
{% if plan.server %}

/** The sort key of the list endpoint for each column that can sort. */
const SORT_KEYS: Record<string, string> = {
{% for column_id, key in plan.server.columns.items() %}
  {{ column_id }}: {{ js(key) }},
{% endfor %}
};

/** Return the sort keys of the list endpoint: the sort of a column first, then the sort of the view. */
function sortKeys(sorting: ServerPages["sorting"]): string[] {
  const keys = sorting.flatMap(({ id, desc }) => (SORT_KEYS[id] ? [`${desc ? "-" : ""}${SORT_KEYS[id]}`] : []));
  return [...keys, ...VIEW_SORT];
}

export type {{ name | pascal }}ViewProps = {
  /** Query parameters of the list endpoint that the view adds, for example the records of one parent. */
  params?: ApiParams;
};
{% else %}

export type {{ name | pascal }}ViewProps = {
  /** Show only the records that pass this test, for example the records of one parent. */
  where?: (record: {{ plan.type }}) => boolean;
};
{% endif %}

{% if view.title %}
/** {{ view.title }}{% if view.description %}: {{ view.description }}{% endif %} */
{% endif %}
{% if plan.server %}
export function {{ name | pascal }}View({ params }: {{ name | pascal }}ViewProps) {
{% if plan.filters %}
{% if plan.me %}
  const initial = initialFilters(useMe());
{% endif %}
  const [filters, setFilters] = useState<Filters>({{ m.initial(plan) }});
{% endif %}
{% if plan.scroll %}
  const [sorting, setSorting] = useState<ServerPages["sorting"]>([]);
  // The list scrolls: each page is one request, and the table keeps the loaded pages.
  const query: Omit<ApiQuery, "page" | "pageSize"> = {
    params: { ...params{% if plan.filters %}, ...filterParams(filters){% endif %} },
    sort: sortKeys(sorting),
  };
  {{ m.scroll_resource(plan) }}
{% else %}
  const [pages, setPages] = useState<ServerPages>({ page: 1, pageSize: PAGE_SIZE, sorting: [] });
  const query: ApiQuery = {
    params: { ...params{% if plan.filters %}, ...filterParams(filters){% endif %} },
    sort: sortKeys(pages.sorting),
    page: pages.page,
    pageSize: pages.pageSize,
  };
  {{ m.server_resource(plan) }}
{% endif %}
{% if plan.actions or plan.row_actions or plan.bulk_actions %}
{{ m.runner(plan) }}
{% endif %}
{% if plan.filters %}

  const updateFilters = (next: Filters) => {
    setFilters(next);
{% if not plan.scroll %}
    setPages((value) => ({ ...value, page: 1 }));
{% endif %}
  };
{% endif %}

{% if check_order %}
  // A role that may not call {{ js(plan.order.operation) }} cannot move the rows.
  const canMove = useAccess().canCall({{ js(plan.order.operation) }}); {{ trace(definition.access.id) }}

{% endif %}
{{ m.states(plan, "table") }}

  const [{ items: rows, total }, lookups] = resource.data;
{{ m.action_lookups(plan) -}}
{% if plan.filters %}
  const filtered = JSON.stringify(filters) !== JSON.stringify({{ m.initial(plan) }});
{% if plan.filters | selectattr("options") | list %}
  const options = filterOptions(lookups);
{% endif %}
{% endif %}
{% else %}
export function {{ name | pascal }}View({ where }: {{ name | pascal }}ViewProps) {
  const resource = useResource({{ js(name) }}, load, subscribe);
{% if plan.filters %}
{% if plan.me %}
  const initial = initialFilters(useMe());
{% endif %}
  const [filters, updateFilters] = useState<Filters>({{ m.initial(plan) }});
{% endif %}
{% if plan.actions or plan.row_actions or plan.bulk_actions %}
{{ m.runner(plan) }}
{% endif %}

{% if check_order %}
  // A role that may not call {{ js(plan.order.operation) }} cannot move the rows.
  const canMove = useAccess().canCall({{ js(plan.order.operation) }}); {{ trace(definition.access.id) }}

{% endif %}
{{ m.states(plan, "table") }}

  const { records, lookups } = resource.data;
  const all = where ? records.filter(where) : records;
{{ m.action_lookups(plan) -}}
{% if plan.filters %}
  const filtered = JSON.stringify(filters) !== JSON.stringify({{ m.initial(plan) }});
{% set options = plan.filters | selectattr("options") | list %}
{% if options %}
  const options = filterOptions(lookups);
{% endif %}
  const rows = sortRecords(all.filter((row) => matches(row, filters, lookups)), lookups);
{% else %}
  const rows = sortRecords(all, lookups);
{% endif %}
{% endif %}
{% if plan.order %}

  // A move of a row (ADR 0039): the new values of the order field, one update for each record.
  const move = async (id: string, overId: string) => {
    try {
{% if plan.server %}
      // The other pages too: a renumber gives new values to all records of the view.
      const list = await {{ plan.var }}Api.all(query.params ?? {}, VIEW_SORT);
{% else %}
      const list = rows;
{% endif %}
      const record = list.find((row) => row.id === id);
      if (!record) return;
      const order = placeItem(list, record, overId).map((row) => ({ id: row.id, value: row.{{ plan.order.key }} }));
      await writeOrder(orderChanges(order, id), (change) => {{ plan.var }}Api.update(change.id, { {{ plan.order.key }}: change.value }));
    } catch (error) {
      toast.error(error instanceof Error ? {{ tr("error.message") }} : {{ tr(js("The row did not move.")) }});
    }
    resource.reload();
  };
{% endif %}
{% set click = plan.row_action(view.row_click) %}

  return (
    <div className="space-y-4">
{{ m.toolbar(plan) }}
{% if plan.server %}
      {total === 0{{ " && !filtered" if plan.filters }} ? (
{% else %}
      {all.length === 0 ? (
{% endif %}
{{ m.empty_state(plan) | indent(2, true) }}
{% if plan.filters %}
      ) : {{ "total" if plan.server else "rows.length" }} === 0 ? (
        <ViewMessage
          title={{ jsx_attr("No matching records") }}
          text={{ jsx_attr("Change or reset the filters.") }}
          action={
            <Button variant="outline" size="sm" onClick={() => updateFilters({{ m.initial(plan) }})}>
              {{ jsx_text("Reset the filters") }}
            </Button>
          }
        />
{% endif %}
      ) : (
        <DataTable
          columns={columnsFor(lookups)}
          data={rows}
          pageSize={PAGE_SIZE}
          pageSizes={PAGE_SIZES}
{% if plan.server and plan.scroll %}
          server={{ '{{' }} page: 1, pageSize: PAGE_SIZE, sorting, total, onChange: (next) => setSorting(next.sorting) {{ '}}' }}
          scroll={{ '{{' }} loading: resource.loadingMore, onMore: resource.more {{ '}}' }}
{% elif plan.server %}
          server={{ '{{' }} ...pages, total, onChange: setPages {{ '}}' }}
{% elif plan.filters %}
          resetKey={JSON.stringify(filters)}
{% endif %}
{% if plan.scroll and not plan.server %}
          scroll
{% endif %}
{% if view.selection %}
          selection
{% endif %}
{% if plan.bulk_actions %}
          bulkActions={(selected, clear) =>
            Object.values(bulkActions).map((action) => (
              <ActionButton
                key={action.key}
                action={action}
                records={selected}
                onRun={(next, records) => {
                  run(next, records);
                  clear();
                }}
              />
            ))
          }
{% endif %}
{% if plan.row_actions %}
          rowActions={(record) => <RowActionsMenu actions={Object.values(rowActions)} record={record} onRun={run} />}
{% endif %}
{% if click %}
          onRowClick={(record) => run(rowActions.{{ click.name | camel }}, [record])}
{% endif %}
{% if plan.order %}
          onMove={ {{- "canMove ? move : undefined" if check_order else "move" }}}
{% endif %}
        />
      )}
{% if plan.actions or plan.row_actions or plan.bulk_actions %}
      {dialog}
{% endif %}
{{ m.form_dialogs(plan) }}
    </div>
  );
}
