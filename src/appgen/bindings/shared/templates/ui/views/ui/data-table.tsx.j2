{{ trace_header("app") }}
"use client";

import {
  type ColumnDef,
  flexRender,
  functionalUpdate,
  getCoreRowModel,
  getPaginationRowModel,
  getSortedRowModel,
  type PaginationState,
  type RowSelectionState,
  type SortingState,
  useReactTable,
} from "@tanstack/react-table";
{% set order = "order" in ui_views.features %}
import { ArrowDownIcon, ArrowUpIcon, ChevronsUpDownIcon{{ ", GripVerticalIcon" if order }} } from "lucide-react";
import { type CSSProperties, type ReactNode, useState } from "react";

import { Button } from "@/shared/ui/button";
import { Checkbox } from "@/shared/ui/checkbox";
import { ListPagination } from "@/shared/ui/list-pagination";
{% if "scroll" in ui_views.features %}
import { ScrollMore } from "@/shared/ui/scroll-more";
{% endif %}
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from "@/shared/ui/table";
import { cn } from "@/shared/lib/utils";

/** The look of a column (`meta` of a column): its classes and its width. */
export type DataColumnMeta = {
  className?: string;
  width?: string;
};

function metaOf(meta: unknown): DataColumnMeta | undefined {
  return meta as DataColumnMeta | undefined;
}

/** The page and the sort of a table whose server sorts and pages the records. */
export type ServerPages = {
  page: number;
  pageSize: number;
  sorting: SortingState;
};

/**
 * A table of records with sorting, pages, and selection: the data table of
 * shadcn/ui on TanStack Table. The view filters the records first. With
 * `server`, `data` is one page, and the view loads the page and the sort
 * that `server.onChange` gives.{% if "scroll" in ui_views.features %} With `scroll`, the table shows the next
 * page at its end, and keeps the shown rows. With `server` and `scroll`,
 * `data` is the loaded pages, and `scroll.onMore` loads the next page.{% endif %}{% if order %} With
 * `onMove`, a row moves by drag and drop, or with the arrow keys on its
 * handle, while no column sorts the rows (ADR 0039).{% endif %}
 */
export function DataTable<T extends { id: string }>({
  columns,
  data,
  initialSorting = [],
  pageSize,
  pageSizes,
  resetKey,
  selection = false,
  bulkActions,
  rowActions,
  onRowClick,
  server,
{% if "scroll" in ui_views.features %}
  scroll,
{% endif %}
{% if order %}
  onMove,
{% endif %}
}: {
  columns: ColumnDef<T>[];
  data: T[];
  initialSorting?: SortingState;
  pageSize: number;
  pageSizes: number[];
  /** A value that changes with the filters. A change shows the first page again. */
  resetKey?: string;
  selection?: boolean;
  /** The actions of the selected records. */
  bulkActions?: (records: T[], clear: () => void) => ReactNode;
  /** The menu of one record, in the last column. */
  rowActions?: (record: T) => ReactNode;
  onRowClick?: (record: T) => void;
  /** The pages and the sort on the server, with the count of all records. */
  server?: ServerPages & { total: number; onChange: (pages: ServerPages) => void };
{% if "scroll" in ui_views.features %}
  /** Show the next page at the end (`pagination.mode: scroll`). The server loads it with `onMore`. */
  scroll?: true | { loading: boolean; onMore: () => void };
{% endif %}
{% if order %}
  /** Move the record `id` to the place of the record `overId` (`order_field`). */
  onMove?: (id: string, overId: string) => void;
{% endif %}
}) {
  const [sorting, setSorting] = useState<SortingState>(initialSorting);
  const [rowSelection, setRowSelection] = useState<RowSelectionState>({});
  const [pagination, setPagination] = useState<PaginationState>({ pageIndex: 0, pageSize });
  const [lastKey, setLastKey] = useState(resetKey);
  if (lastKey !== resetKey) {
    setLastKey(resetKey);
{% if "scroll" in ui_views.features %}
    // A list that scrolls shows its first page again.
    setPagination((value) => ({ pageIndex: 0, pageSize: scroll ? pageSize : value.pageSize }));
{% else %}
    setPagination((value) => ({ ...value, pageIndex: 0 }));
{% endif %}
  }

{% if order %}
  // The rows move only in the manual order: not while a column sorts them.
  const movable = onMove !== undefined && (server ? server.sorting : sorting).length === 0;
  const [dragged, setDragged] = useState<string | null>(null);
  const [over, setOver] = useState<string | null>(null);
  const endDrag = () => {
    setDragged(null);
    setOver(null);
  };

{% endif %}
  const allColumns: ColumnDef<T>[] = [
{% if order %}
    ...(movable
      ? [
          {
            id: "move",
            header: () => <span className="sr-only">{{ jsx_text("Order") }}</span>,
            cell: ({ row, table }) => (
              <Button
                variant="ghost"
                size="icon"
                className="size-7 cursor-grab text-muted-foreground active:cursor-grabbing"
                aria-label={{ jsx_attr("Move the row") }}
                onClick={(event) => event.stopPropagation()}
                onKeyDown={(event) => {
                  // The arrow keys move the row above the row before it, or below the row after it.
                  const shown = table.getRowModel().rows;
                  const index = shown.findIndex((other) => other.id === row.id);
                  const other = event.key === "ArrowUp" ? shown[index - 1] : event.key === "ArrowDown" ? shown[index + 1] : undefined;
                  if (other) {
                    event.preventDefault();
                    onMove?.(row.id, other.id);
                  }
                }}
              >
                <GripVerticalIcon className="size-4" />
              </Button>
            ),
            enableSorting: false,
            meta: { className: "w-10" },
          } satisfies ColumnDef<T>,
        ]
      : []),
{% endif %}
    ...(selection
      ? [
          {
            id: "select",
            header: ({ table }) => (
              <Checkbox
                aria-label={{ jsx_attr("Select all") }}
                checked={table.getIsAllPageRowsSelected() || (table.getIsSomePageRowsSelected() && "indeterminate")}
                onCheckedChange={(value) => table.toggleAllPageRowsSelected(Boolean(value))}
              />
            ),
            cell: ({ row }) => (
              <Checkbox
                aria-label={{ jsx_attr("Select the row") }}
                checked={row.getIsSelected()}
                onCheckedChange={(value) => row.toggleSelected(Boolean(value))}
                onClick={(event) => event.stopPropagation()}
              />
            ),
            enableSorting: false,
            meta: { className: "w-10" },
          } satisfies ColumnDef<T>,
        ]
      : []),
    ...columns,
    ...(rowActions
      ? [
          {
            id: "actions",
            header: () => <span className="sr-only">{{ jsx_text("Actions") }}</span>,
            cell: ({ row }) => <div className="flex justify-end">{rowActions(row.original)}</div>,
            enableSorting: false,
            meta: { className: "w-12" },
          } satisfies ColumnDef<T>,
        ]
      : []),
  ];

{% if "scroll" in ui_views.features %}
  // The loaded pages of the server are one page of the table.
  const serverPage = server && scroll
    ? { pageIndex: 0, pageSize: Math.max(data.length, 1) }
    : server && { pageIndex: server.page - 1, pageSize: server.pageSize };
  const state = server && serverPage ? { sorting: server.sorting, pagination: serverPage } : { sorting, pagination };
{% else %}
  const state = server
    ? { sorting: server.sorting, pagination: { pageIndex: server.page - 1, pageSize: server.pageSize } }
    : { sorting, pagination };
{% endif %}
  const table = useReactTable({
    data,
    columns: allColumns,
    state: { ...state, rowSelection },
    getRowId: (row) => row.id,
    onSortingChange: server
      ? (update) => server.onChange({ page: 1, pageSize: server.pageSize, sorting: functionalUpdate(update, server.sorting) })
      : setSorting,
    onRowSelectionChange: setRowSelection,
    onPaginationChange: server
      ? (update) => {
          const next = functionalUpdate(update, state.pagination);
          server.onChange({ page: next.pageIndex + 1, pageSize: next.pageSize, sorting: server.sorting });
        }
      : setPagination,
    enableRowSelection: selection,
    autoResetPageIndex: false,
    manualSorting: server !== undefined,
    manualPagination: server !== undefined,
    rowCount: server?.total,
    getCoreRowModel: getCoreRowModel(),
    getSortedRowModel: getSortedRowModel(),
    getPaginationRowModel: getPaginationRowModel(),
  });

  const selected = table.getSelectedRowModel().rows.map((row) => row.original);
  const rows = table.getRowModel().rows;

  return (
    <div className="space-y-3">
      {selection && selected.length > 0 && bulkActions && (
        <div className="flex flex-wrap items-center gap-2 rounded-md border bg-muted/50 px-3 py-2 text-sm">
          <span className="font-medium tabular-nums">{{ jsx_format("{count} selected", count="selected.length") }}</span>
          <div className="ms-auto flex flex-wrap items-center gap-2">
            {bulkActions(selected, () => setRowSelection({}))}
            <Button variant="ghost" size="sm" onClick={() => setRowSelection({})}>
              {{ jsx_text("Clear the selection") }}
            </Button>
          </div>
        </div>
      )}
      <div className="overflow-hidden rounded-md border">
        <Table>
          <TableHeader className="bg-muted/40">
            {table.getHeaderGroups().map((group) => (
              <TableRow key={group.id}>
                {group.headers.map((header) => {
                  const meta = metaOf(header.column.columnDef.meta);
                  const sorted = header.column.getIsSorted();
                  const SortIcon = sorted === "asc" ? ArrowUpIcon : sorted === "desc" ? ArrowDownIcon : ChevronsUpDownIcon;
                  return (
                    <TableHead
                      key={header.id}
                      className={meta?.className}
                      style={meta?.width ? ({ width: meta.width } as CSSProperties) : undefined}
                      aria-sort={sorted === "asc" ? "ascending" : sorted === "desc" ? "descending" : undefined}
                    >
                      {header.isPlaceholder ? null : header.column.getCanSort() ? (
                        <Button
                          variant="ghost"
                          size="sm"
                          className="-mx-2 h-8 data-[state=open]:bg-accent"
                          onClick={header.column.getToggleSortingHandler()}
                        >
                          {flexRender(header.column.columnDef.header, header.getContext())}
                          <SortIcon className={cn("size-3.5", !sorted && "text-muted-foreground/60")} />
                        </Button>
                      ) : (
                        flexRender(header.column.columnDef.header, header.getContext())
                      )}
                    </TableHead>
                  );
                })}
              </TableRow>
            ))}
          </TableHeader>
          <TableBody>
            {rows.map((row) => (
              <TableRow
                key={row.id}
                data-state={row.getIsSelected() ? "selected" : undefined}
{% if order %}
                className={cn(
                  onRowClick && "cursor-pointer",
                  dragged === row.id && "opacity-50",
                  over === row.id && dragged !== row.id && "bg-primary/5 outline-2 -outline-offset-2 outline-primary",
                )}
{% else %}
                className={cn(onRowClick && "cursor-pointer")}
{% endif %}
                onClick={onRowClick ? () => onRowClick(row.original) : undefined}
{% if order %}
                draggable={movable}
                onDragStart={(event) => {
                  event.dataTransfer.setData("text/plain", row.id);
                  event.dataTransfer.effectAllowed = "move";
                  setDragged(row.id);
                }}
                onDragOver={(event) => {
                  if (dragged === null) return;
                  event.preventDefault();
                  setOver(row.id);
                }}
                onDrop={(event) => {
                  event.preventDefault();
                  if (dragged !== null && dragged !== row.id) onMove?.(dragged, row.id);
                  endDrag();
                }}
                onDragEnd={endDrag}
{% endif %}
              >
                {row.getVisibleCells().map((cell) => (
                  <TableCell key={cell.id} className={metaOf(cell.column.columnDef.meta)?.className}>
                    {flexRender(cell.column.columnDef.cell, cell.getContext())}
                  </TableCell>
                ))}
              </TableRow>
            ))}
          </TableBody>
        </Table>
      </div>
{% if "scroll" in ui_views.features %}
      {scroll ? (
        <ScrollMore
          count={rows.length}
          total={server?.total ?? data.length}
          loading={scroll !== true && scroll.loading}
          onMore={scroll === true ? () => setPagination((value) => ({ pageIndex: 0, pageSize: value.pageSize + pageSize })) : scroll.onMore}
        />
      ) : (
{% endif %}
      <ListPagination
        page={state.pagination.pageIndex + 1}
        pageCount={Math.max(1, table.getPageCount())}
        pageSize={state.pagination.pageSize}
        pageSizes={pageSizes}
        total={server?.total ?? data.length}
        onPageChange={(page) => table.setPageIndex(page - 1)}
        onPageSizeChange={(size) => table.setPagination({ pageIndex: 0, pageSize: size })}
      />
{% if "scroll" in ui_views.features %}
      )}
{% endif %}
    </div>
  );
}
