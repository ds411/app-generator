{% set plan = ui_views.api_view_plan(name) %}
{% set development = 'process.env.NODE_ENV === "development"' if binding.name == "nextjs" else "import.meta.env.DEV" %}
{{ trace_header(*plan.element_ids()) }}
/*
 * The view `{{ name }}` shows the answer of the operation
 * `{{ plan.method.operation_id }}` of the API `{{ plan.api.name }}`.
 * {{ ("The API %s, so this app has no client for the API." | format(plan.api.server_reason)) | wordwrap(73, break_long_words=False, wrapstring="\n * ", break_on_hyphens=False) }}
 *
 * TODO(appgen): set `expose: true` on the API: then appgen generates the
 * view, and with `x-react-data: api` in the section `app`, the FastAPI
 * app of the same definition calls the API for this app. Or write the
 * view here.
 * When it is done, change the kind of the traces in the header from gap to manual.
 */
{% if plan.props %}

export type {{ name | pascal }}ViewProps = {
  /** The path parameters of the page, for the parameters of the operation. */
  route: Record<string, string | undefined>;
};
{% endif %}

export function {{ name | pascal }}View({% if plan.props %}_props: {{ name | pascal }}ViewProps{% endif %}) {
  return (
    <div role="note" className="rounded-md border border-dashed p-4 text-sm wrap-anywhere text-muted-foreground">
{% if i18n %}
      {{ "{" ~ development ~ " ? " ~ js_format("Not implemented yet: {element}", element=js(element_id)) ~ " : " ~ tr(js("Not available yet.")) ~ "}" }}
{% else %}
      {{ "{" ~ development ~ " ? " }}"Not implemented yet: {{ element_id }}" : "Not available yet."{{ "}" }}
{% endif %}
    </div>
  );
}
