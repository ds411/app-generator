{% import "ui/views/macros.j2" as m with context %}
{% set plan = ui_views.detail_plan(name) %}
{% set view = plan.view %}
{% set code = plan.code() %}
{% set uses_lookups = "lookups." in code %}
{% set action_lookups = "lookups." in (plan.actions | map(attribute="href") | select | join(" ")) %}
{% set gaps = plan.sections | map(attribute="gap") | select | list %}
{% for tab in plan.tabs %}{% set gaps = gaps + ([tab.gap] if tab.gap else []) + (tab.sections | map(attribute="gap") | select | list) %}{% endfor %}
{% set cards = (plan.sections + (plan.tabs | map(attribute="sections") | sum(start=[]))) %}
{% set titled = cards | selectattr("title") | list %}
{% set described = cards | selectattr("description") | list %}
{{ trace_header(element_id) }}
"use client";

{% macro section(s, indent) -%}
{% filter indent(indent, true) %}
<Card> {{ trace(s.element_id, jsx=True) }}
{% if s.title or s.description %}
  <CardHeader>
{% if s.title %}
    <CardTitle>{{ jsx_text(s.title) }}</CardTitle>
{% endif %}
{% if s.description %}
    <CardDescription>{{ jsx_text(s.description) }}</CardDescription>
{% endif %}
  </CardHeader>
{% endif %}
  <CardContent>
{% if s.gap %}
    <{{ s.gap.name }} record={record} />
{% else %}
    <dl className={{ js(s.grid) }}>
{% for field_label, jsx in s.fields %}
      <div className="min-w-0 space-y-1">
        <dt className="text-sm text-muted-foreground">{{ jsx_text(field_label) }}</dt>
        <dd className="break-words">{{ jsx }}</dd>
      </div>
{% endfor %}
    </dl>
{% endif %}
  </CardContent>
</Card>
{%- endfilter %}
{%- endmacro %}
{% set ns = namespace(icons=[]) %}
{% for icon in plan.icons %}{% set ns.icons = ns.icons + [(icon | pascal) ~ "Icon"] %}{% endfor %}
{% if ns.icons %}
import { {{ ns.icons | unique | sort | join(", ") }} } from "lucide-react";
{% endif %}
{% if plan.forms %}
import { useState } from "react";
{% endif %}

{% if plan.related and plan.lookups %}
import { loadRelated, NotFoundError, type RelatedStep } from "@/shared/api";
{% else %}
import { NotFoundError } from "@/shared/api";
{% endif %}
{% for entity, entity_names in plan.entity_imports() %}
import { {{ entity_names | join(", ") }} } from "@/entities/{{ entity | kebab }}";
{% endfor %}
{% for line in plan.imports %}
{{ line }}
{% endfor %}
{% if "badges." in code %}
import { badges } from "@/shared/config/badges";
{% endif %}
{% if "compute." in code %}
import { compute } from "@/shared/lib/compute";
{% endif %}
{% if plan.needs("formatValue") %}
import { formatValue } from "@/shared/lib/format";
{% endif %}
{% if plan.needs("pageHref") %}
import { pageHref } from "@/shared/lib/pages";
{% endif %}
{% if plan.lookups and plan.related is none %}
import { byId } from "@/shared/lib/query";
{% endif %}
import { useResource } from "@/shared/lib/use-resource";
{% if plan.actions %}
import { ActionButton, type ActionSpec, useActionRunner } from "@/shared/ui/actions";
{% endif %}
{% if cards %}
{% set card_names = ["Card", "CardContent"] + (["CardHeader"] if titled or described else []) + (["CardTitle"] if titled else []) + (["CardDescription"] if described else []) %}
import { {{ card_names | sort | join(", ") }} } from "@/shared/ui/card";
{% endif %}
{% if plan.tabs %}
import { Tabs, TabsContent, TabsList, TabsTrigger } from "@/shared/ui/tabs";
{% endif %}
{% if "avatar" in plan.uses %}
import { AvatarValue } from "@/shared/ui/values/avatar-value";
{% endif %}
{% if "badge" in plan.uses %}
import { BadgeValue } from "@/shared/ui/values/badge-value";
{% endif %}
{% if "formatted" in plan.uses %}
import { FormattedValue } from "@/shared/ui/values/formatted-value";
{% endif %}
{% set file_names = (["FileLink"] if "<FileLink" in code else []) + (["ImageValue"] if "<ImageValue" in code else []) %}
{% if file_names %}
import { {{ file_names | join(", ") }} } from "@/shared/ui/values/file-value";
{% endif %}
{% for f in plan.forms %}
import { {{ f.component }}Dialog } from "{{ f.module }}";
{% endfor %}
{% if plan.forms | selectattr("route_params") | list %}
import { useParams } from "@/shared/lib/router";
{% endif %}
{% set state = ["ViewLoading", "ViewMessage"] %}
{% if plan.states.error.action == "retry" %}{% set state = state + ["RetryButton"] %}{% endif %}
import { {{ state | join(", ") }} } from "@/shared/ui/view-state";

{% if plan.lookups %}
type Lookups = {
{% for entity in plan.lookups %}
  {{ entity | camel }}: Map<string, {{ entity | pascal }}>;
{% endfor %}
};

type ViewData = { record: {{ plan.type }}; lookups: Lookups };
{% else %}
type ViewData = { record: {{ plan.type }} };
{% endif %}

{% if plan.related and plan.lookups %}
{{ m.related_steps(plan.related) }}

/** Read the record, and the related records that it shows: the records of their IDs. */
async function load(id: string): Promise<ViewData> {
  const record = await {{ plan.var }}Api.get(id);
  return { record, lookups: (await loadRelated([record], RELATED)) as Lookups };
{% else %}
/** Read the record{% if plan.lookups %}, and the related records that its fields show{% endif %}. */
async function load(id: string): Promise<ViewData> {
{% endif %}
{% if plan.related and plan.lookups %}
{% elif plan.lookups %}
  const [record, {% for entity in plan.lookups %}{{ entity | camel }}List{{ ", " if not loop.last }}{% endfor %}] = await Promise.all([
    {{ plan.var }}Api.get(id),
{% for entity in plan.lookups %}
    {{ entity | camel }}Api.list(),
{% endfor %}
  ]);
  return {
    record,
    lookups: { {% for entity in plan.lookups %}{{ entity | camel }}: byId({{ entity | camel }}List.items){{ ", " if not loop.last }}{% endfor %} },
  };
{% else %}
  return { record: await {{ plan.var }}Api.get(id) };
{% endif %}
}

/** Load the data again after a change of the records. */
function subscribe(listener: () => void): () => void {
  const stops = [{% for entity in ([plan.entity] + plan.lookups) | unique %}{{ entity | camel }}Api.subscribe(listener){{ ", " if not loop.last }}{% endfor %}];
  return () => stops.forEach((stop) => stop());
}
{% for tab in plan.tabs if tab.history %}
{% if tab.history.fields %}

/** The fields of the change log of the tab {{ tab.label }} (ADR 0040), by name. */
function {{ tab.name | camel }}Fields(): Record<string, HistoryField> {
  return {
{% for f in tab.history.fields %}
    {{ f.key }}: { label: {{ tr(js(f.label)) }}{% if f.format != "text" %}, format: {{ js(f.format) }}{% endif %}{% if f.currency %}, currency: {{ js(f.currency) }}{% endif %} },
{% endfor %}
  };
}
{% endif %}
{% if tab.history.records %}

/** The display values of the related records of the change log of the tab {{ tab.label }}. */
const {{ tab.name | camel }}Records = {
{% for r in tab.history.records %}
  {{ r.key }}: async (id: string) => {
    const item = await {{ r.target | camel }}Api.get(id);
    return {{ r.text }};
  },
{% endfor %}
};
{% endif %}
{% endfor %}
{% if plan.actions %}

{{ m.action_group("viewActions", plan.actions, plan.type) }}
{% endif %}

export type {{ name | pascal }}ViewProps = {
  /** The ID of the record. */
  id: string;
};

{% if view.title %}
/** {{ view.title }}{% if view.description %}: {{ view.description }}{% endif %} */
{% endif %}
export function {{ name | pascal }}View({ id }: {{ name | pascal }}ViewProps) {
  const resource = useResource(`{{ name }}:${id}`, () => load(id), subscribe);
{% if plan.actions %}
{{ m.runner(plan) }}
{% endif %}

  if (resource.status === "error" && resource.error instanceof NotFoundError) {
    return (
{{ m.empty_state(plan) }}
    );
  }
{{ m.states(plan, "detail") }}

  const { record{% if uses_lookups or action_lookups %}, lookups{% endif %} } = resource.data;
{% if action_lookups %}
  const viewActions = viewActionsFor(lookups);
{% endif %}
  return (
    <div className="space-y-6">
      <div className="flex flex-wrap items-start justify-between gap-4">{% if view.header %} {{ trace(view.header.id, jsx=True) }}{% endif %}

        <div className="min-w-0 space-y-2">
          <h1 className="{{ ui_plan.text_class('heading', 'text-2xl font-semibold tracking-tight') }}">{{ plan.title }}</h1>
{% if plan.subtitle %}
          <div className="text-muted-foreground">{{ plan.subtitle }}</div>
{% endif %}
{% if plan.badges %}
          <div className="flex flex-wrap items-center gap-2">
{% for badge in plan.badges %}
            {{ badge }}
{% endfor %}
          </div>
{% endif %}
        </div>
{% if plan.actions %}
        <div className="flex flex-wrap items-center gap-2">
          {Object.values(viewActions).map((action) => (
            <ActionButton key={action.key} action={action} records={[record]} onRun={run} />
          ))}
        </div>
{% endif %}
      </div>
{% for s in plan.sections %}
{{ section(s, 6) }}
{% endfor %}
{% if plan.tabs %}
      <Tabs defaultValue={{ js(plan.tabs[0].name) }}>
        <TabsList className="max-w-full justify-start overflow-x-auto">
{% for tab in plan.tabs %}
          <TabsTrigger value={{ js(tab.name) }}>
{% if tab.icon %}
            <{{ tab.icon | pascal }}Icon />
{% endif %}
            {{ jsx_text(tab.label) }}
          </TabsTrigger>
{% endfor %}
        </TabsList>
{% for tab in plan.tabs %}
        <TabsContent value={{ js(tab.name) }} className="space-y-4"> {{ trace(tab.element_id, jsx=True) }}
{% if tab.gap %}
          <{{ tab.gap.name }} record={record} />
{% elif tab.history %}
          <HistoryList
            history={ {{- tab.history.api -}} }
            id={record.id}
            fields={ {{- (tab.name | camel) ~ "Fields()" if tab.history.fields else "{}" -}} }
{% if tab.history.records %}
            records={ {{- tab.name | camel -}} Records}
{% endif %}
{% if tab.history.restore %}
            restore={{ js(tab.history.restore) }}
{% endif %}
            subscribe={subscribe}
          />
{% elif tab.view %}
{% if tab.params %}
          <{{ tab.view | pascal }}View params={ {{- tab.params -}} } />
{% else %}
          <{{ tab.view | pascal }}View where={(row) => {{ tab.where }}} />
{% endif %}
{% endif %}
{% for s in tab.sections %}
{{ section(s, 10) }}
{% endfor %}
        </TabsContent>
{% endfor %}
      </Tabs>
{% endif %}
{% if plan.actions %}
      {dialog}
{{ m.form_dialogs(plan) }}
{% endif %}
    </div>
  );
}
