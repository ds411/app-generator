// The checks of the forms: the messages of the zod issues, and the rules
// that compare two fields.
import type { z } from "zod";

/** The messages of a form, by field key. The key `_form` is for the whole form. */
export type FormErrors = Record<string, string>;

export type CompareOp = "eq" | "ne" | "lt" | "lte" | "gt" | "gte";

function isEmpty(value: unknown): boolean {
  return value === null || value === undefined || value === "" || (Array.isArray(value) && value.length === 0);
}

/** Return true if two values pass a compare rule. An empty value passes. */
export function compareRule(a: unknown, op: CompareOp, b: unknown): boolean {
  if (isEmpty(a) || isEmpty(b)) return true;
  const order =
    typeof a === "number" && typeof b === "number" ? a - b : String(a).localeCompare(String(b), undefined, { numeric: true });
  switch (op) {
    case "eq":
      return order === 0;
    case "ne":
      return order !== 0;
    case "lt":
      return order < 0;
    case "lte":
      return order <= 0;
    case "gt":
      return order > 0;
    case "gte":
      return order >= 0;
  }
}

/** Return a message for a zod issue, in the words of the forms. */
export function issueMessage(issue: z.core.$ZodIssue): string {
  switch (issue.code) {
    case "too_small":
      return issue.origin === "string"
        ? {{ js_format("Use {count} or more characters.", count="String(issue.minimum)") }}
        : {{ js_format("Use {count} or more.", count="String(issue.minimum)") }};
    case "too_big":
      return issue.origin === "string"
        ? {{ js_format("Use {count} or fewer characters.", count="String(issue.maximum)") }}
        : {{ js_format("Use {count} or less.", count="String(issue.maximum)") }};
    case "invalid_format":
      if (issue.format === "email") return {{ tr(js("Enter a valid email address.")) }};
      if (issue.format === "url") return {{ tr(js("Enter a valid URL.")) }};
      if (issue.format === "uuid") return {{ tr(js("Select a value.")) }};
      return {{ tr(js("Use the correct format.")) }};
    case "invalid_value":
      return {{ tr(js("Select a value.")) }};
    case "invalid_type":
      return issue.expected === "int" ? {{ tr(js("Enter a whole number.")) }} : {{ tr(js("Enter a value.")) }};
    default:
      return {{ tr("issue.message") }};
  }
}

{% if i18n and i18n.translatable %}
/**
 * Return the key of the message of a zod issue: the field, or the field
 * and the language of a value of a translatable field, for example
 * `titleTranslations.de` (ADR 0026).
 */
function issueKey(path: readonly PropertyKey[]): string {
  if (path.length === 0) return "_form";
  const key = String(path[0]);
  return key.endsWith("Translations") && path.length > 1 ? `${key}.${String(path[1])}` : key;
}

/**
 * Add the messages of a zod error to the form errors. A field keeps its
 * first message. `at` is the place of a row of a lines editor, for
 * example `lines.2`: the keys start with it.
 */
export function schemaErrors(error: z.ZodError, errors: FormErrors, at?: string): void {
  for (const issue of error.issues) {
    const key = issueKey(issue.path);
    const place = at === undefined ? key : key === "_form" ? at : `${at}.${key}`;
    errors[place] ??= issueMessage(issue);
  }
}
{% else %}
/**
 * Add the messages of a zod error to the form errors. A field keeps its
 * first message. `at` is the place of a row of a lines editor, for
 * example `lines.2`: the keys start with it.
 */
export function schemaErrors(error: z.ZodError, errors: FormErrors, at?: string): void {
  for (const issue of error.issues) {
    const key = issue.path.length > 0 ? String(issue.path[0]) : "_form";
    const place = at === undefined ? key : key === "_form" ? at : `${at}.${key}`;
    errors[place] ??= issueMessage(issue);
  }
}
{% endif %}

/**
 * Return the form errors of an error of a submit. A server error with
 * issues (for example a `ValidationError` of a server action) puts each
 * message on its field.{% if ui_forms.lines %} An issue of a line of a lines editor (`lines`)
 * keeps its place, for example `lines.2.amount` (ADR 0035).{% endif %}

 */
{% if ui_forms.lines %}
export function submitErrors(error: unknown, lines: readonly string[] = []): FormErrors {
{% else %}
export function submitErrors(error: unknown): FormErrors {
{% endif %}
  const message = error instanceof Error ? {{ tr("error.message") }} : {{ tr(js("The form did not save.")) }};
  const errors: FormErrors = { _form: message };
  const issues: unknown = error instanceof Error && "issues" in error ? error.issues : undefined;
  if (Array.isArray(issues)) {
    for (const issue of issues as { path?: unknown; message?: unknown }[]) {
      if (typeof issue.path !== "string" || typeof issue.message !== "string") continue;
{% if ui_forms.lines %}
      const first = issue.path.split(".")[0] ?? "";
      const key = lines.includes(first) ? issue.path : first || "_form";
{% else %}
      const key = issue.path.split(".")[0] || "_form";
{% endif %}
      if (key !== "_form") errors[key] ??= {{ tr("issue.message") }};
    }
  }
  return errors;
}
