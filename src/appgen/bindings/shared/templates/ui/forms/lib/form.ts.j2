/** A condition of the filter of a total: the key of a value, an operator, and an operand. */
export type TotalCondition = readonly [key: string, op: string, operand: unknown];

/** Return true if a value passes a condition of a filter, as the filters of the back ends do. */
function passes(value: unknown, op: string, operand: unknown): boolean {
  const actual = value ?? null;
  switch (op) {
    case "eq":
      return actual === operand;
    case "ne":
      return actual !== operand;
    case "in":
      return Array.isArray(operand) && operand.includes(actual);
    case "not_in":
      return !Array.isArray(operand) || !operand.includes(actual);
  }
  if (actual === null || operand === null) return false;
  const a = actual as number | string;
  const b = operand as number | string;
  switch (op) {
    case "lt":
      return a < b;
    case "lte":
      return a <= b;
    case "gt":
      return a > b;
    default:
      return a >= b;
  }
}

/**
 * Return a total of the lines of a form, before the save (ADR 0034): the
 * count of the lines, or the sum, the average, the smallest, or the
 * largest value of a number field. The conditions filter the lines. The
 * count and the sum of no lines are 0, the others null.
 */
export function linesTotal(
  fn: "count" | "sum" | "avg" | "min" | "max",
  lines: readonly Record<string, unknown>[],
  field: string | null,
  conditions: readonly TotalCondition[] = [],
): number | null {
  const kept = lines.filter((line) => conditions.every(([key, op, operand]) => passes(line[key], op, operand)));
  if (fn === "count") return kept.length;
  const numbers = kept.flatMap((line) => {
    const value = line[field ?? ""];
    return typeof value === "number" && Number.isFinite(value) ? [value] : [];
  });
  if (fn === "sum") return numbers.reduce((total, value) => total + value, 0);
  if (numbers.length === 0) return null;
  if (fn === "avg") return numbers.reduce((total, value) => total + value, 0) / numbers.length;
  return fn === "min" ? Math.min(...numbers) : Math.max(...numbers);
}
