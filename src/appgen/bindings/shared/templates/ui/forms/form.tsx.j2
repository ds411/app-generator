export function {{ c }}(props: {{ c }}Props) {
  // The form edits the lines of the record, so it reads them first (ADR 0035).
  const id = props.record?.id;
  const lines = useResource(`{{ name }}_form_lines:${id ?? ""}`, () => loadLines(id));
  if (lines.status === "loading") {
    return (
      <div role="status" className="flex items-center gap-2 py-8 text-sm text-muted-foreground">
        <Spinner />
        {{ jsx_text("Loading") }}
      </div>
    );
  }
  if (lines.status === "error") {
    return (
      <p role="alert" className="py-8 text-sm text-destructive">
        {{ jsx_text("The lines did not load.") }}
      </p>
    );
  }
  return <{{ c }}Body {...props} lines={lines.data} />;
}

