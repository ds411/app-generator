function {{ c }}Body({ {{ "record, " if uses_record }}routeParams, onSuccess, onCancel, lines }: {{ c }}Props & { lines: Lines }) {
{% else %}
export function {{ c }}({ {{ "record, " if uses_record }}routeParams, onSuccess, onCancel }: {{ c }}Props) {
{% endif %}
{% if plan.navigate %}
  const navigate = useNavigate();
{% endif %}
{% if plan.lookups %}
