/** Read the lines of the record. Without a record, there are no lines. */
async function loadLines(id: string | undefined): Promise<Lines> {
  if (id === undefined) return { {% for f in editors %}{{ f.key }}: []{{ ", " if not loop.last }}{% endfor %} };
  const [{% for f in editors %}{{ f.key }}{{ ", " if not loop.last }}{% endfor %}] = await Promise.all([
{% for f in editors %}
    {{ f.lines.item.list_function }}(id, { pageSize: 1000 }),
{% endfor %}
  ]);
  return { {% for f in editors %}{{ f.key }}: {{ f.key }}.items{{ ", " if not loop.last }}{% endfor %} };
}
{% endif %}
{% if editors %}

