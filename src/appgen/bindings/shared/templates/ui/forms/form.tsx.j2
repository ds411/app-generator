{% if plan.scoped %}
  // A user of a record rule owns the record, and does not choose the owner
  // and the values that the rule sets (ADR 0018, ADR 0025).
  const scope = useAccess().scopeOf({{ js(plan.entity) }});
{% endif %}
{% if plan.me %}
