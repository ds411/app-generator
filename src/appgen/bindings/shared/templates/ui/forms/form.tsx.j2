/** Return a new row of the lines editor {{ f.label }}, with the defaults of the fields. */
function new{{ p }}Row(): {{ row }} {
  rowCount += 1;
  return { key: `new-${rowCount}`{% for c in f.lines.columns %}, {{ c.key }}: {{ c.initial }}{% endfor %} };
