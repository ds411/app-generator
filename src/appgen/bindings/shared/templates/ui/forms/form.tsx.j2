{% for f in editors %}
{% set p = f.key | pascal %}
{% set row = f.lines.row_type %}

  const change{{ p }}Row = <K extends keyof {{ row }}>(index: number, key: K, value: {{ row }}[K]) =>
    change({{ js(f.key) }}, values.{{ f.key }}.map((line, at) => (at === index ? { ...line, [key]: value } : line)));
  const add{{ p }}Row = () => change({{ js(f.key) }}, [...values.{{ f.key }}, new{{ p }}Row()]);
  const remove{{ p }}Row = (index: number) => change({{ js(f.key) }}, values.{{ f.key }}.filter((_, at) => at !== index));
{% endfor %}
{% if plan.previews %}

  // The record as the form saves it, with the totals of its lines (ADR 0034).
  const preview = {
    ...{{ plan.entity | camel }}Defaults,
{% if plan.kind == "update" %}
    ...record,
{% endif %}
    ...toInput(values),
{% for total in plan.totals %}
    {{ total.key }}: {{ total.code }},
{% endfor %}
  };
{% endif %}

