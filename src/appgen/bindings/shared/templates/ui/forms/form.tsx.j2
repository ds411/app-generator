{% elif f.kind in ("many", "lines") %}
  if (values.{{ f.key }}.length === 0) errors.{{ f.key }} ??= {{ tr(js(f.required_message)) }};{% if f.required_id %} {{ trace(f.required_id) }}{% endif %}

{% else %}
  if (values.{{ f.key }} === null) errors.{{ f.key }} ??= {{ tr(js(f.required_message)) }};{% if f.required_id %} {{ trace(f.required_id) }}{% endif %}

{% endif %}
{% endif %}
{% if f.rules_id %}
  {{ trace(f.rules_id) }}
{% endif %}
{% for check in f.checks %}
  if ({{ check.condition }}) errors.{{ f.key }} ??= {{ tr(js(check.message)) }}; {{ trace(check.element_id) }}
{% endfor %}
{% endfor %}
{% for f in editors %}
  const {{ f.key }} = values.{{ f.key }}.flatMap((line, index) => {
{% for c in f.lines.columns if c.required and c.kind != "boolean" %}
{% set at = "errors[`" ~ f.key ~ ".${index}." ~ c.key ~ "`]" %}
{% if c.kind in ("text", "json") %}
    if (line.{{ c.key }}.trim() === "") {{ at }} ??= {{ tr(js(c.required_message)) }};
{% elif c.kind == "many" %}
    if (line.{{ c.key }}.length === 0) {{ at }} ??= {{ tr(js(c.required_message)) }};
{% else %}
    if (line.{{ c.key }} === null) {{ at }} ??= {{ tr(js(c.required_message)) }};
{% endif %}
{% endfor %}
    const parsed = {{ f.lines.item.schema }}.safeParse({{ f.key }}Item(line));
    if (parsed.success) return [parsed.data];
    schemaErrors(parsed.error, errors, `{{ f.key }}.${index}`);
    return [];
  });
{% endfor %}
  const result = SCHEMA.safeParse(toInput(values));
  if (!result.success) schemaErrors(result.error, errors);
{% for rule in plan.rules if rule.condition %}
  if ({{ rule.condition }}) errors.{{ rule.fields[0] }} ??= {{ tr(js(rule.message)) }}; {{ trace(rule.element_id) }}
{% endfor %}
  if (!result.success || Object.keys(errors).length > 0) return { errors };
{% for rule in plan.rules if rule.gap_name %}
  if (!{{ rule.gap_name }}(result.data as {{ plan.rule_values }})) { {{ trace(rule.element_id) }}
{% if rule.fields %}
{% for key in rule.fields %}
    errors.{{ key }} ??= {{ tr(js(rule.message)) }};
{% endfor %}
{% else %}
    errors._form ??= {{ tr(js(rule.message)) }};
{% endif %}
  }
{% endfor %}
{% if plan.rules | selectattr("gap_name") | list %}
  if (Object.keys(errors).length > 0) return { errors };
{% endif %}
  return { input: result.data, {{ "lines: { " ~ (editors | map(attribute="key") | join(", ")) ~ " }, " if editors }}errors };
}

