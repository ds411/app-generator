    ...(line.id === undefined ? {} : { id: line.id }),
{% for c in f.lines.columns %}
    {{ c.key }}: {{ c.to_input }},
{% endfor %}
  };
}
{% if f.key in plan.previews | map(attribute="lines") | sum(start=[]) %}

/** Return the lines of the rows for the totals: the defaults of the fields, and the values of each row. */
