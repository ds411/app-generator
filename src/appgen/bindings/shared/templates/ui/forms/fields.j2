{#-
  The widgets and the fields of the forms. A form (form.tsx.j2) and the
  sign-up form use them. The component of the form has `values`,
  `errors`, `busy`, and `change`. `prefix` starts the IDs of the widgets.
-#}
{#- The widget of a field. In a row of a lines editor `row` (ADR 0035), the
  widget edits the value of the row `line` at `index`. #}
{% macro widget(f, prefix, row=none) -%}
{% if row is none %}
{% set id = '"' ~ (prefix | kebab) ~ "-" ~ (f.name | kebab) ~ '"' %}
{% set invalid = "Boolean(errors." ~ f.key ~ ")" %}
{% set value = "values." ~ f.key %}
{% set on_change = "change(" ~ js(f.key) ~ ", " %}
{% set value_type = "Values[" ~ js(f.key) ~ "]" %}
{% else %}
{% set id = "{`" ~ (prefix | kebab) ~ "-" ~ (row.name | kebab) ~ "-${index}-" ~ (f.name | kebab) ~ "`}" %}
{% set invalid = "Boolean(errors[`" ~ row.key ~ ".${index}." ~ f.key ~ "`])" %}
{% set value = "line." ~ f.key %}
{% set on_change = "change" ~ (row.key | pascal) ~ "Row(index, " ~ js(f.key) ~ ", " %}
{% set value_type = row.lines.row_type ~ "[" ~ js(f.key) ~ "]" %}
{% endif %}
{% set placeholder = (" placeholder=" ~ jsx_attr(f.placeholder)) if f.placeholder else "" %}
{% set options = f.options_const if not f.target else (f.options or "") | replace("lookups.", "related.") %}
{% set choices = ("source={" ~ f.source ~ "}") if f.source else ("options={" ~ options ~ "}") %}
{% if f.widget == "custom" %}
<{{ f.gap_name }} id={{ id }} value={ {{- value }}} onChange={(value) => {{ on_change }}value ?? {{ f.empty }})} disabled={busy} />
{%- elif f.kind == "file" %}
<FileInput id={{ id }} value={ {{- value }}} onChange={(value) => {{ on_change }}value)} rule={ {{- f.key | snake | upper }}_FILE_RULE} disabled={busy} invalid={ {{- invalid }}} />
{%- elif f.kind == "many" %}
<RelationMultiSelect id={{ id }}{{ placeholder }} {{ choices }} value={ {{- value }}} onChange={(value) => {{ on_change }}value)} disabled={busy} invalid={ {{- invalid }}} />
{%- elif f.kind == "one" and f.widget != "select" and f.widget != "radio" %}
<RelationSelect id={{ id }}{{ placeholder }} {{ choices }} value={ {{- value }}} onChange={(value) => {{ on_change }}value)}{% if not f.required %} clearable{% endif %} disabled={busy} invalid={ {{- invalid }}} />
{%- elif f.widget == "select" %}
<OptionSelect id={{ id }}{{ placeholder }} options={ {{- options }}} value={ {{- value }}} onChange={(value) => {{ on_change }}value as {{ value_type }})}{% if not f.required %} clearable{% endif %} disabled={busy} invalid={ {{- invalid }}} />
{%- elif f.widget == "radio" %}
<OptionRadio id={{ id }} options={ {{- options }}} value={ {{- value }}} onChange={(value) => {{ on_change }}value as {{ value_type }})} disabled={busy} invalid={ {{- invalid }}} />
{%- elif f.widget == "checkbox" %}
<Checkbox id={{ id }} checked={ {{- value }}} onCheckedChange={(value) => {{ on_change }}value === true)} disabled={busy} aria-invalid={ {{- invalid }}} />
{%- elif f.widget == "switch" %}
<Switch id={{ id }} checked={ {{- value }}} onCheckedChange={(value) => {{ on_change }}value)} disabled={busy} aria-invalid={ {{- invalid }}} />
{%- elif f.widget == "date" %}
<DateInput id={{ id }}{{ placeholder }} value={ {{- value }}} onChange={(value) => {{ on_change }}value)} disabled={busy} invalid={ {{- invalid }}} />
{%- elif f.widget == "datetime" %}
<DateTimeInput id={{ id }}{{ placeholder }} value={ {{- value }}} onChange={(value) => {{ on_change }}value)} disabled={busy} invalid={ {{- invalid }}} />
{%- elif f.widget == "textarea" %}
<Textarea id={{ id }}{{ placeholder }}{% if f.rows %} rows={ {{- f.rows }}}{% endif %} value={ {{- value }}} onChange={(event) => {{ on_change }}event.target.value)} disabled={busy} aria-invalid={ {{- invalid }}} />
{%- elif f.format %}
<NumberInput id={{ id }} format={{ js(f.format) }}{% if f.currency_expr %} currency={ {{- f.currency_expr }}}{% elif f.currency %} currency={{ js(f.currency) }}{% endif %}{{ placeholder }}{% if f.step %} step={ {{- f.step }}}{% endif %} value={ {{- value }}} onChange={(value) => {{ on_change }}value)} disabled={busy} invalid={ {{- invalid }}} />
{%- elif f.widget == "number" or f.kind == "number" %}
<Input id={{ id }} type="number" inputMode="decimal"{{ placeholder }}{% if f.step %} step={ {{- f.step }}}{% endif %} value={ {{- value }} ?? ""} onChange={(event) => {{ on_change }}event.target.value === "" ? null : Number(event.target.value))} disabled={busy} aria-invalid={ {{- invalid }}} />
{%- else %}
<Input id={{ id }} type={{ js(f.input_type) }}{{ placeholder }} value={ {{- value }}} onChange={(event) => {{ on_change }}event.target.value)} disabled={busy} aria-invalid={ {{- invalid }}} />
{%- endif %}
{%- endmacro %}

{% macro field(f, indent, prefix, previews=[]) -%}
{% if f.lines %}
{{ lines(f, indent, prefix, previews) }}
{%- else %}
{% set id = (prefix | kebab) ~ "-" ~ (f.name | kebab) %}
{% set horizontal = f.widget in ("checkbox", "switch") %}
{% filter indent(indent, true) %}
<Field{% if horizontal %} orientation="horizontal"{% endif %} data-invalid={Boolean(errors.{{ f.key }})}{% if f.classes %} className={{ js(f.classes) }}{% endif %}> {{ trace(f.element_id, jsx=True) }}
{% if horizontal %}
  {{ widget(f, prefix) }}
  <FieldLabel htmlFor={{ js(id) }}>{{ jsx_text(f.label) }}</FieldLabel>
{% else %}
  <FieldLabel htmlFor={{ js(id) }}>
{% if f.languages %}
    {{ jsx_format("{field} ({language})", field=tr(js(f.label)), language=js(i18n.languages[0].label)) }}
{% else %}
    {{ jsx_text(f.label) }}
{% endif %}
{% if f.required and f.kind != "boolean" %}
    <span aria-hidden className="text-destructive">*</span>
{% endif %}
  </FieldLabel>
  {{ widget(f, prefix) }}
{% endif %}
{% if f.help %}
  <FieldDescription>{{ jsx_text(f.help) }}</FieldDescription>
{% endif %}
  <FieldError>{errors.{{ f.key }}}</FieldError>
</Field>
{% endfilter %}
{%- endif %}
{%- endmacro %}

{#- A lines editor (ADR 0035): a table with a row for each line, a column
  for each field of the lines, and the totals of the lines before the save. #}
{% macro lines(f, indent, prefix, previews) -%}
{% set p = f.key | pascal %}
{% set id = (prefix | kebab) ~ "-" ~ (f.name | kebab) %}
{% set columns = f.lines.columns %}
{% filter indent(indent, true) %}
<FieldSet data-invalid={Boolean(errors.{{ f.key }})}{% if f.classes %} className={{ js(f.classes) }}{% endif %}> {{ trace(f.element_id, jsx=True) }}
  <FieldLegend variant="label">{{ jsx_text(f.label) }}</FieldLegend>
{% if f.help %}
  <FieldDescription>{{ jsx_text(f.help) }}</FieldDescription>
{% endif %}
  <div className="overflow-x-auto rounded-md border">
    <table className="w-full text-sm">
      <thead>
        <tr className="border-b bg-muted/50 text-start">
{% for c in columns %}
          <th scope="col" className="px-2 py-1.5 font-medium"> {{ trace(c.element_id, jsx=True) }}
            {{ jsx_text(c.label) }}
{% if c.required and c.kind != "boolean" %}
            <span aria-hidden className="text-destructive">*</span>
{% endif %}
          </th>
{% endfor %}
          <th scope="col" className="w-12 px-2 py-1.5">
            <span className="sr-only">{{ jsx_text("Actions") }}</span>
          </th>
        </tr>
      </thead>
      <tbody>
        {values.{{ f.key }}.length === 0 && (
          <tr>
            <td colSpan={ {{- columns | length + 1 }}} className="px-2 py-3 text-center text-muted-foreground">
              {{ jsx_text("No lines yet.") }}
            </td>
          </tr>
        )}
        {values.{{ f.key }}.map((line, index) => (
          <tr key={line.key} className="border-b align-top last:border-0">
{% for c in columns %}
            <td className="p-1.5">
              <label htmlFor={`{{ id }}-${index}-{{ c.name | kebab }}`} className="sr-only">
                {{ jsx_format("{field}, line {number}", field=tr(js(c.label)), number="index + 1") }}
              </label>
              {{ widget(c, prefix, f) }}
              <FieldError>{errors[`{{ f.key }}.${index}.{{ c.key }}`]}</FieldError>
            </td>
{% endfor %}
            <td className="p-1.5 text-end">
              <Button type="button" variant="ghost" size="icon" aria-label={ {{- js_format("Remove line {number}", number="index + 1") }}} onClick={() => remove{{ p }}Row(index)} disabled={busy}>
                <Trash2Icon />
              </Button>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  {values.{{ f.key }}.map((line, index) => {
    const message = errors[`{{ f.key }}.${index}`];
    return message ? <FieldError key={line.key}>{{ jsx_format("Line {number}: {message}", number="index + 1", message="message") }}</FieldError> : null;
  })}
  <div className="flex flex-wrap items-start justify-between gap-3">
    <Button type="button" variant="outline" size="sm" onClick={add{{ p }}Row} disabled={busy}>
      <PlusIcon />
      {{ jsx_text("Add a line") }}
    </Button>
{% set own = previews | selectattr("editor", "eq", f.key) | list %}
{% if own %}
    <dl className="grid grid-cols-[auto_auto] gap-x-4 gap-y-1 text-sm">
{% for preview in own %}
      <dt className="text-muted-foreground">{{ jsx_text(preview.label) }}</dt> {{ trace(preview.element_id, jsx=True) }}
      <dd className="text-end font-medium tabular-nums">{ {{- preview.text }}}</dd>
{% endfor %}
    </dl>
{% endif %}
  </div>
  <FieldError>{errors.{{ f.key }}}</FieldError>
</FieldSet>
{% endfilter %}
{%- endmacro %}

{#- The widget of the value of a translatable field in another language (ADR 0026). #}
{% macro translation(f, language, indent, prefix) -%}
{% set code = language.code %}
{% set id = (prefix | kebab) ~ "-" ~ (f.name | kebab) ~ "-" ~ (code | kebab) %}
{% set error = "errors[" ~ js(f.translations_key ~ "." ~ code) ~ "]" %}
{% set value = "values." ~ f.translations_key ~ "[" ~ js(code) ~ "] ?? \"\"" %}
{% set on_change = "(event) => change(" ~ js(f.translations_key) ~ ", { ...values." ~ f.translations_key ~ ", " ~ js(code) ~ ": event.target.value })" %}
{% filter indent(indent, true) %}
<Field data-invalid={Boolean({{ error }})}{% if f.classes %} className={{ js(f.classes) }}{% endif %}> {{ trace(f.element_id, jsx=True) }}
  <FieldLabel htmlFor={{ js(id) }}>{{ jsx_format("{field} ({language})", field=tr(js(f.label)), language=js(language.label)) }}</FieldLabel>
{% if f.widget == "textarea" %}
  <Textarea id={{ js(id) }} lang={{ js(language.locale) }} dir={{ js(language.direction) }}{% if f.rows %} rows={ {{- f.rows }}}{% endif %} value={ {{- value }}} onChange={ {{- on_change }}} disabled={busy} aria-invalid={Boolean({{ error }})} />
{% else %}
  <Input id={{ js(id) }} lang={{ js(language.locale) }} dir={{ js(language.direction) }} type="text" value={ {{- value }}} onChange={ {{- on_change }}} disabled={busy} aria-invalid={Boolean({{ error }})} />
{% endif %}
  <FieldError>{ {{- error }}}</FieldError>
</Field>
{% endfilter %}
{%- endmacro %}
