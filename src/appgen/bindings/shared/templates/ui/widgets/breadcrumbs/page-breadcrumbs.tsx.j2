"use client";

import { Fragment } from "react";

import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbList,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from "@/shared/ui/breadcrumb";
import { Skeleton } from "@/shared/ui/skeleton";
import { pages } from "@/shared/config/pages";
import { matchPage, pageChain, pageHref, pageParams } from "@/shared/lib/pages";
import { Link, usePathname } from "@/shared/lib/router";
import { useResource } from "@/shared/lib/use-resource";

import { recordLabels } from "../model/record-labels";

function RecordLabel({ entity, id, fallback }: { entity: string; id: string; fallback: string }) {
  const load = recordLabels[entity];
  const label = useResource(`${entity}:${id}`, () => (load ? load(id) : Promise.resolve(fallback)));
  if (label.status === "loading") return <Skeleton className="h-4 w-24" />;
  return <span className="block max-w-48 truncate">{label.status === "success" ? label.data : fallback}</span>;
}

/** The breadcrumbs of the current page: the parent pages, from the root page. */
export function PageBreadcrumbs({ className }: { className?: string }) {
  const pathname = usePathname();
  const match = matchPage(pathname);
  if (match === null) return null;
  const chain = pageChain(match.name);
  return (
    <Breadcrumb className={className}>
      <BreadcrumbList className="flex-nowrap">
        {chain.map((name, index) => {
          const page = pages[name];
          const params = pageParams(name, match.values);
          const recordId = page.recordParam ? params[page.recordParam] : undefined;
          const label =
            page.recordEntity && recordId ? (
              <RecordLabel entity={page.recordEntity} id={recordId} fallback={page.breadcrumb} />
            ) : (
              page.breadcrumb
            );
          const last = index === chain.length - 1;
          return (
            <Fragment key={name}>
              {index > 0 && <BreadcrumbSeparator />}
              <BreadcrumbItem className="min-w-0">
                {last ? (
                  <BreadcrumbPage>{label}</BreadcrumbPage>
                ) : (
                  <BreadcrumbLink asChild>
                    <Link href={pageHref(name, params)}>{label}</Link>
                  </BreadcrumbLink>
                )}
              </BreadcrumbItem>
            </Fragment>
          );
        })}
      </BreadcrumbList>
    </Breadcrumb>
  );
}
