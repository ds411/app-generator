{{ trace_header("app") }}
import type { ReactNode } from "react";

import { cn } from "@/shared/lib/utils";

/**
 * The header of a page: the title, the description, and the actions. On
 * a detail page (`label`), the title is a small label: the name of the
 * record in the detail view is the main heading of the page.
 */
export function PageHeader({
  title,
  description,
  actions,
  className,
  label = false,
}: {
  title: ReactNode;
  description?: ReactNode;
  actions?: ReactNode;
  className?: string;
  label?: boolean;
}) {
  return (
    <div className={cn("mb-6 flex flex-wrap items-start justify-between gap-4", className)}>
      <div className="space-y-1">
        {label ? (
          <p className="text-sm font-medium text-muted-foreground">{title}</p>
        ) : (
          <h1 className="{{ ui_plan.text_class('heading', 'text-2xl font-semibold tracking-tight') }}">{title}</h1>
        )}
        {description && <p className="text-muted-foreground">{description}</p>}
      </div>
      {actions && <div className="flex flex-wrap items-center gap-2">{actions}</div>}
    </div>
  );
}
