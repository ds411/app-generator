/** The responses of the endpoints of the widgets, and the related records that the widgets show. */
type DashboardData = {
{% for w in served %}
  {{ w.function }}: {{ w.data }};
{% if w.change %}
  {{ w.function }}Previous: {{ w.data }};
{% endif %}
{% endfor %}
  lookups: Lookups;
};
{% for w in related %}

{{ m.related_steps(w.related, w.related_name) }}
{% endfor %}

/** Read the value of each widget from its endpoint, and the related records of the values. */
async function load({{ "period: Period" if period_served }}): Promise<DashboardData> {
{% if plan.compare %}
  const previous = previousPeriod(period);
{% endif %}
  const [{% for w in served %}{{ w.function }}{{ ", " ~ w.function ~ "Previous" if w.change }}{{ ", " if not loop.last }}{% endfor %}] = await Promise.all([
{% for w in served %}
{% set items = (["today: today()"] if w.endpoint.today else []) + (["week_start: String(firstWeekday())"] if w.endpoint.week and i18n else []) %}
{% set all = items + (["...periodParams(period)"] if w.endpoint.period else []) %}
{% set params = (", periodParams(period)" if all == ["...periodParams(period)"] else ", { " ~ all | join(", ") ~ " }") if all else "" %}
{% if w.kind == "stat" %}
    statValue({{ js(w.endpoint.path) }}{{ params }}),
{% if w.change %}
{% set before = items + ["...periodParams(previous)"] %}
    previous ? statValue({{ js(w.endpoint.path) }}, {{ "periodParams(previous)" if before == ["...periodParams(previous)"] else "{ " ~ before | join(", ") ~ " }" }}) : null,
{% endif %}
{% elif w.kind == "chart" %}
    chartValues({{ js(w.endpoint.path) }}{{ params }}),
{% else %}
    widgetRecords({{ w.store }}, {{ js(w.endpoint.path) }}{{ params }}),
{% endif %}
{% endfor %}
  ]);
{% if plan.lookups %}
  const parts = await Promise.all([
{% for w in related %}
    loadRelated({{ w.function }}, {{ w.related_name }}),
{% endfor %}
{% for w in served if w.target %}
    groupRecords({{ js(w.target | camel) }}, {{ w.target | camel }}Api, {{ w.function }}),
{% endfor %}
  ]);
  const lookups = mergeLookups({{ js(plan.lookups | map("camel") | list) }}, parts) as Lookups;
{% else %}
  const lookups: Lookups = {};
{% endif %}
  return { {% for w in served %}{{ w.function }}, {{ w.function ~ "Previous, " if w.change }}{% endfor %}lookups };
}

/** Load the data again after a change of the records. */
function subscribe(listener: () => void): () => void {
  const stops = [{% for entity in plan.entities %}{{ entity | camel }}Api.subscribe(listener){{ ", " if not loop.last }}{% endfor %}];
  return () => stops.forEach((stop) => stop());
}
{% elif plan.entities %}

type Lookups = {
{% for entity in plan.entities %}
  {{ entity | camel }}: Map<string, {{ entity | pascal }}>;
{% endfor %}
};

type DashboardData = {
  records: {
{% for entity in plan.entities %}
    {{ entity | camel }}: {{ entity | pascal }}[];
{% endfor %}
  };
  lookups: Lookups;
{% if snapshot_actions %}
  /** The stored daily values of the charts of snapshots (ADR 0042). */
  snapshots: {
{% for w in snapshot_actions %}
    {{ w.function }}: { key: string; value: number | null }[];
{% endfor %}
  };
{% endif %}
};

/** Read the records of the entities that the widgets show{{ ", and the stored daily values of the stats" if snapshot_actions }}. */
async function load(): Promise<DashboardData> {
{% set loaded = namespace(names=[]) %}
{% for entity in plan.entities %}{% set loaded.names = loaded.names + [(entity | camel) ~ "List"] %}{% endfor %}
{% for w in snapshot_actions %}{% set loaded.names = loaded.names + [w.function ~ "Values"] %}{% endfor %}
  const [{{ loaded.names | join(", ") }}] = await Promise.all([
{% for entity in plan.entities %}
    {{ entity | camel }}Api.list(),
{% endfor %}
{% for w in snapshot_actions %}
    {{ w.action }}(today()),
{% endfor %}
  ]);
  return {
    records: { {% for entity in plan.entities %}{{ entity | camel }}: {{ entity | camel }}List.items{{ ", " if not loop.last }}{% endfor %} },
    lookups: { {% for entity in plan.entities %}{{ entity | camel }}: byId({{ entity | camel }}List.items){{ ", " if not loop.last }}{% endfor %} },
{% if snapshot_actions %}
    snapshots: { {% for w in snapshot_actions %}{{ w.function }}: unwrap({{ w.function }}Values){{ ", " if not loop.last }}{% endfor %} },
{% endif %}
  };
}

/** Load the data again after a change of the records. */
function subscribe(listener: () => void): () => void {
  const stops = [{% for entity in plan.entities %}{{ entity | camel }}Api.subscribe(listener){{ ", " if not loop.last }}{% endfor %}];
  return () => stops.forEach((stop) => stop());
}
{% else %}

type DashboardData = Record<string, never>;

async function load(): Promise<DashboardData> {
  return {};
}
