export function {{ name | pascal }}Dashboard() {
{% if period %}
  const [choice, setChoice] = useState<PeriodChoice>({ range: {{ js(period.default) }}, custom: {} });
  const period = periodOf(choice.range, today(), choice.custom);
{% if plan.compare and not plan.server %}
  const previous = previousPeriod(period);
{% endif %}
{% endif %}
{% if period_served %}
  // The API gives the values of the period: a new period loads them again, and shows the last values until then.
  const resource = useResource([{{ js(name) }}, period.from, period.to].join(" "), () => load(period), subscribe, { keep: true });
{% else %}
  const resource = useResource({{ js(name) }}, load{% if plan.entities %}, subscribe{% endif %});
{% endif %}
{% if takes_me %}
  const me = useMe();
{% endif %}

{{ m.states(plan, "widget") }}

{% if functions %}
  const data = resource.data;
{% endif %}
{% if "lookups." in render %}
  const { lookups } = data;
{% endif %}
{% for w in lists %}
  const {{ w.function }}Rows = {{ w.function }}({{ args(w) }});
{% endfor %}
  return (
{% if period %}
    <div className="space-y-4">
      <div className="flex justify-end"> {{ trace(period.id, jsx=True) }}
        <PeriodPicker ranges={ {{- js(period.ranges) }}} value={choice} onChange={setChoice} />
      </div>
{% endif %}
    <div className={{ js(plan.grid) }}>{% if dashboard.grid %} {{ trace(dashboard.grid.id, jsx=True) }}{% endif %}

{% if dashboard.grid %}
{% for override in dashboard.grid.responsive.values() %}
      {{ trace(override.id, jsx=True) }}
{% endfor %}
{% endif %}
{% for w in plan.widgets %}
{% if w.kind == "stat" %}
      <StatTile
        label={{ jsx_attr(w.label) }}
        value={formatValue({{ w.function }}({{ args(w) }}), {{ js(w.format) }}{% if w.currency %}, {{ js(w.currency) }}{% endif %})}
{% if w.change %}
        change={ {{- w.change }}}
{% endif %}
{% if w.icon %}
        icon={ {{- w.icon | pascal }}Icon}
{% endif %}
{% if w.color %}
        color={{ js(w.color) }}
{% endif %}
{% if w.href %}
        href={ {{- w.href }}}
{% endif %}
        className={{ js(w.classes) }}
      />{{ " " }}{{ trace(w.element_id, jsx=True) }}
{% else %}
      <WidgetCard title={{ jsx_attr(w.label) }}{% if w.href %} href={ {{- w.href }}}{% endif %} className={{ js(w.classes) }}> {{ trace(w.element_id, jsx=True) }}
{% if w.kind == "chart" %}
        <DashboardChart kind={{ js(w.chart) }} data={ {{- w.function }}({{ args(w) }})} valueLabel={{ jsx_attr(w.value_label) }}{% if plan.motion == "none" %} animate={false}{% endif %} />
{% elif w.kind == "list" %}
{% if w.sort_id %}
        {{ trace(w.sort_id, jsx=True) }}
{% endif %}
        { {{- w.function }}Rows.length === 0 ? (
          <p className="py-6 text-center text-sm text-muted-foreground">{{ jsx_text(plan.states.empty.title or "No records yet") }}</p>
        ) : (
{% if w.columns %}
          <Table>
            <TableHeader>
              <TableRow>
{% for column in w.columns %}
                <TableHead{% if column.classes %} className={{ js(column.classes) }}{% endif %}>{{ jsx_text(column.header) }}</TableHead>
{% endfor %}
              </TableRow>
            </TableHeader>
            <TableBody>
              { {{- w.function }}Rows.map((row) => (
                <TableRow key={row.id}>
{% for column in w.columns %}
                  <TableCell{% if column.classes %} className={{ js(column.classes) }}{% endif %}>{{ column.cell }}</TableCell>
{% endfor %}
                </TableRow>
              ))}
            </TableBody>
          </Table>
{% else %}
{% set card = w.card %}
          <ul className="divide-y">
            { {{- w.function }}Rows.map((row) => (
              <li key={row.id} className="flex items-center justify-between gap-3 py-2">
                <div className="min-w-0">
{% if card.href %}
                  <Link href={ {{- card.href }}} className="block truncate font-medium underline-offset-4 hover:underline">
                    {{ card.title }}
                  </Link>
{% else %}
                  <p className="truncate font-medium">{{ card.title }}</p>
{% endif %}
{% if card.subtitle %}
                  <div className="truncate text-sm text-muted-foreground">{{ card.subtitle }}</div>
{% endif %}
                </div>
{% if card.badge %}
                {{ card.badge }}
{% endif %}
              </li>
            ))}
          </ul>
{% endif %}
        )}
{% else %}
        <{{ w.gap.name }} />
{% endif %}
      </WidgetCard>
{% endif %}
{% endfor %}
    </div>
{% if period %}
    </div>
{% endif %}
  );
}
