{{ trace_header("app") }}
{% set compare = "period" in ui_views.features %}
{% raw %}
"use client";

{% endraw %}
{% if compare %}
import { MoveDownRightIcon, MoveRightIcon, MoveUpRightIcon, type LucideIcon } from "lucide-react";
{% else %}
import type { LucideIcon } from "lucide-react";
{% endif %}
{% raw %}
import type { ReactNode } from "react";

{% endraw %}
{% if compare and i18n %}
import { numberFormat } from "@/shared/lib/format";
{% endif %}
{% raw %}
import { Link } from "@/shared/lib/router";
import { cn } from "@/shared/lib/utils";
import { Card, CardAction, CardContent, CardHeader, CardTitle } from "@/shared/ui/card";

/** A card of a dashboard widget, with a title and an optional link. */
export function WidgetCard({
  title,
  href,
  linkLabel = {% endraw %}{{ tr(js("View all")) }}{% raw %},
  className,
  children,
}: {
  title: string;
  href?: string;
  linkLabel?: string;
  className?: string;
  children: ReactNode;
}) {
  return (
    <Card className={cn("min-w-0 gap-4", className)}>
      <CardHeader>
        <CardTitle className="text-base">{title}</CardTitle>
        {href && (
          <CardAction>
            <Link href={href} className="text-sm text-muted-foreground underline-offset-4 hover:text-foreground hover:underline">
              {linkLabel}
            </Link>
          </CardAction>
        )}
      </CardHeader>
      <CardContent className="min-w-0">{children}</CardContent>
    </Card>
  );
}

{% endraw %}
{% if compare %}
{% if i18n %}
/** The format of a change: a percentage with its sign, in the locale of the selected language. */
const changeFormat = () => numberFormat({ style: "percent", signDisplay: "exceptZero", maximumFractionDigits: 1 });
{% else %}
const CHANGE_FORMAT = new Intl.NumberFormat(undefined, { style: "percent", signDisplay: "exceptZero", maximumFractionDigits: 1 });
/** The format of a change: a percentage with its sign. */
const changeFormat = () => CHANGE_FORMAT;
{% endif %}

/** The change of a stat from the previous period, or a dash if the change is not known. */
function StatChange({ change }: { change: number | null }) {
  const Icon = change === null || change === 0 ? MoveRightIcon : change > 0 ? MoveUpRightIcon : MoveDownRightIcon;
  const text = change === null ? "—" : changeFormat().format(change);
  return (
    <p className="mt-1 flex items-center gap-1 text-xs text-muted-foreground">
      <Icon className="size-3.5" aria-hidden />
      {{ jsx_format("{change} from the previous period", change="text") }}
    </p>
  );
}

{% endif %}
{% raw %}
/** A stat tile: a label, a value, an icon, and an optional link to a page. */
export function StatTile({
  label,
  value,
  icon: Icon,
  color,
  href,
  className,{% endraw %}{% if compare %}
  change,{% endif %}{% raw %}
}: {
  label: string;
  value: string;
  icon?: LucideIcon;
  /** A CSS color for the icon, for example a color token. */
  color?: string;
  href?: string;
  className?: string;{% endraw %}{% if compare %}
  /** The change from the previous period, as a fraction (0.1 is 10%), or null if it is not known. */
  change?: number | null;{% endif %}{% raw %}
}) {
  const content = (
    <Card className={cn("h-full gap-2 py-5 transition-shadow", href && "hover:shadow-md", className)}>
      <CardHeader className="px-5">
        <CardTitle className="text-sm font-medium text-muted-foreground">{label}</CardTitle>
        {Icon && (
          <CardAction>
            <span
              className="flex size-9 items-center justify-center rounded-md bg-muted"
              style={color ? { color, backgroundColor: `color-mix(in oklab, ${color} 12%, transparent)` } : undefined}
            >
              <Icon className="size-5" />
            </span>
          </CardAction>
        )}
      </CardHeader>
      <CardContent className="px-5">
        <p className="text-3xl font-semibold tracking-tight tabular-nums">{value || "—"}</p>{% endraw %}{% if compare %}
        {change !== undefined && <StatChange change={change} />}{% endif %}{% raw %}
      </CardContent>
    </Card>
  );
  if (!href) return content;
  return (
    <Link href={href} className={cn("block rounded-xl focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none", className)}>
      {content}
    </Link>
  );
}
{% endraw %}
