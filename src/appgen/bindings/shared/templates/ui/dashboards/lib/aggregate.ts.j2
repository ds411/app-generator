{% raw %}
export type FilterOp = "eq" | "ne" | "lt" | "lte" | "gt" | "gte" | "in" | "not_in";

export type Aggregate = "count" | "sum" | "avg" | "min" | "max";

/** One group of a chart: its key, its label, its value, and its color. */
export type ChartDatum = { key: string; label: string; value: number; color?: string };

/** A known group of a chart, in the order of the chart. */
export type Group = { key: string; label: string; color?: string };

function isEmpty(value: unknown): boolean {
  return value === null || value === undefined || value === "";
}

/**
 * Return true if a value passes a filter operator. A list value (the IDs of
 * a `many_to_many` relation) passes `eq` if it has the operand. An empty
 * value passes no comparison (`lt`, `lte`, `gt`, `gte`).
 */
export function matchesOp(value: unknown, op: FilterOp, operand: unknown): boolean {
  const operands = Array.isArray(operand) ? operand : [operand];
  if (Array.isArray(value)) {
    switch (op) {
      case "eq":
      case "in":
        return operands.some((item) => value.includes(item));
      case "ne":
      case "not_in":
        return !operands.some((item) => value.includes(item));
      default:
        return false;
    }
  }
  const actual = value === undefined ? null : value;
  switch (op) {
    case "eq":
      return actual === operand;
    case "ne":
      return actual !== operand;
    case "in":
      return operands.includes(actual);
    case "not_in":
      return !operands.includes(actual);
  }
  if (isEmpty(actual) || isEmpty(operand)) return false;
  const a = actual as number | string;
  const b = operand as number | string;
  switch (op) {
    case "lt":
      return a < b;
    case "lte":
      return a <= b;
    case "gt":
      return a > b;
    case "gte":
      return a >= b;
  }
}

/** Return an aggregate of numbers. Empty values do not count. Without numbers, return null. */
export function aggregate(values: unknown[], kind: Exclude<Aggregate, "count">): number | null {
  const numbers = values.filter((value) => !isEmpty(value)).map(Number);
  if (numbers.length === 0) return kind === "sum" ? 0 : null;
  switch (kind) {
    case "sum":
      return numbers.reduce((total, value) => total + value, 0);
    case "avg":
      return numbers.reduce((total, value) => total + value, 0) / numbers.length;
    case "min":
      return Math.min(...numbers);
    case "max":
      return Math.max(...numbers);
  }
}

/**
 * Return the value of each group of records. With known groups, the chart
 * shows them in their order, also without records, and the records of
 * other groups count as "Other". Without known groups, the chart shows the
 * groups of the records, sorted by key.
 */
export function groupRows<T>(
  rows: T[],
  keyOf: (row: T) => string | null,
  valueOf: (group: T[]) => number,
  groups?: Group[],
): ChartDatum[] {
  const byKey = new Map<string, T[]>();
  for (const row of rows) {
    const key = keyOf(row) ?? "";
    byKey.set(key, [...(byKey.get(key) ?? []), row]);
  }
  if (groups) {
    const known = new Set(groups.map((group) => group.key));
    const result: ChartDatum[] = groups.map((group) => ({
      ...group,
      value: valueOf(byKey.get(group.key) ?? []),
    }));
    const other = [...byKey.entries()].filter(([key]) => !known.has(key)).flatMap(([, items]) => items);
    if (other.length > 0) result.push({ key: "other", label: {% endraw %}{{ text("Other") }}{% raw %}, value: valueOf(other) });
    return result;
  }
  return [...byKey.entries()]
    .sort(([a], [b]) => a.localeCompare(b))
    .map(([key, items]) => ({ key: key || "none", label: key || {% endraw %}{{ text("None") }}{% raw %}, value: valueOf(items) }));
}
{% endraw %}
{% if dates %}

/** The interval of the groups of a chart of dates. */
export type Interval = "day" | "week" | "month" | "year";

{% if i18n %}
// The formats of the intervals, in the locale of the selected language.
const dayFormat = () => dateTimeFormat({ day: "numeric", month: "short", year: "numeric" });
const monthFormat = () => dateTimeFormat({ month: "short", year: "numeric" });
const yearFormat = () => dateTimeFormat({ year: "numeric" });
{% else %}
// The formats of the intervals.
const DAY_FORMAT = new Intl.DateTimeFormat(undefined, { day: "numeric", month: "short", year: "numeric" });
const MONTH_FORMAT = new Intl.DateTimeFormat(undefined, { month: "short", year: "numeric" });
const YEAR_FORMAT = new Intl.DateTimeFormat(undefined, { year: "numeric" });
const dayFormat = () => DAY_FORMAT;
const monthFormat = () => MONTH_FORMAT;
const yearFormat = () => YEAR_FORMAT;

/** The first day of the week: 1 is Monday (ISO 8601). */
const firstWeekday = () => 1;
{% endif %}
{% raw %}

/** Return the date of a key: a day `YYYY-MM-DD`, a month `YYYY-MM`, or a year `YYYY`. */
function keyDate(key: string, utc: boolean): Date {
  const day = key.length === 4 ? `${key}-01-01` : key.length === 7 ? `${key}-01` : key;
  return new Date(`${day}T00:00:00${utc ? "Z" : ""}`);
}

/** Return the day `YYYY-MM-DD` of a number of days after a day. */
function addDays(day: string, days: number): string {
  const date = keyDate(day, true);
  date.setUTCDate(date.getUTCDate() + days);
  return date.toISOString().slice(0, 10);
}

/**
 * Return the key of the interval of a date or a date and time: the day
 * `YYYY-MM-DD`, the first day of the week, the month `YYYY-MM`, or the year
 * `YYYY`. A date and time gives the interval of its day in UTC.
 */
export function intervalKey(value: string | null | undefined, interval: Interval): string | null {
  if (!value) return null;
  const day = value.slice(0, 10);
  switch (interval) {
    case "day":
      return day;
    case "week":
      return addDays(day, -((keyDate(day, true).getUTCDay() - firstWeekday() + 7) % 7));
    case "month":
      return day.slice(0, 7);
    case "year":
      return day.slice(0, 4);
  }
}

/** Return the key of the next interval. */
function nextKey(key: string, interval: Interval): string {
  const date = keyDate(key, true);
  switch (interval) {
    case "day":
      return addDays(key, 1);
    case "week":
      return addDays(key, 7);
    case "month":
      date.setUTCMonth(date.getUTCMonth() + 1);
      return date.toISOString().slice(0, 7);
    case "year":
      date.setUTCFullYear(date.getUTCFullYear() + 1);
      return date.toISOString().slice(0, 4);
  }
}

/** Return the label of an interval: the day, the days of the week, the month, or the year. */
function intervalLabel(key: string, interval: Interval): string {
  const date = keyDate(key, false);
  switch (interval) {
    case "day":
      return dayFormat().format(date);
    case "week":
      return dayFormat().formatRange(date, new Date(date.getFullYear(), date.getMonth(), date.getDate() + 6));
    case "month":
      return monthFormat().format(date);
    case "year":
      return yearFormat().format(date);
  }
}

/**
 * Return the chart data of each interval from the first to the last key,
 * also of the intervals without a value, then the value of the records
 * without a date ("None"). `values` maps the key of each interval to its
 * value, and "" to the value of the records without a date.
 */
function intervalData(values: ReadonlyMap<string, number>, interval: Interval, empty: number): ChartDatum[] {
  const keys = [...values.keys()].filter(Boolean).sort();
  const first = keys[0];
  const last = keys[keys.length - 1];
  const result: ChartDatum[] = [];
  if (first !== undefined && last !== undefined) {
    for (let key = first; key <= last; key = nextKey(key, interval)) {
      result.push({ key, label: intervalLabel(key, interval), value: values.get(key) ?? empty });
    }
  }
  const none = values.get("");
  if (none !== undefined) result.push({ key: "none", label: {% endraw %}{{ text("None") }}{% raw %}, value: none });
  return result;
}

/**
 * Return the value of each interval of the records of a chart of dates:
 * each day, week, month, or year from the first to the last date, also
 * without records, then the records without a date ("None").
 */
export function intervalRows<T>(
  rows: T[],
  dateOf: (row: T) => string | null | undefined,
  valueOf: (group: T[]) => number,
  interval: Interval,
): ChartDatum[] {
  const byKey = new Map<string, T[]>();
  for (const row of rows) {
    const key = intervalKey(dateOf(row), interval) ?? "";
    byKey.set(key, [...(byKey.get(key) ?? []), row]);
  }
  const values = new Map([...byKey.entries()].map(([key, items]) => [key, valueOf(items)]));
  return intervalData(values, interval, valueOf([]));
}
