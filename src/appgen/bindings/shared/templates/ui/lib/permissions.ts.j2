{{ trace_header(definition.access.id) }}
// The permissions of the roles (ADR 0012): the operations and the pages
// that each role may use. The checks of the app and the menus, the
// links, and the actions of the UI read this table. `*` stands for all
// operations or pages. A public page or operation needs no role.{% if record_rules %}

// The record rules (ADR 0018, ADR 0025) limit a role to some records: the
// records of its user, or the records with some values.{% endif %}{% if memberships %}

// The memberships (ADR 0048) give a user a role in a record of {{ memberships.scope }}: the
// role gives operations on the records of the scope, if the role of the
// user does not give them.{% endif +%}
import type { PageName } from "@/shared/config/pages";

const ALL = "*";

const OPERATIONS: Record<string, readonly string[]> = {
{% for name, r in definition.access.roles.items() %}
  {{ name | tojson }}: {{ r.operations | list | tojson }}, {{ trace(r.id) }}
{% endfor %}
};

const PAGES: Record<string, readonly (PageName | typeof ALL)[]> = {
{% for name, r in definition.access.roles.items() %}
  {{ name | tojson }}: [{% for page in r.pages %}{{ (page if page == "*" else page | camel) | tojson }}{{ ", " if not loop.last }}{% endfor %}], {{ trace(r.id) }}
{% endfor %}
};

const PUBLIC_OPERATIONS: readonly string[] = {{ definition.auth.public_operations | list | tojson }}; {{ trace(definition.auth.id) }}

const PUBLIC_PAGES: readonly PageName[] = [{% for page in definition.auth.public_pages %}{{ page | camel | tojson }}{{ ", " if not loop.last }}{% endfor %}]; {{ trace(definition.auth.id) }}

function allows(names: readonly string[] | undefined, name: string): boolean {
  return names !== undefined && (names.includes(ALL) || names.includes(name));
}

/** Return true if a role may call an operation. Without a role (null), only the public operations. */
export function roleMayCall(role: string | null, operation: string): boolean {
  return PUBLIC_OPERATIONS.includes(operation) || (role !== null && allows(OPERATIONS[role], operation));
}

/** Return true if a role may open a page. Without a role (null), only the public pages. */
export function roleMayOpenPage(role: string | null, page: PageName): boolean {
  return PUBLIC_PAGES.includes(page) || (role !== null && allows(PAGES[role], page));
}
{% if record_rules %}

/** The records of a rule: `read` (the lists and the reads) or `change` (the creates, the changes, the deletes, and the custom operations). */
export type RecordAction = "read" | "change";

/** A value of a condition of a record rule. */
export type RecordValue = string | number | boolean;

/**
 * A record rule of a role on an entity. With `owner`, the role uses only
 * the records of its user. With `where`, the role uses only the records
 * with one of the values of each field.
 */
type RecordRule = {
  actions: readonly RecordAction[];
  owner?: true;
  where?: Readonly<Record<string, readonly RecordValue[]>>;
};

/** The records that a user may use for an action: the user, and the parts of the rule. */
export type RecordScope = {
  user: string;
  /** True if the user uses only the records of the user (the owner path of the entity). */
  owner: boolean;
  /** The values that each field must have: one of the values of the list. */
  where: Readonly<Record<string, readonly RecordValue[]>>;
{% if memberships %}
  /**
   * The IDs of the scopes whose memberships give the operation (ADR 0048):
   * the user uses only the records of these scopes. Undefined if the role
   * of the user gives the operation.
   */
  scopes?: readonly string[];
  /** The IDs of all scopes of the memberships of the user. */
  memberOf?: readonly string[];
{% endif %}
};

const RECORD_RULES: Record<string, Record<string, RecordRule>> = {
{% for name, r in definition.access.roles.items() if r.records %}
  {{ name | tojson }}: {
{% for entity, rule in r.records.items() %}
{% set where = rule.conditions() %}
{% set parts = ["actions: " ~ (rule.operations | sort | list | tojson)] + (["owner: true"] if rule.owner else []) %}
{% if where %}
{% set ns = namespace(items=[]) %}
{% for field, values in where.items() %}
{% set ns.items = ns.items + [(field | camel) ~ ": " ~ ts_value(values)] %}
{% endfor %}
{% set parts = parts + ["where: { " ~ (ns.items | join(", ")) ~ " }"] %}
{% endif %}
    {{ entity | tojson }}: { {{ parts | join(", ") }} }, {{ trace(rule.id) }}
{% endfor %}
  },
{% endfor %}
};

/**
 * Return the records that a user of a role may use for an action on the
 * records of an entity, or null for all records. A rule for `read` also
 * applies to `change`, because a user cannot change a record that the
 * user cannot see.
 */
export function recordScopeOf(role: string | null, user: string | null, entity: string, action: RecordAction): RecordScope | null {
  if (role === null || user === null) {
    return null;
  }
  const rule = RECORD_RULES[role]?.[entity];
  if (rule === undefined || !(action === "change" || rule.actions.includes(action))) {
    return null;
  }
  return { user, owner: rule.owner === true, where: rule.where ?? {} };
}

/** Return true if a record has the values of a scope. The owner is not part of the check. */
export function hasValuesOf(scope: RecordScope, record: object): boolean {
  const values = record as Record<string, unknown>;
  return Object.entries(scope.where).every(([key, allowed]) => allowed.some((value) => value === values[key]));
}

/**
 * Return the one value of a field that a scope allows, or undefined. A
 * form sets the value, and does not show the field.
 */
export function fixedValue<V>(scope: RecordScope | null, key: string): V | undefined {
  const values = scope?.where[key];
  return values?.length === 1 ? (values[0] as V) : undefined;
}
{% endif %}
{% if memberships %}
{% set m = memberships %}

/** A membership of a user (ADR 0048): the ID of the scope record of {{ m.scope }}, and the role in it. */
export type Membership = { scope: string; role: string };

/** The operations of each role of the memberships, on the records of its scopes. */
const MEMBER_ROLES: Record<string, readonly string[]> = {
{% for name, ops in m.roles.items() %}
  {{ name | tojson }}: {{ ops | tojson }}, {{ trace(m.role_ids[name]) }}
{% endfor %}
};

/** The entity of each operation that a role of the memberships gives. */
export const MEMBER_OPERATIONS: Readonly<Record<string, string>> = {
{% for name, entity in m.operation_entities.items() %}
  {{ name }}: {{ entity | tojson }},
{% endfor %}
};

/** The operations of the memberships on one record: the record must be in a scope of the operation. */
const RECORD_OPERATIONS: readonly string[] = {{ m.record_operations | list | tojson }};

/** The entities of the scope: the scope records, and the records whose path ends at one. */
export const SCOPE_ENTITIES: readonly string[] = {{ m.paths | list | tojson }}; {{ trace(m.element_id) }}

/** Return the IDs of the scopes of the memberships whose role gives an operation. */
export function scopesOf(memberships: readonly Membership[], operation: string): string[] {
  return memberships.filter((item) => MEMBER_ROLES[item.role]?.includes(operation) === true).map((item) => item.scope);
}

/** Return true if an operation is on one record: a membership gives it only in the scope of the record. */
export function onRecord(operation: string): boolean {
  return RECORD_OPERATIONS.includes(operation);
}
{% endif %}
