{% set u = definition.entities[definition.auth.user_entity] %}
{% set f = u.fields[definition.auth.username_field] %}
{% set password = definition.auth.password %}
{% set providers = definition.auth.providers %}
{% set grouped = definition.access and (providers.values() | selectattr("roles") | list) %}
{% set card = "form onSubmit={submit}" if password else "div" %}
{% set verify = auth_pages.verify_email %}
{% set sf = auth_pages.second_factor %}
{{ trace_header(definition.auth.id) }}
"use client";

import { {{ "type FormEvent, " if password }}useState } from "react";

{% if sf %}
import { SecondFactorSetup } from "@/features/second-factor";
{% endif %}
import { {{ ((["requestEmailVerification"] if verify else []) + (["type SecondFactorSecret", "setUpSecondFactor"] if sf else []) + (["signIn"] if password else []) + (["signInWithCode"] if sf else []) + (["signInWithProvider"] if providers else [])) | join(", ") }} } from "@/shared/auth";
{% if auth_pages.sign_up or auth_pages.password_reset %}
import { Link } from "@/shared/lib/router";
{% endif %}
{% if providers %}

/** Return the message of a failed sign-in with a provider: the code in `?error=` of the page. */
function providerError(code: string | undefined): string | null {
  if (code === undefined) return null;
{% if grouped %}
  if (code === "no-role") return {{ tr(js("Your groups at the provider give you no role in this app. Ask an administrator.")) }};
{% endif %}
  return code === "unknown-user" ? {{ tr(js("No user has this user name. Ask an administrator.")) }} : {{ tr(js("The sign-in with the provider failed.")) }};
}
{% endif %}

{% if password and providers %}
/**
 * The sign-in form: a user name and a password, and a button for each
 * provider (ADR 0020). After the sign-in, it opens the page `next`.
 */
export function SignInForm({ next, error: code }: { next: string; error?: string }) {
  const [error, setError] = useState<string | null>(providerError(code));
{% elif providers %}
/** The sign-in page: a button for each provider (ADR 0020). After the sign-in, it opens the page `next`. */
export function SignInForm({ next, error: code }: { next: string; error?: string }) {
  const [error, setError] = useState<string | null>(providerError(code));
{% else %}
/** The sign-in form: a user name and a password. After the sign-in, it opens the page `next`. */
export function SignInForm({ next }: { next: string }) {
  const [error, setError] = useState<string | null>(null);
{% endif %}
  const [pending, setPending] = useState(false);
{% if verify %}
  // The user name of a user who must confirm the email address first (ADR 0023).
  const [unverified, setUnverified] = useState<string | null>(null);
  const [linkSent, setLinkSent] = useState(false);
{% endif %}
{% if sf %}
  // The challenge of the password step of a user with a second factor (ADR 0024).
  const [challenge, setChallenge] = useState<string | null>(null);
  // The new secret of a user who must turn on the second factor before the sign-in.
  const [secret, setSecret] = useState<SecondFactorSecret | null>(null);
{% endif %}
{% if password %}

  async function submit(event: FormEvent<HTMLFormElement>) {
    event.preventDefault();
    const data = new FormData(event.currentTarget);
    const username = String(data.get("username") ?? "");
    setPending(true);
    const result = await signIn(username, String(data.get("password") ?? ""));
{% if sf %}
    if (result.status === "second-factor") {
      {{ trace(definition.auth.second_factor.id) }}
      const setup = result.setup ? await setUpSecondFactor(result.challenge) : null;
      setPending(false);
      if (setup !== null && !setup.ok) {
        setError(setup.message);
        return;
      }
      setError(null);
      setSecret(setup === null ? null : setup.value);
      setChallenge(result.challenge);
      return;
    }
{% endif %}
    setPending(false);
    if (result.status === "signed-in") {
      window.location.assign(next);
    } else {
      setError(result.message);
{% if verify %}
      setUnverified(result.status === "unverified" ? username : null);
      setLinkSent(false);
{% endif %}
    }
  }
{% endif %}
{% if sf %}

  async function submitCode(event: FormEvent<HTMLFormElement>) {
    event.preventDefault();
    if (challenge === null) return;
    setPending(true);
    const message = await signInWithCode(challenge, String(new FormData(event.currentTarget).get("code") ?? "").trim());
    setPending(false);
    if (message === null) {
      window.location.assign(next);
    } else {
      setError(message);
    }
  }

  function cancelCode() {
    setChallenge(null);
    setSecret(null);
    setError(null);
  }
{% endif %}
{% if verify %}

  async function sendLink() {
    if (unverified === null) return;
    setPending(true);
    const message = await requestEmailVerification(unverified);
    setPending(false);
    setError(message);
    setLinkSent(message === null);
  }
{% endif %}
{% if providers %}

  async function signInWith(provider: string) {
    setPending(true);
    const message = await signInWithProvider(provider, next);
    if (message !== null) {
      setPending(false);
      setError(message);
    }
  }
{% endif %}
{% if sf %}

  if (challenge !== null && secret !== null) {
    // A user of a role that must use the second factor turns it on before the first sign-in.
    return (
      <main className="flex min-h-svh items-center justify-center bg-background p-6 text-foreground">
        <div className="flex w-full max-w-sm flex-col gap-4 rounded-xl border bg-card p-6 shadow-sm">
          <h1 className="text-xl font-semibold">{{ jsx_text("Second factor") }}</h1>
          <p className="text-sm">{{ jsx_text("Your role must use a second factor. Turn it on to sign in.") }}</p>
          <SecondFactorSetup secret={secret} challenge={challenge} onDone={() => window.location.assign(next)} />
          <button type="button" onClick={cancelCode} className="text-sm font-medium underline underline-offset-4">
            {{ jsx_text("Cancel") }}
          </button>
        </div>
      </main>
    );
  }

  if (challenge !== null) {
    return (
      <main className="flex min-h-svh items-center justify-center bg-background p-6 text-foreground">
        <form onSubmit={submitCode} className="flex w-full max-w-sm flex-col gap-4 rounded-xl border bg-card p-6 shadow-sm">
          <h1 className="text-xl font-semibold">{{ jsx_text(definition.app.title) }}</h1>
          <label className="flex flex-col gap-1.5 text-sm font-medium">
            {{ jsx_text("Code of the authenticator app") }}
            <input
              name="code"
              autoComplete="one-time-code"
              minLength={6}
              maxLength={40}
              required
              className="h-9 rounded-md border bg-background px-3 text-sm font-normal"
            />
          </label>
          <p className="text-sm text-muted-foreground">{{ jsx_text("Without the app, enter a recovery code.") }}</p>
          {error && (
            <p role="alert" className="text-sm text-destructive">
              {error}
            </p>
          )}
          <button
            type="submit"
            disabled={pending}
            className="h-9 rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground disabled:opacity-50"
          >
            {{ jsx_text("Sign in") }}
          </button>
          <button type="button" onClick={cancelCode} className="text-sm font-medium underline underline-offset-4">
            {{ jsx_text("Cancel") }}
          </button>
        </form>
      </main>
    );
  }
{% endif %}

  return (
    <main className="flex min-h-svh items-center justify-center bg-background p-6 text-foreground">
      <{{ card }} className="flex w-full max-w-sm flex-col gap-4 rounded-xl border bg-card p-6 shadow-sm">
        <h1 className="text-xl font-semibold">{{ jsx_text(definition.app.title) }}</h1>
{% if password %}
        <label className="flex flex-col gap-1.5 text-sm font-medium">
          {{ jsx_text(f.label or (definition.auth.username_field | replace("_", " ") | capitalize)) }}
          <input
            name="username"
            type="{{ 'email' if f.type == 'email' else 'text' }}"
            autoComplete="username"
            required
            className="h-9 rounded-md border bg-background px-3 text-sm font-normal"
          />
        </label>
        <label className="flex flex-col gap-1.5 text-sm font-medium">
          {{ jsx_text("Password") }}
          <input
            name="password"
            type="password"
            autoComplete="current-password"
            required
            className="h-9 rounded-md border bg-background px-3 text-sm font-normal"
          />
        </label>
{% endif %}
        {error && (
          <p role="alert" className="text-sm text-destructive">
            {error}
          </p>
        )}
{% if verify %}
        {linkSent ? (
          <p role="status" className="text-sm"> {{ trace(definition.auth.sign_up.verify_email.id, jsx=True) }}
            {{ jsx_text("If the user name needs a confirmation, the user gets a message with a link.") }}
          </p>
        ) : (
          unverified !== null && (
            <button
              type="button"
              disabled={pending}
              onClick={sendLink}
              className="h-9 rounded-md border bg-background px-4 text-sm font-medium hover:bg-accent disabled:opacity-50"
            >
              {{ jsx_text("Send the link again") }}
            </button>
          )
        )}
{% endif %}
{% if password %}
        <button
          type="submit"
          disabled={pending}
          className="h-9 rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground disabled:opacity-50"
        >
          {{ jsx_text("Sign in") }}
        </button>
{% endif %}
{% if password and providers %}
        <p className="text-center text-xs text-muted-foreground">{{ jsx_text("or") }}</p>
{% endif %}
{% for name, p in providers.items() %}
        <button
          type="button"
          disabled={pending}
          onClick={() => signInWith({{ name | tojson }})}
          className="h-9 rounded-md border bg-background px-4 text-sm font-medium hover:bg-accent disabled:opacity-50"
        > {{ trace(p.id, jsx=True) }}
          {{ jsx_text(p.title or name) }}
        </button>
{% endfor %}
{% if auth_pages.password_reset %}
        <Link href="/forgot-password" className="text-sm font-medium underline underline-offset-4"> {{ trace(definition.auth.password_reset.id, jsx=True) }}
          {{ jsx_text("Did you forget the password?") }}
        </Link>
{% endif %}
{% if auth_pages.sign_up %}
        <p className="text-sm text-muted-foreground"> {{ trace(definition.auth.sign_up.id, jsx=True) }}
          {{ jsx_text("Do you need an account?") }}{" "}
          <Link href={`/sign-up?next=${encodeURIComponent(next)}`} className="font-medium text-foreground underline underline-offset-4">
            {{ jsx_text("Sign up") }}
          </Link>
        </p>
{% endif %}
      </{{ card.split(" ")[0] }}>
    </main>
  );
}
