{% set u = definition.entities[definition.auth.user_entity] %}
{% set f = u.fields[definition.auth.username_field] %}
{{ trace_header(definition.auth.password_reset.id) }}
"use client";

import { type FormEvent, useState } from "react";

import { requestPasswordReset } from "@/shared/auth";
import { Link } from "@/shared/lib/router";

/** The form that asks for a reset link with the user name. The app sends the link to the user. */
export function ForgotPasswordForm() {
  const [error, setError] = useState<string | null>(null);
  const [sent, setSent] = useState(false);
  const [pending, setPending] = useState(false);

  async function submit(event: FormEvent<HTMLFormElement>) {
    event.preventDefault();
    const data = new FormData(event.currentTarget);
    setPending(true);
    const message = await requestPasswordReset(String(data.get("username") ?? ""));
    setPending(false);
    setError(message);
    setSent(message === null);
  }

  return (
    <main className="flex min-h-svh items-center justify-center bg-background p-6 text-foreground">
      <form onSubmit={submit} className="flex w-full max-w-sm flex-col gap-4 rounded-xl border bg-card p-6 shadow-sm">
        <h1 className="text-xl font-semibold">{{ jsx_text("Reset the password") }}</h1>
        {sent ? (
          <p role="status" className="text-sm">
            {{ jsx_text("If the user name exists, the user gets a message with a reset link.") }}
          </p>
        ) : (
          <>
            <p className="text-sm text-muted-foreground">
              {{ jsx_text("Enter your user name. The app sends you a link to set a new password.") }}
            </p>
            <label className="flex flex-col gap-1.5 text-sm font-medium">
              {{ jsx_text(f.label or (definition.auth.username_field | replace("_", " ") | capitalize)) }}
              <input
                name="username"
                type="{{ 'email' if f.type == 'email' else 'text' }}"
                autoComplete="username"
                required
                className="h-9 rounded-md border bg-background px-3 text-sm font-normal"
              />
            </label>
            {error && (
              <p role="alert" className="text-sm text-destructive">
                {error}
              </p>
            )}
            <button
              type="submit"
              disabled={pending}
              className="h-9 rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground disabled:opacity-50"
            >
              {{ jsx_text("Send the link") }}
            </button>
          </>
        )}
        <Link href="/sign-in" className="text-sm font-medium underline underline-offset-4">
          {{ jsx_text("Go to the sign-in") }}
        </Link>
      </form>
    </main>
  );
}
