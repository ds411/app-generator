"use client";

import { type FormEvent, useState } from "react";

import { confirmPasswordReset } from "@/shared/auth";
import { Link } from "@/shared/lib/router";

/** The lowest number of characters of a new password. */
const MIN_PASSWORD_LENGTH = {{ definition.auth.min_password_length }};

/** The form that sets a new password with the token of a reset link. */
export function ResetPasswordForm({ token }: { token: string }) {
  const [error, setError] = useState<string | null>(token ? null : {{ tr(js("The reset link is not valid, was used, or has ended.")) }});
  const [done, setDone] = useState(false);
  const [pending, setPending] = useState(false);

  async function submit(event: FormEvent<HTMLFormElement>) {
    event.preventDefault();
    const password = String(new FormData(event.currentTarget).get("password") ?? "");
    if (password.length < MIN_PASSWORD_LENGTH) {
      setError({{ js_format("Use {count} or more characters.", count="String(MIN_PASSWORD_LENGTH)") }});
      return;
    }
    setPending(true);
    const message = await confirmPasswordReset(token, password);
    setPending(false);
    setError(message);
    setDone(message === null);
  }

  return (
    <main className="flex min-h-svh items-center justify-center bg-background p-6 text-foreground">
      <form onSubmit={submit} className="flex w-full max-w-sm flex-col gap-4 rounded-xl border bg-card p-6 shadow-sm">
        <h1 className="text-xl font-semibold">{{ jsx_text("Set a new password") }}</h1>
        {done ? (
          <p role="status" className="text-sm">
            {{ jsx_text("The password is changed. Sign in with the new password.") }}
          </p>
        ) : (
          <>
            <label className="flex flex-col gap-1.5 text-sm font-medium">
              {{ jsx_text("New password") }}
              <input
                name="password"
                type="password"
                autoComplete="new-password"
                required
                className="h-9 rounded-md border bg-background px-3 text-sm font-normal"
              />
              <span className="text-sm font-normal text-muted-foreground">
                {{ jsx_format("Use {count} or more characters.", count="MIN_PASSWORD_LENGTH") }}
              </span>
            </label>
            {error && (
              <p role="alert" className="text-sm text-destructive">
                {error}
              </p>
            )}
            <button
              type="submit"
              disabled={pending || !token}
              className="h-9 rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground disabled:opacity-50"
            >
              {{ jsx_text("Set the password") }}
            </button>
          </>
        )}
        <Link href="/sign-in" className="text-sm font-medium underline underline-offset-4">
          {{ jsx_text("Go to the sign-in") }}
        </Link>
      </form>
    </main>
  );
}
