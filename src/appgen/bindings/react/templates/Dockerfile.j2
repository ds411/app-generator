# syntax=docker/dockerfile:1
{{ trace_header("app") }}
# Build the static files with pnpm, and serve them with nginx as a
# non-root user on port 8080. The build arguments NODE_IMAGE and
# NGINX_IMAGE select other images, for example a mirror of the registry.

ARG NODE_IMAGE=node:{{ react.node_version }}-alpine
ARG NGINX_IMAGE=nginxinc/nginx-unprivileged:1.29-alpine

FROM ${NODE_IMAGE} AS build
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml* ./
# A BuildKit cache keeps the pnpm store between builds, so a new build
# downloads only the packages that changed.
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --store-dir /pnpm/store
COPY . .
{% if react.api %}
# The URL of the FastAPI app, as the browser reaches it.
ARG VITE_API_URL=http://localhost:8000
ENV VITE_API_URL=${VITE_API_URL}
{% for api in ts_apis.values() | rejectattr("exposed") %}
# The base URL of the API {{ api.name }}, as the browser reaches it.
ARG {{ api.browser_env }}={{ api.base_url }}
ENV {{ api.browser_env }}=${ {{- api.browser_env -}} }
{% endfor %}
{% endif %}
{% if ui_views.map_tiles %}
# The tiles of the maps (see the README). Without a value, the maps use
# the tiles of OpenStreetMap.
ARG VITE_MAP_TILES
ARG VITE_MAP_ATTRIBUTION
{% endif %}
RUN pnpm build

FROM ${NGINX_IMAGE}
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
USER nginx
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
