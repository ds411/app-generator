import type { ReactNode } from "react";
import { Navigate, useLocation, useSearchParams } from "react-router";

import { SignInForm } from "@/features/sign-in";
import { currentUserId } from "@/shared/auth";

/** Show a page that needs a signed-in user, or go to the sign-in page. */
export function RequireAuth({ children }: { children: ReactNode }) {
  const location = useLocation();
  if (currentUserId() === null) {
    const next = location.pathname + location.search;
    return <Navigate to={`/sign-in?next=${encodeURIComponent(next)}`} replace />;
  }
  return children;
}

/** The sign-in page. After the sign-in, the app opens the page in `next`. */
export function SignInRoute() {
  const [params] = useSearchParams();
  const next = params.get("next");
  return <SignInForm next={next && next.startsWith("/") ? next : "/"} />;
}
