{{ trace_header(definition.auth.id) }}
import type { ReactNode } from "react";
import { Navigate, useLocation, useSearchParams } from "react-router";

{% if auth_pages.password_reset %}
import { ResetPasswordForm } from "@/features/password-reset";
{% endif %}
import { SignInForm } from "@/features/sign-in";
{% if definition.auth.sign_up %}
import { SignUpForm } from "@/features/sign-up";
{% endif %}
{% if definition.access %}
import { NotFoundPage } from "@/pages/not-found";
import { canOpenPage, currentUserId } from "@/shared/auth";
import type { PageName } from "@/shared/config/pages";
{% else %}
import { currentUserId } from "@/shared/auth";
{% endif %}

/** Show a page that needs a signed-in user, or go to the sign-in page.{% if definition.access %} A page that the role may not open shows as not found.{% endif %} */
export function RequireAuth({ {% if definition.access %}page, {% endif %}children }: { {% if definition.access %}page: PageName; {% endif %}children: ReactNode }) {
  const location = useLocation();
  if (currentUserId() === null) {
    const next = location.pathname + location.search;
    return <Navigate to={`/sign-in?next=${encodeURIComponent(next)}`} replace />;
  }
{% if definition.access %}
  if (!canOpenPage(page)) {
    return <NotFoundPage />;
  }
{% endif %}
  return children;
}

/** The sign-in page. After the sign-in, the app opens the page in `next`. */
export function SignInRoute() {
  const [params] = useSearchParams();
  const next = params.get("next");
  return <SignInForm next={next && next.startsWith("/") ? next : "/"} />;
}
{% if definition.auth.sign_up %}

/** The sign-up page. After the sign-up, the app opens the page in `next`. */
export function SignUpRoute() {
  const [params] = useSearchParams();
  const next = params.get("next");
  return <SignUpForm next={next && next.startsWith("/") ? next : "/"} />;
}
{% endif %}
{% if auth_pages.password_reset %}

/** The page of a reset link: it sets a new password with the token of the link (ADR 0017). */
export function ResetPasswordRoute() {
  const [params] = useSearchParams();
  return <ResetPasswordForm token={params.get("token") ?? ""} />;
}
{% endif %}
