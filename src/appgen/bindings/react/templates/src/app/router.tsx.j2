{{ trace_header("app") }}
{% set default_layout = definition.ui.defaults.layout if definition.ui and definition.ui.defaults else none %}
{% set used_layouts = ui_plan.layouts | select("in", ui_plan.pages.values() | map(attribute="layout") | list + [default_layout]) | list %}
{% set bare_pages = ui_plan.pages_of(none) %}
{% set use_root = bare_pages or not default_layout %}
{% macro page_element(info) -%}
{% if definition.auth and info.name not in definition.auth.public_pages -%}
<RequireAuth{% if definition.access %} page={{ info.name | camel | tojson }}{% endif %}><{{ info.name | pascal }}Page /></RequireAuth>
{%- else -%}
<{{ info.name | pascal }}Page />
{%- endif %}
{%- endmacro %}
import { createBrowserRouter{% if used_layouts %}, Outlet{% endif %} } from "react-router";

{% if auth_pages.password_reset %}
import { ForgotPasswordForm } from "@/features/password-reset";
{% endif %}
{% for page_name in definition.pages %}
import { {{ page_name | pascal }}Page } from "@/pages/{{ page_name | kebab }}";
{% endfor %}
import { NotFoundPage } from "@/pages/not-found";
{% if used_layouts %}
import { {% for layout_name in used_layouts %}{{ layout_name | pascal }}Layout{{ ", " if not loop.last }}{% endfor %} } from "@/widgets/layouts";
{% endif %}
{% for share in shares.values() | sort(attribute="view") %}
import { {{ share.view | pascal }}SharedView } from "@/widgets/{{ share.view | kebab }}";
{% endfor %}
{% if use_root or definition.auth or ui_plan.embedded_pages %}

{% endif %}
{% if definition.auth %}
import { {% if auth_pages.connections %}ConnectionsRoute, {% endif %}{% if react.api and definition.auth.providers %}ProviderCallbackRoute, {% endif %}RequireAuth{% if auth_pages.password_reset %}, ResetPasswordRoute{% endif %}{% if auth_pages.second_factor %}, SecondFactorRoute{% endif %}, SignInRoute{% if definition.auth.sign_up %}, SignUpRoute{% endif %}{% if auth_pages.verify_email %}, VerifyEmailRoute{% endif %} } from "./auth/require-auth";
{% endif %}
{% if ui_plan.embedded_pages %}
import { EmbedLayout } from "./layout/embed-layout";
{% endif %}
{% if use_root %}
import { RootLayout } from "./layout/root-layout";
{% endif %}
{% if shares %}
import { SharedLayout } from "./layout/shared-layout";
{% endif %}

// The pages, grouped by layout. Each layout shows its pages in the outlet.
export const router = createBrowserRouter([
{% if definition.auth %}
  { path: "/sign-in", element: <SignInRoute /> }, {{ trace(definition.auth.id) }}
{% endif %}
{% if react.api and definition.auth and definition.auth.providers %}
  { path: "/auth/callback", element: <ProviderCallbackRoute /> }, {{ trace(definition.auth.id) }}
{% endif %}
{% if definition.auth and definition.auth.sign_up %}
  { path: "/sign-up", element: <SignUpRoute /> }, {{ trace(definition.auth.sign_up.id) }}
{% endif %}
{% if auth_pages.password_reset %}
  { path: "/forgot-password", element: <ForgotPasswordForm /> }, {{ trace(definition.auth.password_reset.id) }}
  { path: "/reset-password", element: <ResetPasswordRoute /> }, {{ trace(definition.auth.password_reset.id) }}
{% endif %}
{% if auth_pages.verify_email %}
  { path: "/verify-email", element: <VerifyEmailRoute /> }, {{ trace(definition.auth.sign_up.verify_email.id) }}
{% endif %}
{% if auth_pages.second_factor %}
  { path: "/second-factor", element: <SecondFactorRoute /> }, {{ trace(definition.auth.second_factor.id) }}
{% endif %}
{% if auth_pages.connections %}
  { path: "/connections", element: <ConnectionsRoute /> }, {{ trace((ts_connections | first).id) }}
{% endif %}
{% if shares %}
  {
    // The records of the secret links: without a sign-in and without the app shell (ADR 0049).
    element: <SharedLayout />,
    children: [
{% for share in shares.values() %}
      { path: {{ route_path(share.shared_path) | tojson }}, element: <{{ share.view | pascal }}SharedView /> }, {{ trace(share.page_id) }}
{% endfor %}
    ],
  },
{% endif %}
{% if ui_plan.embedded_pages %}
  {
    // The pages that other websites show in a frame: without the app shell (ADR 0032).
    element: <EmbedLayout />,
    children: [
{% for info in ui_plan.embedded_pages %}
      { path: {{ route_path(info.page.path) | tojson }}, element: {{ page_element(info) }} }, {{ trace(info.page.id) }}
{% endfor %}
    ],
  },
{% endif %}
{% for layout_name in used_layouts %}
  {
    element: (
      <{{ layout_name | pascal }}Layout>
        <Outlet />
      </{{ layout_name | pascal }}Layout>
    ),
    children: [
{% for info in ui_plan.pages_of(layout_name) %}
      { path: {{ route_path(info.page.path) | tojson }}, element: {{ page_element(info) }} }, {{ trace(info.page.id) }}
{% endfor %}
{% if layout_name == default_layout %}
      { path: "*", element: <NotFoundPage /> },
{% endif %}
    ],
  },
{% endfor %}
{% if use_root %}
  {
    element: <RootLayout />,
    children: [
{% for info in bare_pages %}
      { path: {{ route_path(info.page.path) | tojson }}, element: {{ page_element(info) }} }, {{ trace(info.page.id) }}
{% endfor %}
{% if not default_layout %}
      { path: "*", element: <NotFoundPage /> },
{% endif %}
    ],
  },
{% endif %}
]);
