{{ trace_header(element_id) }}
{% set type = name | pascal %}
{% set var = name | camel %}
{% set ops = operations_of(definition, name) | rejectattr("1.kind", "eq", "custom") | list %}
{% set lists = inverse_lists(definition, name) %}
{% set guarded = definition.access and (ops | rejectattr("0", "in", definition.auth.public_operations) | list) %}
{% macro guard(op_name) -%}
{% if definition.access and op_name not in definition.auth.public_operations %}
  requireOperation({{ op_name | tojson }}); {{ trace(definition.access.id) }}
{% endif %}
{%- endmacro %}
{% set store = "HttpStore" if react.api else "MockStore" %}
{% set events = ts_events(definition, name) %}
{# With mock data, the store applies the record rules of the entity (ADR 0018, ADR 0025). #}
{% set rule = record_rules.get(name) if not react.api else none %}
{% set auth_names = (["recordScope"] if rule else []) + (["requireOperation"] if guarded else []) %}
{% if lists or ops | selectattr("1.kind", "eq", "list") | list %}
import { {% if not react.api %}type EntityApi, {% endif %}{{ store }}, type ListQuery, type ListResult } from "@/shared/api";
{% else %}
import { {% if not react.api %}type EntityApi, {% endif %}{{ store }} } from "@/shared/api";
{% endif %}

{% if auth_names %}
import { {{ auth_names | join(", ") }} } from "@/shared/auth";

{% endif %}
{% if react.api %}
{% set api = api_entities[name] %}
import type { {{ type }}, {{ type }}Input } from "../model/types";

/** The data access of {{ type }}: the endpoints {{ api.path }} of the FastAPI app. */
export const {{ var }}Api = new HttpStore<{{ type }}, {{ type }}Input>({{ ts_value(name) }}, {{ api.path | tojson }}, {
  keys: {
{% for json, key in api.keys.items() %}
    {{ json | tojson }}: {{ key | tojson }},
{% endfor %}
  },
  numbers: {{ api.numbers | tojson }},
  filters: {{ api.filters | tojson }},
  sorts: {{ api.sorts | tojson }},
  display: { key: {{ api.display | tojson }}, search: {{ api.search | tojson }} },
{% if api.translations %}
  translations: true,
{% endif %}
});

/** The records of {{ type }} for a choice, with the text of the display field: the server searches them. */
export const {{ var }}Options = {{ var }}Api.options((item) => String(item.{{ api.display }} ?? ""));
{% if events %}

// The FastAPI app runs the events of {{ type }} (ADR 0031).
{% for event in events %}
{{ trace(event.element_id) }}
{% endfor %}
{% endif %}
{% else %}
import { {{ var }}Defaults, type {{ type }}, type {{ type }}Input } from "../model/types";
import { {{ var }}MockData } from "./{{ name | kebab }}-mock-data";

/** The data access of {{ type }}. It keeps the records in memory. */
export const {{ var }}Api: EntityApi<{{ type }}, {{ type }}Input> = new MockStore<{{ type }}, {{ type }}Input>(
  {{ ts_value(name) }},
  {{ var }}MockData,
  {{ var }}Defaults,
{% set workflows = definition.workflows.values() | selectattr("entity", "eq", name) | list %}
{% set translatable = element.fields.items() | selectattr("1.translatable") | map(attribute="0") | map("camel") | list %}
{% if workflows %}
  [
{% for w in workflows %}
    { {{ trace(w.id, scope="begin") }}
      field: {{ ts_value((members(name, element) | selectattr("name", "eq", w.field) | first).key) }},
{% if w.initial %}
      initial: {{ ts_value(w.initial) }},
{% endif %}
      transitions: [
{% for t in w.transitions.values() %}
{% for before in t.from_ %}
        [{{ ts_value(before) }}, {{ ts_value(t.to) }}], {{ trace(t.id) }}
{% endfor %}
{% endfor %}
      ],
{% if w.message %}
      message: {{ text(w.message) }},
{% endif %}
    }, {{ trace(w.id, scope="end") }}
{% endfor %}
  ],
{% elif rule or translatable %}
  [],
{% endif %}
{% if translatable %}
  {{ ts_value(translatable) }},
{% elif rule and i18n and i18n.translatable %}
  [],
{% endif %}
{% if rule %}
  {
{% for id in rule.element_ids %}
    {{ trace(id) }}
{% endfor %}
    scopeOf: (action) => recordScope({{ ts_value(name) }}, action),
{% if rule.path %}
    path: [
{% for step in rule.path %}
      { key: {{ ts_value(step.key) }}, target: {{ ts_value(step.target) }} }, {{ trace(step.element_id) }}
{% endfor %}
    ],
{% else %}
    path: [],
{% endif %}
{% if rule.direct %}
    owner: {{ ts_value(rule.path[0].key) }},
{% endif %}
  },
{% endif %}
{% if events %}
).withEvents({
  // The events (ADR 0031). The store imports the extension file of an
  // operation when its event runs, because the operation imports the store.
{% for event in events | rejectattr("kind", "eq", "transition") %}
{% if event.kind == "changed" %}
  changed: { {{ trace(event.element_id, scope="begin") }}
    keys: {{ ts_value(event.keys | list) }},
    run: async (record) => {
      const { {{ event.function }} } = await import({{ ts_value(event.module) }});
      await {{ event.call(parse=False) }};
    },
  }, {{ trace(event.element_id, scope="end") }}
{% else %}
  {{ event.kind }}: async (record) => { {{ trace(event.element_id, scope="begin") }}
    const { {{ event.function }} } = await import({{ ts_value(event.module) }});
    await {{ event.call(parse=False) }};
  }, {{ trace(event.element_id, scope="end") }}
{% endif %}
{% endfor %}
{% set transitions = events | selectattr("kind", "eq", "transition") | list %}
{% if transitions %}
  transitions: [
{% for event in transitions %}
    { {{ trace(event.element_id, scope="begin") }}
      field: {{ ts_value(event.field) }},
      from: {{ ts_value(event.before | list) }},
      to: {{ ts_value(event.after) }},
      run: async (record) => {
        const { {{ event.function }} } = await import({{ ts_value(event.module) }});
        await {{ event.call(parse=False) }};
      },
    }, {{ trace(event.element_id, scope="end") }}
{% endfor %}
  ],
{% endif %}
});
{% else %}
);
{% endif %}
{% endif %}
{% for op_name, op in ops %}

{% if op.description %}
/** {{ op.description }} */
{% endif %}
{% if op.kind == "create" %}
export function {{ op_name | camel }}(input: {{ type }}Input): Promise<{{ type }}> { {{ trace(op.id) }}
{{ guard(op_name) }}  return {{ var }}Api.create(input);
}
{% elif op.kind == "read" %}
export function {{ op_name | camel }}(id: string): Promise<{{ type }}> { {{ trace(op.id) }}
{{ guard(op_name) }}  return {{ var }}Api.get(id);
}
{% elif op.kind == "update" %}
export function {{ op_name | camel }}(id: string, patch: Partial<{{ type }}Input>): Promise<{{ type }}> { {{ trace(op.id) }}
{{ guard(op_name) }}  return {{ var }}Api.update(id, patch);
}
{% elif op.kind == "delete" %}
export function {{ op_name | camel }}(id: string): Promise<void> { {{ trace(op.id) }}
{{ guard(op_name) }}  return {{ var }}Api.remove(id);
}
{% elif op.kind == "list" %}
export function {{ op_name | camel }}(query?: ListQuery<{{ type }}>): Promise<ListResult<{{ type }}>> { {{ trace(op.id) }}
{{ guard(op_name) }}  return {{ var }}Api.list(query);
}
{% endif %}
{% endfor %}
{% for owner, relation_name, relation in lists %}

/** The {{ type }} records of one {{ owner | pascal }}. */
export function list{{ relation_name | pascal }}Of{{ owner | pascal }}( {{ trace(relation.id) }}
  {{ owner | camel }}Id: string,
  query: ListQuery<{{ type }}> = {},
): Promise<ListResult<{{ type }}>> {
  const filters = [...(query.filters ?? []), { field: "{{ relation.inverse | camel }}Id" as const, op: "eq" as const, value: {{ owner | camel }}Id }];
  return {{ var }}Api.list({ ...query, filters });
}
{% endfor %}
