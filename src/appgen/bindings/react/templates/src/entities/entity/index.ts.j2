{{ trace_header(element_id) }}
{% set type = name | pascal %}
{% set var = name | camel %}
{# An operation with lines (ADR 0035) is in its own feature slice. #}
{% set ops = operations_of(definition, name) | rejectattr("1.kind", "in", ("custom", "query")) | rejectattr("1.lines") | map(attribute=0) | map("camel") | list %}
{% set lists = inverse_lists(definition, name) %}
export {
  {{ var }}Api,
{% if react.api %}
  {{ var }}Options,
{% endif %}
{% if element.file_fields and definition.storage and (api_entities[name].files if react.api else true) %}
  {{ var }}Files,
{% endif %}
{% if element.history %}
  {{ var }}History,
{% endif %}
{% if shares.get(name) %}
  {{ var }}Sharing,
{% endif %}
{% if react.ranges.get(name) %}
  {{ var }}Ranges,
{% endif %}
{% for op in ops %}
  {{ op }},
{% endfor %}
{% for owner, relation_name, relation in lists %}
  list{{ relation_name | pascal }}Of{{ owner | pascal }},
{% endfor %}
{% if shares.get(name) %}
  read{{ name | pascal }}Shared,
{% endif %}
} from "./api/{{ name | kebab }}-api";
{% if not react.api %}
export { {{ var }}MockData } from "./api/{{ name | kebab }}-mock-data";
{% endif %}
export { {{ var }}Meta } from "./model/meta";
{% if ui_forms.used %}
{% set customs = operations_of(definition, name) | selectattr("1.kind", "in", ("custom", "query")) | selectattr("1.params") | map(attribute=0) | map("camel") | list %}
export {
  {{ var }}InputSchema,
  {{ var }}PatchSchema,
{% for op in customs %}
  {{ op }}ParamsSchema,
{% endfor %}
{% for item in line_items(definition, name) %}
  {{ item.schema }},
{% endfor %}
} from "./model/schema";
{% endif %}
export * from "./model/types";
