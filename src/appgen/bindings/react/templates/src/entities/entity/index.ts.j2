{{ trace_header(element_id) }}
{% set type = name | pascal %}
{% set var = name | camel %}
{% set ops = operations_of(definition, name) | rejectattr("1.kind", "eq", "custom") | map(attribute=0) | map("camel") | list %}
{% set lists = inverse_lists(definition, name) %}
export {
  {{ var }}Api,
{% for op in ops %}
  {{ op }},
{% endfor %}
{% for owner, relation_name, relation in lists %}
  list{{ relation_name | pascal }}Of{{ owner | pascal }},
{% endfor %}
} from "./api/{{ name | kebab }}-api";
export { {{ var }}MockData } from "./api/{{ name | kebab }}-mock-data";
export { {{ var }}Meta } from "./model/meta";
export * from "./model/types";
