{{ trace_header(element_id) }}
{% set params = route_params(element.path) %}
{% set custom = element.content is not none and element.content.custom %}
{% set view = element.content.view if element.content is not none and element.content.view in ui_views.list_views else none %}
{% set form = element.content.form if element.content is not none else none %}
{% set detail = element.content.view if params and element.content is not none and element.content.view in ui_views.detail_views else none %}
{% set dashboard = element.content.dashboard if element.content is not none and element.content.dashboard else none %}
{% set id_param = params[-1] if detail else none %}
{% set api_view = element.content.view if element.content is not none and element.content.view in ui_views.api_views else none %}
{% set api_route = api_view and ui_views.api_view_plan(api_view).props %}
{# A view of a query loads its rows with the function of the query (ADR 0045). #}
{% set query_view = element.content.view if element.content is not none and element.content.view in ui_views.query_views else none %}
{% set query_route = query_view and ui_views.query_view_plan(query_view).route_params %}
{% set description = element.meta.description if element.meta else none %}
{# A description that a field of the record of the page gives (`$record.<field>`). #}
{% set description_field = description[8:] if description and description.startswith("$record.") else none %}
{# The button "Share" of the secret links (ADR 0049). #}
{% set share = shares.get(element.entity) if detail and element.share else none %}
{# The other users on the record (ADR 0052): only with the FastAPI app. #}
{% set presence = presences.get(name) if detail else none %}
{% set entity_names = ([(element.entity | camel) ~ "Api"] if description_field else []) + ([(element.entity | camel) ~ "Presence"] if presence else []) + ([(element.entity | camel) ~ "Sharing"] if share else []) %}
{% if entity_names %}
import { {{ entity_names | join(", ") }} } from "@/entities/{{ element.entity | kebab }}";
{% endif %}
{% if form %}
import { {{ form | pascal }}FormPage } from "@/features/{{ form | kebab }}-form";
{% endif %}
{% if presence %}
import { RecordPresence } from "@/features/record-presence";
{% endif %}
{% if share %}
import { ShareButton } from "@/features/share-record";
{% endif %}
{% if (params and not view and not dashboard and not api_view and not query_view) or form or api_route or query_route or description_field %}
import { useParams } from "@/shared/lib/router";
{% endif %}
{% if description %}
import { useDescription } from "@/shared/lib/use-description";
{% endif %}
{% if description_field %}
import { useResource } from "@/shared/lib/use-resource";
{% endif %}
{% if dashboard %}
import { {{ dashboard | pascal }}Dashboard } from "@/widgets/{{ dashboard | kebab }}";
{% endif %}
{% set page_actions = ui_views.action_bar(element_id).actions %}
{% if page_actions %}
import { {{ name | pascal }}PageActions } from "@/widgets/page-actions";
{% endif %}
import { PageHeader } from "@/widgets/page-header";
{% if view or detail or api_view or query_view %}
import { {{ (view or detail or api_view or query_view) | pascal }}View } from "@/widgets/{{ (view or detail or api_view or query_view) | kebab }}";
{% endif %}
{% if custom %}

import { {{ name | pascal }}Content } from "./{{ name | kebab }}-content.gen";
{% endif %}

{% for action_id in ui_views.action_bar(element_id).hidden_actions %}
// The top bar has the same action, so the page header does not show it.
{{ trace(action_id) }}

{% endfor %}
{% if description_field %}
/** The description of the page: a field of its record, when the record is there. */
function usePageDescription(): string | null {
  const { {{ params[-1] }}{% if params[-1] != "id" %}: id{% endif %} } = useParams();
  const record = useResource(`{{ name }}:meta:${id}`, () => {{ element.entity | camel }}Api.get(id ?? ""));
  return record.status === "success" ? (record.data.{{ description_field | camel }} ?? null) : null;
}

{% endif %}
export function {{ name | pascal }}Page() {
{% if description_field %}
  useDescription(usePageDescription()); {{ trace(element.meta.id) }}
{% elif description %}
  useDescription({{ tr(js(description)) }}); {{ trace(element.meta.id) }}
{% endif %}
{% if (custom and element.entity) or form %}
  const params = useParams();
{% elif detail %}
  const { {{ id_param }}{% if id_param != id_param | camel %}: {{ id_param | camel }}{% endif %} } = useParams();
{% elif api_route or query_route %}
  const route = useParams();
{% elif params and not view and not dashboard and not api_view and not query_view %}
  const { {% for param in params %}{{ param }}{% if param != param | camel %}: {{ param | camel }}{% endif %}{{ ", " if not loop.last }}{% endfor %} } = useParams();
{% endif %}
{% set regions = page_regions(element, page_actions | length > 0 or share is not none or presence is not none) %}
{% set share_button %}{% if share %}<ShareButton sharing={ {{- element.entity | camel }}Sharing} id={ {{- id_param | camel }} ?? ""} path={{ js(share.shared_prefix) }}{% if definition.access %} operation={{ js(share.update) }}{% endif %} />{% endif %}{% endset %}
{% set presence_bar %}{% if presence %}<RecordPresence presence={ {{- element.entity | camel }}Presence} id={ {{- id_param | camel }} ?? ""} />{% endif %}{% endset %}
{% set header_items = ([presence_bar] if presence else []) + (["<" ~ (name | pascal) ~ "PageActions />"] if page_actions else []) + ([share_button] if share else []) %}
{% set content %}
{% if custom %}
<{{ name | pascal }}Content{% if element.entity %} params={params}{% endif %} />
{% elif view %}
<{{ view | pascal }}View /> {{ trace(element.content.id, jsx=True) }}
{% elif detail %}
<{{ detail | pascal }}View id={ {{- id_param | camel }} ?? ""} /> {{ trace(element.content.id, jsx=True) }}
{% elif api_view %}
<{{ api_view | pascal }}View{% if api_route %} route={route}{% endif %} /> {{ trace(element.content.id, jsx=True) }}
{% elif query_view %}
<{{ query_view | pascal }}View{% if query_route %} route={route}{% endif %} /> {{ trace(element.content.id, jsx=True) }}
{% elif dashboard %}
<{{ dashboard | pascal }}Dashboard /> {{ trace(element.content.id, jsx=True) }}
{% elif form %}
<{{ form | pascal }}FormPage routeParams={params} /> {{ trace(element.content.id, jsx=True) }}
{% else %}
{% for param in params %}
<p>{{ param }}: {{ "{" }}{{ param | camel }}{{ "}" }}</p>
{% endfor %}
{% endif %}
{% endset %}
  return (
{% if regions %}
    <div className="{{ page_grid(element) }}"> {{ trace(element.arrangement.id, jsx=True) }}
{% for region in regions %}
{% if region.name == "title" %}
      <PageHeader
        title={{ jsx_attr(element.title) }}
{% if detail %}
        label
{% endif %}
{% if element.description %}
        description={{ jsx_attr(element.description) }}
{% endif %}
        className={{ js("mb-0 " ~ region.classes) }}
      />
{% elif region.name == "actions" %}
      <div className={{ js(region.classes) }}>
{% for item in header_items %}
        {{ item }}
{% endfor %}
      </div>
{% else %}
      <div className={{ js(region.classes) }}>
{{ content | indent(8, true) }}      </div>
{% endif %}
{% endfor %}
    </div>
{% else %}
    <>
      <PageHeader
        title={{ jsx_attr(element.title) }}
{% if detail %}
        label
{% endif %}
{% if element.description %}
        description={{ jsx_attr(element.description) }}
{% endif %}
{% if header_items | length > 1 %}
        actions={
          <>
{% for item in header_items %}
            {{ item }}
{% endfor %}
          </>
        }
{% elif header_items %}
        actions={ {{- header_items[0] -}} }
{% endif %}
      />
{{ content | indent(6, true) }}    </>
{% endif %}
  );
}
