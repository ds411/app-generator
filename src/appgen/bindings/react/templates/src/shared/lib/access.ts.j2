// The permissions of the signed-in user in the browser (ADR 0012): the
// menus, the links, and the actions show only the pages and the
// operations that the role allows. The session of the browser tab gives
// the role.{% if react.api %} The API checks each request again.{% endif %}

{% if record_rules %}
import { currentRole, currentUserId } from "@/shared/auth";
import type { PageName } from "@/shared/config/pages";
import { type RecordScope, recordScopeOf, roleMayCall, roleMayOpenPage } from "@/shared/lib/permissions";
{% else %}
import { currentRole } from "@/shared/auth";
import type { PageName } from "@/shared/config/pages";
import { roleMayCall, roleMayOpenPage } from "@/shared/lib/permissions";
{% endif %}

export type Access = {
  /** Return true if the user may open a page. */
  canOpenPage: (page: PageName) => boolean;
  /** Return true if the user may call an operation. */
  canCall: (operation: string) => boolean;
{% if record_rules %}
  /**
   * Return the records that the user may change, of the record rule of the
   * role (ADR 0018, ADR 0025), or null for all records. A form then gives a
   * new record to the user, sets the values that the rule allows, and does
   * not show these fields.
   */
  scopeOf: (entity: string) => RecordScope | null;
{% endif %}
};

/** Return the permissions of the signed-in user. */
export function useAccess(): Access {
  const role = currentRole();
{% if record_rules %}
  const userId = currentUserId();
{% endif %}
  return {
    canOpenPage: (page) => roleMayOpenPage(role, page),
    canCall: (operation) => roleMayCall(role, operation),
{% if record_rules %}
    scopeOf: (entity) => recordScopeOf(role, userId, entity, "change"),
{% endif %}
  };
}
