{{ trace_header("app") }}
// The HTTP client of the FastAPI app (`x-react-data: api`). The build
// variable VITE_API_URL sets the URL of the API.
{% if i18n %}
// The requests ask for the selected language (`Accept-Language`), so the
// messages of the API are in it.

import { getLocale } from "@/shared/lib/i18n";
{% endif %}

/** The URL of the API, without a slash at the end. */
export const API_URL: string = (import.meta.env.VITE_API_URL ?? "http://localhost:8000").replace(/\/$/, "");

const TOKEN_KEY = {{ (app.name ~ "-token") | tojson }};

/** Return the bearer token of the signed-in user, or null. */
export function accessToken(): string | null {
  try {
    return window.sessionStorage.getItem(TOKEN_KEY);
  } catch {
    return null;
  }
}

/** Keep the bearer token of the signed-in user in the browser tab, or delete it (null). */
export function setAccessToken(token: string | null): void {
  try {
    if (token === null) {
      window.sessionStorage.removeItem(TOKEN_KEY);
    } else {
      window.sessionStorage.setItem(TOKEN_KEY, token);
    }
  } catch {
    // No storage: the session ends with the page.
  }
{% if react.live and definition.auth %}
  for (const listener of tokenListeners) {
    listener();
  }
{% endif %}
}
{% if react.live and definition.auth %}

const tokenListeners = new Set<() => void>();

/**
 * Call a listener after each new token, for example the stream of the live
 * updates (ADR 0051). Return the function that removes it.
 */
export function subscribeAccessToken(listener: () => void): () => void {
  tokenListeners.add(listener);
  return () => {
    tokenListeners.delete(listener);
  };
}
{% endif %}
{% if guests %}

{{ trace(guests.element_id) }}
// A visitor without a sign-in is a guest (ADR 0050): the guest token of
// the API gives the guest operations on the records of the guest. The
// local storage keeps it after the tab closes, until its time ends. A
// request without a sign-in sends the guest token.
const GUEST_KEY = {{ (app.name ~ "-guest") | tojson }};

/** Return the guest token of the visitor, or null without one or after its time. */
export function guestToken(): string | null {
  try {
    const value = JSON.parse(window.localStorage.getItem(GUEST_KEY) ?? "null") as { token: string; end: number } | null;
    return value !== null && value.end > Date.now() ? value.token : null;
  } catch {
    return null;
  }
}

/** Keep the guest token of the visitor for `seconds`, or delete it (null). */
export function setGuestToken(token: string | null, seconds = 0): void {
  try {
    if (token === null) {
      window.localStorage.removeItem(GUEST_KEY);
    } else {
      window.localStorage.setItem(GUEST_KEY, JSON.stringify({ token, end: Date.now() + seconds * 1000 }));
    }
  } catch {
    // No storage: the guest has no records after the page.
  }
}

let guestRequest: Promise<void> | null = null;

/**
 * Get a guest token from the API (`POST /auth/guest`) for a visitor without
 * a sign-in and without a guest token: a guest operation needs one.
 */
export function startGuestSession(): Promise<void> {
  if (accessToken() !== null || guestToken() !== null) {
    return Promise.resolve();
  }
  guestRequest ??= apiRequest("POST", "/auth/guest")
    .then((answer) => {
      const token = answer as { access_token: string; expires_in: number };
      setGuestToken(token.access_token, token.expires_in);
    })
    .finally(() => {
      guestRequest = null;
    });
  return guestRequest;
}
{% endif %}

{% if ts_apis.values() | selectattr("exposed") | list %}
/**
 * A `fetch` function for the clients of the exposed third-party APIs
 * (`expose`), which call the endpoints of the FastAPI app: it adds the
 * bearer token of the signed-in user{{ " and the selected language" if i18n }}.
 */
export const apiFetch: typeof fetch = (input, init) => {
  const headers = new Headers(init?.headers);
{% if i18n %}
  headers.set("Accept-Language", getLocale());
{% endif %}
  const token = accessToken();
  if (token) {
    headers.set("Authorization", `Bearer ${token}`);
  }
  return fetch(input, { ...init, headers });
};

{% endif %}
/** An error response of the API. The message is the detail of the problem (RFC 9457). */
export class ApiError extends Error {
  readonly status: number;

  constructor(status: number, message: string) {
    super(message);
    this.name = "ApiError";
    this.status = status;
  }
}

{% if definition.storage %}
/** Send a request to the API, and return the JSON body of the response. A form data body is multipart. */
export async function apiRequest(method: string, path: string, body?: unknown): Promise<unknown> {
  const headers: Record<string, string> = { Accept: "application/json" };
{% if i18n %}
  headers["Accept-Language"] = getLocale();
{% endif %}
  if (body !== undefined && !(body instanceof FormData)) {
    headers["Content-Type"] = "application/json";
  }
{% else %}
/** Send a request to the API, and return the JSON body of the response. */
export async function apiRequest(method: string, path: string, body?: unknown): Promise<unknown> {
  const headers: Record<string, string> = { Accept: "application/json" };
{% if i18n %}
  headers["Accept-Language"] = getLocale();
{% endif %}
  if (body !== undefined) {
    headers["Content-Type"] = "application/json";
  }
{% endif %}
  const token = accessToken(){{ " ?? guestToken()" if guests }};
  if (token) {
    headers.Authorization = `Bearer ${token}`;
  }
  const response = await fetch(API_URL + path, {
    method,
    headers,
{% if definition.storage %}
    body: body === undefined || body instanceof FormData ? body : JSON.stringify(body),
{% else %}
    body: body === undefined ? undefined : JSON.stringify(body),
{% endif %}
  });
  if (!response.ok) {
    let message = response.statusText || {{ js_format("The API gave the status {status}.", status="response.status") }};
    try {
      const problem = (await response.json()) as { detail?: string | null; title?: string };
      message = problem.detail ?? problem.title ?? message;
    } catch {
      // The body is not JSON: keep the status text.
    }
    throw new ApiError(response.status, message);
  }
  return response.status === 204 ? undefined : response.json();
}
