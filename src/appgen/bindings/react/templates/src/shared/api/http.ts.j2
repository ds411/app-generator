{{ trace_header("app") }}
// The HTTP client of the FastAPI app (`x-react-data: api`). The build
// variable VITE_API_URL sets the URL of the API.
{% if i18n %}
// The requests ask for the selected language (`Accept-Language`), so the
// messages of the API are in it.

import { getLocale } from "@/shared/lib/i18n";
{% endif %}

/** The URL of the API, without a slash at the end. */
export const API_URL: string = (import.meta.env.VITE_API_URL ?? "http://localhost:8000").replace(/\/$/, "");

const TOKEN_KEY = {{ (app.name ~ "-token") | tojson }};

/** Return the bearer token of the signed-in user, or null. */
export function accessToken(): string | null {
  try {
    return window.sessionStorage.getItem(TOKEN_KEY);
  } catch {
    return null;
  }
}

/** Keep the bearer token of the signed-in user in the browser tab, or delete it (null). */
export function setAccessToken(token: string | null): void {
  try {
    if (token === null) {
      window.sessionStorage.removeItem(TOKEN_KEY);
    } else {
      window.sessionStorage.setItem(TOKEN_KEY, token);
    }
  } catch {
    // No storage: the session ends with the page.
  }
}

/** An error response of the API. The message is the detail of the problem (RFC 9457). */
export class ApiError extends Error {
  readonly status: number;

  constructor(status: number, message: string) {
    super(message);
    this.name = "ApiError";
    this.status = status;
  }
}

/** Send a request to the API, and return the JSON body of the response. */
export async function apiRequest(method: string, path: string, body?: unknown): Promise<unknown> {
  const headers: Record<string, string> = { Accept: "application/json" };
{% if i18n %}
  headers["Accept-Language"] = getLocale();
{% endif %}
  if (body !== undefined) {
    headers["Content-Type"] = "application/json";
  }
  const token = accessToken();
  if (token) {
    headers.Authorization = `Bearer ${token}`;
  }
  const response = await fetch(API_URL + path, {
    method,
    headers,
    body: body === undefined ? undefined : JSON.stringify(body),
  });
  if (!response.ok) {
    let message = response.statusText || {{ js_format("The API gave the status {status}.", status="response.status") }};
    try {
      const problem = (await response.json()) as { detail?: string | null; title?: string };
      message = problem.detail ?? problem.title ?? message;
    } catch {
      // The body is not JSON: keep the status text.
    }
    throw new ApiError(response.status, message);
  }
  return response.status === 204 ? undefined : response.json();
}
