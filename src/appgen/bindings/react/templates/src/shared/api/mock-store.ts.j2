  /**
   * Check the workflows of the entity. `before` is undefined for a new
   * record, which must start in the initial state. A change to the same
   * state, and a change from or to no state, pass.
   */
  private checkWorkflows(before: T | undefined, after: T): void {
    for (const workflow of this.workflows) {
      const to: unknown = (after as Record<string, unknown>)[workflow.field];
      if (to === null || to === undefined) continue;
      if (before === undefined) {
        if (workflow.initial !== undefined && to !== workflow.initial) {
          throw new TransitionError(
            workflow.message ?? {{ js_format("A new {entity} starts with the state {initial}, not {state}.", entity="this.entity", initial="workflow.initial", state="String(to)") }},
          );
        }
        continue;
      }
      const from: unknown = (before as Record<string, unknown>)[workflow.field];
      if (from === null || from === undefined || from === to) continue;
      if (!workflow.transitions.some(([a, b]) => a === from && b === to)) {
        throw new TransitionError(
          workflow.message ?? {{ js_format("The state of {entity} cannot change from {before} to {after}.", entity="this.entity", before="String(from)", after="String(to)") }},
        );
      }
    }
  }

{% if memberships %}
  /** Return true if the user may use a record for a call: without a record rule or a membership, all records. */
  private allows(record: T, action: RecordAction, kind?: CallKind): boolean {
    const scope = this.scopeFor(action, kind);
    return scope === null || this.inScope(record, scope);
  }

  /**
   * Return the records that the user may use for a call: the record rule of
   * the role, or the scopes of the memberships whose role gives the
   * operation of the call (ADR 0048). Null for all records.
   */
  private scopeFor(action: RecordAction, kind?: CallKind): RecordScope | null {
    const operation = kind === undefined ? undefined : this.rules?.operations?.[kind];
    return this.rules?.scopeOf(action, operation) ?? null;
  }

  /**
   * Return true if a record has the values of a scope, belongs to its user
   * if the scope has an owner, and is in a scope of the memberships if the
   * scope has them.
   */
  private inScope(record: T, scope: RecordScope): boolean {
    return (
      hasValuesOf(scope, record) &&
      (!scope.owner || this.ownersOf(record).includes(scope.user)) &&
      (scope.scopes === undefined || this.inScopes(record, scope.scopes))
    );
  }

  /** Return true if a record is in one of the scope records with the IDs. */
  private inScopes(record: T, scopes: readonly string[]): boolean {
    return this.scopesOf(record).some((id) => scopes.includes(id));
  }

  /** Return the IDs of the scope records of a record: the record of the scope entity, else the end of its path. */
  private scopesOf(record: T): string[] {
    const steps = this.rules?.scope;
    if (steps === undefined) return [];
    return steps.length === 0 ? [record.id] : pathIds(record, steps);
  }
