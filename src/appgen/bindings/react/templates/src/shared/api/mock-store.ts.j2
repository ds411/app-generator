{% if react.events %}
  /**
   * Return the operations of the events of a change: the transitions with
   * `run` first, then `changed` if a field that it watches has a new value.
   */
  private changeEvents(before: T, after: T): EventOperation<T>[] {
    const was = before as Record<string, unknown>;
    const now = after as Record<string, unknown>;
    const operations = (this.events.transitions ?? [])
      .filter(({ field, from, to }) => now[field] === to && was[field] !== to && from.includes(String(was[field])))
      .map(({ run }) => run);
    const changed = this.events.changed;
    if (changed !== undefined && changed.keys.some((key) => !sameValue(was[key], now[key]))) {
      operations.push(changed.run);
    }
    return operations;
  }

  /** Run the operations of the events of a change, in order. A change in an operation starts no event. */
  private async runEvents(record: T, operations: EventOperation<T>[]): Promise<void> {
    if (operations.length === 0 || inEvent) {
      return;
    }
    inEvent = true;
    try {
      for (const operation of operations) {
        await operation(this.show(record));
      }
    } finally {
      inEvent = false;
    }
  }

  /** Return the stored record with the ID of a record, as the operations of the events leave it. */
  private current(record: T): T {
    return this.records.find((item) => item.id === record.id) ?? record;
  }

{% endif %}
{% if react.history %}
  /**
   * Add an entry to the change log, with the old and the new value of each
   * kept field that changed. A change without a new value adds no entry.
   */
  private log(id: string, action: HistoryAction, before: T | undefined, after: T | undefined): void {
    if (this.historyMembers.length === 0) {
      return;
    }
    const old = before === undefined ? {} : snapshot(before, this.historyMembers);
    const now = after === undefined ? {} : snapshot(after, this.historyMembers);
    const changes: HistoryEntry["changes"] = {};
    for (const [name] of this.historyMembers) {
      const value = { old: old[name] ?? null, new: now[name] ?? null };
      if (JSON.stringify(value.old) !== JSON.stringify(value.new)) {
        changes[name] = value;
      }
    }
    if ((action === "changed" || action === "restored") && Object.keys(changes).length === 0) {
      return;
    }
    const userId = this.historyUsers?.current() ?? null;
    this.entries = [...this.entries, { id: crypto.randomUUID(), recordId: id, action, userId, at: new Date().toISOString(), changes }];
  }

{% endif %}
{% if react.sequences %}
  /** Return the next number of each sequence: the largest number of the records plus one. */
  private nextNumbers(): Record<string, string | number> {
    const values: Record<string, string | number> = {};
    for (const sequence of this.sequences) {
      const numbers = this.records.map((record) => sequenceNumber((record as Record<string, unknown>)[sequence.key], sequence));
      const next = Math.max(sequence.start - 1, ...numbers) + 1;
      values[sequence.key] =
        sequence.width === undefined ? next : `${sequence.prefix ?? ""}${String(next).padStart(sequence.width, "0")}`;
    }
    return values;
  }

{% endif %}
