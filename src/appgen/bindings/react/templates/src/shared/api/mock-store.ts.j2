/** A workflow on an enum field: the allowed changes of the field. */
export type Workflow = {
  field: string;
  /** The state of a new record. */
  initial?: string;
  /** The allowed changes: the value before and the value after. */
  transitions: [string, string][];
  message?: string;
};

{% if record_rules %}
/** A step of an owner path (ADR 0025): the key of a relation in the record, and its target entity. */
export type OwnerStep = { key: string; target: string };

/**
 * The record rules of the entity (ADR 0018, ADR 0025): the records that
 * the user may use for an action (`read`: the lists and the reads,
 * `change`: the other calls), or null for all records, and the owner path
 * from a record to its users.
 */
export type RecordRules = {
{% if memberships %}
  scopeOf: (action: RecordAction, operation?: string) => RecordScope | null;
{% else %}
  scopeOf: (action: RecordAction) => RecordScope | null;
{% endif %}
  path: readonly OwnerStep[];
  /** The key of an owner of one many-to-one relation: a new record of a user of the rule belongs to the user. */
  owner?: string;
{% if memberships %}
  /** The operation of each call of the store: a membership gives an operation in its scopes (ADR 0048). */
  operations?: Readonly<Partial<Record<CallKind, string>>>;
  /** The path to the scope entity of the memberships: no steps for the scope entity, none out of the scope. */
  scope?: readonly PathStep[];
{% endif %}
};
{% if memberships %}

/** The calls of the store on the records. */
export type CallKind = "list" | "read" | "create" | "update" | "delete";
{% endif %}

/** A new or changed record out of the record rule of the user. */
export class RecordRuleError extends Error {
  constructor() {
    super({{ tr(js("Your role may not give a record these values.")) }});
    this.name = "RecordRuleError";
  }
}
{% if memberships %}

/** A record in a scope of the memberships of the user (ADR 0048), whose role in that scope does not give the operation. */
export class ScopeError extends Error {
  constructor() {
    super({{ tr(js("Your role in the scope of the record may not do this operation.")) }});
    this.name = "ScopeError";
  }
}
{% endif %}

{% endif %}
{% set reads_others = record_rules or react.totals or react.notices or react.ranges %}
{% if reads_others %}
{% if record_rules and react.totals %}
/** The records of each store by entity: an owner path and a total read the records of other entities. */
{% elif record_rules %}
/** The records of each store by entity: an owner path reads the records of other entities. */
{% elif react.totals %}
/** The records of each store by entity: a total reads the records of another entity. */
{% elif react.ranges %}
/** The records of each store by entity: an available filter reads the records of another entity. */
{% else %}
/** The records of each store by entity: a receiver path of a notice reads the records of other entities. */
{% endif %}
const recordsByEntity = new Map<string, () => readonly EntityRecord[]>();

/** Return the IDs in the value of a relation: one ID, a list of IDs, or none. */
function idsOf(value: unknown): string[] {
  if (Array.isArray(value)) return value.map(String);
  return typeof value === "string" ? [value] : [];
}

{% endif %}
{% if record_rules or react.notices %}
/** A step of a path of relations: the key of the relation in the record, and the target entity. */
export type PathStep = { key: string; target: string };

/**
 * Return the IDs at the end of a path of relations of a record: the users
 * of an owner path (ADR 0025), or of a receiver path of a notice (ADR 0041).
 */
export function pathIds(record: object, path: readonly PathStep[]): string[] {
  let records: readonly object[] = [record];
  for (const [index, step] of path.entries()) {
    const ids = records.flatMap((item) => idsOf((item as Record<string, unknown>)[step.key]));
    if (index === path.length - 1) return ids;
    records = (recordsByEntity.get(step.target)?.() ?? []).filter((item) => ids.includes(item.id));
  }
  return [];
}

{% endif %}
{% if memberships %}
/** Return the records of the store of an entity, for example the memberships of the users (ADR 0048). */
export function recordsOf(entity: string): readonly EntityRecord[] {
  return recordsByEntity.get(entity)?.() ?? [];
}

{% endif %}
{% if react.notices %}
/** Return a value of the record of an entity with an ID, or null: the display value of a relation. */
export function recordValue(entity: string, id: unknown, key: string): unknown {
  const record = (recordsByEntity.get(entity)?.() ?? []).find((item) => item.id === id);
  return record === undefined ? null : ((record as Record<string, unknown>)[key] ?? null);
}

{% endif %}
{% if react.totals %}
/** An operator of the filter of a total. */
export type TotalOp = "eq" | "ne" | "in" | "not_in" | "lt" | "lte" | "gt" | "gte";

/**
 * A total of the related records of a record (ADR 0034): a key of the
 * records. The store reads the related records from the store of their
 * entity, as the database of a back end does in a subquery.
 */
export type Total = {
  /** The key of the total in the records, for example `sumLinesAmount`. */
  key: string;
  fn: "count" | "sum" | "avg" | "min" | "max";
  /** The entity of the related records. */
  target: string;
  /** A `one_to_many` relation: the key of the ID of the record in the related records. */
  link?: string;
  /** A `many_to_many` relation: the key of the IDs of the related records in the record. */
  list?: string;
  /** The key of the number field of the related records. `count` has none. */
  field?: string;
  /**
   * The conditions of the related records: a key, an operator, and a value.
   * A function gives the value at each read, for example the signed-in user.
   */
  filter?: [string, TotalOp, unknown][];
};

/** The stores to notify after a change of the records of an entity: the stores with totals of them. */
const dependents = new Map<string, Set<() => void>>();

/** Return true if a value passes a condition of a filter, as the filters of the back ends do. */
function passes(value: unknown, op: TotalOp, operand: unknown): boolean {
  const actual = value ?? null;
  switch (op) {
    case "eq":
      return actual === operand;
    case "ne":
      return actual !== operand;
    case "in":
      return Array.isArray(operand) && operand.includes(actual);
    case "not_in":
      return !Array.isArray(operand) || !operand.includes(actual);
  }
  if (actual === null || operand === null) return false;
  const a = actual as number | string;
  const b = operand as number | string;
  switch (op) {
    case "lt":
      return a < b;
    case "lte":
      return a <= b;
    case "gt":
      return a > b;
    case "gte":
      return a >= b;
  }
}

/** Return the total of the related records. The count and the sum of no records are 0, the others null. */
function totalOf(total: Total, items: readonly Record<string, unknown>[]): number | null {
  if (total.fn === "count") return items.length;
  const numbers = items
    .map((item) => item[total.field ?? ""])
    .filter((value) => value !== null && value !== undefined)
    .map(Number);
  if (numbers.length === 0) return total.fn === "sum" ? 0 : null;
  const sum = numbers.reduce((a, b) => a + b, 0);
  switch (total.fn) {
    case "sum":
      return sum;
    case "avg":
      return sum / numbers.length;
    case "min":
      return Math.min(...numbers);
    case "max":
      return Math.max(...numbers);
  }
}

{% endif %}
{% if react.ranges %}
/**
 * The related records of an available filter (ADR 0047): their entity, and
 * the keys of their start, of their end, and of the relation to the records.
 */
export type RangeSpec = {
  target: string;
  start: string;
  end: string;
  /** A `one_to_many` relation: the key of the ID of the record in the related records. */
  link?: string;
  /** A `many_to_many` relation: the key of the IDs of the related records in the record. */
  list?: string;
};

/** Return the text of a start or an end of a range, or null. */
function rangeText(value: unknown): string | null {
  return typeof value === "string" && value !== "" ? value : null;
}

{% endif %}
{% if react.events %}
/** The custom operation of an event (ADR 0031): it gets the record after the change. */
export type EventOperation<T> = (record: T) => Promise<void>;

/** The events of an entity (ADR 0031): the custom operations that run after a change of a record. */
export type Events<T> = {
  created?: EventOperation<T>;
  /** Runs when a field of `keys` has a new value. */
  changed?: { keys: string[]; run: EventOperation<T> };
  deleted?: EventOperation<T>;
  /** The transitions of the workflows with `run`: a change of `field` from a state of `from` to `to`. */
  transitions?: { field: string; from: string[]; to: string; run: EventOperation<T> }[];
};

/** True while the operation of an event runs: its changes start no event. */
let inEvent = false;

/** Return true if two values of a field are the same. */
function sameValue(a: unknown, b: unknown): boolean {
  return a === b || JSON.stringify(a) === JSON.stringify(b);
}

{% endif %}
{% if react.sequences %}
/**
 * A field with a sequence: a new record gets the next number. A text field
 * has `width`, and the number has zeros on the left up to the width.
 */
export type SequenceField = { key: string; start: number; prefix?: string; width?: number };

/** Return the number in a value of a field with a sequence, or the start before the first. */
function sequenceNumber(value: unknown, { start, prefix = "" }: SequenceField): number {
  const number = Number(typeof value === "string" ? value.slice(prefix.length) : value);
  return Number.isInteger(number) ? number : start - 1;
}

{% endif %}
/** A change of state that no transition of a workflow allows. */
export class TransitionError extends Error {
  constructor(message: string) {
    super(message);
    this.name = "TransitionError";
  }
}

{% if definition.storage %}
/** The largest file, in bytes, and the media types of a file field (ADR 0027). Empty types: all types. */
export type FileRule = { maxSize: number; types: readonly string[] };

/** A file that the rule of its field does not allow. */
export class FileError extends Error {
  constructor(message: string) {
    super(message);
    this.name = "FileError";
  }
}

/** Return a size as a short text with a unit, for example `5 MB` or `1.5 KB`. */
function sizeText(size: number): string {
  const units: [string, number][] = [
    ["GB", 1024 ** 3],
    ["MB", 1024 ** 2],
    ["KB", 1024],
  ];
  for (const [unit, factor] of units) {
    if (size >= factor) {
      return `${(size / factor).toFixed(1).replace(/\.0$/, "")} ${unit}`;
    }
  }
  return `${size} B`;
}

/** Throw a FileError if the rule does not allow a file: the size, and the type or its group, for example `image/*`. */
function checkFile(file: File, rule: FileRule): void {
  if (file.size > rule.maxSize) {
    throw new FileError({{ js_format("The file is larger than {size}.", size="sizeText(rule.maxSize)") }});
  }
  const type = file.type.toLowerCase() || "application/octet-stream";
  const group = type.split("/")[0];
  if (rule.types.length > 0 && !rule.types.some((item) => item === type || item === `${group}/*`)) {
    throw new FileError({{ js_format("The type {type} is not allowed. Use one of: {types}.", type="type", types='rule.types.join(", ")') }});
  }
}

{% endif %}
{% if react.history %}
/** A field or a relation that the change log keeps (ADR 0040): the name in the app definition, and the key of the record. */
export type HistoryMember = readonly [name: string, key: string];

/** The signed-in user of the entries of the change log, and the display value of a user. */
export type HistoryUsers = {
  current: () => string | null;
  label: (id: string) => string | null;
};

/** An entry of the change log of the mock store: the entry, and the ID of its record. */
type StoredEntry = Omit<HistoryEntry, "user"> & { recordId: string };

/** Return the values of the kept fields of a record, by name. A missing value is null. */
function snapshot(record: object, members: readonly HistoryMember[]): Record<string, unknown> {
  const values = record as Record<string, unknown>;
  return Object.fromEntries(members.map(([name, key]) => [name, values[key] ?? null]));
}

{% endif %}
{% if shares %}
/** The key of the secret links in the browser storage (ADR 0049). */
const SHARE_LINKS_KEY = {{ js(app.name ~ "-share-links") }};

/** A secret link of the mock store: the browser keeps it, so that a guest opens it in another tab. */
type StoredLink = { entity: string; recordId: string; token: string; createdAt: string };

function storedLinks(): StoredLink[] {
  try {
    return JSON.parse(window.localStorage.getItem(SHARE_LINKS_KEY) ?? "[]") as StoredLink[];
  } catch {
    return [];
  }
}

function storeLinks(links: readonly StoredLink[]): void {
  try {
    window.localStorage.setItem(SHARE_LINKS_KEY, JSON.stringify(links));
  } catch {
    // No storage: the browser does not keep the link.
  }
}

/** Return a new token: 32 random bytes in base64url, as the server makes it. */
function newToken(): string {
  const bytes = crypto.getRandomValues(new Uint8Array(32));
  return btoa(String.fromCharCode(...bytes))
    .replace(/\+/g, "-")
    .replace(/\//g, "_")
    .replace(/=+$/, "");
}

{% endif %}
/** The time that each call waits, so that the UI shows its loading states. */
export const MOCK_LATENCY_MS = 250;
{% if lines_ops %}

/** The snapshots of the records of all stores, for `inTransaction`. */
const snapshots = new Set<() => () => void>();

/**
 * Run changes of the stores as one (ADR 0035), for example a record and its
 * lines: an error restores the records of all stores, and throws again.
 */
export async function inTransaction<R>(work: () => Promise<R>): Promise<R> {
  const restores = [...snapshots].map((snapshot) => snapshot());
  try {
    return await work();
  } catch (error) {
    for (const restore of restores) {
      restore();
    }
    throw error;
  }
}
{% endif %}

function wait(): Promise<void> {
  return new Promise((resolve) => setTimeout(resolve, MOCK_LATENCY_MS));
}

/**
 * An in-memory store of the records of one entity. It starts with the
 * mock data, and keeps the changes until the page reloads.{% if record_rules %} With a record
 * rule, a user uses only the records of the rule: the other records do not
 * exist for the user, and a new or changed record must be part of the rule.{% endif +%}
{% if translatable %}
 * The store keeps the value of the default language in each translatable
 * field, and gives the records in the selected language (ADR 0026).
{% endif %}
 */
export class MockStore<T extends EntityRecord, TInput extends object>
  implements EntityApi<T, TInput>
{
  private records: T[];
  private readonly listeners = new Set<() => void>();
{% if react.events %}
  private events: Events<T> = {};
{% endif %}
{% if react.sequences %}
  private sequences: readonly SequenceField[] = [];
{% endif %}
{% if react.totals %}
  private totals: readonly Total[] = [];
{% endif %}
{% if react.history %}
  private historyMembers: readonly HistoryMember[] = [];
  private historyUsers: HistoryUsers | undefined;
  private entries: StoredEntry[] = [];
{% endif %}
{% if react.notices %}
  private addNotices: ((record: T, before: T | undefined) => void) | undefined;
{% endif %}

  constructor(
    private readonly entity: string,
    data: readonly T[],
    private readonly defaults: Partial<Omit<T, "id">>,
    private readonly workflows: readonly Workflow[] = [],
{% if translatable %}
    /** The keys of the translatable fields. */
    private readonly translatable: readonly string[] = [],
{% endif %}
{% if record_rules %}
    private readonly rules?: RecordRules,
{% endif %}
  ) {
    this.records = data.map((record) => ({ ...record }));
{% if reads_others %}
    recordsByEntity.set(entity, () => this.records);
{% endif %}
{% if lines_ops %}
    snapshots.add(() => this.snapshot());
{% endif %}
  }
{% if lines_ops %}

  /** Return a function that restores the records of now, for `inTransaction` (ADR 0035). */
  snapshot(): () => void {
    const records = this.records;
{% if react.history %}
    const entries = this.entries;
{% endif %}
    return () => {
{% if react.history %}
      this.entries = entries;
{% endif %}
      if (this.records !== records) {
        this.records = records;
        this.notify();
      }
    };
  }
{% endif %}

  async list(query: ListQuery<T> = {}): Promise<ListResult<T>> {
    await wait();
{% if record_rules %}
    const result = applyQuery(
      this.records.filter((record) => this.allows(record, "read"{{ ', "list"' if memberships }})),
      query,
    );
{% else %}
    const result = applyQuery(this.records, query);
{% endif %}
{% if translatable or react.totals %}
    return { ...result, items: result.items.map((record) => this.show(record)) };
{% else %}
    return result;
{% endif %}
  }

  async get(id: string): Promise<T> {
    await wait();
    return this.show(this.find(id{{ ', "read", "read"' if memberships }}));
  }

  async create(input: TInput): Promise<T> {
    await wait();
{% set stored = (", ...storeTranslations(this.defaults, input, this.translatable, true)" if translatable else "") ~ (", ...this.nextNumbers()" if react.sequences else "") %}
{% if record_rules %}
    const record = { ...this.defaults, ...input{{ stored }}, ...this.ownerValues(), id: crypto.randomUUID() } as unknown as T;
{% else %}
    const record = { ...this.defaults, ...input{{ stored }}, id: crypto.randomUUID() } as unknown as T;
{% endif %}
    this.checkWorkflows(undefined, record);
{% if record_rules %}
    this.checkRules(record{{ ', "create"' if memberships }});
{% endif %}
    this.records = [...this.records, record];
    this.notify();
{% if react.events %}
    const created = this.events.created;
    await this.runEvents(record, created ? [created] : []);
{% if react.history %}
    this.log(record.id, "created", undefined, this.current(record));
{% endif %}
{% if react.notices %}
    this.addNotices?.(this.current(record), undefined);
{% endif %}
    return this.show(this.current(record));
{% else %}
{% if react.history %}
    this.log(record.id, "created", undefined, record);
{% endif %}
{% if react.notices %}
    this.addNotices?.(record, undefined);
{% endif %}
    return this.show(record);
{% endif %}
  }

{% if react.history %}
  async update(id: string, patch: Partial<TInput>, action: HistoryAction = "changed"): Promise<T> {
{% else %}
  async update(id: string, patch: Partial<TInput>): Promise<T> {
{% endif %}
    await wait();
{% set stored = ", ...storeTranslations(before, patch, this.translatable)" if translatable else "" %}
{% if record_rules %}
    const before = this.find(id, "change"{{ ', "update"' if memberships }});
    const record = { ...before, ...patch{{ stored }}, ...this.ownerValues(), id } as T;
{% else %}
    const before = this.find(id);
    const record = { ...before, ...patch{{ stored }}, id } as T;
{% endif %}
    this.checkWorkflows(before, record);
{% if record_rules %}
    this.checkRules(record{{ ', "update"' if memberships }});
{% endif %}
    this.records = this.records.map((item) => (item.id === id ? record : item));
    this.notify();
{% if react.events %}
    await this.runEvents(record, this.changeEvents(before, record));
{% if react.history %}
    this.log(id, action, before, this.current(record));
{% endif %}
{% if react.notices %}
    this.addNotices?.(this.current(record), before);
{% endif %}
    return this.show(this.current(record));
{% else %}
{% if react.history %}
    this.log(id, action, before, record);
{% endif %}
{% if react.notices %}
    this.addNotices?.(record, before);
{% endif %}
    return this.show(record);
{% endif %}
  }

  async remove(id: string): Promise<void> {
    await wait();
{% if react.events or react.history %}
    const record = this.find(id{{ ', "change"' if record_rules }}{{ ', "delete"' if memberships }});
{% else %}
    this.find(id{{ ', "change"' if record_rules }}{{ ', "delete"' if memberships }});
{% endif %}
    this.records = this.records.filter((item) => item.id !== id);
    this.notify();
{% if react.events %}
    const deleted = this.events.deleted;
    await this.runEvents(record, deleted ? [deleted] : []);
{% endif %}
{% if react.history %}
    this.log(id, "deleted", record, undefined);
{% endif %}
  }

{% if react.events %}
  /**
   * Set the events of the entity (ADR 0031). The store runs the operation
   * of an event after the change, as a demonstration of the events of the
   * back ends. It has no transactions: a failed operation gives its
   * error, and the change stays.
   */
  withEvents(events: Events<T>): this {
    this.events = events;
    return this;
  }

{% endif %}
{% if react.sequences %}
  /** Set the fields with a sequence: the store gives a new record the next number of each. */
  withSequences(sequences: readonly SequenceField[]): this {
    this.sequences = sequences;
    return this;
  }

{% endif %}
{% if react.totals %}
  /**
   * Set the totals of the related records (ADR 0034). The records of the
   * store get a key for each total, and a change of the related records
   * notifies the listeners of the store.
   */
  withTotals(totals: readonly Total[]): this {
    this.totals = totals;
    for (const target of new Set(totals.map((total) => total.target))) {
      const stores = dependents.get(target) ?? new Set<() => void>();
      stores.add(() => this.notifyListeners());
      dependents.set(target, stores);
    }
    return this;
  }

{% endif %}
{% if react.history %}
  /**
   * Keep a change log of the records (ADR 0040), and return its entries
   * and the restore. The store adds an entry for each create, change, and
   * delete, until the page reloads. `members` are the kept fields, and
   * `users` gives the signed-in user. `guards` check the access first.
   */
  history(
    members: readonly HistoryMember[],
    users?: HistoryUsers,
    guards: { list?: () => void; restore?: () => void } = {},
  ): HistoryApi<T> {
    this.historyMembers = members;
    this.historyUsers = users;
    return {
      list: async (id, page = { page: 1, pageSize: 20 }) => {
        guards.list?.();
        await wait();
        this.find(id{{ ', "read", "read"' if memberships }});
        const entries = this.entries.filter((entry) => entry.recordId === id).reverse();
        const start = (page.page - 1) * page.pageSize;
        const items = entries.slice(start, start + page.pageSize).map(
          ({ id: entryId, action, userId, at, changes }): HistoryEntry => ({
            id: entryId,
            action,
            userId,
            user: userId === null ? null : (this.historyUsers?.label(userId) ?? null),
            at,
            changes,
          }),
        );
        return { items, total: entries.length, page: page.page, pageSize: page.pageSize };
      },
      restore: async (id, entryId) => {
        guards.restore?.();
        const entry = this.entries.find((item) => item.id === entryId && item.recordId === id);
        if (entry === undefined) {
          throw new NotFoundError("HistoryEntry", entryId);
        }
        if (entry.action !== "changed" && entry.action !== "restored") {
          throw new Error({{ tr(js("Only the entry of a change has old values to restore.")) }});
        }
        const keys = new Map(this.historyMembers);
        const patch: Record<string, unknown> = {};
        for (const [name, change] of Object.entries(entry.changes)) {
          const key = keys.get(name);
          if (key !== undefined) {
            patch[key] = change.old;
          }
        }
{% if react.sequences %}
        // A restore keeps the numbers of the fields with a sequence.
        for (const sequence of this.sequences) {
          delete patch[sequence.key];
        }
{% endif %}
{% if translatable %}
        // The change log keeps the value of the default language.
        for (const key of this.translatable) {
          if (key in patch) {
            patch[`${key}Translations`] = { [defaultLanguage]: patch[key] };
            delete patch[key];
          }
        }
{% endif %}
