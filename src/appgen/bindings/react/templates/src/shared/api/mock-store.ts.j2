{{ trace_header("app") }}
{% if record_rules %}
import { hasValuesOf, type RecordAction, type RecordScope } from "@/shared/lib/permissions";

{% endif %}
import { applyQuery } from "./query";
import { type EntityApi, type EntityRecord, type ListQuery, type ListResult, NotFoundError } from "./types";

/** A workflow on an enum field: the allowed changes of the field. */
export type Workflow = {
  field: string;
  /** The state of a new record. */
  initial?: string;
  /** The allowed changes: the value before and the value after. */
  transitions: [string, string][];
  message?: string;
};

{% if record_rules %}
/** A step of an owner path (ADR 0025): the key of a relation in the record, and its target entity. */
export type OwnerStep = { key: string; target: string };

/**
 * The record rules of the entity (ADR 0018, ADR 0025): the records that
 * the user may use for an action (`read`: the lists and the reads,
 * `change`: the other calls), or null for all records, and the owner path
 * from a record to its users.
 */
export type RecordRules = {
  scopeOf: (action: RecordAction) => RecordScope | null;
  path: readonly OwnerStep[];
  /** The key of an owner of one many-to-one relation: a new record of a user of the rule belongs to the user. */
  owner?: string;
};

/** A new or changed record out of the record rule of the user. */
export class RecordRuleError extends Error {
  constructor() {
    super({{ tr(js("Your role may not give a record these values.")) }});
    this.name = "RecordRuleError";
  }
}

/** The records of each store by entity: an owner path reads the records of other entities. */
const recordsByEntity = new Map<string, () => readonly EntityRecord[]>();

/** Return the IDs in the value of a relation: one ID, a list of IDs, or none. */
function idsOf(value: unknown): string[] {
  if (Array.isArray(value)) return value.map(String);
  return typeof value === "string" ? [value] : [];
}

{% endif %}
/** A change of state that no transition of a workflow allows. */
export class TransitionError extends Error {
  constructor(message: string) {
    super(message);
    this.name = "TransitionError";
  }
}

/** The time that each call waits, so that the UI shows its loading states. */
export const MOCK_LATENCY_MS = 250;

function wait(): Promise<void> {
  return new Promise((resolve) => setTimeout(resolve, MOCK_LATENCY_MS));
}

/**
 * An in-memory store of the records of one entity. It starts with the
 * mock data, and keeps the changes until the page reloads.{% if record_rules %} With a record
 * rule, a user uses only the records of the rule: the other records do not
 * exist for the user, and a new or changed record must be part of the rule.{% endif +%}
 */
export class MockStore<T extends EntityRecord, TInput extends object>
  implements EntityApi<T, TInput>
{
  private records: T[];
  private readonly listeners = new Set<() => void>();

  constructor(
    private readonly entity: string,
    data: readonly T[],
    private readonly defaults: Partial<Omit<T, "id">>,
    private readonly workflows: readonly Workflow[] = [],
{% if record_rules %}
    private readonly rules?: RecordRules,
{% endif %}
  ) {
    this.records = data.map((record) => ({ ...record }));
{% if record_rules %}
    recordsByEntity.set(entity, () => this.records);
{% endif %}
  }

  async list(query: ListQuery<T> = {}): Promise<ListResult<T>> {
    await wait();
{% if record_rules %}
    return applyQuery(
      this.records.filter((record) => this.allows(record, "read")),
      query,
    );
{% else %}
    return applyQuery(this.records, query);
{% endif %}
  }

  async get(id: string): Promise<T> {
    await wait();
    return { ...this.find(id) };
  }

  async create(input: TInput): Promise<T> {
    await wait();
{% if record_rules %}
    const record = { ...this.defaults, ...input, ...this.ownerValues(), id: crypto.randomUUID() } as unknown as T;
{% else %}
    const record = { ...this.defaults, ...input, id: crypto.randomUUID() } as unknown as T;
{% endif %}
    this.checkWorkflows(undefined, record);
{% if record_rules %}
    this.checkRules(record);
{% endif %}
    this.records = [...this.records, record];
    this.notify();
    return { ...record };
  }

  async update(id: string, patch: Partial<TInput>): Promise<T> {
    await wait();
{% if record_rules %}
    const before = this.find(id, "change");
    const record = { ...before, ...patch, ...this.ownerValues(), id } as T;
{% else %}
    const before = this.find(id);
    const record = { ...before, ...patch, id } as T;
{% endif %}
    this.checkWorkflows(before, record);
{% if record_rules %}
    this.checkRules(record);
{% endif %}
    this.records = this.records.map((item) => (item.id === id ? record : item));
    this.notify();
    return { ...record };
  }

  async remove(id: string): Promise<void> {
    await wait();
    this.find(id{{ ', "change"' if record_rules }});
    this.records = this.records.filter((item) => item.id !== id);
    this.notify();
  }

  subscribe(listener: () => void): () => void {
    this.listeners.add(listener);
    return () => {
      this.listeners.delete(listener);
    };
  }

  /**
   * Check the workflows of the entity. `before` is undefined for a new
   * record, which must start in the initial state. A change to the same
   * state, and a change from or to no state, pass.
   */
  private checkWorkflows(before: T | undefined, after: T): void {
    for (const workflow of this.workflows) {
      const to: unknown = (after as Record<string, unknown>)[workflow.field];
      if (to === null || to === undefined) continue;
      if (before === undefined) {
        if (workflow.initial !== undefined && to !== workflow.initial) {
          throw new TransitionError(
            workflow.message ?? {{ js_format("A new {entity} starts with the state {initial}, not {state}.", entity="this.entity", initial="workflow.initial", state="String(to)") }},
          );
        }
        continue;
      }
      const from: unknown = (before as Record<string, unknown>)[workflow.field];
      if (from === null || from === undefined || from === to) continue;
      if (!workflow.transitions.some(([a, b]) => a === from && b === to)) {
        throw new TransitionError(
          workflow.message ?? {{ js_format("The state of {entity} cannot change from {before} to {after}.", entity="this.entity", before="String(from)", after="String(to)") }},
        );
      }
    }
  }

{% if record_rules %}
  /** Return true if the user may use a record for an action: without a record rule, all records. */
  private allows(record: T, action: RecordAction): boolean {
    const scope = this.rules?.scopeOf(action) ?? null;
    return scope === null || this.inScope(record, scope);
  }

  /** Return true if a record has the values of a scope, and belongs to its user if the scope has an owner. */
  private inScope(record: T, scope: RecordScope): boolean {
    return hasValuesOf(scope, record) && (!scope.owner || this.ownersOf(record).includes(scope.user));
  }

  /** Return the IDs of the users that a record belongs to: the records at the end of the owner path. */
  private ownersOf(record: T): string[] {
    const path = this.rules?.path ?? [];
    let records: readonly object[] = [record];
    for (const [index, step] of path.entries()) {
      const ids = records.flatMap((item) => idsOf((item as Record<string, unknown>)[step.key]));
      if (index === path.length - 1) return ids;
      records = (recordsByEntity.get(step.target)?.() ?? []).filter((item) => ids.includes(item.id));
    }
    return [];
  }

  /** Throw a RecordRuleError if a new or changed record is not part of the record rule of the user. */
  private checkRules(record: T): void {
    if (!this.allows(record, "change")) {
      throw new RecordRuleError();
    }
  }

  /** Return the owner of a new or changed record: the user of an owner rule of one relation, or nothing. */
  private ownerValues(): Record<string, string> {
    const scope = this.rules?.scopeOf("change") ?? null;
    const key = this.rules?.owner;
    return key === undefined || scope === null || !scope.owner ? {} : { [key]: scope.user };
  }

  /** Return the record with an ID. A record that the user may not use does not exist. */
  private find(id: string, action: RecordAction = "read"): T {
    const record = this.records.find((item) => item.id === id);
    if (!record || !this.allows(record, action)) {
      throw new NotFoundError(this.entity, id);
    }
    return record;
  }
{% else %}
  private find(id: string): T {
    const record = this.records.find((item) => item.id === id);
    if (!record) {
      throw new NotFoundError(this.entity, id);
    }
    return record;
  }
{% endif %}

  private notify(): void {
    for (const listener of this.listeners) {
      listener();
    }
  }
}
