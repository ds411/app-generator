  private find(id: string, action: RecordAction = "read", kind?: CallKind): T {
    const record = this.records.find((item) => item.id === id);
    const scope = this.scopeFor(action, kind);
    if (record && scope !== null && !this.inScope(record, scope) && this.inScopes(record, scope.memberOf ?? [])) {
