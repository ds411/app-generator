{% set type_names = ["type EntityApi", "type EntityRecord"] + (["type FileApi", "type FileValue"] if definition.storage else []) + (["type HistoryAction", "type HistoryApi", "type HistoryEntry"] if react.history else []) + ["type ListQuery", "type ListResult"] + (["type MemberPermissions"] if memberships else []) + ["NotFoundError"] + (["type OwnerRange"] if react.ranges else []) + (["type SharedRecord", "type SharingApi"] if shares else []) %}
