  /** Return true if a record has the values of a scope, and belongs to its user if the scope has an owner. */
  private inScope(record: T, scope: RecordScope): boolean {
    return hasValuesOf(scope, record) && (!scope.owner || this.ownersOf(record).includes(scope.user));
  }
{% endif %}
{% if record_rules %}

  /** Return the IDs of the users that a record belongs to: the records at the end of the owner path. */
