  /** Return the owner of a new or changed record: the user of an owner rule of one relation, or nothing. */
  private ownerValues(): Record<string, string> {
    const scope = this.rules?.scopeOf("change") ?? null;
    const key = this.rules?.owner;
    return key === undefined || scope === null || !scope.owner ? {} : { [key]: scope.user };
