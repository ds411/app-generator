{% if react.totals %}

  /** Return the totals of a record: the related records of each total in the store of their entity. */
  private totalsOf(record: T): Record<string, number | null> {
    const values: Record<string, number | null> = {};
    const own = record as Record<string, unknown>;
    for (const total of this.totals) {
      const ids = total.list === undefined ? undefined : idsOf(own[total.list]);
      const items = (recordsByEntity.get(total.target)?.() ?? [])
        .map((item) => item as Record<string, unknown>)
        .filter((item) =>
          ids === undefined ? item[total.link ?? ""] === record.id : ids.includes(String(item.id)),
        )
        .filter((item) => (total.filter ?? []).every(([key, op, operand]) => passes(item[key], op, typeof operand === "function" ? (operand as () => unknown)() : operand)));
      values[total.key] = totalOf(total, items);
    }
    return values;
  }
