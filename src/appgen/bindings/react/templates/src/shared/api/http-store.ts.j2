{{ trace_header("app") }}
import { ApiError, apiRequest } from "./http";
{% set type_names = ["type EntityApi", "type EntityRecord"] + (["type FileApi"] if definition.storage else []) + ["type Filter"] + (["type HistoryAction", "type HistoryApi", "type HistoryEntry"] if react.history else []) + ["type ListQuery", "type ListResult"] + (["type MemberPermissions"] if memberships else []) + ["NotFoundError"] + (["type PresenceApi", "type PresentUser"] if presences else []) + (["type RowsPage"] if query_operations(definition) else []) + (["type SharedRecord", "type SharingApi"] if shares else []) %}
{% if type_names | length > 6 %}
import {
{% for type_name in type_names %}
  {{ type_name }},
{% endfor %}
} from "./types";
{% else %}
import { {{ type_names | join(", ") }} } from "./types";
{% endif %}

/** The JSON names of an entity in the API. */
export type ApiShape = {
  /** The key of the TypeScript type for each JSON name, for example `due_date: "dueDate"`. */
  keys: Readonly<Record<string, string>>;
  /** The keys of the decimal fields: the API sends them as text. */
  numbers: readonly string[];
  /** The keys that the list endpoint can filter by: `one` value, or a `list` of values. */
  filters: Readonly<Record<string, "one" | "list">>;
  /** The keys that the list endpoint can sort by. */
  sorts: readonly string[];
  /** The key of the display field, and true if `q` of the list endpoint searches it. */
  display: { key: string; search: boolean };
  /**
   * True if the entity has a translatable field (ADR 0026). The client asks
   * for the values of all languages (`translations=all`), for the forms.
   */
  translations?: boolean;
};

/** A choice of a record: its ID and its text. */
export type RecordOption = { value: string; label: string };

/**
 * The options of a reference field or of a filter: the first records of a
 * search on the server, and the options of the selected IDs.
 */
export type OptionSource = {
  search(text: string): Promise<RecordOption[]>;
  labels(ids: readonly string[]): Promise<RecordOption[]>;
};

/**
 * A value of a query parameter. A query leaves out null, undefined, and an
 * empty text. An empty list matches no records, for example the related
 * records of a record without relations.
 */
export type ApiParam = string | number | boolean | null | undefined | readonly string[];

/** The query parameters of a list endpoint, for example `{ status: ["open"], q: "text" }`. */
export type ApiParams = Readonly<Record<string, ApiParam>>;

/** A query of a list endpoint in the names of the API: the parameters, the sort keys, and the page. */
export type ApiQuery = {
  params?: ApiParams;
  /** The sort keys, for example `["-due_date", "owner"]`. A `-` sorts in descending order. */
  sort?: readonly string[];
  /** The page number, from 1. */
  page: number;
  pageSize: number;
};

/** The largest page of the list endpoints. */
const PAGE_LIMIT = 200;

/** The count of the options that a search of a choice gives. */
const OPTION_COUNT = 20;

/** The most IDs in one request of `byIds`, for a short URL. */
const ID_LIMIT = 100;
{% if react.live %}

/** The stores of each entity: a change in another browser loads their records again (ADR 0051). */
const stores = new Map<string, Set<() => void>>();

/** Load the records of an entity again in the open views, or of all entities without an entity. */
export function notifyChange(entity?: string): void {
  const sets = entity === undefined ? [...stores.values()] : [stores.get(entity)];
  for (const set of sets) {
    for (const reload of set ?? []) {
      reload();
    }
  }
}
{% endif %}

/**
 * The records of one entity in the FastAPI app. The list endpoint filters,
 * searches, sorts, and pages the records: a view sends its query with
 * `page`, and loads one page. The store keeps the records that it loads,
 * so that `byIds` asks only for the records that it does not have. A
 * change of a record clears them.
 */
export class HttpStore<T extends EntityRecord, TInput extends object>
  implements EntityApi<T, TInput>
{
  private readonly listeners = new Set<() => void>();
  private readonly jsonNames: Record<string, string>;
  private readonly known = new Map<string, T>();

  constructor(
    private readonly entity: string,
    private readonly path: string,
    private readonly shape: ApiShape,
  ) {
    this.jsonNames = { id: "id", ...Object.fromEntries(Object.entries(shape.keys).map(([json, key]) => [key, json])) };
{% if react.live %}
    let set = stores.get(entity);
    if (set === undefined) {
      set = new Set();
      stores.set(entity, set);
    }
    set.add(() => this.notify());
{% endif %}
  }

  /** Load one page of the list endpoint. */
  async page(query: ApiQuery): Promise<ListResult<T>> {
    const offset = (query.page - 1) * query.pageSize;
    const { items, total } = await this.load(query.params ?? {}, query.sort ?? [], offset, query.pageSize);
    return { items, total, page: query.page, pageSize: query.pageSize };
  }

  /** Load all records of the query parameters, for example the records of the dates of a calendar. */
  async all(params: ApiParams, sort: readonly string[] = []): Promise<T[]> {
    return (await this.load(params, sort, 0, Infinity)).items;
  }

  /**
   * Return the records with the IDs, for example the related records of a
   * page. One request (`id`) loads the IDs that the store does not have,
   * for each ID_LIMIT IDs. An ID without a record is not in the result.
   */
  async byIds(ids: Iterable<string>): Promise<Map<string, T>> {
    const wanted = [...new Set(ids)];
    const missing = wanted.filter((id) => !this.known.has(id));
    for (let start = 0; start < missing.length; start += ID_LIMIT) {
      const part = missing.slice(start, start + ID_LIMIT);
      await this.load({ id: part }, [], 0, part.length);
    }
    return new Map(
      wanted.flatMap((id): [string, T][] => {
        const record = this.known.get(id);
        return record ? [[id, record]] : [];
      }),
    );
  }

  /**
   * Return the first records of a choice, in the order of the display
   * field. With a text, the list endpoint searches its words in the display
   * field (`q`). An entity whose display field is not a text searches the
   * first records in the browser.
   */
  async search(text: string): Promise<T[]> {
    const words = text.trim();
    const { key, search } = this.shape.display;
    const name = this.jsonNames[key];
    const sort = name && this.shape.sorts.includes(key) ? [name] : [];
    if (search || !words) {
      return (await this.load(words ? { q: words } : {}, sort, 0, OPTION_COUNT)).items;
    }
    const { items } = await this.load({}, sort, 0, PAGE_LIMIT);
    const found = items.filter((item) => String((item as Record<string, unknown>)[key] ?? "").toLowerCase().includes(words.toLowerCase()));
    return found.slice(0, OPTION_COUNT);
  }

  /** Return the options of the records for a choice, with the text of each record. */
  options(label: (record: T) => string): OptionSource {
    const option = (record: T): RecordOption => ({ value: record.id, label: label(record) });
    return {
      search: async (text) => (await this.search(text)).map(option),
      labels: async (ids) => [...(await this.byIds(ids)).values()].map(option),
    };
  }

  /**
   * Load the records of a query: one page with `page`, else all pages. The
   * API takes the filters `eq` and `in` and the sort of the keys of its shape,
   * and no search: other queries throw an error.
   */
  async list(query: ListQuery<T> = {}): Promise<ListResult<T>> {
    if (query.search?.text.trim()) {
      throw new Error(`list() of ${this.entity} cannot search. Send the search of a view with page().`);
    }
    const params = Object.fromEntries((query.filters ?? []).map((filter) => this.param(filter)));
    const sort = (query.sort ?? []).map(({ field, direction }) => {
      if (!this.shape.sorts.includes(field)) {
        throw new Error(`The list of ${this.entity} cannot sort by ${field}.`);
      }
      return `${direction === "desc" ? "-" : ""}${this.jsonNames[field] ?? field}`;
    });
    if (query.page !== undefined) {
      return this.page({ params, sort, page: query.page, pageSize: query.pageSize ?? PAGE_LIMIT });
    }
    const { items, total } = await this.load(params, sort, 0, Infinity);
    return { items, total, page: 1, pageSize: total || 1 };
  }

  async get(id: string): Promise<T> {
    return this.fromJson(await this.request("GET", id, undefined, "", this.translations()));
  }

{% if lines_ops %}
  /** Create a record. `more` adds keys to the JSON body, for example the lines of the record (ADR 0035). */
  async create(input: TInput, more: Record<string, unknown> = {}): Promise<T> {
    const body = { ...this.toJson(input), ...more };
    const record = this.fromJson(await this.request("POST", null, body, "", this.translations()));
    this.notify();
    return record;
  }

  /** Change a record. `more` adds keys to the JSON body, for example the lines of the record (ADR 0035). */
  async update(id: string, patch: Partial<TInput>, more: Record<string, unknown> = {}): Promise<T> {
    const body = { ...this.toJson(patch), ...more };
    const record = this.fromJson(await this.request("PATCH", id, body, "", this.translations()));
    this.notify();
    return record;
  }

  /** Return the JSON object of values in the names of the API, for example a line of a record. */
  json(values: object): Record<string, unknown> {
    return this.toJson(values);
  }

  /** Tell the views that the records changed, for example after a change of the lines of a record. */
  changed(): void {
    this.notify();
  }
{% else %}
  async create(input: TInput): Promise<T> {
    const record = this.fromJson(await this.request("POST", null, this.toJson(input), "", this.translations()));
    this.notify();
    return record;
  }

  async update(id: string, patch: Partial<TInput>): Promise<T> {
    const record = this.fromJson(await this.request("PATCH", id, this.toJson(patch), "", this.translations()));
    this.notify();
    return record;
  }
{% endif %}

  async remove(id: string): Promise<void> {
    await this.request("DELETE", id);
    this.notify();
  }

  subscribe(listener: () => void): () => void {
    this.listeners.add(listener);
    return () => {
      this.listeners.delete(listener);
    };
  }

{% if definition.storage %}
  /**
   * Return the upload and the delete of the files of the file fields
   * (ADR 0027): `PUT` and `DELETE <path>/{id}/<field>`. `paths` gives the
   * last part of the path of each field. The upload sends the file in the
   * part `file` of a multipart body.
   */
  {{ trace(definition.storage.id) }}
  files<TField extends string>(paths: Readonly<Record<TField, string>>): FileApi<T, TField> {
    const send = async (method: string, id: string, field: TField, body?: FormData): Promise<T> => {
      const record = this.fromJson(await this.request(method, id, body, `/${paths[field]}`));
      this.notify();
      return record;
    };
    return {
      upload: (id, field, file) => {
        const body = new FormData();
        body.set("file", file);
        return send("PUT", id, field, body);
      },
      remove: (id, field) => send("DELETE", id, field),
    };
  }

{% endif %}
{% if react.history %}
  /**
   * Return the change log of the records (ADR 0040): `GET <path>/{id}/history`
   * and `POST <path>/{id}/history/{entry_id}/restore`. The changes of an
   * entry have the names of the fields in the app definition.
   */
  history(): HistoryApi<T> {
    return {
      list: async (id, page = { page: 1, pageSize: 20 }) => {
        const query = `?limit=${page.pageSize}&offset=${(page.page - 1) * page.pageSize}`;
        const result = (await this.request("GET", id, undefined, "/history", query)) as {
          items: Record<string, unknown>[];
          total: number;
        };
        const items = result.items.map(
          (item): HistoryEntry => ({
            id: String(item.id),
            action: item.action as HistoryAction,
            userId: typeof item.user_id === "string" ? item.user_id : null,
            user: typeof item.user === "string" ? item.user : null,
            at: String(item.at),
            changes: item.changes as HistoryEntry["changes"],
          }),
        );
        return { items, total: result.total, page: page.page, pageSize: page.pageSize };
      },
      restore: async (id, entryId) => {
        const suffix = `/history/${encodeURIComponent(entryId)}/restore`;
        const record = this.fromJson(await this.request("POST", id, undefined, suffix, this.translations()));
        this.notify();
        return record;
      },
    };
  }

{% endif %}
{% if presences %}
  /**
   * Return the other users on the pages of the records (ADR 0052): `PUT`
   * and `DELETE <path>/{id}/presence`. The FastAPI app checks the access.
   */
  presence(): PresenceApi {
    return {
      entity: this.entity,
      here: async (id, typing) => {
        const result = (await this.request("PUT", id, { typing }, "/presence")) as { users: PresentUser[] };
        return result.users;
      },
      leave: async (id) => {
        await this.request("DELETE", id, undefined, "/presence");
      },
    };
  }

{% endif %}
{% if shares %}
  /**
   * Return the secret links of the records (ADR 0049): `GET`, `POST`, and
   * `DELETE <path>/{id}/share`. The FastAPI app checks the access.
   */
  sharing(): SharingApi {
    return {
      state: async (id) => {
        const result = (await this.request("GET", id, undefined, "/share")) as {
          active: boolean;
          created_at?: string | null;
        };
        return { active: result.active, createdAt: result.created_at ?? null };
      },
      create: async (id) => {
        const result = (await this.request("POST", id, undefined, "/share")) as { token: string; created_at: string };
        return { token: result.token, createdAt: result.created_at };
      },
      revoke: async (id) => {
        await this.request("DELETE", id, undefined, "/share");
      },
    };
  }

  /**
   * Return the record of a secret link without a sign-in: `GET /shared<path>/{token}`.
   * The related records stay JSON, by the JSON name of their entity: the
   * stores of their entities read them. A wrong or revoked token gives a
   * NotFoundError.
   */
  async shared(token: string): Promise<SharedRecord<T, unknown>> {
    const path = `/shared${this.path}/${encodeURIComponent(token)}${this.translations()}`;
    try {
      const result = (await apiRequest("GET", path)) as { record: unknown; related: Record<string, unknown[]> };
      return { record: this.fromJson(result.record), related: result.related };
    } catch (error) {
      if (error instanceof ApiError && error.status === 404) {
        throw new NotFoundError(this.entity, token);
      }
      throw error;
    }
  }

{% endif %}
{% if memberships %}
  /**
   * Return the operations that the memberships of the user give on the
   * records (ADR 0048): `GET /permissions<path>?ids=`. The FastAPI app checks
   * each call again.
   */
  async permissions(ids: string[]): Promise<MemberPermissions> {
    const search = new URLSearchParams(ids.map((id) => ["ids", id]));
    const query = ids.length > 0 ? `?${search.toString()}` : "";
    return (await apiRequest("GET", `/permissions${this.path}${query}`)) as MemberPermissions;
  }

{% endif %}
  /** Call the endpoint of a custom operation, for example `/{id}/cancel`, with the JSON params. */
  async call(method: string, suffix: string, id: string, params: object): Promise<unknown> {
    const result = await this.request(method, id, params, suffix);
    this.notify();
    return result;
  }

{% if query_operations(definition) %}
  /**
   * Return a page of the JSON rows of the endpoint of a query, for example
   * `/listings-for-guests` (ADR 0045), with the params as query parameters.
   */
  async rows(suffix: string, params: ApiParams, page: RowsPage): Promise<ListResult<Record<string, unknown>>> {
    const search = new URLSearchParams();
    for (const [name, value] of Object.entries(params)) {
      for (const item of typeof value === "object" && value !== null ? value : [value]) {
        if (item !== null && item !== undefined && item !== "") {
          search.append(name, String(item));
        }
      }
    }
    search.set("limit", String(page.pageSize));
    search.set("offset", String((page.page - 1) * page.pageSize));
    const result = (await apiRequest("GET", `${this.path}${suffix}?${search.toString()}`)) as {
      items: Record<string, unknown>[];
      total: number;
    };
    return { items: result.items, total: result.total, ...page };
  }

{% endif %}
  /** Return the record of a JSON object of the API. */
  fromJson(json: unknown): T {
    const values = json as Record<string, unknown>;
    const record: Record<string, unknown> = { id: String(values.id) };
    for (const [name, key] of Object.entries(this.shape.keys)) {
      const value = values[name];
      record[key] = this.shape.numbers.includes(key) && typeof value === "string" ? Number(value) : value;
    }
    return record as T;
  }

  /** Return the query parameter of a filter. */
  private param(filter: Filter<T>): [string, ApiParam] {
    const kind = this.shape.filters[filter.field];
    const name = this.jsonNames[filter.field];
    const value = filter.value;
    const one = typeof value === "string" || typeof value === "number" || typeof value === "boolean";
    const list = Array.isArray(value) && value.every((item) => typeof item === "string");
    if (name && ((filter.op === "eq" && kind && one) || (filter.op === "in" && kind === "list" && list))) {
      return [name, value as ApiParam];
    }
    throw new Error(`The list of ${this.entity} cannot filter ${filter.field} with ${filter.op}.`);
  }

  /** Load `count` records from `offset`, with requests of at most PAGE_LIMIT records. */
  private async load(
    params: ApiParams,
    sort: readonly string[],
    offset: number,
    count: number,
  ): Promise<{ items: T[]; total: number }> {
    if (Object.values(params).some((value) => typeof value === "object" && value?.length === 0)) {
      return { items: [], total: 0 };
    }
    const search = new URLSearchParams();
    for (const [name, value] of Object.entries(params)) {
      for (const item of typeof value === "object" && value !== null ? value : [value]) {
        if (item !== null && item !== undefined && item !== "") {
          search.append(name, String(item));
        }
      }
    }
    if (sort.length > 0) {
      search.set("sort", sort.join(","));
    }
    if (this.shape.translations) {
      search.set("translations", "all");
    }
    const items: T[] = [];
    let total = 0;
    while (items.length < count) {
      search.set("limit", String(Math.min(PAGE_LIMIT, count - items.length)));
      search.set("offset", String(offset + items.length));
      const page = (await apiRequest("GET", `${this.path}?${search.toString()}`)) as {
        items: Record<string, unknown>[];
        total: number;
      };
      for (const item of page.items) {
        const record = this.fromJson(item);
        this.known.set(record.id, record);
        items.push(record);
      }
      total = page.total;
      if (page.items.length === 0 || offset + items.length >= total) break;
    }
    return { items, total };
  }

  private toJson(values: object): Record<string, unknown> {
    const json: Record<string, unknown> = {};
    for (const [key, value] of Object.entries(values)) {
      if (value !== undefined) {
        json[this.jsonNames[key] ?? key] = value;
      }
    }
    return json;
  }

  /** The query of the values of all languages of the translatable fields, or no query. */
  private translations(): string {
    return this.shape.translations ? "?translations=all" : "";
  }

  private async request(method: string, id: string | null, body?: unknown, suffix = "", query = ""): Promise<unknown> {
    const path = (id === null ? this.path : `${this.path}/${encodeURIComponent(id)}${suffix}`) + query;
    try {
      return await apiRequest(method, path, body);
    } catch (error) {
      if (error instanceof ApiError && error.status === 404 && id !== null) {
        throw new NotFoundError(this.entity, id);
      }
      throw error;
    }
  }

  private notify(): void {
    this.known.clear();
    for (const listener of this.listeners) {
      listener();
    }
  }
}
