/**
 * Sign in with a provider (ADR 0020): the browser goes to the flow of the
 * FastAPI app, and comes back to the page `/auth/callback` with a token.
 * Then the app opens the page `next`. Return null, or the message of the error.
 */
export async function signInWithProvider(name: string, next: string): Promise<string | null> {
{% if signs_out %}
  const returnTo = `${window.location.origin}/auth/callback?next=${encodeURIComponent(next)}&provider=${encodeURIComponent(name)}`;
{% else %}
  const returnTo = `${window.location.origin}/auth/callback?next=${encodeURIComponent(next)}`;
{% endif %}
  window.location.assign(`${API_URL}/auth/providers/${encodeURIComponent(name)}/start?return_to=${encodeURIComponent(returnTo)}`);
  return null;
}

/**
 * Finish a sign-in with a provider: the FastAPI app gives the token, or
 * the error, in the fragment of the URL of `/auth/callback`. Return true
 * if the session starts.
 */
{% if signs_out %}
export async function finishProviderSignIn(fragment: string, provider: string | null = null): Promise<boolean> {
{% else %}
export async function finishProviderSignIn(fragment: string): Promise<boolean> {
{% endif %}
  const values = new URLSearchParams(fragment.replace(/^#/, ""));
  const token = values.get("access_token");
  if (token === null) {
    console.error(values.get("error") ?? "The callback has no token.");
    return false;
  }
  try {
    await startSession(token{{ ", provider" if signs_out }});
  } catch (error) {
    console.error(error);
    return false;
  }
  return true;
}
