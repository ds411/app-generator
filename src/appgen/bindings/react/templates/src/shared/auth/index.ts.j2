// The second factor of the mock users (ADR 0024) is a demonstration: the
// secrets and the recovery codes stay in the browser tab, and the browser
// makes the codes. An app with a back end keeps them on the server.
const SECOND_FACTORS_KEY = {{ (app.name ~ "-second-factors") | tojson }};
/** The name of the app in the authenticator app. */
const ISSUER = {{ definition.app.title | tojson }};
const BASE32 = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567";
{% if required %}
/** The roles that must use the second factor. */
const REQUIRED_ROLES: ReadonlySet<string> = new Set({{ required | tojson }});
{% endif %}

/** The second factor of a mock user: the secret in base32, the last time step of a code, and the recovery codes. */
type MockSecondFactor = { secret: string; enabled: boolean; lastStep: number | null; recoveryCodes: string[] };

function secondFactors(): Record<string, MockSecondFactor | undefined> {
  try {
    return JSON.parse(window.sessionStorage.getItem(SECOND_FACTORS_KEY) ?? "{}") as Record<string, MockSecondFactor | undefined>;
  } catch {
    return {};
  }
}

function saveSecondFactor(userId: string, factor: MockSecondFactor | undefined): void {
  window.sessionStorage.setItem(SECOND_FACTORS_KEY, JSON.stringify({ ...secondFactors(), [userId]: factor }));
}

/** Sign in as a mock user. Return null, or the message of the error. */
function startMockSession(userId: string): string | null {
  try {
    window.sessionStorage.setItem(STORAGE_KEY, userId);
  } catch {
    return {{ tr(js("The browser does not keep the session.")) }};
  }
  return null;
}

/** Return the second step of the sign-in of a mock user: `code`, `setup`, or null. */
function secondFactorStep(user: { id: string{{ "; role: string | null" if required }} }): "code" | "setup" | null {
  if (secondFactors()[user.id]?.enabled) return "code";
{% if required %}
  return REQUIRED_ROLES.has(user.role ?? "") ? "setup" : null;
{% else %}
  return null;
{% endif %}
}

/** Return bytes in base32 without padding (RFC 4648). */
function toBase32(bytes: Uint8Array): string {
  let text = "";
  let value = 0;
  let bits = 0;
  for (const byte of bytes) {
    value = ((value << 8) | byte) & 0xffff;
    bits += 8;
    while (bits >= 5) {
      text += BASE32.charAt((value >>> (bits - 5)) & 31);
      bits -= 5;
    }
  }
  return bits > 0 ? text + BASE32.charAt((value << (5 - bits)) & 31) : text;
}

function fromBase32(text: string): Uint8Array<ArrayBuffer> {
  const bytes: number[] = [];
  let value = 0;
  let bits = 0;
  for (const char of text) {
    value = ((value << 5) | BASE32.indexOf(char)) & 0xffff;
    bits += 5;
    if (bits >= 8) {
      bytes.push((value >>> (bits - 8)) & 255);
      bits -= 8;
    }
  }
  return new Uint8Array(bytes);
}

/** Return the code of a time step (RFC 6238: HMAC-SHA-1, 6 digits, steps of 30 seconds). */
async function totpCode(secret: string, step: number): Promise<string> {
  const key = await crypto.subtle.importKey("raw", fromBase32(secret), { name: "HMAC", hash: "SHA-1" }, false, ["sign"]);
  const counter = new DataView(new ArrayBuffer(8));
  counter.setUint32(0, Math.floor(step / 2 ** 32));
  counter.setUint32(4, step >>> 0);
  const digest = new DataView(await crypto.subtle.sign("HMAC", key, counter.buffer));
  const offset = digest.getUint8(19) & 0x0f;
  return String((digest.getUint32(offset) & 0x7fffffff) % 1_000_000).padStart(6, "0");
}

/** Accept a code of the authenticator app, or a recovery code, one time. */
async function acceptCode(userId: string, factor: MockSecondFactor, code: string): Promise<boolean> {
  const value = code.trim();
  const now = Math.floor(Date.now() / 30_000);
  for (let step = now - 1; step <= now + 1 && /^[0-9]{6}$/.test(value); step++) {
    if ((factor.lastStep === null || step > factor.lastStep) && (await totpCode(factor.secret, step)) === value) {
      saveSecondFactor(userId, { ...factor, lastStep: step });
      return true;
    }
  }
  const normal = (text: string) => text.replace(/[-\s]/g, "").toLowerCase();
  const left = factor.recoveryCodes.filter((item) => normal(item) !== normal(value));
  if (left.length === factor.recoveryCodes.length) return false;
  saveSecondFactor(userId, { ...factor, recoveryCodes: left });
  return true;
}

/** Sign in with the challenge of a sign-in and a code, or a recovery code. Return null, or the message of the error. */
export async function signInWithCode(challenge: string, code: string): Promise<string | null> { {{ trace(sf.id) }}
  const factor = secondFactors()[challenge];
  if (!factor?.enabled) return {{ tr(js("The sign-in has ended. Sign in again.")) }};
  if (!(await acceptCode(challenge, factor, code))) return {{ tr(js("The code is not correct.")) }};
  return startMockSession(challenge);
}

/** Return the state of the second factor of the signed-in user. */
export async function readSecondFactor(): Promise<SecondFactorStatus> { {{ trace(sf.id) }}
  const userId = currentUserId();
  if (userId === null) throw new Error({{ tr(js("Sign in to do this.")) }});
  const factor = secondFactors()[userId];
  const enabled = factor?.enabled ?? false;
  return { enabled, required: {{ 'REQUIRED_ROLES.has(currentRole() ?? "")' if required else "false" }}, recoveryCodesLeft: enabled ? (factor?.recoveryCodes.length ?? 0) : 0 };
}

/** Give a new secret for the authenticator app: for the signed-in user, or for the challenge of a sign-in. */
export async function setUpSecondFactor(challenge: string | null): Promise<AuthResult<SecondFactorSecret>> { {{ trace(sf.id) }}
  const userId = challenge ?? currentUserId();
  if (userId === null) return { ok: false, message: {{ tr(js("Sign in to do this.")) }} };
  const user = {{ "allUsers()" if sign_up else "users" }}.find((item) => item.id === userId);
  if (user === undefined) return { ok: false, message: {{ tr(js("Sign in to do this.")) }} };
  if (secondFactors()[userId]?.enabled) return { ok: false, message: {{ tr(js("The second factor is on.")) }} };
  const secret = toBase32(crypto.getRandomValues(new Uint8Array(20)));
  try {
    saveSecondFactor(userId, { secret, enabled: false, lastStep: null, recoveryCodes: [] });
  } catch {
    return { ok: false, message: {{ tr(js("The browser does not keep the session.")) }} };
  }
  const label = encodeURIComponent(`${ISSUER}:${user.username}`);
  const uri = `otpauth://totp/${label}?secret=${secret}&issuer=${encodeURIComponent(ISSUER)}&algorithm=SHA1&digits=6&period=30`;
  return { ok: true, value: { secret, uri } };
}

/** Turn on the second factor with a code, and return the recovery codes. With a challenge, the user is signed in. */
export async function confirmSecondFactor(code: string, challenge: string | null): Promise<AuthResult<string[]>> { {{ trace(sf.id) }}
  const userId = challenge ?? currentUserId();
  const factor = userId === null ? undefined : secondFactors()[userId];
  if (userId === null || factor === undefined || factor.enabled) return { ok: false, message: {{ tr(js("The sign-in has ended. Sign in again.")) }} };
  const now = Math.floor(Date.now() / 30_000);
  let step: number | null = null;
  for (let candidate = now - 1; candidate <= now + 1 && step === null; candidate++) {
    if ((await totpCode(factor.secret, candidate)) === code.trim()) step = candidate;
  }
  if (step === null) return { ok: false, message: {{ tr(js("The code is not correct.")) }} };
  const recoveryCodes = Array.from({ length: 10 }, () =>
    toBase32(crypto.getRandomValues(new Uint8Array(10))).toLowerCase().replace(/(.{4})(?=.)/g, "$1-"),
  );
  saveSecondFactor(userId, { ...factor, enabled: true, lastStep: step, recoveryCodes });
  const message = challenge === null ? null : startMockSession(userId);
  return message === null ? { ok: true, value: recoveryCodes } : { ok: false, message };
}

/** Turn off the second factor with a code, or a recovery code. Return null, or the message of the error. */
export async function disableSecondFactor(code: string): Promise<string | null> { {{ trace(sf.id) }}
  const userId = currentUserId();
  const factor = userId === null ? undefined : secondFactors()[userId];
  if (userId === null || !factor?.enabled) return {{ tr(js("The second factor is off.")) }};
{% if required %}
  if (REQUIRED_ROLES.has(currentRole() ?? "")) return {{ tr(js("Your role must use a second factor.")) }};
{% endif %}
  if (!(await acceptCode(userId, factor, code))) return {{ tr(js("The code is not correct.")) }};
  saveSecondFactor(userId, undefined);
  return null;
}
{% endif %}

