{% if definition.access %}

/** An operation that the role of the user may not call. */
export class ForbiddenError extends Error {
  constructor() {
    super({{ tr(js("Your role may not do this operation.")) }});
    this.name = "ForbiddenError";
  }
}

/** Return the role of the signed-in user, or null without a session or a role. */
export function currentRole(): string | null {
{% if react.api %}
  if (currentUserId() === null) return null;
  try {
    return window.sessionStorage.getItem(ROLE_KEY) || null;
  } catch {
    return null;
  }
{% else %}
  const id = currentUserId();
  return {{ "allUsers()" if sign_up else "users" }}.find((user) => user.id === id)?.role ?? null;
{% endif %}
}

/** Return true if the signed-in user may open a page (ADR 0012). */
export function canOpenPage(page: PageName): boolean {
  return roleMayOpenPage(currentRole(), page);
}

/** Throw a ForbiddenError if the signed-in user may not call an operation (ADR 0012). */
export function requireOperation(operation: string): void {
  if (!roleMayCall(currentRole(), operation)) {
    throw new ForbiddenError();
  }
}
{% if owner_rules and not react.api %}

/**
 * Return the ID of the signed-in user if an owner rule of its role applies
 * to an action on the records of an entity (ADR 0018), else null. The mock
 * data then gives only the records of the user, as a demonstration: an app
 * with a back end applies the rules on the server.
 */
export function recordOwner(entity: string, action: RecordAction): string | null {
  const userId = currentUserId();
  return userId !== null && ownerRuleApplies(currentRole(), entity, action) ? userId : null;
}
{% endif %}
{% endif %}

/** Return the ID of the signed-in user, or null. */
export function currentUserId(): string | null {
  try {
    return window.sessionStorage.getItem(STORAGE_KEY);
  } catch {
    return null;
  }
}

{% if react.api %}
/** Keep the session of a token of the API: the ID{% if role_key %} and the role{% endif %} of the user. */
export async function startSession(token: string): Promise<void> {
  setAccessToken(token);
  try {
    const user = (await apiRequest("GET", "/auth/me")) as Record<string, unknown>;
    window.sessionStorage.setItem(STORAGE_KEY, String(user.id));
{% if role_key %}
    window.sessionStorage.setItem(ROLE_KEY, String(user[{{ definition.access.role_field | tojson }}] ?? ""));
{% endif %}
  } catch (error) {
    setAccessToken(null);
    throw error;
  }
}

{% if definition.auth.password %}
/**
 * The result of a sign-in: the user is signed in, or an error with its
 * message.{% if verify %} `unverified`: the password is correct, but the user must
 * confirm the email address first (ADR 0023).{% endif %}

 */
export type SignInResult = { status: "signed-in" } | { status: "error" | "unverified"; message: string };

/** Sign in with the API. */
export async function signIn(username: string, password: string): Promise<SignInResult> {
  try {
    const token = (await apiRequest("POST", "/auth/sign-in", { username, password })) as { access_token: string };
    await startSession(token.access_token);
  } catch (error) {
    setAccessToken(null);
{% if verify %}
    if (error instanceof ApiError && error.status === 403) {
      return { status: "unverified", message: error.message }; {{ trace(verify.id) }}
    }
{% endif %}
    return { status: "error", message: error instanceof Error ? error.message : {{ tr(js("The sign-in failed.")) }} };
  }
  return { status: "signed-in" };
}
{% endif %}
{% if definition.auth.providers %}

/**
 * Sign in with a provider (ADR 0020): the browser goes to the flow of the
 * FastAPI app, and comes back to the page `/auth/callback` with a token.
 * Then the app opens the page `next`. Return null, or the message of the error.
 */
export async function signInWithProvider(name: string, next: string): Promise<string | null> {
  const returnTo = `${window.location.origin}/auth/callback?next=${encodeURIComponent(next)}`;
  window.location.assign(`${API_URL}/auth/providers/${encodeURIComponent(name)}/start?return_to=${encodeURIComponent(returnTo)}`);
  return null;
}

/**
 * Finish a sign-in with a provider: the FastAPI app gives the token, or
 * the error, in the fragment of the URL of `/auth/callback`. Return true
 * if the session starts.
 */
export async function finishProviderSignIn(fragment: string): Promise<boolean> {
  const values = new URLSearchParams(fragment.replace(/^#/, ""));
  const token = values.get("access_token");
  if (token === null) {
    console.error(values.get("error") ?? "The callback has no token.");
    return false;
  }
  try {
    await startSession(token);
  } catch (error) {
    console.error(error);
    return false;
  }
  return true;
}
{% endif %}

{% if definition.auth.password_reset %}

/** Ask the API for a reset link (`POST /auth/password-reset`). Return null, or the message of the error. */
export async function requestPasswordReset(username: string): Promise<string | null> { {{ trace(definition.auth.password_reset.id) }}
  try {
    await apiRequest("POST", "/auth/password-reset", { username });
  } catch (error) {
    return error instanceof Error ? error.message : {{ tr(js("The request failed.")) }};
  }
  return null;
}

/** Set a new password with the token of a reset link (`POST /auth/password-reset/confirm`). Return null, or the message of the error. */
export async function confirmPasswordReset(token: string, newPassword: string): Promise<string | null> { {{ trace(definition.auth.password_reset.id) }}
  try {
    await apiRequest("POST", "/auth/password-reset/confirm", { token, new_password: newPassword });
  } catch (error) {
    return error instanceof Error ? error.message : {{ tr(js("The request failed.")) }};
  }
  return null;
}
{% endif %}
