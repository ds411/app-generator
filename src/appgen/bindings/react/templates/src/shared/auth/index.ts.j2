{% set key = definition.auth.username_field | camel %}
{% set role_key = definition.access.role_field | camel if definition.access else none %}
{{ trace_header(definition.auth.id) }}
{% if react.api %}
// The sign-in of the app with the FastAPI app (ADR 0011): the API checks
// the password, and gives a bearer token. The session stays in the
// browser tab.{% if role_key %} The checks of the roles in the browser only hide what the
// API refuses: the API checks each request.{% endif %}

import { apiRequest, setAccessToken } from "@/shared/api";
{% if role_key %}
import type { PageName } from "@/shared/config/pages";
import { roleMayCall, roleMayOpenPage } from "@/shared/lib/permissions";
{% endif %}

const STORAGE_KEY = {{ (app.name ~ "-session") | tojson }};
{% if role_key %}
const ROLE_KEY = {{ (app.name ~ "-role") | tojson }};
{% endif %}
{% else %}
// The sign-in of the app with mock data (ADR 0011). The users are the mock
// records of {{ definition.auth.user_entity }}, and each one signs in with the password
// MOCK_PASSWORD. The session stays in the browser tab. An app with a back
// end checks the passwords on the server.

{% if role_key %}
import type { PageName } from "@/shared/config/pages";
import { roleMayCall, roleMayOpenPage } from "@/shared/lib/permissions";

{% endif %}
/** The password of each mock user. */
export const MOCK_PASSWORD = "password";

const STORAGE_KEY = {{ (app.name ~ "-session") | tojson }};

const users: { id: string; username: string{% if role_key %}; role: string | null{% endif %} }[] = [
{% for record in mock[definition.auth.user_entity] %}
  { id: {{ record.id | tojson }}, username: {{ record[key] | tojson }}{% if role_key %}, role: {{ record[role_key] | tojson }}{% endif %} },
{% endfor %}
];
{% endif %}
{% if definition.access %}

/** An operation that the role of the user may not call. */
export class ForbiddenError extends Error {
  constructor() {
    super({{ tr(js("Your role may not do this operation.")) }});
    this.name = "ForbiddenError";
  }
}

/** Return the role of the signed-in user, or null without a session or a role. */
export function currentRole(): string | null {
{% if react.api %}
  if (currentUserId() === null) return null;
  try {
    return window.sessionStorage.getItem(ROLE_KEY) || null;
  } catch {
    return null;
  }
{% else %}
  const id = currentUserId();
  return users.find((user) => user.id === id)?.role ?? null;
{% endif %}
}

/** Return true if the signed-in user may open a page (ADR 0012). */
export function canOpenPage(page: PageName): boolean {
  return roleMayOpenPage(currentRole(), page);
}

/** Throw a ForbiddenError if the signed-in user may not call an operation (ADR 0012). */
export function requireOperation(operation: string): void {
  if (!roleMayCall(currentRole(), operation)) {
    throw new ForbiddenError();
  }
}
{% endif %}

/** Return the ID of the signed-in user, or null. */
export function currentUserId(): string | null {
  try {
    return window.sessionStorage.getItem(STORAGE_KEY);
  } catch {
    return null;
  }
}

{% if react.api %}
/** Sign in with the API. Return null, or the message of the error. */
export async function signIn(username: string, password: string): Promise<string | null> {
  try {
    const token = (await apiRequest("POST", "/auth/sign-in", { username, password })) as { access_token: string };
    setAccessToken(token.access_token);
    const user = (await apiRequest("GET", "/auth/me")) as Record<string, unknown>;
    window.sessionStorage.setItem(STORAGE_KEY, String(user.id));
{% if role_key %}
    window.sessionStorage.setItem(ROLE_KEY, String(user[{{ definition.access.role_field | tojson }}] ?? ""));
{% endif %}
  } catch (error) {
    setAccessToken(null);
    return error instanceof Error ? error.message : {{ tr(js("The sign-in failed.")) }};
  }
  return null;
}

/** Sign out. */
export async function signOut(): Promise<void> {
  setAccessToken(null);
  try {
    window.sessionStorage.removeItem(STORAGE_KEY);
{% if role_key %}
    window.sessionStorage.removeItem(ROLE_KEY);
{% endif %}
  } catch {
    // No storage: no session to delete.
  }
}
{% else %}
/** Sign in. Return null, or the message of the error. */
export async function signIn(username: string, password: string): Promise<string | null> {
  const user = users.find((item) => item.username === username);
  if (!user || password !== MOCK_PASSWORD) {
    return {{ tr(js("The user name or the password is not correct.")) }};
  }
  try {
    window.sessionStorage.setItem(STORAGE_KEY, user.id);
  } catch {
    return {{ tr(js("The browser does not keep the session.")) }};
  }
  return null;
}

/** Sign out. */
export async function signOut(): Promise<void> {
  try {
    window.sessionStorage.removeItem(STORAGE_KEY);
  } catch {
    // No storage: no session to delete.
  }
}
{% endif %}
