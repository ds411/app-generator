/** Return the message of an error of the API. */
function errorMessage(error: unknown): string {
  return error instanceof Error ? error.message : {{ tr(js("The request failed.")) }};
}

/**
 * Sign in with the challenge of a sign-in and a code, or a recovery code
 * (`POST /auth/sign-in/second-factor`). Return null, or the message of the error.
 */
export async function signInWithCode(challenge: string, code: string): Promise<string | null> { {{ trace(sf.id) }}
  try {
    const token = (await apiRequest("POST", "/auth/sign-in/second-factor", { challenge, code })) as { access_token: string };
    await startSession(token.access_token);
  } catch (error) {
    setAccessToken(null);
    return errorMessage(error);
  }
  return null;
}

/** Return the state of the second factor of the signed-in user (`GET /auth/second-factor`). */
export async function readSecondFactor(): Promise<SecondFactorStatus> { {{ trace(sf.id) }}
  const status = (await apiRequest("GET", "/auth/second-factor")) as { enabled: boolean; required: boolean; recovery_codes_left: number };
  return { enabled: status.enabled, required: status.required, recoveryCodesLeft: status.recovery_codes_left };
}

/**
 * Give a new secret for the authenticator app (`POST /auth/second-factor/setup`):
 * for the signed-in user, or for the challenge of a sign-in.
 */
export async function setUpSecondFactor(challenge: string | null): Promise<AuthResult<SecondFactorSecret>> { {{ trace(sf.id) }}
  try {
    return { ok: true, value: (await apiRequest("POST", "/auth/second-factor/setup", { challenge })) as SecondFactorSecret };
  } catch (error) {
    return { ok: false, message: errorMessage(error) };
  }
}

/**
 * Turn on the second factor with a code (`POST /auth/second-factor/confirm`),
 * and return the recovery codes. With a challenge, the API gives a token: the user is signed in.
 */
export async function confirmSecondFactor(code: string, challenge: string | null): Promise<AuthResult<string[]>> { {{ trace(sf.id) }}
  try {
    const answer = (await apiRequest("POST", "/auth/second-factor/confirm", { code, challenge })) as {
      recovery_codes: string[];
      token: { access_token: string } | null;
    };
    if (answer.token) {
      await startSession(answer.token.access_token);
    }
    return { ok: true, value: answer.recovery_codes };
  } catch (error) {
    return { ok: false, message: errorMessage(error) };
  }
}

/** Turn off the second factor with a code, or a recovery code (`POST /auth/second-factor/disable`). Return null, or the message of the error. */
export async function disableSecondFactor(code: string): Promise<string | null> { {{ trace(sf.id) }}
  try {
    await apiRequest("POST", "/auth/second-factor/disable", { code });
  } catch (error) {
    return errorMessage(error);
  }
  return null;
}
