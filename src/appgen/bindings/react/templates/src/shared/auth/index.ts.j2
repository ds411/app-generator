/** The users of the sign-up in this browser tab (ADR 0016). */
function signedUpUsers(): MockUser[] {
  try {
    return JSON.parse(window.sessionStorage.getItem(SIGN_UPS_KEY) ?? "[]") as MockUser[];
  } catch {
    return [];
  }
}

/** Return the mock users and the users of the sign-up. */
function allUsers(): MockUser[] {
  return [...users, ...signedUpUsers()];
}

/** Return the SHA-256 hash of a password, as hexadecimal text. */
async function passwordHash(password: string): Promise<string> {
  const digest = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(password));
  return Array.from(new Uint8Array(digest), (byte) => byte.toString(16).padStart(2, "0")).join("");
}

/** Return true if a password is the password of a mock user. */
async function passwordMatches(user: MockUser, password: string): Promise<boolean> {
  return user.passwordHash === undefined ? password === MOCK_PASSWORD : user.passwordHash === (await passwordHash(password));
}

/**
 * Add a user of the sign-up for the session of the browser tab, and sign
 * in as the user. Later, the user signs in with its own password.
 */
export async function addMockUser(username: string, password: string): Promise<void> {
  if (allUsers().some((user) => user.username === username)) {
    throw new Error({{ tr(js("A user with this user name exists.")) }});
  }
  const user: MockUser = { id: crypto.randomUUID(), username{% if role_key %}, role: {{ ui_forms.sign_up.role | tojson }}{% endif %}, passwordHash: await passwordHash(password) };
  try {
    window.sessionStorage.setItem(SIGN_UPS_KEY, JSON.stringify([...signedUpUsers(), user]));
    window.sessionStorage.setItem(STORAGE_KEY, user.id);
  } catch {
    throw new Error({{ tr(js("The browser does not keep the session.")) }});
  }
}
