}

/** List the APIs that the users connect, with the connections of the signed-in user. */
export async function listConnections(): Promise<Connection[]> {
  const userId = currentUserId();
  if (userId === null) throw new Error({{ tr(js("Sign in to do this.")) }});
  const own = mockConnections()[userId] ?? {};
