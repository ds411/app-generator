{% if definition.auth.password %}
/** The result of a sign-in: the user is signed in, or an error with its message. */
export type SignInResult = { status: "signed-in" } | { status: "error" | "unverified"; message: string };

/** Sign in with the password of a mock user. */
export async function signIn(username: string, password: string): Promise<SignInResult> {
{% if sign_up %}
  const user = allUsers().find((item) => item.username === username);
  if (!user || !(await passwordMatches(user, password))) {
{% else %}
  const user = users.find((item) => item.username === username);
  if (!user || password !== MOCK_PASSWORD) {
{% endif %}
    return { status: "error", message: {{ tr(js("The user name or the password is not correct.")) }} };
  }
  try {
    window.sessionStorage.setItem(STORAGE_KEY, user.id);
  } catch {
    return { status: "error", message: {{ tr(js("The browser does not keep the session.")) }} };
  }
  return { status: "signed-in" };
}
{% endif %}
{% if definition.auth.providers %}
{% set mock_users = mock[definition.auth.user_entity] %}

/** The mock user of each provider: a sign-in with the provider signs in this user. */
const PROVIDER_USERS: Record<string, string> = {
{% for name, p in definition.auth.providers.items() %}
{% set role_users = (mock_users | selectattr(role_key, "eq", p.default_role) | list) if role_key and p.create_users and p.default_role else [] %}
{% set user = (role_users or mock_users) | first %}
{% if user %}
  {{ name }}: {{ user.id | tojson }}, {{ trace(p.id) }}
{% endif %}
{% endfor %}
};

/**
 * Sign in with a provider (ADR 0020): with mock data, sign in the mock user
 * of the provider at once, and open the page `next`. Return null, or the
 * message of the error.
 */
export async function signInWithProvider(name: string, next: string): Promise<string | null> {
  const userId = PROVIDER_USERS[name];
  if (userId === undefined) {
    return {{ tr(js("The sign-in failed.")) }};
  }
  try {
    window.sessionStorage.setItem(STORAGE_KEY, userId);
  } catch {
    return {{ tr(js("The browser does not keep the session.")) }};
  }
  window.location.assign(next);
  return null;
}
{% endif %}

/** Sign out. */
export async function signOut(): Promise<void> {
  try {
    window.sessionStorage.removeItem(STORAGE_KEY);
  } catch {
    // No storage: no session to delete.
  }
}
{% endif %}
