{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ds411/app-generator/main/schema/app.schema.json",
  "$defs": {
    "Action": {
      "oneOf": [
        {
          "$ref": "#/$defs/NavigateAction"
        },
        {
          "$ref": "#/$defs/FormAction"
        },
        {
          "$ref": "#/$defs/OperationAction"
        },
        {
          "$ref": "#/$defs/CustomAction"
        }
      ]
    },
    "App": {
      "additionalProperties": false,
      "description": "The name and the description of the app.",
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "name": {
          "$ref": "#/$defs/AppName"
        },
        "title": {
          "$ref": "#/$defs/Text"
        },
        "description": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "name",
        "title"
      ],
      "title": "App",
      "type": "object"
    },
    "AppName": {
      "pattern": "^[a-z][a-z0-9-]*$",
      "type": "string"
    },
    "ColorMode": {
      "enum": [
        "light",
        "dark",
        "system"
      ],
      "type": "string"
    },
    "Confirm": {
      "additionalProperties": false,
      "description": "A question that the user must confirm before an action runs.",
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "title": {
          "$ref": "#/$defs/Text"
        },
        "message": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "confirm_label": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "title"
      ],
      "title": "Confirm",
      "type": "object"
    },
    "Content": {
      "additionalProperties": false,
      "description": "The content region of a layout, where the page shows.",
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "max_width": {
          "anyOf": [
            {
              "$ref": "#/$defs/TokenRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "padding": {
          "anyOf": [
            {
              "$ref": "#/$defs/TokenRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "Content",
      "type": "object"
    },
    "CustomAction": {
      "additionalProperties": false,
      "description": "An action that hand-written code gives (a generation gap).",
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "icon": {
          "anyOf": [
            {
              "$ref": "#/$defs/IconName"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "variant": {
          "$ref": "#/$defs/Variant",
          "default": "default"
        },
        "confirm": {
          "anyOf": [
            {
              "$ref": "#/$defs/Confirm"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "const": "custom",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "CustomAction",
      "type": "object"
    },
    "Defaults": {
      "additionalProperties": false,
      "description": "Values that apply when a UI element does not set them.",
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "layout": {
          "anyOf": [
            {
              "$ref": "#/$defs/MemberName"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "Defaults",
      "type": "object"
    },
    "Entity": {
      "additionalProperties": false,
      "description": "A kind of record that the app stores, for example a task.",
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "description": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "plural_label": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "display_field": {
          "anyOf": [
            {
              "$ref": "#/$defs/MemberName"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "fields": {
          "additionalProperties": {
            "$ref": "#/$defs/Field"
          },
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/MemberName"
          },
          "title": "Fields",
          "type": "object"
        },
        "relations": {
          "additionalProperties": {
            "$ref": "#/$defs/Relation"
          },
          "propertyNames": {
            "$ref": "#/$defs/MemberName"
          },
          "title": "Relations",
          "type": "object"
        }
      },
      "required": [
        "fields"
      ],
      "title": "Entity",
      "type": "object"
    },
    "EntityName": {
      "pattern": "^[A-Z][A-Za-z0-9]*$",
      "type": "string"
    },
    "Field": {
      "additionalProperties": false,
      "description": "A field of an entity, or a param of a custom operation.",
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "type": {
          "$ref": "#/$defs/FieldType"
        },
        "description": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "unique": {
          "default": false,
          "title": "Unique",
          "type": "boolean"
        },
        "default": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        },
        "min_length": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Length"
        },
        "max_length": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Length"
        },
        "pattern": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min"
        },
        "max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max"
        },
        "precision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Precision"
        },
        "scale": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scale"
        },
        "values": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/MemberName"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Values"
        }
      },
      "required": [
        "type"
      ],
      "title": "Field",
      "type": "object"
    },
    "FieldPath": {
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*$",
      "type": "string"
    },
    "FieldType": {
      "enum": [
        "string",
        "text",
        "integer",
        "decimal",
        "boolean",
        "date",
        "datetime",
        "uuid",
        "email",
        "url",
        "enum",
        "json"
      ],
      "type": "string"
    },
    "Footer": {
      "additionalProperties": false,
      "description": "The optional footer region of a layout.",
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "text": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [
        "text"
      ],
      "title": "Footer",
      "type": "object"
    },
    "FormAction": {
      "additionalProperties": false,
      "description": "Open a form.",
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "icon": {
          "anyOf": [
            {
              "$ref": "#/$defs/IconName"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "variant": {
          "$ref": "#/$defs/Variant",
          "default": "default"
        },
        "confirm": {
          "anyOf": [
            {
              "$ref": "#/$defs/Confirm"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "const": "form",
          "title": "Kind",
          "type": "string"
        },
        "form": {
          "$ref": "#/$defs/MemberName"
        },
        "on_success": {
          "anyOf": [
            {
              "$ref": "#/$defs/OnSuccess"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind",
        "form"
      ],
      "title": "FormAction",
      "type": "object"
    },
    "IconName": {
      "pattern": "^[a-z][a-z0-9-]*$",
      "type": "string"
    },
    "JsonValue": {},
    "Layout": {
      "additionalProperties": false,
      "description": "An app shell: a sidebar, a top bar, the content, and an optional footer.",
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "sidebar": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sidebar"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "topbar": {
          "anyOf": [
            {
              "$ref": "#/$defs/Topbar"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "content": {
          "anyOf": [
            {
              "$ref": "#/$defs/Content"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "footer": {
          "anyOf": [
            {
              "$ref": "#/$defs/Footer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "Layout",
      "type": "object"
    },
    "MemberName": {
      "pattern": "^[a-z][a-z0-9_]*$",
      "type": "string"
    },
    "Menu": {
      "additionalProperties": false,
      "description": "A navigation menu. The items without a group show before the groups.",
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "items": {
          "additionalProperties": {
            "$ref": "#/$defs/MenuItem"
          },
          "propertyNames": {
            "$ref": "#/$defs/MemberName"
          },
          "title": "Items",
          "type": "object"
        },
        "groups": {
          "additionalProperties": {
            "$ref": "#/$defs/MenuGroup"
          },
          "propertyNames": {
            "$ref": "#/$defs/MemberName"
          },
          "title": "Groups",
          "type": "object"
        }
      },
      "title": "Menu",
      "type": "object"
    },
    "MenuGroup": {
      "additionalProperties": false,
      "description": "A group of menu items with a label.",
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "icon": {
          "anyOf": [
            {
              "$ref": "#/$defs/IconName"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "collapsible": {
          "default": false,
          "title": "Collapsible",
          "type": "boolean"
        },
        "items": {
          "additionalProperties": {
            "$ref": "#/$defs/MenuItem"
          },
          "propertyNames": {
            "$ref": "#/$defs/MemberName"
          },
          "title": "Items",
          "type": "object"
        }
      },
      "title": "MenuGroup",
      "type": "object"
    },
    "MenuItem": {
      "additionalProperties": false,
      "description": "An item of a menu. It opens a page, and it can have one level of sub-items.",
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "page": {
          "$ref": "#/$defs/MemberName"
        },
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "icon": {
          "anyOf": [
            {
              "$ref": "#/$defs/IconName"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "items": {
          "additionalProperties": {
            "$ref": "#/$defs/MenuSubItem"
          },
          "propertyNames": {
            "$ref": "#/$defs/MemberName"
          },
          "title": "Items",
          "type": "object"
        }
      },
      "required": [
        "page"
      ],
      "title": "MenuItem",
      "type": "object"
    },
    "MenuSubItem": {
      "additionalProperties": false,
      "description": "An item below a menu item.",
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "page": {
          "$ref": "#/$defs/MemberName"
        },
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "icon": {
          "anyOf": [
            {
              "$ref": "#/$defs/IconName"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "page"
      ],
      "title": "MenuSubItem",
      "type": "object"
    },
    "Mode": {
      "enum": [
        "light",
        "dark"
      ],
      "type": "string"
    },
    "NavigateAction": {
      "additionalProperties": false,
      "description": "Open a page.",
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "icon": {
          "anyOf": [
            {
              "$ref": "#/$defs/IconName"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "variant": {
          "$ref": "#/$defs/Variant",
          "default": "default"
        },
        "confirm": {
          "anyOf": [
            {
              "$ref": "#/$defs/Confirm"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "const": "navigate",
          "title": "Kind",
          "type": "string"
        },
        "page": {
          "$ref": "#/$defs/MemberName"
        },
        "params": {
          "additionalProperties": {
            "$ref": "#/$defs/FieldPath"
          },
          "propertyNames": {
            "$ref": "#/$defs/MemberName"
          },
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "kind",
        "page"
      ],
      "title": "NavigateAction",
      "type": "object"
    },
    "OnDelete": {
      "enum": [
        "restrict",
        "cascade",
        "set_null"
      ],
      "type": "string"
    },
    "OnSuccess": {
      "additionalProperties": false,
      "description": "What the app does after an action or a form succeeds.",
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "toast": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "navigate": {
          "anyOf": [
            {
              "$ref": "#/$defs/MemberName"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "OnSuccess",
      "type": "object"
    },
    "Operation": {
      "additionalProperties": false,
      "description": "An action that the app can do on an entity.",
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "kind": {
          "$ref": "#/$defs/OperationKind"
        },
        "entity": {
          "$ref": "#/$defs/EntityName"
        },
        "description": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "params": {
          "additionalProperties": {
            "$ref": "#/$defs/Field"
          },
          "propertyNames": {
            "$ref": "#/$defs/MemberName"
          },
          "title": "Params",
          "type": "object"
        },
        "returns": {
          "$ref": "#/$defs/Text",
          "default": "none"
        }
      },
      "required": [
        "kind",
        "entity"
      ],
      "title": "Operation",
      "type": "object"
    },
    "OperationAction": {
      "additionalProperties": false,
      "description": "Run an operation, for example a delete.",
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "icon": {
          "anyOf": [
            {
              "$ref": "#/$defs/IconName"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "variant": {
          "$ref": "#/$defs/Variant",
          "default": "default"
        },
        "confirm": {
          "anyOf": [
            {
              "$ref": "#/$defs/Confirm"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "const": "operation",
          "title": "Kind",
          "type": "string"
        },
        "operation": {
          "$ref": "#/$defs/MemberName"
        },
        "on_success": {
          "anyOf": [
            {
              "$ref": "#/$defs/OnSuccess"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind",
        "operation"
      ],
      "title": "OperationAction",
      "type": "object"
    },
    "OperationKind": {
      "enum": [
        "create",
        "read",
        "update",
        "delete",
        "list",
        "custom"
      ],
      "type": "string"
    },
    "Page": {
      "additionalProperties": false,
      "description": "A screen of a front-end app.",
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "path": {
          "pattern": "^/",
          "title": "Path",
          "type": "string"
        },
        "title": {
          "$ref": "#/$defs/Text"
        },
        "entity": {
          "anyOf": [
            {
              "$ref": "#/$defs/EntityName"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "description": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "layout": {
          "anyOf": [
            {
              "$ref": "#/$defs/MemberName"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "content": {
          "anyOf": [
            {
              "$ref": "#/$defs/PageContent"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "actions": {
          "additionalProperties": {
            "$ref": "#/$defs/Action"
          },
          "propertyNames": {
            "$ref": "#/$defs/MemberName"
          },
          "title": "Actions",
          "type": "object"
        },
        "breadcrumb": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "path",
        "title"
      ],
      "title": "Page",
      "type": "object"
    },
    "PageContent": {
      "additionalProperties": false,
      "description": "What a page shows in its layout: one view, form, or dashboard, or a gap.",
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "view": {
          "anyOf": [
            {
              "$ref": "#/$defs/MemberName"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "form": {
          "anyOf": [
            {
